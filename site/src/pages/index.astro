      .trade-visual { position: relative; }
      .ps-dot { position: absolute; width: 7px; height: 7px; border-radius: 50%; background: var(--structure, #AEB6C2); opacity: 0.5; }
      .ps-dot.lit { background: var(--accent); opacity: 1; box-shadow: 0 0 12px var(--accent); }
      .building { opacity: 0.9; }
      .sinking-visual { display: flex; align-items: flex-end; justify-content: center; padding: 24px 24px 0; overflow: hidden; }
      .sinking-visual svg { width: min(440px, 100%); height: auto; display: block; }
      .sinking-visual .wave { animation: drift 9s linear infinite; }
      .sinking-visual .w2 { animation-duration: 13s; animation-direction: reverse; }
      @keyframes drift { to { transform: translateX(200px); } }

      .platform { padding-top: 4vh; }
      .section-head { display: flex; flex-direction: column; gap: 8px; }
      .section-sub { margin: 0; color: var(--ink-muted); max-width: 34rem; }
      .pustaka-live { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 12px; padding: 26px; }
      .pustaka-live > * { width: min(420px, 100%); }
      .try-chips { display: flex; flex-wrap: wrap; gap: 6px; }
      .try-chips button { background: none; border: 1px solid var(--hairline); color: var(--ink-muted); border-radius: 16px; padding: 5px 11px; font-size: 0.75rem; cursor: pointer; font-family: var(--font-body); }
      .try-chips button:hover { border-color: var(--accent); color: var(--accent); }
      .try-answer { background: var(--surface-raised); border: 1px solid var(--hairline); border-radius: 10px; padding: 12px 16px; font-size: 0.85rem; line-height: 1.6; max-height: 190px; overflow-y: auto; }
      .try-answer .tcite { display: inline-flex; min-width: 15px; height: 15px; align-items: center; justify-content: center; border: 1px solid var(--accent); border-radius: 3px; color: var(--accent); font-size: 0.75rem; margin: 0 2px; font-family: var(--font-data); }
      .try-sources { line-height: 1.7; }
      #try-form { display: flex; gap: 8px; }
      #try-q { flex: 1; background: var(--surface-raised); border: 1px solid var(--hairline); border-radius: 8px; color: var(--ink); padding: 10px 14px; font-family: var(--font-body); font-size: 0.85rem; }
      #try-q:focus-visible { outline: 2px solid var(--accent); }
      #try-form button { background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 8px; padding: 0 18px; font-family: var(--font-display); font-weight: 600; cursor: pointer; }
      .narrative-visual { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 28px; }
      .narrative-visual span { width: 6px; border-radius: 3px; background: var(--accent); opacity: 0.75; animation: pulse-bar 1.6s ease-in-out infinite; }
      .narrative-visual span:nth-child(odd) { background: var(--ink-muted); opacity: 0.35; }
      .narrative-visual span:nth-child(1) { height: 18px; animation-delay: 0s; }
      .narrative-visual span:nth-child(2) { height: 42px; animation-delay: .1s; }
      .narrative-visual span:nth-child(3) { height: 26px; animation-delay: .2s; }
      .narrative-visual span:nth-child(4) { height: 58px; animation-delay: .3s; }
      .narrative-visual span:nth-child(5) { height: 34px; animation-delay: .4s; }
      .narrative-visual span:nth-child(6) { height: 74px; animation-delay: .5s; }
      .narrative-visual span:nth-child(7) { height: 30px; animation-delay: .6s; }
      .narrative-visual span:nth-child(8) { height: 88px; animation-delay: .7s; }
      .narrative-visual span:nth-child(9) { height: 40px; animation-delay: .8s; }
      .narrative-visual span:nth-child(10) { height: 62px; animation-delay: .9s; }
      .narrative-visual span:nth-child(11) { height: 24px; animation-delay: 1s; }
      .narrative-visual span:nth-child(12) { height: 48px; animation-delay: 1.1s; }
      @keyframes pulse-bar { 50% { transform: scaleY(0.55); } }
      /* air-quality visual: haze layers drifting across a hidden sun */
      .aq-visual, .forest-visual, .transit-visual { padding: 0; overflow: hidden; }
      .aq-visual svg, .forest-visual svg, .transit-visual svg, .sinking-visual svg { width: 100%; height: 100%; display: block; }
      @keyframes haze-drift { to { transform: translateX(9%); } }
      .aq-reading { position: absolute; left: 22px; bottom: 16px; font-family: var(--font-data);
        font-size: 0.75rem; letter-spacing: 0.12em; color: var(--accent); }

      /* queued phase-3 grid */
      .queued-head { margin-top: 8px; }
      .queued-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
      @media (max-width: 860px) { .queued-grid { grid-template-columns: 1fr; } }
      .mini-case { border: 1px solid var(--hairline); border-radius: 8px; overflow: hidden;
        background: var(--surface); display: flex; flex-direction: column; }
      .mini-case h3 { margin: 0; font-size: 1.02rem; padding: 16px 18px 0; letter-spacing: -0.01em; }
      .mini-case p { margin: 0; padding: 8px 18px 0; font-size: 0.85rem; line-height: 1.55; color: var(--ink-muted); }
      .mini-case .meta { padding: 12px 18px 18px; margin-top: auto; }
      .mini-visual { height: 130px; background: linear-gradient(120deg, var(--ground), var(--surface));
        display: flex; align-items: center; justify-content: center; }
      .mini-visual svg { width: 78%; height: 82%; }


      /* Trade: a real orthographic globe on Indonesia — Natural Earth coastlines,
         true great-circle arcs, weight and speed set by Comtrade 2023 export value.
         Arcs are cut where they pass behind the sphere, not faked. */
      .tg-grat path { fill: none; stroke: #AEB6C2; stroke-width: 0.35; opacity: 0.13; }
      .tg-land path { fill: none; stroke: #7F8B9C; stroke-width: 0.8; opacity: 0.55; }
      .tr-arc path { fill: none; stroke-linecap: round; }
      .a-base { stroke: #D9722C; stroke-width: calc(var(--w) * 0.5px); opacity: 0.22; }
      .a-glow { stroke: #D9722C; stroke-width: calc(var(--w) * 2.2px); opacity: 0.5;
        filter: url(#tg-bloom); stroke-dasharray: 60 940;
        animation: tg-run var(--d) linear var(--t) infinite; }
      .a-core { stroke: #FFD9B0; stroke-width: calc(var(--w) * 0.8px); opacity: 0.95;
        stroke-dasharray: 34 966; animation: tg-run var(--d) linear var(--t) infinite; }
      @keyframes tg-run { from { stroke-dashoffset: 1000; } to { stroke-dashoffset: 0; } }
      .o-ring { transform-box: fill-box; transform-origin: center;
        animation: tg-pulse 3.2s ease-out infinite; }
      @keyframes tg-pulse {
        0% { transform: scale(0.6); opacity: 0.95; }
        75%, 100% { transform: scale(2.1); opacity: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        .a-glow, .a-core { animation: none; stroke-dasharray: none; opacity: 0.45; }
        .o-ring { animation: none; }
      }

      /* Transit: the real 249-corridor network draws Jakarta, and light runs the trunks.
         pathLength=1000 normalises every line so a pulse crosses each in the same beat. */
      .tr-web path { fill: none; stroke: #6E7A8C; stroke-width: 0.6; opacity: 0.22; }
      .corr path { fill: none; stroke-linecap: round; }
      .c-base { stroke: var(--c); stroke-width: 1.1; opacity: 0.30; }
      .c-glow { stroke: var(--c); stroke-width: 5; opacity: 0.55; filter: url(#tr-bloom);
        stroke-dasharray: 46 954; animation: tr-run var(--d) linear var(--t) infinite; }
      .c-core { stroke: #FFF3EA; stroke-width: 1.5; opacity: 0.95;
        stroke-dasharray: 26 974; animation: tr-run var(--d) linear var(--t) infinite; }
      @keyframes tr-run { from { stroke-dashoffset: 1000; } to { stroke-dashoffset: 0; } }
      @media (prefers-reduced-motion: reduce) {
        .c-glow, .c-core { animation: none; stroke-dasharray: none; opacity: 0.5; }
      }

      /* Fire & haze: smoke actually moving along the trajectories the case computes.
         Streamlines march downwind, ignitions flare, the receptor breathes. */
      .flow { fill: none; stroke: url(#hz-stream); stroke-width: var(--w); stroke-linecap: round;
        opacity: var(--o); stroke-dasharray: 10 118; animation: hz-march 4.6s linear var(--t) infinite; }
      @keyframes hz-march { from { stroke-dashoffset: 128; } to { stroke-dashoffset: 0; } }
      .flame { transform-box: fill-box; transform-origin: 50% 100%;
        animation: hz-dance var(--d) ease-in-out var(--t) infinite; }
      .fl-body { fill: #FF7A45; opacity: 0.92; }
      .fl-core { fill: #FFD08A; transform-box: fill-box; transform-origin: 50% 100%;
        animation: hz-core var(--d) ease-in-out var(--t) infinite; }
      @keyframes hz-dance {
        0%, 100% { transform: scale(1, 1)       rotate(0deg); }
        22%      { transform: scale(0.9, 1.18)  rotate(-5deg); }
        48%      { transform: scale(1.08, 0.88) rotate(4deg); }
        74%      { transform: scale(0.95, 1.1)  rotate(-2deg); }
      }
      @keyframes hz-core {
        0%, 100% { transform: scaleY(1);    opacity: 0.95; }
        35%      { transform: scaleY(1.28); opacity: 0.7; }
        65%      { transform: scaleY(0.82); opacity: 1; }
      }
      .recv .ring { transform-box: fill-box; transform-origin: center;
        animation: hz-recv 3.6s ease-out infinite; }
      @keyframes hz-recv {
        0%   { transform: scale(0.7); opacity: 0.95; }
        70%  { transform: scale(1.5); opacity: 0; }
        100% { transform: scale(1.5); opacity: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        .flow { animation: none; stroke-dasharray: none; }
        .flame, .fl-core, .recv .ring { animation: none; }
      }

      /* Air quality: suspended particulate drifting downwind. Motion is the point —
         the air is not still — so it animates, but stops for reduced-motion users. */
      .mol { transform-box: fill-box; animation: aq-drift var(--d) linear var(--t) infinite; }
      .mol.m-lo  { fill: #9FD9E4; }
      .mol.m-mid { fill: #E0A63F; }
      .mol.m-hi  { fill: #F26D5B; }
      @keyframes aq-drift {
        0%   { transform: translate(0, 0) scale(0.7); opacity: 0; }
        14%  { opacity: var(--o); }
        82%  { opacity: var(--o); }
        100% { transform: translate(var(--x), var(--y)) scale(1.12); opacity: 0; }
      }
      .aq-line { stroke-dasharray: 420; stroke-dashoffset: 420; animation: aq-draw 2.6s ease-out 0.3s forwards; }
      @keyframes aq-draw { to { stroke-dashoffset: 0; } }
      .aq-now, .aq-then { animation: aq-pulse 3.4s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
      .aq-then { animation-delay: 1.1s; }
      @keyframes aq-pulse { 0%,100% { r: 4.5; opacity: 1; } 50% { r: 6; opacity: 0.72; } }
      @media (prefers-reduced-motion: reduce) {
        .mol { animation: none; opacity: var(--o); }
        .aq-line { animation: none; stroke-dashoffset: 0; }
        .aq-now, .aq-then { animation: none; }
      }
      .roof-grid { display: grid; grid-template-columns: repeat(10, 12px); grid-auto-rows: 12px; gap: 4px;
        align-content: center; justify-content: center; }
      .roof-grid i { width: 12px; height: 12px; background: var(--accent); opacity: 0.35; border-radius: 2px; }
      .roof-grid i:nth-child(3n) { opacity: 0.7; }
      .roof-grid i:nth-child(7n) { opacity: 0.16; }
      .roof-grid i:nth-child(11n) { background: #6FC7D6; opacity: 0.85; }
      .parked-note { margin: 4px 0 0; font-size: 0.8rem; color: var(--ink-muted); font-style: italic; max-width: 60ch; }

      .coming { border: 1px dashed var(--hairline); border-radius: 8px; padding: 24px 28px; display: flex; flex-direction: column; gap: 12px; }
      .coming ul { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: 6px; color: var(--ink-muted); font-size: 0.92rem; }

      .foot { max-width: 46rem; margin: 0 auto; padding: 6vh 24px 12vh; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
      .foot h2 { margin: 0; font-size: 1.6rem; }
      .foot p { margin: 0; color: var(--ink-muted); line-height: 1.65; max-width: 34rem; }
    </style>
  </body>
</html>
