    <script>
      // Homepage taste of Pustaka — real answers from the real API.
      // Host-aware: works on localhost and when served from the dev server IP.
      const API = `http://${location.hostname}:4330/api`; // TODO prod: /knowledge/api
      document.querySelectorAll('a[href^="http://localhost:"]').forEach((a) => {
        a.href = a.href.replace("//localhost:", `//${location.hostname}:`);
      });
      const chips = document.getElementById("try-chips");
      const answerEl = document.getElementById("try-answer");
      const sourcesEl = document.getElementById("try-sources");
      const statusEl = document.getElementById("try-status");
      const input = document.getElementById("try-q");

      const QUESTIONS = [
        "Berapa hari cuti yang boleh dibawa ke tahun depan?",
        "Batas waktu notifikasi kebocoran data pribadi?",
        "What is the per diem for domestic travel?",
      ];
      chips.innerHTML = QUESTIONS.map((q) => `<button type="button">${q}</button>`).join("");
      chips.querySelectorAll("button").forEach((b) =>
        b.addEventListener("click", () => { input.value = b.textContent; tryAsk(); }));

      function renderAnswer(text) {
        const safe = text.replace(/&/g, "&amp;").replace(/</g, "&lt;");
        return safe
          .replace(/\*\*(.+?)\*\*/g, "<b>$1</b>")
          .replace(/\[(\d+)\]/g, '<span class="tcite">$1</span>')
          .replace(/\n+/g, "<br>");
      }

      async function tryAsk() {
        const q = input.value.trim();
        if (!q) return;
        answerEl.hidden = false;
        answerEl.textContent = "Mencari di dokumen…";
        sourcesEl.textContent = "";
        try {
          const res = await fetch(`${API}/ask`, { method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ question: q }) }).then((r) => r.json());
          answerEl.innerHTML = renderAnswer(res.answer || "");
          const cites = (res.citations || []).filter((c) => c.source);
          sourcesEl.innerHTML = cites.slice(0, 3).map((c) =>
            `${c.verified ? "✓ " : ""}${c.source.doc_title}${c.source.pasal ? " · " + c.source.pasal : ""}${c.source.page ? " · hal. " + c.source.page : ""}`
          ).join("<br>");
          statusEl.textContent = `${(res.mode || "").toUpperCase()} · ${res.latency_s}s — FULL EXPERIENCE IN THE DEMO →`;
        } catch {
          answerEl.textContent = "The demo API isn't running — open the full demo instead.";
        }
      }
      document.getElementById("try-form").addEventListener("submit", (e) => {
        e.preventDefault(); tryAsk();
      });

      /* Entrance reveal for the case gallery. The hidden state is applied only once
         this runs, so a JS failure leaves every card visible rather than blank. */
      (() => {
        const cases = [...document.querySelectorAll(".case")];
        if (!cases.length || !("IntersectionObserver" in window)) return;
        const wrap = document.querySelector(".cases");
        if (!wrap) return;
        wrap.classList.add("reveal-on");
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) { cases.forEach((c) => c.classList.add("in")); return; }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
        }, { rootMargin: "0px 0px -12% 0px", threshold: 0.08 });
        cases.forEach((c) => io.observe(c));
        // belt and braces: never leave a card stuck invisible
        setTimeout(() => cases.forEach((c) => c.classList.add("in")), 4000);
      })();
    </script>

