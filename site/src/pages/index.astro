                <rect x="326" y="116" width="4" height="6"/><rect x="336" y="116" width="4" height="6"/>
              </g>
            </g>
            <!-- water: two drifting wave sheets over the lower third -->
            <g class="water">
              <path class="wave w1" fill="#35C6E0" opacity="0.20"
                d="M-400 178 q50 -10 100 0 t100 0 t100 0 t100 0 t100 0 t100 0 t100 0 t100 0 V240 H-400 z"/>
              <path class="wave w2" fill="#1B7FA3" opacity="0.30"
                d="M-400 190 q50 -8 100 0 t100 0 t100 0 t100 0 t100 0 t100 0 t100 0 t100 0 V240 H-400 z"/>
            </g>
            <text x="16" y="228" fill="#35C6E0" opacity="0.85" font-size="12" letter-spacing="1.6" font-family="ui-monospace,monospace">NORTH JAKARTA · −4 CM / YEAR</text>
          </svg>
        </div>
        <div class="case-body">
          <span class="badge">LIVE DEMO</span>
          <h2>Jakarta Is Sinking</h2>
          <p>Sentinel-1 InSAR 2017–2023 fused with elevation, population and
          observed floods: 442,000 people live on ground sinking faster than
          2&nbsp;cm a year — mapped for all 267 kelurahan, with a clock to 2050.</p>
          <span class="meta">INSAR · SENTINEL-1 · 267 KELURAHAN · CLOCK TO 2050</span>
        </div>
      </a>

      <a class="case live" data-case="narrative" href={DEMOS.narrative} target="_blank" rel="noopener">
        <div class="case-visual narrative-visual" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="case-body">
          <span class="badge">LIVE DEMO</span>
          <h2>Indonesia in the Global Narrative</h2>
          <p>Every 15 minutes, the world’s news mentions Indonesia somewhere. GDELT
          watches all of it — 65 languages, a decade back. This case turns that
          firehose into attention, tone, and theme signals a strategy team can read —
          validated against nine dated events, from the 2018 tsunamis to the 2025
          protests.</p>
          <span class="meta">GDELT OPEN FEED · 65 LANGUAGES · 9 ANCHOR EVENTS · 50 GB STREAMED</span>
        </div>
      </a>

