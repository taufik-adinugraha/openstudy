        stroke-width: calc(0.5 + 0.8 * var(--w));
      }
      /* the voice travels inward: a gradient-tapered head, not a solid line */
      .gn-v .v-glow, .gn-v .v-core {
        stroke-dasharray: 128 872;
        animation: gn-travel var(--d) linear infinite;
        animation-delay: var(--t);
      }
      .gn-v .v-glow {
        stroke: #B26DF2; stroke-width: calc(2.2 + 3.4 * var(--w));
        opacity: calc(0.14 + 0.26 * var(--w)); filter: url(#gn-bloom);
      }
      .gn-v .v-core {
        stroke: #E4CBFF; stroke-width: calc(0.6 + 1.05 * var(--w));
        opacity: calc(0.4 + 0.5 * var(--w));
      }
      @keyframes gn-travel {
        from { stroke-dashoffset: 1000; }
        to   { stroke-dashoffset: 0; }
      }

      .gn-origin { filter: url(#gn-bloom); }
      .gn-ring { transform-origin: center; animation: gn-listen 2.6s ease-out infinite; }
      @keyframes gn-listen {
        0%   { r: 4; opacity: 0.85; }
        100% { r: 15; opacity: 0; }
      }

      .gn-wave { animation: gn-scroll 26s linear infinite; opacity: 0.82; }
      @keyframes gn-scroll {
        from { transform: translateX(0); }
        to   { transform: translateX(-397.5px); }
      }

      @media (prefers-reduced-motion: reduce) {
        .gn-v .v-glow, .gn-v .v-core { animation: none; stroke-dasharray: none; opacity: 0.4; }
        .gn-ring, .gn-wave { animation: none; }
      }

      /* Jakarta: 261 real kelurahan shaded by their measured InSAR subsidence on the
         case's own bathymetric ramp. The tide breathes off the bay to the north and
         the fastest-sinking ground pulses — Kamal Muara at −2.4 cm/yr leads. */
      .jk-k { stroke: #0B1626; stroke-width: 0.28; }
      .jk-k.sink { animation: jk-settle 5.2s ease-in-out var(--t) infinite; }
      @keyframes jk-settle { 0%, 100% { opacity: 1; } 50% { opacity: 0.62; } }
      .jk-tide { animation: jk-tide 7.5s ease-in-out infinite; transform-box: fill-box;
        transform-origin: top center; }
      @keyframes jk-tide { 0%, 100% { transform: scaleY(1); opacity: 0.85; }
        50% { transform: scaleY(1.55); opacity: 1; } }
      .jk-hot { fill: #F26D5B; transform-box: fill-box; transform-origin: center;
        animation: jk-hot 3.4s ease-out var(--t) infinite; }
      @keyframes jk-hot { 0% { transform: scale(0.5); opacity: 0.95; }
        70%, 100% { transform: scale(2.6); opacity: 0; } }
      @media (prefers-reduced-motion: reduce) {
        .jk-k.sink, .jk-tide, .jk-hot { animation: none; }
        .jk-hot { opacity: 0.7; }
      }

      /* Rice: each kecamatan cycles through its OWN detected phenology, fortnight by
         fortnight over one crop year. SMIL drives the fill because the sequence is
         per-polygon real data, not a shared keyframe. The ramp closes: a calendar loops. */
      .rc { stroke: #0A1214; stroke-width: 0.25; }
      @media (prefers-reduced-motion: reduce) { .rc animate { display: none; } }

      /* Forest: the real alert record replaying over Indonesia — 520 largest events
         in the order they were first detected, coloured by supply-chain linkage. */
      .fw-land path { fill: #121A14; stroke: #1E2A20; stroke-width: 0.35; }
      .fw-a { opacity: 0; animation: fw-ignite 11s linear var(--t) infinite; }
      @keyframes fw-ignite {
        0%   { opacity: 0; transform: scale(2.6); }
        4%   { opacity: 1; transform: scale(1); }
        88%  { opacity: var(--o); }
        100% { opacity: 0; transform: scale(1); }
      }
      .fw-a { transform-box: fill-box; transform-origin: center; }
      @media (prefers-reduced-motion: reduce) {
        .fw-a { animation: none; opacity: var(--o); }
      }

      /* Air quality: real Jabodetabek kelurahan under the case's own station network.
         Every bloom sits on a MEASURED station mean — nothing is interpolated between
         them, because 2 of 24 sensors still report and the empty space is the finding. */
      .aq-land path { fill: #141A22; stroke: #232C38; stroke-width: 0.3; }
      .aq-bloom { opacity: var(--o); transform-box: fill-box; transform-origin: center;
        animation: aq-breathe 6s ease-in-out var(--t) infinite; }
      @keyframes aq-breathe {
        0%, 100% { opacity: var(--o); transform: scale(0.94); }
        50%      { opacity: calc(var(--o) * 1.5); transform: scale(1.08); }
      }
      .aq-st.live  { animation: aq-lively 2.8s ease-in-out var(--t) infinite; }
      .aq-st.stale { opacity: 0.5; }
      .aq-st.dead  { fill: #4A5464; opacity: 0.5; }
      @keyframes aq-lively { 0%, 100% { opacity: 0.75; } 50% { opacity: 1; } }
      .aq-ping { transform-box: fill-box; transform-origin: center;
        animation: aq-ping 3.4s ease-out var(--t) infinite; }
      @keyframes aq-ping {
        0% { transform: scale(0.5); opacity: 0.9; }
        70%, 100% { transform: scale(3); opacity: 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        .aq-bloom, .aq-st, .aq-ping { animation: none; }
        .aq-ping { opacity: 0.35; }
      }
      .roof-grid { display: grid; grid-template-columns: repeat(10, 12px); grid-auto-rows: 12px; gap: 4px;
        align-content: center; justify-content: center; }
      .roof-grid i { width: 12px; height: 12px; background: var(--accent); opacity: 0.35; border-radius: 2px; }
      .roof-grid i:nth-child(3n) { opacity: 0.7; }
      .roof-grid i:nth-child(7n) { opacity: 0.16; }
      .roof-grid i:nth-child(11n) { background: #6FC7D6; opacity: 0.85; }

      .coming { border: 1px dashed var(--hairline); border-radius: 8px; padding: 24px 28px; display: flex; flex-direction: column; gap: 12px; }
      .coming ul { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: 6px; color: var(--ink-muted); font-size: 0.92rem; }

      .foot { max-width: 46rem; margin: 0 auto; padding: 6vh 24px 12vh; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
      .foot h2 { margin: 0; font-size: 1.6rem; }
      .foot p { margin: 0; color: var(--ink-muted); line-height: 1.65; max-width: 34rem; }
    </style>
  </body>
</html>
