---
// Landing page — lab chrome (graphite + spectral cyan). Case tiles carry
// their own data-case identity; the chrome stays neutral (plan §3).
// TODO D8: replace "Demo Lab" with the final brand; CTA wording pending.
import "../styles/tokens.css";

const DEMOS = {
  nightlights: "http://localhost:4322/nightlights", // TODO prod: /nightlights
  knowledge: "http://localhost:4324/knowledge",     // TODO prod: /knowledge
  trade: "http://localhost:4325/trade",             // TODO prod: /trade
  jakarta: "http://localhost:4327/jakarta",         // TODO prod: /jakarta
  narrative: "http://localhost:4326/narrative",     // TODO prod: /narrative
  transit: "http://localhost:4329/transit",         // TODO prod: /transit
  forest: "http://localhost:4331/forest",           // TODO prod: /forest
  poverty: "http://localhost:4332/poverty",         // TODO prod: /poverty
  airquality: "http://localhost:4328/airquality",   // TODO prod: /airquality
