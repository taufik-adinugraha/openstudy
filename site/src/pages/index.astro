              <rect x="188" y="196" width="40" height="44" rx="2"/>
              <rect x="196" y="182" width="24" height="16" rx="3"/>
              <rect x="203" y="92"  width="10" height="92"/>
              <path d="M208 74 c7 6 8 14 0 20 c-8 -6 -7 -14 0 -20 z" fill="#E8A33D" opacity="0.9"/>
              <rect x="244" y="110" width="28" height="130"/>
              <rect x="278" y="140" width="36" height="100"/>
              <rect x="320" y="88"  width="26" height="152"/>
              <rect x="352" y="126" width="34" height="114"/>
              <!-- windows -->
              <g fill="#35C6E0" opacity="0.28">
                <rect x="60" y="106" width="4" height="6"/><rect x="70" y="106" width="4" height="6"/>
                <rect x="60" y="120" width="4" height="6"/><rect x="70" y="120" width="4" height="6"/>
