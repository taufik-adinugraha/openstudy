# secrets
.env
.env.*
!.env.example

# data planes (R2-synced, never in git)
cases/*/data/*
!cases/*/data/.gitkeep
!cases/*/data/crosswalk/
cases/*/web/public/frames/
*.duckdb
*.duckdb.wal
*.parquet
*.pmtiles
*.tif

# python
__pycache__/
.venv/
*.egg-info/
.ruff_cache/

# node
node_modules/
dist/
.astro/

# os
.DS_Store

# third-party tool checkouts (LiCSBAS etc.)
cases/*/tools/

# agent worktrees (managed by the harness)
.claude/worktrees/

# operational state — runtime, not source. ALIASES and RETIRED_BASES are the
# exception: ops/serve-static reads them to generate the nginx config, so they are
# inputs to a build rather than state a run produced, and a clone that lacks them
# cannot reproduce the redirects. Negation needs the glob — git will not descend
# into a directory excluded by name.
ops/state/*
!ops/state/ALIASES
!ops/state/RETIRED_BASES
ops/backups/

# rebuilt at startup from corpus/, and it accumulates a spend ledger and
# upload records that have no business in version control
platform/knowledge/api/knowledge.db

# FMV product material — a separate private repo, never in the public one
docs/spec-pustaka.html
docs/build-plan.html
