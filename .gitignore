# secrets
.env
.env.*
!.env.example

# data planes (R2-synced, never in git)
cases/*/data/*
!cases/*/data/.gitkeep
!cases/*/data/crosswalk/
cases/*/web/public/frames/
*.duckdb
*.duckdb.wal
*.parquet
*.pmtiles
*.tif

# python
__pycache__/
.venv/
*.egg-info/
.ruff_cache/

# node
node_modules/
dist/
.astro/

# os
.DS_Store

# third-party tool checkouts (LiCSBAS etc.)
cases/*/tools/

# agent worktrees (managed by the harness)
.claude/worktrees/

# operational state — runtime, not source
ops/state/
ops/backups/

# rebuilt at startup from corpus/, and it accumulates a spend ledger and
# upload records that have no business in version control
platform/knowledge/api/knowledge.db

# FMV product material — a separate private repo, never in the public one
docs/spec-pustaka.html
docs/build-plan.html

# The knowledge assistant is a separate commercial product with its own private
# repository. It was removed from this repository's entire history with
# git-filter-repo, and this line is what stops a bulk copy putting it back.
/platform/
