# Copy to .env and fill in. Never commit .env.

# NASA Earthdata — PRIMARY lights source (D12): Black Marble VNP46A3 + VJ146A3
# via LAADS archive set 5200. Token expires ~60 days; regenerate at
# urs.earthdata.nasa.gov and re-set the GitHub secret when it does.
EARTHDATA_TOKEN=

# LAADS App Key — REQUIRED for file downloads (EDL token alone gets bounced).
# ladsweb.modaps.eosdis.nasa.gov → log in → Profile → App Keys → generate.
# Also accept the Black Marble license once by downloading any file in-browser.
LAADS_APP_KEY=

# EOG (OPTIONAL — manual annual cross-check only; EOG made programmatic access
# paid on 2026-06-01, decision D12). Leave blank unless doing the yearly download.
EOG_USERNAME=
EOG_PASSWORD=

# BPS Statistics Indonesia WebAPI — https://webapi.bps.go.id/developer/
BPS_API_KEY=

# UN Comtrade free tier (500 calls/day) — latest-year pulse only, never bulk
COMTRADE_API_KEY=

# Cloudflare R2 (S3-compatible) — raw + derived data planes
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=demo-lab-data

# Insight briefs and grounded answers (either key enables grounded answers;
# ANSWER_PROVIDER=claude|gemini forces one, otherwise Claude is preferred)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# ANSWER_PROVIDER=claude

# Google Cloud project for BigQuery public datasets (GDELT, phase 2).
# Discipline: only *_partitioned tables, always date filters.
GOOGLE_CLOUD_PROJECT=
