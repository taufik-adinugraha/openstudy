      const EMBED_API = `http://${location.hostname}:4330/api/embed`; // TODO prod: /knowledge/api/embed
      const [searchText, vectors] = await Promise.all([
        load("search_text.json").catch(() => null), load("product_vectors.json").catch(() => null)]);
      const tokenize = (s) => s.toLowerCase().normalize("NFKD").replace(/[^\p{L}\p{N}\s]/gu, " ").split(/\s+/).filter((t) => t.length > 1);
      const lex = space.nodes.map((nd) => {
        const text = ((searchText?.[nd.id] ?? label(nd.id)) + " " + label(nd.id)).toLowerCase();
        return { id: nd.id, text, tokens: new Set(tokenize(text)) };
      });
      const editDistance1 = (a, b) => { // Damerau-lite: one edit or one transposition
        if (Math.abs(a.length - b.length) > 1) return false;
        let i = 0, j = 0, edits = 0;
        while (i < a.length && j < b.length) {
          if (a[i] === b[j]) { i++; j++; continue; }
          if (++edits > 1) return false;
          if (a.length > b.length) i++; else if (b.length > a.length) j++;
          else if (a[i + 1] === b[j] && a[i] === b[j + 1]) { i += 2; j += 2; } else { i++; j++; }
        }
        return edits + (a.length - i) + (b.length - j) <= 1;
      };
      // Bahasa ↔ English trade glossary: deterministic hits for the common terms,
      // independent of embedding quality. Expand each query token with its synonyms.
      const GLOSSARY = {
        sawit: ["palm"], "kelapa sawit": ["palm"], minyak: ["oil", "oils"], mobil: ["motor", "vehicles", "cars"],
        kendaraan: ["vehicles"], kopi: ["coffee"], nikel: ["nickel"], bijih: ["ores", "ore"], batubara: ["coal"],
        batu: ["stone"], karet: ["rubber"], kayu: ["wood"], kertas: ["paper"], pakaian: ["apparel", "garments", "clothing"],
        baju: ["apparel", "garments"], sepatu: ["footwear", "shoes"], tekstil: ["textile", "textiles"], ikan: ["fish"],
        udang: ["shrimps", "prawns"], tembaga: ["copper"], emas: ["gold"], timah: ["tin"], baja: ["steel"], besi: ["iron"],
        pupuk: ["fertilisers", "fertilizers"], gas: ["gas"], alam: ["natural"], kakao: ["cocoa"], coklat: ["chocolate", "cocoa"],
        teh: ["tea"], gula: ["sugar"], beras: ["rice"], padi: ["rice"], jagung: ["maize", "corn"], kedelai: ["soya"],
        obat: ["medicaments", "pharmaceutical"], mesin: ["machinery", "machines"], listrik: ["electric", "electrical"],
        elektronik: ["electronic"], komputer: ["computers", "data processing"], ponsel: ["telephones"], kapal: ["ships", "vessels"],
        pesawat: ["aircraft"], semen: ["cement"], plastik: ["plastics"], kaca: ["glass"], kulit: ["leather", "hides"],
        perhiasan: ["jewellery"], furnitur: ["furniture"], mebel: ["furniture"], rokok: ["cigarettes", "tobacco"], tembakau: ["tobacco"],
        aluminium: ["aluminium"], alumunium: ["aluminium"], kimia: ["chemical", "chemicals"], cat: ["paints"], ban: ["tyres"],
      };
      const expand = (tokens) => tokens.flatMap((t) => [t, ...(GLOSSARY[t] ?? [])]);
      function lexicalMatch(q) {
