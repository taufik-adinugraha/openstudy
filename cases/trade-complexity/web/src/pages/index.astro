---
// Flagship B — page anatomy per spec §B5: constellation hero → 4 chapters →
// explore → methodology. Identity: smelter metal (spec §B6).
// Product space renders in 3-D (Three.js); the third axis can be the force
// layout's depth or the product's complexity (PCI) — "altitude".
import "../styles/tokens.css";
const summary = (await import("../data/summary.json").catch(() => null))?.default ?? {
  latestYear: 2024, totalExports: 0, idnRank: {}, nCountries: 0, peers: [] };
const latest = summary.latestYear;
const rankNow = summary.idnRank?.[String(latest)] ?? "—";
const rankThen = summary.idnRank?.[String(latest - 10)] ?? "—";
const exportsB = summary.totalExports ? Math.round(summary.totalExports / 1e6) : null;
// Partner/import extension (chapters 07–10). Absent until `make partners` has
// run, so every read is guarded and the chapters render a pending state.
const pm = (await import("../data/partner_summary.json").catch(() => null))?.default ?? null;
const bn = (v) => (v == null ? "—" : `US$${(v / 1e6).toFixed(1)}B`);   // kUSD → US$B
const pct = (v) => (v == null ? "—" : `${(v * 100).toFixed(1)}%`);
const chinaNow = pm?.chinaShare?.[String(pm.latest)] ?? null;
const chinaThen = pm?.chinaShare?.["1995"] ?? null;
const topImp1 = pm?.topImp?.[0] ?? null;
const nickelVerdict = pm?.nickel?.verdict ?? null;
const conc = pm?.concentration ?? null;
const biggestFirst = conc?.biggestFirst ?? null;
const chinaImpNow = pm?.chinaImpShare?.[String(pm.latest)] ?? null;
const bigInput = pm?.nickel?.biggestInput ?? null;
const growthPct = (v) => (v == null ? "—" : `${v >= 0 ? "+" : ""}${Math.round(v * 100)}%`);
const timesX = (v) => (v == null ? "—" : `${(v + 1).toFixed(0)}×`);
// Review layer (pipeline/review.py -> pipeline/article.py). Chapters 04, 08 and 10
// were corrected against it; every number below is read from it, never typed.
const rv = (await import("../data/article.json").catch(() => null))?.default ?? null;
const peerLadder = rv?.peerLadder ?? [];
const peerNamed = peerLadder.filter((p) => ["VNM", "PHL", "IND"].includes(p.iso3));
const peerPhrase = peerNamed.length
  ? peerNamed.map((p) => `${{ VNM: "Vietnam", PHL: "the Philippines", IND: "India" }[p.iso3]} ` +
      `${p.gain >= 0 ? "+" : ""}${p.gain}`).join(", ")
  : "—";
const nk = rv?.nickel ?? null;
const cImp = rv?.conc?.imp ?? null;
const cExp = rv?.conc?.exp ?? null;
const at = rv?.atlas ?? null;
const gb1 = rv?.gateB1 ?? null;
const dens = rv?.density ?? null;
const x1 = (v) => (v == null ? "—" : `${v.toFixed(1)}×`);
