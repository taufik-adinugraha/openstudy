      .chapter.wide { max-width: 58rem; }
      .race-hud { display: grid; grid-template-columns: auto 1fr auto; gap: 24px; align-items: center; padding: 18px 22px; border: 1px solid var(--hairline); border-radius: 10px; background: linear-gradient(135deg, var(--surface), var(--ground)); }
