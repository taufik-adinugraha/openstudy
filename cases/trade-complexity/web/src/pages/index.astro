      .gchip { font-family: var(--font-data); font-size: 12px; letter-spacing: 0.08em; padding: 2px 7px; border-radius: 3px; flex: none; margin-top: 1px; }
      .gchip.pass { background: color-mix(in srgb, #58A89B 22%, transparent); color: #7FCBBE; }
