          return { id, sim: dot * k };
        }).sort((a, b) => b.sim - a.sim);
        const top = sims[0].sim;
        return { hits: sims.slice(0, 40).filter((s) => s.sim >= top - 0.05).map((s) => ({ id: s.id, score: s.sim, how: "semantic" })) };
      }
      const resultsEl = document.getElementById("ps-results"), statusEl = document.getElementById("search-status");
      let searchSeq = 0;
      async function runSearch(q) {
        q = q.trim();
        if (!q) { explore.setFilter(null); resultsEl.hidden = true; statusEl.textContent = ""; return; }
        const seq = ++searchSeq;
