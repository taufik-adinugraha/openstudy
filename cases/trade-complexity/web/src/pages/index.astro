        [[2014, "first ore ban", 0], [2020, "full ban", 32]].forEach(([yr, txt, dy]) => {
          svg.append("line").attr("x1", x(yr)).attr("x2", x(yr)).attr("y1", M.t).attr("y2", H - M.b).attr("stroke", "#3A4452").attr("stroke-dasharray", "3 4");
          svg.append("text").attr("x", x(yr) - 5).attr("y", M.t + 10 + dy)
            .attr("text-anchor", "end").attr("class", "annot").text(`${yr} · ${txt}`);
        });
        const line = d3.line().x((d) => x(d.yr)).y((d) => y(d.v)).curve(d3.curveMonotoneX);
        svg.append("path").datum(ore).attr("d", line).attr("fill", "none").attr("stroke", SILVER).attr("stroke-width", 1.8);
        svg.append("path").datum(proc).attr("d", line).attr("fill", "none").attr("stroke", COPPER).attr("stroke-width", 2.2).style("filter", "url(#copper-glow-soft)");
        const labels = spread([
          { y: y(ore.at(-1).v), text: "ore (HS 2604)", fill: SILVER },
          { y: y(proc.at(-1).v), text: "processed nickel & stainless", fill: COPPER }], 14, M.t + 8, H - M.b - 4);
        svg.selectAll("text.end").data(labels).join("text").attr("class", "annot end")
          .attr("x", W - M.r).attr("y", (d) => d.y - 6).attr("text-anchor", "end").attr("fill", (d) => d.fill).text((d) => d.text);
        // hover: crosshair + dots + tooltip
        const guide = svg.append("line").attr("y1", M.t).attr("y2", H - M.b).attr("stroke", "#E6E8EC").attr("stroke-opacity", 0.45).style("display", "none");
        const dots = svg.selectAll("circle.h").data([ore, proc]).join("circle").attr("class", "h").attr("r", 4)
          .attr("fill", (d, i) => (i ? COPPER : SILVER)).attr("stroke", INK).style("display", "none");
        svg.append("rect").attr("x", M.l).attr("y", M.t).attr("width", W - M.l - M.r).attr("height", H - M.t - M.b).attr("fill", "transparent")
          .on("mousemove", (e) => {
            const yr = Math.round(x.invert(d3.pointer(e)[0])); const i = years.indexOf(yr); if (i < 0) return;
            guide.style("display", null).attr("x1", x(yr)).attr("x2", x(yr));
            dots.style("display", null).attr("cx", x(yr)).attr("cy", (d) => y(d[i].v));
            showTip(e, `<b>${yr}</b><br><span style="color:${COPPER}">●</span> processed ${fmt$(proc[i].v)}<br><span style="color:${SILVER}">●</span> ore ${fmt$(ore[i].v)}`);
          })
          .on("mouseleave", () => { guide.style("display", "none"); dots.style("display", "none"); hideTip(); });
      });

      /* ---------- chapter 3: trajectory ---------- */
      sect("trajectory chart", () => {
        const el = document.getElementById("trajectory");
        const W = el.clientWidth, H = 300, M = { t: 16, r: 60, b: 30, l: 44 };
        const years = Object.keys(traj.ranks.IDN).map(Number).sort();
        const maxRank = d3.max(Object.values(traj.ranks).flatMap((r) => Object.values(r)));
        const x = d3.scaleLinear(d3.extent(years), [M.l, W - M.r]);
        const y = d3.scaleLinear([1, maxRank], [M.t, H - M.b]);
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H);
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`).call(d3.axisLeft(y).ticks(5).tickFormat((v) => "#" + v));
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - M.b})`).call(d3.axisBottom(x).tickFormat(d3.format("d")));
        const line = d3.line().defined((d) => d.r != null).x((d) => x(d.yr)).y((d) => y(d.r)).curve(d3.curveMonotoneX);
        const series = Object.entries(traj.ranks).map(([iso, ranks]) => ({
          iso, isIdn: iso === "IDN", pts: years.map((yr) => ({ yr, r: ranks[String(yr)] ?? null })) }));
        const paths = svg.selectAll("path.s").data(series).join("path").attr("class", "s")
          .attr("d", (s) => line(s.pts)).attr("fill", "none")
          .attr("stroke", (s) => (s.isIdn ? COPPER : VERDIGRIS)).attr("stroke-width", (s) => (s.isIdn ? 2.6 : 1.2))
          .attr("opacity", (s) => (s.isIdn ? 1 : 0.7)).style("filter", (s) => (s.isIdn ? "url(#copper-glow-soft)" : null));
        const labels = spread(series.map((s) => {
          const last = s.pts.filter((d) => d.r != null).at(-1);
          return { y: y(last.r), text: `${s.iso} #${last.r}`, fill: s.isIdn ? COPPER : VERDIGRIS, iso: s.iso, x: x(last.yr) };
        }), 13, M.t + 4, H - M.b - 2);
        svg.selectAll("text.end").data(labels).join("text").attr("class", "annot end")
          .attr("x", (d) => d.x + 8).attr("y", (d) => d.y + 4).attr("fill", (d) => d.fill).text((d) => d.text);
        // hover: crosshair + per-series dots + ranked tooltip; hovering a label highlights its line
        const guide = svg.append("line").attr("y1", M.t).attr("y2", H - M.b).attr("stroke", "#E6E8EC").attr("stroke-opacity", 0.45).style("display", "none");
        const dots = svg.selectAll("circle.h").data(series).join("circle").attr("class", "h").attr("r", 3.5)
          .attr("fill", (s) => (s.isIdn ? COPPER : VERDIGRIS)).attr("stroke", INK).style("display", "none");
        svg.append("rect").attr("x", M.l).attr("y", M.t).attr("width", W - M.l - M.r).attr("height", H - M.t - M.b).attr("fill", "transparent")
          .on("mousemove", (e) => {
            const yr = Math.round(x.invert(d3.pointer(e)[0])); const i = years.indexOf(yr); if (i < 0) return;
            guide.style("display", null).attr("x1", x(yr)).attr("x2", x(yr));
            dots.style("display", (s) => (s.pts[i].r == null ? "none" : null)).attr("cx", x(yr)).attr("cy", (s) => y(s.pts[i].r ?? 1));
            const rows = series.filter((s) => s.pts[i].r != null).sort((a, b) => a.pts[i].r - b.pts[i].r)
              .map((s) => `<span style="color:${s.isIdn ? COPPER : VERDIGRIS}">${s.isIdn ? "<b>" : ""}${s.iso} #${s.pts[i].r}${s.isIdn ? "</b>" : ""}</span>`);
            showTip(e, `<b>${yr}</b> · ECI rank<br>${rows.join("<br>")}`);
          })
          .on("mouseleave", () => { guide.style("display", "none"); dots.style("display", "none"); hideTip(); });
        svg.selectAll("text.end").style("cursor", "default")
          .on("mouseenter", (e, d) => paths.attr("opacity", (s) => (s.iso === d.iso ? 1 : 0.15)).attr("stroke-width", (s) => (s.iso === d.iso ? 2.6 : 1.2)))
          .on("mouseleave", () => paths.attr("opacity", (s) => (s.isIdn ? 1 : 0.7)).attr("stroke-width", (s) => (s.isIdn ? 2.6 : 1.2)));
      });

      /* ---------- chapter 4: adjacency ---------- */
      sect("adjacency chart", () => {
        const el = document.getElementById("adjacency");
        const W = el.clientWidth, H = 320, M = { t: 16, r: 20, b: 34, l: 50 };
        const x = d3.scaleLinear(d3.extent(adjacency, (d) => d.density), [M.l, W - M.r]).nice();
        const y = d3.scaleLinear(d3.extent(adjacency, (d) => d.pci), [H - M.b, M.t]).nice();
        const r = d3.scaleSqrt(d3.extent(adjacency, (d) => d.world), [2, 14]);
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H);
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`).call(d3.axisLeft(y).ticks(5));
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - M.b})`).call(d3.axisBottom(x).ticks(6));
        svg.append("text").attr("x", W - M.r).attr("y", H - 6).attr("text-anchor", "end").attr("class", "annot").text("density → closer to Indonesia’s current strengths");
        svg.append("text").attr("x", M.l + 4).attr("y", M.t + 10).attr("class", "annot").text("↑ PCI (product sophistication)");
        const q80 = d3.quantile(adjacency.map((a) => a.density).sort(d3.ascending), 0.8);
        const frontier = (d) => d.density > q80 && d.pci > 0;
        svg.selectAll("circle").data(adjacency).join("circle")
          .attr("cx", (d) => x(d.density)).attr("cy", (d) => y(d.pci)).attr("r", (d) => r(d.world))
          .attr("fill", (d) => (frontier(d) ? `url(#${gradId(COPPER)})` : `url(#${gradId(SILVER)})`))
          .style("filter", (d) => (frontier(d) ? "url(#copper-glow-soft)" : null))
          .attr("opacity", 0.55).attr("stroke", INK).attr("stroke-width", 0.5)
          .on("mousemove", function (e, d) {
            d3.select(this).attr("opacity", 1).attr("stroke", "#E6E8EC");
            showTip(e, `<b>${label(d.hs4)}</b><br>HS ${d.hs4}<br>density ${d.density.toFixed(2)} · PCI ${d.pci.toFixed(2)}<br>world trade ${fmt$(d.world * 1e3)}`);
          })
          .on("mouseleave", function () { d3.select(this).attr("opacity", 0.55).attr("stroke", INK); hideTip(); });
      });

      /* ================= partners & imports — chapters 07–10 =================
         Loaded SEPARATELY from the export corpus above: if the partner build
         has not run, these chapters show a designed pending state instead of
         taking the six export chapters down with them. Every visual here is
         plain SVG — no WebGL path to regress. */
      let partners = null, balance = null, imports = null, ninputs = null, pgates = null;
      try {
        [partners, balance, imports, ninputs, pgates] = await Promise.all(
          ["partners.json", "balance.json", "imports.json",
           "nickel_inputs.json", "gates_partners.json"].map(load));
      } catch (missing) {
        console.warn("partner data not built yet:", missing);
        for (const host of document.querySelectorAll(
          ".needs-partners .chart, .needs-partners .gate-card, .needs-partners .spark-grid")) {
          host.innerHTML = `<div class="pending-note">
            <b>Partner &amp; import data pending</b>
            <span>This half of the network is built by <code>make partners</code>, which
            re-streams the 2.4 GB BACI archive year by year. The export chapters above are
            unaffected.</span></div>`;
        }
        for (const s of document.querySelectorAll(".needs-partners .scrub")) s.hidden = true;
      }

      const k$ = (v) => fmt$((v ?? 0) * 1e3);              // BACI values are kUSD
      const pctFmt = d3.format(".1%");
      /* one palette for partner identity, reused across all four chapters so a
         country keeps its colour from chapter to chapter. China is copper — it
         is the subject of the argument, not just another band. */
      const PARTNER_PAL = ["#5D8FBF", "#58A89B", "#A48E5A", "#9A6F86", "#7D6F9C",
        "#7E9A6C", "#6F97A6", "#B0A46B", "#8C7A6B", "#6C8FA1", "#8F7D9A", "#7C8A61"];
      const pColor = (() => {
        const m = new Map(); let k = 0;
        return (code) => {
          const s = String(code);
          if (s === "156") return COPPER;                  // China
          if (s === "other") return "#39414E";
          if (!m.has(s)) { m.set(s, PARTNER_PAL[k % PARTNER_PAL.length]); k++; }
          return m.get(s);
        };
      })();
      const shortName = (n) => (n ?? "")
        .replace(/\s*\(.*?\)\s*/g, "").replace("Republic of ", "")
        .replace("United States of America", "USA").replace("United States", "USA")
        .replace("Republic of Korea", "South Korea").replace("Korea, Rep.", "South Korea")
        .replace("Viet Nam", "Vietnam").replace("Russian Federation", "Russia")
        .replace("United Kingdom", "UK").replace("Other Asia, nes", "Taiwan (n.e.s.)")
        .replace("China, Hong Kong SAR", "Hong Kong").replace("China, Macao SAR", "Macao")
        .replace("United Arab Emirates", "UAE").trim();

      /* ---------- chapter 07: partner mix + concentration strip ---------- */
      sect("partner mix", () => {
        if (!partners) return;
        const el = document.getElementById("partner-mix");
        const W = el.clientWidth, narrow = W < 620;
        const M = { t: 12, r: narrow ? 14 : 124, b: 26, l: narrow ? 38 : 46 };
        const HA = narrow ? 250 : 320, GAP = 34, HB = 104;
        const H = M.t + HA + GAP + HB + M.b;
        const yrs = partners.years;
        const totals = partners.totalExp;
        // bands ordered by latest share, largest at the base of the stack
        const feat = partners.partners.slice().sort((a, b) =>
          (partners.exp[b.code]?.at(-1) ?? 0) - (partners.exp[a.code]?.at(-1) ?? 0));
        const keys = feat.map((p) => String(p.code)).concat(["other"]);
        const nameOf = new Map(feat.map((p) => [String(p.code), shortName(p.name)]));
        nameOf.set("other", "all other partners");
        const rows = yrs.map((y, i) => {
          const o = { year: y }; let acc = 0;
          for (const p of feat) {
            const s = (partners.exp[p.code]?.[i] ?? 0) / (totals[i] || 1);
            o[String(p.code)] = s; acc += s;
          }
          o.other = Math.max(0, 1 - acc);
          return o;
        });
        keys.forEach((k) => mkGrad(pColor(k)));
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H)
          .attr("viewBox", `0 0 ${W} ${H}`);
        const x = d3.scaleLinear(d3.extent(yrs), [M.l, W - M.r]);
        const yA = d3.scaleLinear([0, 1], [M.t + HA, M.t]);
        const area = d3.area().x((d) => x(d.data.year)).y0((d) => yA(d[0])).y1((d) => yA(d[1]))
          .curve(d3.curveMonotoneX);
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`)
          .call(d3.axisLeft(yA).ticks(5).tickFormat(d3.format(".0%")));
        svg.selectAll("path.band").data(d3.stack().keys(keys)(rows)).join("path")
          .attr("class", "band").attr("d", area)
          .attr("fill", (s) => `url(#${gradId(pColor(s.key))})`)
          .attr("stroke", INK).attr("stroke-width", 0.5)
          .style("filter", (s) => (s.key === "156" ? "url(#copper-glow-soft)" : null));
        // sheen over the whole stack: depth without muddying the bands
        svg.append("rect").attr("x", M.l).attr("y", M.t).attr("width", W - M.l - M.r)
          .attr("height", HA).attr("fill", "url(#sheen)").style("pointer-events", "none");
        if (!narrow) {
          const last = d3.stack().keys(keys)(rows).map((s) => ({
            key: s.key, y: yA((s.at(-1)[0] + s.at(-1)[1]) / 2),
            h: s.at(-1)[1] - s.at(-1)[0] })).filter((d) => d.h > 0.045);
          svg.selectAll("text.pend").data(spread(last, 13, M.t + 6, M.t + HA - 2))
            .join("text").attr("class", "annot pend").attr("x", W - M.r + 7)
            .attr("y", (d) => d.y + 4).attr("fill", (d) => pColor(d.key))
            .text((d) => (d.key === "other" ? "all others" : nameOf.get(d.key)));
        }
        // ---- concentration strip, sharing the x scale ----
        const yTop = M.t + HA + GAP;
        // The whole point of this strip is the U — a zero-based axis would flatten
        // a 48%->58% swing into a straight line. Both scales are framed on their
        // own range, and the axis ticks say so.
        const t5e = d3.extent(partners.top5Exp), hhe = d3.extent(partners.hhiExp);
        const yB = d3.scaleLinear(
          [t5e[0] - (t5e[1] - t5e[0]) * 0.35, t5e[1] + (t5e[1] - t5e[0]) * 0.22],
          [yTop + HB, yTop]);
        const yH = d3.scaleLinear(
          [hhe[0] - (hhe[1] - hhe[0]) * 0.25, hhe[1] + (hhe[1] - hhe[0]) * 0.30],
          [yTop + HB, yTop]);
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`)
          .call(d3.axisLeft(yB).ticks(3).tickFormat(d3.format(".0%")));
        if (!narrow) svg.append("g").attr("class", "axis axis-alt")
          .attr("transform", `translate(${W - M.r},0)`)
          .call(d3.axisRight(yH).ticks(3).tickFormat(d3.format("d")));
        svg.append("path").datum(yrs.map((y, i) => ({ y, v: partners.hhiExp[i] })))
          .attr("fill", SILVER).attr("opacity", 0.14)
          .attr("d", d3.area().x((d) => x(d.y)).y0(yTop + HB).y1((d) => yH(d.v))
            .curve(d3.curveMonotoneX));
        svg.append("path").datum(yrs.map((y, i) => ({ y, v: partners.top5Exp[i] })))
          .attr("fill", "none").attr("stroke", COPPER).attr("stroke-width", 2.2)
          .style("filter", "url(#copper-glow-soft)")
          .attr("d", d3.line().x((d) => x(d.y)).y((d) => yB(d.v)).curve(d3.curveMonotoneX));
        svg.append("text").attr("class", "annot").attr("x", M.l + 4).attr("y", yTop + 12)
          .attr("fill", COPPER).text("top-5 buyers’ share");
        if (!narrow) svg.append("text").attr("class", "annot").attr("x", W - M.r - 4)
          .attr("y", yTop + 12).attr("text-anchor", "end").attr("fill", SILVER)
          .text("HHI (right)");
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${yTop + HB})`)
          .call(d3.axisBottom(x).ticks(narrow ? 4 : 8).tickFormat(d3.format("d")));
        // ---- hover: one guide across both panels ----
        const guide = svg.append("line").attr("y1", M.t).attr("y2", yTop + HB)
          .attr("stroke", "#E6E8EC").attr("stroke-opacity", 0.45).style("display", "none");
        const dot = svg.append("circle").attr("r", 4).attr("fill", COPPER)
          .attr("stroke", INK).style("display", "none");
        svg.append("rect").attr("x", M.l).attr("y", M.t).attr("width", W - M.l - M.r)
          .attr("height", yTop + HB - M.t).attr("fill", "transparent")
          .on("mousemove", (e) => {
            const yr = Math.round(x.invert(d3.pointer(e)[0])), i = yrs.indexOf(yr);
            if (i < 0) return;
            guide.style("display", null).attr("x1", x(yr)).attr("x2", x(yr));
            dot.style("display", null).attr("cx", x(yr)).attr("cy", yB(partners.top5Exp[i]));
            const top = feat.map((p) => ({ n: shortName(p.name), s: rows[i][String(p.code)] }))
              .sort((a, b) => b.s - a.s).slice(0, 6).filter((d) => d.s > 0.001);
            showTip(e, `<b>${yr}</b> · exports ${k$(totals[i])}<br>` +
              top.map((d) => `${d.n} ${pctFmt(d.s)}`).join("<br>") +
              `<br><span style="color:${COPPER}">top-5 ${pctFmt(partners.top5Exp[i])}</span>` +
              ` · HHI ${Math.round(partners.hhiExp[i])}` +
              `<br><span class="dim">${partners.nPartnersExp[i]} partners</span>`);
          })
          .on("mouseleave", () => {
            guide.style("display", "none"); dot.style("display", "none"); hideTip(); });
        // legend — the only way to read the bands at 390px
        const leg = d3.select(el).append("div").attr("class", "legend-row");
        leg.selectAll("span")
          .data(keys.filter((k) => k !== "other").slice(0, narrow ? 8 : 12).concat("other"))
          .join("span").attr("class", "lg")
          .html((k) => `<i style="background:${pColor(k)}"></i>${nameOf.get(k)}`);
      });

      /* ---------- chapter 08: the import bill + who supplies it ---------- */
      sect("import mix", () => {
        if (!imports) return;
        const el = document.getElementById("import-mix");
        const W = el.clientWidth, narrow = W < 620;
        const M = { t: 14, r: narrow ? 14 : 128, b: 28, l: narrow ? 46 : 58 };
        const H = M.t + (narrow ? 240 : 300) + M.b;
        const yrs = imports.years, order = imports.groups.order, ser = imports.groups.series;
        order.forEach((g) => mkGrad(imports.groups.colors[g]));
        const rows = yrs.map((y) => {
          const o = { year: y };
          for (const g of order) o[g] = (ser[String(y)]?.[g] ?? 0);
          return o;
        });
        const x = d3.scaleLinear(d3.extent(yrs), [M.l, W - M.r]);
        const y = d3.scaleLinear(
          [0, d3.max(rows, (r) => d3.sum(order, (g) => r[g])) * 1.06], [H - M.b, M.t]);
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H);
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`)
          .call(d3.axisLeft(y).ticks(5).tickFormat((v) => k$(v)));
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - M.b})`)
          .call(d3.axisBottom(x).ticks(narrow ? 4 : 8).tickFormat(d3.format("d")));
        const stacked = d3.stack().keys(order)(rows);
        svg.selectAll("path.band").data(stacked).join("path").attr("class", "band")
          .attr("d", d3.area().x((d) => x(d.data.year)).y0((d) => y(d[0]))
            .y1((d) => y(d[1])).curve(d3.curveMonotoneX))
          .attr("fill", (s) => `url(#${gradId(imports.groups.colors[s.key])})`)
          .attr("stroke", INK).attr("stroke-width", 0.5);
        svg.append("rect").attr("x", M.l).attr("y", M.t).attr("width", W - M.l - M.r)
          .attr("height", H - M.t - M.b).attr("fill", "url(#sheen)")
          .style("pointer-events", "none");
        if (!narrow) {
          const ends = stacked.map((s) => ({
            key: s.key, y: y((s.at(-1)[0] + s.at(-1)[1]) / 2),
            h: s.at(-1)[1] - s.at(-1)[0] })).filter((d) => d.h > 0);
          // the full group names do not fit the gutter; the legend and tooltip
          // carry them in full, so the end label gets the short form
          const shortGroup = (k) => k.replace(" & machinery", "").replace(" & plastics", "")
            .replace(" & agriculture", " & agri").replace(" & minerals", "");
          svg.selectAll("text.iend").data(spread(ends, 14, M.t + 6, H - M.b - 2))
            .join("text").attr("class", "annot iend").attr("x", W - M.r + 6)
            .attr("y", (d) => d.y + 4).attr("fill", (d) => imports.groups.colors[d.key])
            .text((d) => shortGroup(d.key));
        }
        const guide = svg.append("line").attr("y1", M.t).attr("y2", H - M.b)
          .attr("stroke", "#E6E8EC").attr("stroke-opacity", 0.45).style("display", "none");
        svg.append("rect").attr("x", M.l).attr("y", M.t).attr("width", W - M.l - M.r)
          .attr("height", H - M.t - M.b).attr("fill", "transparent")
          .on("mousemove", (e) => {
            const yr = Math.round(x.invert(d3.pointer(e)[0])), i = yrs.indexOf(yr);
            if (i < 0) return;
            guide.style("display", null).attr("x1", x(yr)).attr("x2", x(yr));
            const tot = d3.sum(order, (g) => rows[i][g]);
            showTip(e, `<b>${yr}</b> · imports ${k$(tot)}<br>` + order
              .map((g) => `<span style="color:${imports.groups.colors[g]}">●</span> ${g} ` +
                `${k$(rows[i][g])} (${pctFmt(rows[i][g] / (tot || 1))})`).join("<br>"));
          })
          .on("mouseleave", () => { guide.style("display", "none"); hideTip(); });
        if (narrow) {
          const leg = d3.select(el).append("div").attr("class", "legend-row");
          leg.selectAll("span").data(order).join("span").attr("class", "lg")
            .html((g) => `<i style="background:${imports.groups.colors[g]}"></i>${g}`);
        }
      });

      sect("import suppliers", () => {
        if (!imports) return;
        const el = document.getElementById("import-suppliers");
        const W = el.clientWidth, narrow = W < 620;
        const chapters = (imports.byYear[String(imports.latest)] ?? []).slice(0, 12);
        const BAR = 30, M = { t: 6, r: narrow ? 10 : 78, b: 28, l: narrow ? 104 : 148 };
        const H = M.t + chapters.length * BAR + M.b;
        const nameOf = (c) => shortName(imports.names[String(c)]?.name ?? `BACI ${c}`);
        const x = d3.scaleLinear([0, d3.max(chapters, (c) => c.v) * 1.02], [M.l, W - M.r]);
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H);
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - M.b})`)
          .call(d3.axisBottom(x).ticks(narrow ? 3 : 6).tickFormat((v) => k$(v)));
        const g = svg.selectAll("g.crow").data(chapters).join("g").attr("class", "crow")
          .attr("transform", (d, i) => `translate(0,${M.t + i * BAR})`);
        g.append("text").attr("class", "crow-name").attr("x", M.l - 10)
          .attr("y", BAR / 2 + 1).attr("text-anchor", "end")
          .text((d) => (narrow && d.name.length > 15 ? d.name.slice(0, 14) + "…" : d.name));
        g.each(function (d) {
          const sup = (imports.suppliers[d.hs2] ?? []).slice();
          const named = d3.sum(sup, (s) => s.v);
          const segs = sup.concat(d.v - named > 0
            ? [{ c: "other", v: d.v - named }] : []);
          let acc = 0;
          const withPos = segs.map((s) => { const o = { ...s, x0: acc }; acc += s.v; return o; });
          withPos.forEach((s) => mkGrad(pColor(s.c)));
          d3.select(this).selectAll("rect").data(withPos).join("rect")
            .attr("x", (s) => x(s.x0)).attr("y", 3).attr("height", BAR - 11).attr("rx", 3)
            .attr("width", (s) => Math.max(0, x(s.x0 + s.v) - x(s.x0)))
            .attr("fill", (s) => `url(#${gradId(pColor(s.c))})`)
            .attr("stroke", INK).attr("stroke-width", 0.6)
            .on("mousemove", (e, s) => showTip(e,
              `<b>${s.c === "other" ? "All other suppliers" : nameOf(s.c)}</b><br>` +
              `${d.name} (HS ${d.hs2})<br>${k$(s.v)} · ${pctFmt(s.v / d.v)} of the chapter`))
            .on("mouseleave", hideTip);
          if (!narrow) d3.select(this).append("text").attr("class", "annot")
            .attr("x", x(d.v) + 7).attr("y", BAR / 2 + 1).text(k$(d.v));
        });
        // colours are shared with chapter 07, but a reader arriving here needs
        // the key in front of them — rank suppliers by what they actually ship
        const tally = new Map();
        for (const c of chapters)
          for (const s of imports.suppliers[c.hs2] ?? [])
            tally.set(s.c, (tally.get(s.c) ?? 0) + s.v);
        const top = [...tally.entries()].sort((a, b) => b[1] - a[1])
          .slice(0, narrow ? 7 : 11).map(([c]) => c);
        const leg = d3.select(el).append("div").attr("class", "legend-row");
        leg.selectAll("span").data(top.concat("other")).join("span").attr("class", "lg")
          .html((c) => `<i style="background:${pColor(c)}"></i>` +
            (c === "other" ? "all other suppliers" : nameOf(c)));
      });

      /* ---------- chapter 09: trade balance by partner ---------- */
      sect("balance", () => {
        if (!balance) return;
        const el = document.getElementById("balance");
        const W = el.clientWidth, narrow = W < 620;
        const N = 18, BAR = 26;
        const M = { t: 22, r: narrow ? 8 : 20, b: 26, l: narrow ? 56 : 92 };
        const H = M.t + N * BAR + M.b;
        const nameOf = (c) => balance.names[String(c)] ?? { name: `BACI ${c}`, iso3: c };
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H);
        const axisG = svg.append("g").attr("class", "axis")
          .attr("transform", `translate(0,${H - M.b})`);
        const zeroLine = svg.append("line").attr("y1", M.t - 6).attr("y2", H - M.b)
          .attr("stroke", "#E6E8EC").attr("stroke-opacity", 0.28);
        const x = d3.scaleLinear().range([M.l, W - M.r]);
        svg.append("text").attr("class", "annot").attr("y", M.t - 10)
          .attr("id", "bal-lbl-def").attr("fill", VERDIGRIS).text("← deficit");
        svg.append("text").attr("class", "annot").attr("y", M.t - 10)
          .attr("id", "bal-lbl-sur").attr("fill", COPPER).text("surplus →");
        function render(year, dur) {
          const rows = (balance.rows[String(year)] ?? []).slice(0, N)
            .map((r) => ({ ...r, b: r.e - r.i })).sort((a, b) => b.b - a.b);
          const m = d3.max(rows, (r) => Math.abs(r.b)) || 1;
          x.domain([-m * 1.08, m * 1.08]);
          const t = svg.transition().duration(reduced ? 0 : dur).ease(d3.easeCubicOut);
          axisG.transition(t).call(d3.axisBottom(x).ticks(narrow ? 3 : 6)
            .tickFormat((v) => (v === 0 ? "0" : k$(Math.abs(v)))));
          zeroLine.transition(t).attr("x1", x(0)).attr("x2", x(0));
          svg.select("#bal-lbl-def").transition(t).attr("x", x(0) - 8)
            .attr("text-anchor", "end");
          svg.select("#bal-lbl-sur").transition(t).attr("x", x(0) + 8)
            .attr("text-anchor", "start");
          const g = svg.selectAll("g.brow").data(rows, (d) => d.c).join(
            (enter) => {
              const g = enter.append("g").attr("class", "brow").style("opacity", 0);
              g.append("rect").attr("class", "bbar").attr("height", BAR - 10).attr("rx", 3);
              g.append("text").attr("class", "brow-name").attr("y", BAR / 2 - 1);
              return g;
            }, (u) => u, (x2) => x2.transition(t).style("opacity", 0).remove());
          // a partner entering the top-18 lands on its row and grows out of the
          // zero line, rather than flying in from the corner
          g.each(function (d, i) {
            if (this.__placed) return;
            this.__placed = true;
            d3.select(this).attr("transform", `translate(0,${M.t + i * BAR})`)
              .select("rect.bbar").attr("x", x(0)).attr("width", 0);
          });
          g.transition(t).attr("transform", (d, i) => `translate(0,${M.t + i * BAR})`)
            .style("opacity", 1);
          g.select("rect.bbar")
            .attr("fill", (d) => (d.b >= 0 ? `url(#${gradId(COPPER)})`
              : `url(#${gradId(VERDIGRIS)})`))
            .style("filter", (d) => (d.b >= 0 ? "url(#copper-glow-soft)" : null))
            .on("mousemove", (e, d) => showTip(e,
              `<b>${shortName(nameOf(d.c).name)}</b> · ${year}<br>` +
              `exports ${k$(d.e)}<br>imports ${k$(d.i)}<br>` +
              `<b style="color:${d.b >= 0 ? COPPER : VERDIGRIS}">` +
              `${d.b >= 0 ? "surplus" : "deficit"} ${k$(Math.abs(d.b))}</b>`))
            .on("mouseleave", hideTip)
            .transition(t)
            .attr("x", (d) => (d.b >= 0 ? x(0) : x(d.b)))
            .attr("width", (d) => Math.max(1, Math.abs(x(d.b) - x(0))));
          g.select("text.brow-name")
            .text((d) => (narrow ? nameOf(d.c).iso3 : shortName(nameOf(d.c).name)))
            .transition(t)
            .attr("x", (d) => (d.b >= 0 ? x(0) - 7 : x(0) + 7))
            .attr("text-anchor", (d) => (d.b >= 0 ? "end" : "start"));
        }
        const yrs = balance.years;
        const slider = document.getElementById("bal-year");
        slider.min = yrs[0]; slider.max = yrs.at(-1); slider.value = yrs.at(-1);
        document.getElementById("bal-label").textContent = yrs.at(-1);
        render(yrs.at(-1), 0);
        slider.addEventListener("input", (e) => {
          render(+e.target.value, 420);
          document.getElementById("bal-label").textContent = e.target.value;
        });
      });

      /* ---------- chapter 10: the pre-registered nickel import test ---------- */
      sect("nickel gate", () => {
        if (!ninputs) return;
        const T = ninputs.thresholds;
        const chip = (ok, label) =>
          `<span class="gchip ${ok ? "pass" : "fail"}">${ok ? "PASS" : "FAIL"}</span>` +
          `<span class="gtext">${label}</span>`;
        const v = ninputs.verdict;
        const host = document.getElementById("gate-b7");
        host.className = `gate-card verdict-${v.toLowerCase()}`;
        host.innerHTML = `
          <div class="gate-head"><span class="stamp dim">PRE-REGISTERED CHECK</span>
            <span class="verdict">${v}</span></div>
          <div class="gate-rows">
            <div>${chip(ninputs.h1, `<b>H1</b> HS 84+85 imports grew
              <b>${d3.format("+.0%")(ninputs.capGrowth)}</b> from the 2013–15 base to the
              2021–24 peak — threshold +${d3.format(".0%")(T.h1)}.`)}</div>
            <div>${chip(ninputs.h2, `<b>H2</b> that beats total import growth
              (${d3.format("+.0%")(ninputs.totalGrowth)}) by
              <b>${d3.format("+.0%")(ninputs.excess)}</b> — threshold
              +${d3.format(".0%")(T.h2)} points.`)}</div>
            <div>${chip(ninputs.h3, `<b>H3</b> smelter inputs doubling:
              <b>${ninputs.h3hits.length ? ninputs.h3hits.map((c) =>
                ninputs.inputs[c].label).join(", ") : "none"}</b> — threshold
              +${d3.format(".0%")(T.h3)}.`)}</div>
          </div>`;
      });

      sect("nickel test chart", () => {
        if (!ninputs) return;
        const el = document.getElementById("nickel-test");
        const W = el.clientWidth, narrow = W < 620;
        const M = { t: 18, r: narrow ? 14 : 152, b: 28, l: narrow ? 42 : 52 };
        const H = M.t + (narrow ? 250 : 300) + M.b;
        const yrs = Object.keys(ninputs.totalImports).map(Number).sort((a, b) => a - b);
        const mean = (obj, ys) => d3.mean(ys, (y) => obj[String(y)] ?? 0) || 1;
        const idx = (obj) => yrs.map((y) => ({
          y, v: ((obj[String(y)] ?? 0) / mean(obj, ninputs.base)) * 100 }));
        const series = [
          { k: "processed nickel", full: "processed nickel exports", c: COPPER, w: 2.6,
            pts: idx(nickel.processed) },
          { k: "machinery imports", full: "machinery & electrical imports",
            c: "#5D8FBF", w: 2.2, pts: idx(ninputs.capgoods) },
          { k: "all imports", full: "all imports", c: SILVER, w: 1.4,
            pts: idx(ninputs.totalImports) },
        ];
        const flat = series.flatMap((s) => s.pts).filter((d) => d.v > 0);
        const x = d3.scaleLinear(d3.extent(yrs), [M.l, W - M.r]);
        const y = d3.scaleLog(
          [Math.max(1, d3.min(flat, (d) => d.v) * 0.8), d3.max(flat, (d) => d.v) * 1.25],
          [H - M.b, M.t]);
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H);
        // pre-registered windows, drawn so the reader sees what was compared
        for (const [ys, lbl, col, end] of [[ninputs.base, "base 2013–15", SILVER, false],
                                          [ninputs.peak, "peak 2021–24", COPPER, true]]) {
          svg.append("rect").attr("x", x(ys[0]) - 3).attr("y", M.t)
            .attr("width", x(ys.at(-1)) - x(ys[0]) + 6).attr("height", H - M.t - M.b)
            .attr("fill", col).attr("opacity", 0.07);
          // the peak label hangs off the right edge of its band so it cannot
          // run past the plot at middling widths
          svg.append("text").attr("class", "annot")
            .attr("x", end ? x(ys.at(-1)) + 3 : x(ys[0]) - 1)
            .attr("text-anchor", end ? "end" : "start")
            .attr("y", M.t + 11).attr("fill", col).text(narrow ? "" : lbl);
        }
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`)
          .call(d3.axisLeft(y).ticks(4, "~s"));
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - M.b})`)
          .call(d3.axisBottom(x).ticks(narrow ? 4 : 8).tickFormat(d3.format("d")));
        svg.append("line").attr("x1", M.l).attr("x2", W - M.r)
          .attr("y1", y(100)).attr("y2", y(100))
          .attr("stroke", "var(--hairline)").attr("stroke-dasharray", "3 4");
        const line = d3.line().defined((d) => d.v > 0).x((d) => x(d.y)).y((d) => y(d.v))
          .curve(d3.curveMonotoneX);
        svg.selectAll("path.ns").data(series).join("path").attr("class", "ns")
          .attr("d", (s) => line(s.pts)).attr("fill", "none")
          .attr("stroke", (s) => s.c).attr("stroke-width", (s) => s.w)
          .style("filter", (s) => (s.c === COPPER ? "url(#copper-glow-soft)" : null));
        if (!narrow) {
          const ends = spread(series.map((s) => ({
            k: s.k, c: s.c, y: y(s.pts.filter((d) => d.v > 0).at(-1).v) })),
            14, M.t + 6, H - M.b - 2);
          svg.selectAll("text.nend").data(ends).join("text").attr("class", "annot nend")
            .attr("x", W - M.r + 6).attr("y", (d) => d.y + 4)
            .attr("fill", (d) => d.c).text((d) => d.k);
        }
        const guide = svg.append("line").attr("y1", M.t).attr("y2", H - M.b)
          .attr("stroke", "#E6E8EC").attr("stroke-opacity", 0.45).style("display", "none");
        const dots = svg.selectAll("circle.nh").data(series).join("circle")
          .attr("class", "nh").attr("r", 3.6).attr("fill", (s) => s.c)
          .attr("stroke", INK).style("display", "none");
        svg.append("rect").attr("x", M.l).attr("y", M.t).attr("width", W - M.l - M.r)
          .attr("height", H - M.t - M.b).attr("fill", "transparent")
          .on("mousemove", (e) => {
            const yr = Math.round(x.invert(d3.pointer(e)[0])), i = yrs.indexOf(yr);
            if (i < 0) return;
            guide.style("display", null).attr("x1", x(yr)).attr("x2", x(yr));
            dots.style("display", (s) => (s.pts[i].v > 0 ? null : "none"))
              .attr("cx", x(yr)).attr("cy", (s) => y(Math.max(s.pts[i].v, 1)));
            showTip(e, `<b>${yr}</b> · index, 2013–15 = 100<br>` + series
              .map((s) => `<span style="color:${s.c}">●</span> ${s.full} ` +
                `<b>${d3.format(".0f")(s.pts[i].v)}</b>`).join("<br>"));
          })
          .on("mouseleave", () => {
            guide.style("display", "none"); dots.style("display", "none"); hideTip(); });
        if (narrow) {
          const leg = d3.select(el).append("div").attr("class", "legend-row");
          leg.selectAll("span").data(series).join("span").attr("class", "lg")
            .html((s) => `<i style="background:${s.c}"></i>${s.k}`);
        }
      });

      sect("nickel input sparklines", () => {
        if (!ninputs) return;
        const host = d3.select("#nickel-inputs");
        const entries = Object.entries(ninputs.inputs)
          .sort((a, b) => (b[1].growth ?? -9) - (a[1].growth ?? -9));
        const cards = host.selectAll("div.spark").data(entries).join("div")
          .attr("class", ([, d]) => "spark" + (d.growth != null
            && d.growth >= ninputs.thresholds.h3 ? " hit" : ""));
        cards.append("div").attr("class", "spark-head")
          .html(([code, d]) => `<b>${d.label}</b><span class="stamp dim">HS ${code}</span>`);
        cards.append("div").attr("class", "spark-val")
          .html(([, d]) => d.growth == null ? "<span class='dim'>no base-year trade</span>"
            : `<b>${d3.format("+.0%")(d.growth)}</b>`);
        cards.each(function ([code, d]) {
          const w = 190, h = 42, pad = 3;
          const yrs = Object.keys(d.series).map(Number).sort((a, b) => a - b);
          if (!yrs.length) return;
          const x = d3.scaleLinear(d3.extent(yrs), [pad, w - pad]);
          const y = d3.scaleLinear([0, d3.max(yrs, (t) => d.series[String(t)]) || 1],
            [h - pad, pad]);
          const hit = d.growth != null && d.growth >= ninputs.thresholds.h3;
          const col = hit ? COPPER : SILVER;
          const svg = d3.select(this).append("svg").attr("class", "spark-svg")
            .attr("viewBox", `0 0 ${w} ${h}`).attr("preserveAspectRatio", "none");
          const pts = yrs.map((t) => ({ t, v: d.series[String(t)] ?? 0 }));
          svg.append("path").datum(pts).attr("fill", col).attr("opacity", 0.16)
            .attr("d", d3.area().x((p) => x(p.t)).y0(h - pad).y1((p) => y(p.v))
              .curve(d3.curveMonotoneX));
          svg.append("path").datum(pts).attr("fill", "none").attr("stroke", col)
            // the card stretches the 190-unit viewBox to its column width, so the
            // stroke must opt out of that non-uniform scale to stay even
            .attr("stroke-width", 1.6).attr("vector-effect", "non-scaling-stroke")
            .attr("d", d3.line().x((p) => x(p.t)).y((p) => y(p.v))
              .curve(d3.curveMonotoneX));
          d3.select(this)
            .on("mousemove", (e) => showTip(e, `<b>${d.label}</b> · HS ${code}<br>` +
              `2013–15 avg ${k$(d3.mean(ninputs.base, (t) => d.series[String(t)] ?? 0))}<br>` +
              `2021–24 avg ${k$(d3.mean(ninputs.peak, (t) => d.series[String(t)] ?? 0))}<br>` +
              (d.growth == null ? "" : `change <b>${d3.format("+.0%")(d.growth)}</b>`)))
            .on("mouseleave", hideTip);
        });
      });

      /* ---------- reconciliation card: G-B5 / G-B6 ---------- */
      sect("reconciliation", () => {
        if (!pgates) return;
        const b = (v) => "US$" + d3.format(".1f")(v / 1e9) + "B";
        const g5 = pgates["G-B5"], g6 = pgates["G-B6"];
        const row = (g, extra) => `
          <div class="recon-row ${g.pass ? "pass" : "fail"}">
            <div class="recon-top"><b>${g.name}</b>
              <span class="gchip ${g.pass ? "pass" : "fail"}">${g.pass ? "PASS" : "FAIL"}</span></div>
            <div class="recon-nums">
              <span>BACI <b>${b(g.baci)}</b></span>
              <span>benchmark <b>${b(g.benchmark)}</b></span>
              <span class="dev">deviation <b>${d3.format("+.2%")(g.deviation)}</b>
                <span class="dim">tolerance ±${d3.format(".0%")(g.tolerance)}</span></span>
            </div>${extra}</div>`;
        // the multi-year strip is what turns "one year missed" into "systematic"
        const strip = (g5.series ?? []).length ? `
          <div class="recon-series">
            ${g5.series.map((r) => `<div class="rs">
              <span class="rs-y">${r.year}</span>
              <span class="rs-bar"><i style="width:${Math.min(100, Math.abs(r.deviation) * 400)}%"></i></span>
              <span class="rs-d">${d3.format("+.1%")(r.deviation)}</span>
              <span class="rs-n">BACI ${b(r.baci)} · BPS ${b(r.bps)}</span>
            </div>`).join("")}
          </div>` : "";
        document.getElementById("recon").innerHTML =
          row(g5, strip + `<p class="recon-note">Against the BPS published total
            (${b(g5.bps)}) the same figure deviates
            ${d3.format("+.2%")(g5.deviationBps)} — and the gap holds at a similar size in
            every year BPS publishes, which is what makes it a methodology difference
            rather than a one-year revision.</p>`) +
          row(g6, `<p class="recon-note">BPS values imports <b>CIF</b>; BACI harmonizes
            every flow to <b>FOB</b>, stripping freight and insurance out of importer
            declarations. A negative deviation of a few per cent is therefore the
            <em>correct</em> result here, not an error — it is roughly the shipping
            margin on Indonesia's import basket.</p>`);
      });
    </script>

    <style is:global>
      html { scroll-behavior: smooth; }
      body { margin: 0; }
      .stamp { font-family: var(--font-data); font-size: 0.75rem; letter-spacing: 0.12em; color: var(--accent); }
      .stamp.dim { color: var(--ink-muted); }
      .eyebrow { font-family: var(--font-data); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
      .copper { color: var(--accent); } .dim { color: var(--ink-muted); }
      .stamp-bar { position: fixed; inset: 0 0 auto 0; z-index: 20; display: flex; justify-content: space-between; padding: 12px 20px; background: linear-gradient(color-mix(in srgb, var(--ground) 82%, transparent), transparent); pointer-events: none; }

      .hero { position: relative; height: 100vh; background: var(--ground); }
      #hero-globe { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      #hero-globe .tg-grat path { fill: none; stroke: #AEB6C2; stroke-width: 0.35; opacity: 0.13; }
      #hero-globe .tg-land path { fill: none; stroke: #7F8B9C; stroke-width: 0.8; opacity: 0.55; }
      #hero-globe .tr-arc path { fill: none; stroke-linecap: round; }
      #hero-globe .a-base { stroke: #D9722C; stroke-width: calc(var(--w) * 0.5px); opacity: 0.22; }
      #hero-globe .a-glow { stroke: #D9722C; stroke-width: calc(var(--w) * 2.2px); opacity: 0.5;
        filter: url(#hg-bloom); stroke-dasharray: 60 940;
        animation: hg-run var(--d) linear var(--t) infinite; }
      #hero-globe .a-core { stroke: #FFD9B0; stroke-width: calc(var(--w) * 0.8px); opacity: 0.95;
        stroke-dasharray: 34 966; animation: hg-run var(--d) linear var(--t) infinite; }
      @keyframes hg-run { from { stroke-dashoffset: 1000; } to { stroke-dashoffset: 0; } }
      #hero-globe .o-ring { transform-box: fill-box; transform-origin: center;
        animation: hg-pulse 3.2s ease-out infinite; }
