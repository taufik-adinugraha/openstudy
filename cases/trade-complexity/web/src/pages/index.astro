      sect("timelapse", () => {
        const el = document.getElementById("race");
        const years = Object.keys(treemap).map(Number).sort((a, b) => a - b);
        const N = 10, BAR = 34, M = { t: 6, r: 110, b: 28, l: 168 };
        const W = el.clientWidth, H = M.t + N * BAR + M.b;
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H).attr("class", "race");
        const x = d3.scaleLinear().range([M.l, W - M.r]);
        const yAt = (i) => M.t + i * BAR;
        const axisG = svg.append("g").attr("class", "axis").attr("transform", `translate(0,${M.t + N * BAR})`);
        const isCopper2 = (hs2) => ["26", "72", "75"].includes(hs2);
        const yearEl = document.getElementById("race-year"), totalEl = document.getElementById("hud-total"),
              rankEl = document.getElementById("hud-rank"), strEl = document.getElementById("hud-strengths");
        const scrub = document.getElementById("race-scrub"), playBtn = document.getElementById("race-play"), speedBtn = document.getElementById("race-speed");
        let year = years[0], playing = false, speed = 1, timer = null;

        function frame(yr, dur) {
          const all = treemap[String(yr)] ?? [];
          const rows = all.slice().sort((a, b) => b.v - a.v).slice(0, N);
          x.domain([0, (rows[0]?.v ?? 1) * 1.06]);
          const t = svg.transition().duration(reduced ? 0 : dur).ease(d3.easeCubicInOut);
          axisG.transition(t).call(d3.axisBottom(x).ticks(5).tickFormat((v) => fmt$(v * 1e3)));
          const g = svg.selectAll("g.bar").data(rows, (d) => d.hs2).join(
            (enter) => {
              const g = enter.append("g").attr("class", "bar").attr("transform", `translate(0,${yAt(N)})`).style("opacity", 0);
              g.append("rect").attr("x", M.l).attr("height", BAR - 9).attr("rx", 5).attr("width", 0);
              g.append("text").attr("class", "race-name").attr("x", M.l - 12).attr("y", (BAR - 9) / 2 + 4).attr("text-anchor", "end");
              g.append("text").attr("class", "race-val").attr("y", (BAR - 9) / 2 + 4);
              return g;
            },
            (update) => update,
            (exit) => exit.transition(t).attr("transform", `translate(0,${yAt(N)})`).style("opacity", 0).remove());
          g.transition(t).attr("transform", (d, i) => `translate(0,${yAt(i)})`).style("opacity", 1);
          g.select("rect").classed("copper", (d) => isCopper2(d.hs2))
            .attr("fill", (d) => `url(#${gradId(isCopper2(d.hs2) ? COPPER : sectorOf(d.hs2)[2])})`)
            .transition(t).attr("width", (d) => Math.max(0, x(d.v) - M.l));
          g.select(".race-name").text((d) => d.name);
          g.select(".race-val").transition(t).attr("x", (d) => x(d.v) + 8)
            .tween("text", function (d) {
              const from = +this.dataset.v || 0, ip = d3.interpolateNumber(from, d.v);
              return (k) => { this.textContent = fmt$(ip(k) * 1e3); };
            }).on("end", function (d) { this.dataset.v = d.v; });
          // HUD
          yearEl.textContent = yr;
          totalEl.textContent = fmt$(d3.sum(all, (d) => d.v) * 1e3);
          const rk = traj.ranks.IDN[String(yr)]; rankEl.textContent = rk ? `#${rk} of ${traj.n[String(yr)]}` : "—";
          strEl.textContent = (states[String(yr)] ?? []).length || "—";
          scrub.value = yr;
        }
        function stop() { playing = false; clearTimeout(timer); playBtn.textContent = "▶"; }
        function step() {
          if (year >= years.at(-1)) { stop(); return; }
          year += 1; frame(year, 700 / speed);
          timer = setTimeout(step, (reduced ? 900 : 780) / speed);
        }
        function play() { if (year >= years.at(-1)) { year = years[0]; frame(year, 300); } playing = true; playBtn.textContent = "❚❚"; timer = setTimeout(step, 400); }
        playBtn.addEventListener("click", () => (playing ? stop() : play()));
        speedBtn.addEventListener("click", () => { speed = speed === 1 ? 2 : speed === 2 ? 4 : 1; speedBtn.textContent = `${speed}×`; });
        scrub.addEventListener("input", (e) => { stop(); year = +e.target.value; frame(year, 350); });
        frame(year, 0);
        // autoplay once when the chapter scrolls into view (not under reduced motion)
        let autoplayed = false;
        new IntersectionObserver(([en]) => {
          if (en.isIntersecting && !autoplayed && !reduced) { autoplayed = true; play(); }
        }, { threshold: 0.5 }).observe(el);
      });

      /* ---------- chapter 3: nickel ---------- */
      sect("nickel chart", () => {
        const el = document.getElementById("nickel");
        const W = el.clientWidth, H = 280, M = { t: 20, r: 20, b: 30, l: 60 };
        const years = Object.keys(nickel.ore).map(Number).sort();
        const series = (obj) => years.map((yr) => ({ yr, v: (obj[String(yr)] ?? 0) * 1e3 }));
        const ore = series(nickel.ore), proc = series(nickel.processed);
        const x = d3.scaleLinear(d3.extent(years), [M.l, W - M.r]);
        const y = d3.scaleLinear([0, d3.max([...ore, ...proc], (d) => d.v) * 1.08], [H - M.b, M.t]);
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H);
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`).call(d3.axisLeft(y).ticks(4).tickFormat((v) => "$" + d3.format("~s")(v)));
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - M.b})`).call(d3.axisBottom(x).tickFormat(d3.format("d")));
        for (const [yr, txt] of [[2014, "first ore ban"], [2020, "full ban"]]) {
          svg.append("line").attr("x1", x(yr)).attr("x2", x(yr)).attr("y1", M.t).attr("y2", H - M.b).attr("stroke", "#3A4452").attr("stroke-dasharray", "3 4");
          svg.append("text").attr("x", x(yr) + 5).attr("y", M.t + 10).attr("class", "annot").text(`${yr} · ${txt}`);
        }
        const line = d3.line().x((d) => x(d.yr)).y((d) => y(d.v)).curve(d3.curveMonotoneX);
        svg.append("path").datum(ore).attr("d", line).attr("fill", "none").attr("stroke", SILVER).attr("stroke-width", 1.8);
        svg.append("path").datum(proc).attr("d", line).attr("fill", "none").attr("stroke", COPPER).attr("stroke-width", 2.2).style("filter", "url(#copper-glow-soft)");
        const labels = spread([
          { y: y(ore.at(-1).v), text: "ore (HS 2604)", fill: SILVER },
          { y: y(proc.at(-1).v), text: "processed nickel & stainless", fill: COPPER }], 14, M.t + 8, H - M.b - 4);
        svg.selectAll("text.end").data(labels).join("text").attr("class", "annot end")
          .attr("x", W - M.r).attr("y", (d) => d.y - 6).attr("text-anchor", "end").attr("fill", (d) => d.fill).text((d) => d.text);
        // hover: crosshair + dots + tooltip
        const guide = svg.append("line").attr("y1", M.t).attr("y2", H - M.b).attr("stroke", "#E6E8EC").attr("stroke-opacity", 0.45).style("display", "none");
        const dots = svg.selectAll("circle.h").data([ore, proc]).join("circle").attr("class", "h").attr("r", 4)
          .attr("fill", (d, i) => (i ? COPPER : SILVER)).attr("stroke", INK).style("display", "none");
        svg.append("rect").attr("x", M.l).attr("y", M.t).attr("width", W - M.l - M.r).attr("height", H - M.t - M.b).attr("fill", "transparent")
          .on("mousemove", (e) => {
            const yr = Math.round(x.invert(d3.pointer(e)[0])); const i = years.indexOf(yr); if (i < 0) return;
            guide.style("display", null).attr("x1", x(yr)).attr("x2", x(yr));
            dots.style("display", null).attr("cx", x(yr)).attr("cy", (d) => y(d[i].v));
            showTip(e, `<b>${yr}</b><br><span style="color:${COPPER}">●</span> processed ${fmt$(proc[i].v)}<br><span style="color:${SILVER}">●</span> ore ${fmt$(ore[i].v)}`);
          })
          .on("mouseleave", () => { guide.style("display", "none"); dots.style("display", "none"); hideTip(); });
      });

      /* ---------- chapter 3: trajectory ---------- */
      sect("trajectory chart", () => {
        const el = document.getElementById("trajectory");
        const W = el.clientWidth, H = 300, M = { t: 16, r: 60, b: 30, l: 44 };
        const years = Object.keys(traj.ranks.IDN).map(Number).sort();
        const maxRank = d3.max(Object.values(traj.ranks).flatMap((r) => Object.values(r)));
        const x = d3.scaleLinear(d3.extent(years), [M.l, W - M.r]);
        const y = d3.scaleLinear([1, maxRank], [M.t, H - M.b]);
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H);
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`).call(d3.axisLeft(y).ticks(5).tickFormat((v) => "#" + v));
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - M.b})`).call(d3.axisBottom(x).tickFormat(d3.format("d")));
        const line = d3.line().defined((d) => d.r != null).x((d) => x(d.yr)).y((d) => y(d.r)).curve(d3.curveMonotoneX);
        const series = Object.entries(traj.ranks).map(([iso, ranks]) => ({
          iso, isIdn: iso === "IDN", pts: years.map((yr) => ({ yr, r: ranks[String(yr)] ?? null })) }));
        const paths = svg.selectAll("path.s").data(series).join("path").attr("class", "s")
          .attr("d", (s) => line(s.pts)).attr("fill", "none")
          .attr("stroke", (s) => (s.isIdn ? COPPER : VERDIGRIS)).attr("stroke-width", (s) => (s.isIdn ? 2.6 : 1.2))
          .attr("opacity", (s) => (s.isIdn ? 1 : 0.7)).style("filter", (s) => (s.isIdn ? "url(#copper-glow-soft)" : null));
        const labels = spread(series.map((s) => {
          const last = s.pts.filter((d) => d.r != null).at(-1);
          return { y: y(last.r), text: `${s.iso} #${last.r}`, fill: s.isIdn ? COPPER : VERDIGRIS, iso: s.iso, x: x(last.yr) };
        }), 13, M.t + 4, H - M.b - 2);
        svg.selectAll("text.end").data(labels).join("text").attr("class", "annot end")
          .attr("x", (d) => d.x + 8).attr("y", (d) => d.y + 4).attr("fill", (d) => d.fill).text((d) => d.text);
        // hover: crosshair + per-series dots + ranked tooltip; hovering a label highlights its line
        const guide = svg.append("line").attr("y1", M.t).attr("y2", H - M.b).attr("stroke", "#E6E8EC").attr("stroke-opacity", 0.45).style("display", "none");
        const dots = svg.selectAll("circle.h").data(series).join("circle").attr("class", "h").attr("r", 3.5)
          .attr("fill", (s) => (s.isIdn ? COPPER : VERDIGRIS)).attr("stroke", INK).style("display", "none");
        svg.append("rect").attr("x", M.l).attr("y", M.t).attr("width", W - M.l - M.r).attr("height", H - M.t - M.b).attr("fill", "transparent")
          .on("mousemove", (e) => {
            const yr = Math.round(x.invert(d3.pointer(e)[0])); const i = years.indexOf(yr); if (i < 0) return;
            guide.style("display", null).attr("x1", x(yr)).attr("x2", x(yr));
            dots.style("display", (s) => (s.pts[i].r == null ? "none" : null)).attr("cx", x(yr)).attr("cy", (s) => y(s.pts[i].r ?? 1));
            const rows = series.filter((s) => s.pts[i].r != null).sort((a, b) => a.pts[i].r - b.pts[i].r)
              .map((s) => `<span style="color:${s.isIdn ? COPPER : VERDIGRIS}">${s.isIdn ? "<b>" : ""}${s.iso} #${s.pts[i].r}${s.isIdn ? "</b>" : ""}</span>`);
            showTip(e, `<b>${yr}</b> · ECI rank<br>${rows.join("<br>")}`);
          })
          .on("mouseleave", () => { guide.style("display", "none"); dots.style("display", "none"); hideTip(); });
        svg.selectAll("text.end").style("cursor", "default")
          .on("mouseenter", (e, d) => paths.attr("opacity", (s) => (s.iso === d.iso ? 1 : 0.15)).attr("stroke-width", (s) => (s.iso === d.iso ? 2.6 : 1.2)))
          .on("mouseleave", () => paths.attr("opacity", (s) => (s.isIdn ? 1 : 0.7)).attr("stroke-width", (s) => (s.isIdn ? 2.6 : 1.2)));
      });

      /* ---------- chapter 4: adjacency ---------- */
      sect("adjacency chart", () => {
        const el = document.getElementById("adjacency");
        const W = el.clientWidth, H = 320, M = { t: 16, r: 20, b: 34, l: 50 };
        const x = d3.scaleLinear(d3.extent(adjacency, (d) => d.density), [M.l, W - M.r]).nice();
        const y = d3.scaleLinear(d3.extent(adjacency, (d) => d.pci), [H - M.b, M.t]).nice();
        const r = d3.scaleSqrt(d3.extent(adjacency, (d) => d.world), [2, 14]);
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H);
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`).call(d3.axisLeft(y).ticks(5));
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - M.b})`).call(d3.axisBottom(x).ticks(6));
        svg.append("text").attr("x", W - M.r).attr("y", H - 6).attr("text-anchor", "end").attr("class", "annot").text("density → closer to Indonesia’s current strengths");
        svg.append("text").attr("x", M.l + 4).attr("y", M.t + 10).attr("class", "annot").text("↑ PCI (product sophistication)");
        const q80 = d3.quantile(adjacency.map((a) => a.density).sort(d3.ascending), 0.8);
        const frontier = (d) => d.density > q80 && d.pci > 0;
        svg.selectAll("circle").data(adjacency).join("circle")
          .attr("cx", (d) => x(d.density)).attr("cy", (d) => y(d.pci)).attr("r", (d) => r(d.world))
          .attr("fill", (d) => (frontier(d) ? `url(#${gradId(COPPER)})` : `url(#${gradId(SILVER)})`))
          .style("filter", (d) => (frontier(d) ? "url(#copper-glow-soft)" : null))
          .attr("opacity", 0.55).attr("stroke", INK).attr("stroke-width", 0.5)
          .on("mousemove", function (e, d) {
            d3.select(this).attr("opacity", 1).attr("stroke", "#E6E8EC");
            showTip(e, `<b>${label(d.hs4)}</b><br>HS ${d.hs4}<br>density ${d.density.toFixed(2)} · PCI ${d.pci.toFixed(2)}<br>world trade ${fmt$(d.world * 1e3)}`);
          })
          .on("mouseleave", function () { d3.select(this).attr("opacity", 0.55).attr("stroke", INK); hideTip(); });
      });
    </script>

    <style is:global>
