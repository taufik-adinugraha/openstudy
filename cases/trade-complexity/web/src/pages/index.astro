      /* gate + reconciliation cards: a failure must look like a failure */
      .gate-card { border: 1px solid var(--hairline); border-left: 3px solid var(--ink-muted); border-radius: 10px; padding: 16px 18px; background: linear-gradient(135deg, var(--surface), var(--ground)); display: flex; flex-direction: column; gap: 12px; }
