      /* ---------- chapter 1: treemap ---------- */
      sect("treemap", () => {
        const el = document.getElementById("treemap");
        const W = el.clientWidth, H = 400;
        const svg = d3.select(el).append("svg").attr("width", W).attr("height", H).attr("class", "treemap");
