      .spark { border: 1px solid var(--hairline); border-radius: 8px; padding: 12px 13px 8px; background: var(--surface); display: flex; flex-direction: column; gap: 6px; cursor: default; transition: border-color 0.2s ease, transform 0.2s ease; }
