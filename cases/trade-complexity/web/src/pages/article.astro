      .stamp { font-family: var(--font-data); font-size: 0.72rem; letter-spacing: 0.12em; color: var(--accent); }
      .stamp.dim { color: var(--ink-muted); text-align: right; }

      article { max-width: 50rem; margin: 0 auto; padding: 0 24px 12vh; }
      .masthead { padding: 9vh 0 4vh; border-bottom: 1px solid var(--hairline); }
      .eyebrow { font-family: var(--font-data); font-size: 0.72rem; letter-spacing: 0.16em; color: var(--accent); }
      h1 { font-family: var(--font-display); font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.1;
        letter-spacing: -0.02em; margin: 18px 0 20px; }
      .standfirst { font-size: 1.12rem; color: var(--ink); margin: 0 0 26px; max-width: 42rem; }
      .byline { display: flex; flex-wrap: wrap; gap: 8px 22px; font-family: var(--font-data);
        font-size: 0.74rem; letter-spacing: 0.08em; color: var(--ink-muted); text-transform: uppercase; }

      .abstract { margin: 5vh 0; padding: 26px 28px; border: 1px solid var(--hairline);
        border-left: 3px solid var(--accent); border-radius: var(--radius); background: var(--surface); }
      .abstract h2 { font-family: var(--font-data); font-size: 0.76rem; letter-spacing: 0.16em;
        color: var(--accent); margin: 0 0 14px; text-transform: uppercase; }
      .abstract p { margin: 0 0 12px; font-size: 0.97rem; }
      .abstract p:last-child { margin-bottom: 0; }

      .toc { display: flex; flex-wrap: wrap; gap: 8px 18px; padding: 20px 0 8px; margin-bottom: 4vh;
        border-bottom: 1px solid var(--hairline); font-family: var(--font-data); font-size: 0.74rem; }
      .toc a { text-decoration: none; color: var(--ink-muted); }
      .toc a:hover { color: var(--accent); }

      section { margin: 6vh 0; }
      h2 { font-family: var(--font-display); font-size: clamp(1.3rem, 3.4vw, 1.55rem); line-height: 1.25;
        letter-spacing: -0.01em; margin: 0 0 20px; display: flex; gap: 14px; align-items: baseline; }
      .num { font-family: var(--font-data); font-size: 0.9rem; color: var(--accent); flex: none; }
      p { margin: 0 0 18px; }
      b { color: #FFF0E2; font-weight: 600; }

      .caveat { border-left: 2px solid var(--alert); padding: 2px 0 2px 18px; color: var(--ink-muted); }
      .caveat b { color: var(--alert); }
      .pull { font-size: 1.08rem; line-height: 1.6; border-left: 3px solid var(--accent);
        padding: 8px 0 8px 20px; color: #FFF0E2; }

      figure { margin: 34px 0; padding: 20px 18px 14px; border: 1px solid var(--hairline);
        border-radius: var(--radius); background: var(--surface); }
      .fig { display: block; width: 100%; height: auto; overflow: visible; }
      figcaption { font-size: 0.85rem; color: var(--ink-muted); margin-top: 14px; line-height: 1.55; }
      figcaption b { color: var(--ink); }
      .hv { cursor: crosshair; transition: r 0.12s; }
      .hv:hover { r: 6; }

      ul.facts { padding-left: 20px; margin: 0 0 18px; }
      ul.facts li { margin-bottom: 8px; font-size: 0.95rem; color: var(--ink-muted); }
      ul.facts b { color: var(--accent); }

      ol.uses, ol.next { padding-left: 22px; margin: 0 0 18px; }
      ol.uses li, ol.next li { margin-bottom: 14px; }
      ol.uses li.no { color: var(--ink-muted); }
      ol.uses li.no b { color: var(--alert); }

      ol.refs { padding-left: 22px; font-size: 0.9rem; color: var(--ink-muted); }
      ol.refs li { margin-bottom: 12px; }
      .repro { font-size: 0.86rem; color: var(--ink-muted); border-top: 1px solid var(--hairline);
        padding-top: 18px; }
      code { font-family: var(--font-data); font-size: 0.88em; color: var(--accent);
        overflow-wrap: anywhere; }

      .end { margin-top: 8vh; padding-top: 26px; border-top: 1px solid var(--hairline); }
      .end p { color: var(--ink-muted); font-size: 0.9rem; }
      .cta { display: inline-block; font-family: var(--font-data); font-size: 0.78rem;
        letter-spacing: 0.08em; color: var(--accent); border: 1px solid var(--accent);
        border-radius: 4px; padding: 10px 18px; text-decoration: none; }
      .cta:hover { background: var(--accent-ink); }

      #tip { position: fixed; z-index: 60; pointer-events: none; background: var(--surface-raised);
        border: 1px solid var(--hairline); border-radius: 5px; padding: 8px 11px;
        font-family: var(--font-data); font-size: 0.72rem; line-height: 1.5; color: var(--ink);
        box-shadow: 0 8px 26px rgba(0,0,0,0.5); max-width: 16rem; }

      @media (max-width: 680px) {
        article { padding: 0 16px 10vh; }
        .masthead { padding-top: 5vh; }
        figure { padding: 14px 8px 10px; }
        .bar { padding: 10px 14px; gap: 10px; }
        .stamp.dim { font-size: 0.62rem; letter-spacing: 0.06em; }
        .toc { font-size: 0.7rem; gap: 6px 12px; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>

    <script>
      /* Hover read-outs. Pure SVG and DOM — no GPU path anywhere on this page. */
      const tip = document.getElementById("tip");
      const show = (html: string, e: MouseEvent) => {
        if (!tip) return;
        tip.innerHTML = html; tip.hidden = false;
        const r = tip.getBoundingClientRect();
        let x = e.clientX + 14, y = e.clientY + 14;
        if (x + r.width > innerWidth - 8) x = e.clientX - r.width - 14;
        if (y + r.height > innerHeight - 8) y = e.clientY - r.height - 14;
        tip.style.left = x + "px"; tip.style.top = y + "px";
      };
      document.querySelectorAll<SVGElement>(".hv").forEach((el) => {
        el.addEventListener("mousemove", (e) => show(el.dataset.t ?? "", e as MouseEvent));
        el.addEventListener("mouseleave", () => { if (tip) tip.hidden = true; });
      });
    </script>
  </body>
</html>
