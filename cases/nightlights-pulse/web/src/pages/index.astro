      .gate-chip { font-family: var(--font-data); font-size: 0.75rem; letter-spacing: 0.1em; padding: 2px 8px; margin-left: 10px; border-radius: 3px; border: 1px solid var(--hairline); }
      .calib-block { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
      .calib-block h3 { margin: 0; }
      .calib-block[hidden] { display: none; }
      .chart-legend { display: flex; flex-wrap: wrap; gap: 6px 20px; font-family: var(--font-data); font-size: 0.75rem; letter-spacing: 0.06em; color: var(--ink-muted); }
      .chart-legend .key { display: inline-flex; align-items: center; gap: 7px; }
      .chart-legend .k-line { width: 18px; height: 0; border-top: 2px solid; display: inline-block; }
      .chart-legend .k-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
      .chart-legend .k-band { width: 18px; height: 10px; display: inline-block; opacity: 0.3; }
      .scatter-row { display: grid; grid-template-columns: 1fr 15rem; gap: 28px; align-items: start; }
      @media (max-width: 800px) { .scatter-row { grid-template-columns: 1fr; } }
      .weak-list { display: flex; flex-direction: column; gap: 8px; }
      .weak-list ol { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 0.78rem; }
      .weak-list li { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; border-bottom: 1px solid var(--hairline); padding-bottom: 5px; }
      .weak-list .tags { display: block; font-size: 0.75rem; color: var(--ink-muted); margin-top: 1px; }
      .weak-list .sig { font-family: var(--font-data); color: var(--ink-muted); white-space: nowrap; }
      .sc-years button + button { border-left: 0; }
      .sc-years button { padding: 6px 9px; }
      .annot { font-family: var(--font-data); font-size: 12px; fill: var(--ink-muted); letter-spacing: 0.06em; }
      #calib-tip { position: absolute; z-index: 30; pointer-events: none; background: var(--surface-raised); border: 1px solid var(--hairline); border-radius: 4px; padding: 8px 11px; font-family: var(--font-data); font-size: 0.75rem; line-height: 1.6; color: var(--ink); max-width: 21rem; }
      #calib-flares { max-width: 34rem; }

      /* Review hand-off — the article is a separate page, so it gets a real door. */
      .review-cta { padding-top: 14vh; padding-bottom: 8vh; }
      .review-cta p { color: var(--ink-muted); }
      .cta.big { align-self: flex-start; margin-top: 8px; font-family: var(--font-data);
        font-size: 0.82rem; letter-spacing: 0.08em; color: var(--accent);
        border: 1px solid var(--accent); border-radius: 4px; padding: 13px 22px;
        text-decoration: none; transition: background 0.18s ease, transform 0.18s ease; }
      .cta.big:hover { background: var(--accent-ink); transform: translateY(-1px); }
      @media (prefers-reduced-motion: reduce) { .cta.big { transition: none; } }

      .method { max-width: 44rem; margin: 0 auto; padding: 12vh 24px 12vh; display: flex; flex-direction: column; gap: 14px; }
      .method p { margin: 0; font-size: 0.9rem; line-height: 1.7; color: var(--ink-muted); }
      .maplibregl-ctrl-attrib { background: color-mix(in srgb, var(--ground) 70%, transparent) !important; color: var(--ink-muted); font-size: 12px; }
    </style>
  
    <script>
      /* A hover read-out must not outlive the hover. Each chart hides its own tooltip on
         mouseleave, but a hover can end without one ever firing: the window loses focus
         (an app switch, a screenshot), or the tab is hidden. Backstop only — it never
         second-guesses an active hover, it just closes read-outs once hovering has
         demonstrably ended. */
      (() => {
        const stale = () => [...document.querySelectorAll('[id*="tip" i],[id*="tool" i],[class*="tip" i]')]
          .filter((e) => !e.hidden && e.offsetWidth > 40 && getComputedStyle(e).position !== "static");
        const hide = () => stale().forEach((e) => { e.hidden = true; });
        addEventListener("blur", hide);
        document.addEventListener("visibilitychange", () => { if (document.hidden) hide(); });
      })();
    </script>
  </body>
</html>
