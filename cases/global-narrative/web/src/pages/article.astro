---
/* Review article — the case, stress-tested against its own archive and the literature.
 *
 * Every figure is built here in frontmatter from data/article.json, which
 * pipeline/article.py derives from exactly what the dashboard serves plus the
 * publisher-attribution study (pipeline/attribution.py). Nothing is drawn by
 * hand and no statistic is typed into the prose, so the two cannot drift apart.
 * SVG only — no WebGL, no canvas.
 */
import "../styles/tokens.css";
import A from "../data/article.json";

const VIOLET = "#B26DF2", TEAL = "#4BB8A9", CORAL = "#F26D5B", AMBER = "#E0A63F", SLATE = "#6B7CA6";
const INK = "#EAE6F2", MUTED = "#9C93B3", GRID = "#2A2142", DEEP = "#0E0A16";

const esc = (s: any) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const pc = (x: number, d = 1) => `${x < 0 ? "−" : ""}${(Math.abs(x) * 100).toFixed(d)}%`;
const sg = (x: number, d = 1) => `${x >= 0 ? "+" : "−"}${Math.abs(x).toFixed(d)}`;
const nf = (x: number) => Math.round(x).toLocaleString("en-US");

const cy = A.crawl.by_year;
const first = cy[0], last = cy[cy.length - 1];
const el = A.crawl.elasticity;
const attr = A.attr;
const pub = attr.publishers;
const dec = attr.tone_decomp;
const composition = dec.between + dec.entry + dec.exit;
const fp = attr.foreign_pulse.by_year;
const fpFirst = fp[0], fpLast = fp[fp.length - 1];
const foreignChange = fpLast.foreign / fpFirst.foreign - 1;
const af = attr.anchor_foreign;
const kanj = af.find((a: any) => a.day === "2022-10-01");
const prot25 = af.find((a: any) => a.day === "2025-08-28");
const g20a = af.find((a: any) => a.day === "2022-11-15");
const kanjA = A.anchors.find((a: any) => a.day === "2022-10-01");
const missed = af.filter((a: any) => (a.published_api_ratio ?? 0) < 1.5 && (a.foreign.ratio ?? 0) >= 1.5);
const flipped = af.filter((a: any) => ((a.published_api_ratio ?? 0) >= 1.5) !== ((a.foreign.ratio ?? 0) >= 1.5));
// a flip where both sides sit on the threshold is a coin-toss, not a finding
const marginal = (a: any) => Math.abs(a.published_api_ratio - 1.5) < 0.15 && Math.abs(a.foreign.ratio - 1.5) < 0.2;
const decisive = flipped.filter((a: any) => !marginal(a));
const WORDS = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
const word = (n: number) => WORDS[n] ?? String(n);
const antara = attr.stable_publishers.find((s: any) => s.site === "antaranews.com");
const coal = A.themes.rows.find((r: any) => r.key === "coal");

/* Published benchmarks, transcribed from the source tables. These are the only
   numbers on this page that do not come from the case's own data; each is quoted
   with its citation so it can be checked against the paper. */
const LIT = {
  gdelt_icews: 0.317,      // Wang et al. 2016, p.1502 — LatAm average, GDELT vs ICEWS
  gdelt_gsr: 0.222,        // Wang et al. 2016 — GDELT vs the human-coded ground truth
  acled_national: 0.64,    // Hammond & Weidmann 2014, p.3 — national time series
  acled_cell: 0.26,        // Hammond & Weidmann 2014, p.3 — 55 km cell-month
  tone_daily_hi: 0.82,     // GDELT's own dictionary comparison, 3 Nov 2019, daily aggregate
  tone_doc_hi: 0.50,       // ibid., document level, best of seven dictionaries
  protest_true: 0.21,      // Wang et al. 2016, p.1503 — share of valid protest URLs that are true protests
  redundancy: 0.206,       // Hong et al. 2025, Table 6 — semantic duplicate rate, US 2015-day sample
  acc_noneng: 0.532,       // Hong et al. 2025, Table 4 — event-type accuracy, non-English
  acc_eng: 0.562,          // ibid., English
  reported: 0.285,         // Weidmann 2016, p.211 — Afghan events with casualties reaching intl news
  asia_ratio: 43,          // Eisensee & Strömberg 2007, Table IX — casualties for equal coverage vs Europe
  olympics_ratio: 3,       // ibid., conclusions — casualties needed during the Olympics
  news_share_asia: 0.13,   // ibid., Table IX — share of Asian disasters covered
  news_share_europe: 0.18, // ibid.
  idn_share_2015: 0.0112,  // Grasland 2020, Table 3 — Indonesia's share of international news, 31 dailies
  idn_rank_2015: 26,       // ibid.
  idn_r2_wu: 0.373,        // Wu 2000, Table 3 — adjusted R2 of Indonesia's own coverage model
  gdp_r: 0.895,            // Blondheim, Segev & Cabrera 2015 — country share of economic news vs GDP
  sheafer_vol: 0.09,       // Sheafer 2007, Table 1 — media salience coefficient
  sheafer_tone: -0.23,     // ibid. — media valence coefficient
  dict_alpha_hi: 0.34,     // van Atteveldt et al. 2021, Table 2 — best English dictionary on translated text
  wire_r2: 0.18,           // Kwak & An 2014, Table 1 — variance added by wire-service pickup
  disaster_reach: 1,       // ibid. — median number of countries a disaster's coverage reaches
};

/* ── Fig L · how well does this agree with anything? ─────────────────────── */
function figL() {
  const rows = [
    { k: "Event layer vs API volume, all", v: A.layers.rho_all, g: 0, s: "this case · Spearman, daily" },
    { k: "…translated feed only", v: A.layers.rho_trans, g: 0, s: "this case" },
    { k: "…English feed only", v: A.layers.rho_en, g: 0, s: "this case" },
    { k: "GDELT vs ACLED, national series", v: LIT.acled_national, g: 1, s: "Hammond & Weidmann 2014" },
    { k: "GDELT vs ICEWS, cross-national", v: LIT.gdelt_icews, g: 1, s: "Wang et al. 2016" },
    { k: "GDELT vs human-coded protests", v: LIT.gdelt_gsr, g: 1, s: "Wang et al. 2016" },
    { k: "GDELT vs ACLED, 55 km cell-month", v: LIT.acled_cell, g: 1, s: "Hammond & Weidmann 2014" },
    { k: "GDELT tone vs neural, daily mean", v: LIT.tone_daily_hi, g: 2, s: "GDELT, 2019 · best of seven" },
    { k: "GDELT tone vs neural, per article", v: LIT.tone_doc_hi, g: 2, s: "GDELT, 2019 · best of seven" },
  ];
  const W = 720, L = 244, R = 62, T = 44, rh = 27;
  const H = T + rows.length * rh + 30;
  const bw = W - L - R;
  const cols = [VIOLET, SLATE, TEAL];
  const body = rows.map((r, i) => {
    const y = T + i * rh;
    return `<text x="${L - 12}" y="${y + 12}" fill="${INK}" font-size="11.5" text-anchor="end">${esc(r.k)}</text>
      <text x="${L - 12}" y="${y + 23}" fill="${MUTED}" font-size="9" text-anchor="end">${esc(r.s)}</text>
      <rect x="${L}" y="${y + 4}" width="${(r.v * bw).toFixed(1)}" height="14" fill="${cols[r.g]}" rx="1.5" opacity="0.88"/>
      <text x="${(L + r.v * bw + 8).toFixed(1)}" y="${y + 15}" fill="${cols[r.g]}" font-size="11" font-family="var(--font-data)">${r.v.toFixed(2)}</text>`;
  }).join("");
  const thr = L + 0.6 * bw;
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="The case's own coherence check reaches 0.64 while GDELT agrees with an independent event dataset at only 0.32">
    <rect x="${L - 232}" y="12" width="11" height="11" fill="${VIOLET}" rx="2"/><text x="${L - 216}" y="22" fill="${MUTED}" font-size="10.5">inside this case — same crawl</text>
    <rect x="${L - 40}" y="12" width="11" height="11" fill="${SLATE}" rx="2"/><text x="${L - 24}" y="22" fill="${MUTED}" font-size="10.5">GDELT vs an independent dataset</text>
    <rect x="${L + 208}" y="12" width="11" height="11" fill="${TEAL}" rx="2"/><text x="${L + 224}" y="22" fill="${MUTED}" font-size="10.5">GDELT tone vs a better model</text>
    <line x1="${thr.toFixed(1)}" y1="${T - 4}" x2="${thr.toFixed(1)}" y2="${H - 24}" stroke="${AMBER}" stroke-dasharray="3 4" opacity="0.8"/>
    <text x="${thr.toFixed(1)}" y="${H - 8}" fill="${AMBER}" font-size="10" text-anchor="middle">the case's own 0.60 bar</text>
    ${body}
  </svg>`;
}

/* ── Fig 1 · three series, one crawl ─────────────────────────────────────── */
function fig1() {
  const W = 720, H = 360, L = 52, R = 158, T = 42, B = 46;
  const base = { mon: first.monitored, idn: first.idn, sh: first.share };
  const rows = cy.map((r: any) => ({
    y: r.year, mon: 100 * r.monitored / base.mon, idn: 100 * r.idn / base.idn, sh: 100 * r.share / base.sh }));
  const hi = 150, lo = 0;
  const sx = (i: number) => L + (i / (rows.length - 1)) * (W - L - R);
  const sy = (v: number) => H - B - ((v - lo) / (hi - lo)) * (H - T - B);
  const path = (k: string, col: string, w = 2.4) =>
    `<path fill="none" stroke="${col}" stroke-width="${w}" stroke-linejoin="round" d="${rows.map((r: any, i: number) =>
      `${i ? "L" : "M"}${sx(i).toFixed(1)} ${sy(r[k]).toFixed(1)}`).join("")}"/>` +
    rows.map((r: any, i: number) => `<circle cx="${sx(i).toFixed(1)}" cy="${sy(r[k]).toFixed(1)}" r="2.8" fill="${col}"/>`).join("");
  const end = (k: string, col: string, lab: string, dy: number) => {
    const v = rows[rows.length - 1][k];
    return `<text x="${(W - R + 10).toFixed(1)}" y="${(sy(v) + dy).toFixed(1)}" fill="${col}" font-size="11.5" font-family="var(--font-data)">${v.toFixed(0)}</text>` +
           `<text x="${(W - R + 44).toFixed(1)}" y="${(sy(v) + dy).toFixed(1)}" fill="${MUTED}" font-size="10.5">${esc(lab)}</text>`;
  };
  const gl = [0, 25, 50, 75, 100, 125, 150].map((v) =>
    `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="${v === 100 ? 1 : 0.5}" ${v === 100 ? 'stroke-dasharray="3 4"' : ""}/>
     <text x="${L - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">${v}</text>`).join("");
  const xt = rows.map((r: any, i: number) => i % 2 === 0
    ? `<text x="${sx(i).toFixed(1)}" y="${H - B + 18}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${String(r.y).slice(2)}</text>` : "").join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Indexed to 2017, the number of articles GDELT monitors falls 77 percent and Indonesia articles fall 71 percent while the published share rises 29 percent">
    <text x="${L}" y="18" fill="${MUTED}" font-size="11">Each series indexed to its own ${first.year} level = 100</text>
    ${gl}${xt}
    ${path("mon", SLATE)}${path("idn", INK, 1.8)}${path("sh", VIOLET, 2.8)}
    ${end("mon", SLATE, "all articles monitored", 4)}
    ${end("idn", INK, "articles naming Indonesia", -8)}
    ${end("sh", VIOLET, "the share the page charts", 4)}
  </svg>`;
}

/* ── Fig 2 · what the decade's rise is made of ───────────────────────────── */
function fig2() {
  const W = 720, H = 268, L = 258, R = 74, T = 26, rh = 46;
  const rows = [
    { k: "Articles naming Indonesia", s: "per day, GDELT's own count", v: A.crawl.idn_change, col: INK },
    { k: "All articles GDELT monitored", s: "per day — the denominator", v: A.crawl.monitored_change, col: SLATE },
    { k: "The share the dashboard charts", s: "the first divided by the second", v: A.crawl.share_change, col: VIOLET },
  ];
  const span = 0.85;
  const zx = L + (span / (span + 0.45)) * (W - L - R);
  const sx = (v: number) => zx + (v / (span + 0.45)) * (W - L - R);
  const body = rows.map((r, i) => {
    const y = T + i * rh, x0 = Math.min(zx, sx(r.v)), w = Math.abs(sx(r.v) - zx);
    const txt = `${r.v > 0 ? "+" : "−"}${Math.abs(r.v * 100).toFixed(1)}%`;
    // negative bars carry their label inside, so it can never reach the label column
    const inside = r.v < 0 && w > 70;
    const lx = inside ? x0 + 10 : (r.v < 0 ? x0 + w + 8 : x0 + w + 8);
    return `<text x="${L - 14}" y="${y + 17}" fill="${INK}" font-size="12.5" text-anchor="end">${esc(r.k)}</text>
      <text x="${L - 14}" y="${y + 31}" fill="${MUTED}" font-size="10" text-anchor="end">${esc(r.s)}</text>
      <rect x="${x0.toFixed(1)}" y="${y + 8}" width="${w.toFixed(1)}" height="19" fill="${r.col}" rx="2" opacity="0.92"/>
      <text x="${lx.toFixed(1)}" y="${y + 22}" fill="${inside ? DEEP : r.col}" font-size="12"
        text-anchor="start" font-family="var(--font-data)" font-weight="${inside ? 600 : 400}">${txt}</text>`;
  }).join("");
  const by = T + 3 * rh + 12;
  const a0 = el.attributable_lo, a1 = el.attributable_hi, am = el.attributable;
  const bx = (v: number) => L + v * (W - L - R);
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Indonesia articles fell 71 percent and monitored articles fell 77 percent, so the published share rose 29 percent">
    <line x1="${zx.toFixed(1)}" y1="${T}" x2="${zx.toFixed(1)}" y2="${T + 3 * rh - 8}" stroke="${GRID}"/>
    <text x="${zx.toFixed(1)}" y="${T - 8}" fill="${MUTED}" font-size="10" text-anchor="middle">no change</text>
    ${body}
    <line x1="${L - 240}" y1="${by}" x2="${W - R}" y2="${by}" stroke="${GRID}"/>
    <text x="${L - 240}" y="${by + 24}" fill="${MUTED}" font-size="11">Share of that rise predicted by the shrinking crawl alone</text>
    <rect x="${bx(0).toFixed(1)}" y="${by + 36}" width="${(bx(1) - bx(0)).toFixed(1)}" height="16" fill="${GRID}" rx="3"/>
    <rect x="${bx(a0).toFixed(1)}" y="${by + 36}" width="${(bx(a1) - bx(a0)).toFixed(1)}" height="16" fill="${AMBER}" opacity="0.35" rx="3"/>
    <line x1="${bx(am).toFixed(1)}" y1="${by + 32}" x2="${bx(am).toFixed(1)}" y2="${by + 56}" stroke="${AMBER}" stroke-width="2.4"/>
    <text x="${bx(am).toFixed(1)}" y="${by + 70}" fill="${AMBER}" font-size="12" text-anchor="middle" font-family="var(--font-data)">${(am * 100).toFixed(0)}% (${(a0 * 100).toFixed(0)}–${(a1 * 100).toFixed(0)}%)</text>
  </svg>`;
}

/* ── Fig 3 · every anchor spike, split into coverage and news hole ───────── */
function fig3() {
  const rows = A.anchors;
  const W = 720, L = 214, R = 74, T = 34, rh = 30;
  const H = T + rows.length * rh + 34;
  const parts = rows.map((r: any) => ({ n: Math.log(r.numer), d: Math.log(r.denom) }));
  const lo = Math.min(0, ...parts.map((p: any) => Math.min(p.n, p.n + p.d, p.d)));
  const hi = Math.max(...parts.map((p: any) => Math.max(p.n, p.n + p.d)));
  const pad = (hi - lo) * 0.06;
  const sx = (v: number) => L + ((v - lo + pad) / (hi - lo + 2 * pad)) * (W - L - R);
  const zx = sx(0);
  const body = rows.map((r: any, i: number) => {
    const p = parts[i], y = T + i * rh;
    const seg = (from: number, to: number, col: string) =>
      `<rect x="${Math.min(sx(from), sx(to)).toFixed(1)}" y="${y + 5}" width="${Math.abs(sx(to) - sx(from)).toFixed(1)}" height="16" fill="${col}" rx="1.5" opacity="0.9"/>`;
    return `<text x="${L - 12}" y="${y + 13}" fill="${INK}" font-size="11.5" text-anchor="end">${esc(r.label)}</text>
      <text x="${L - 12}" y="${y + 25}" fill="${MUTED}" font-size="9.5" text-anchor="end" font-family="var(--font-data)">${esc(r.peak_day)} · ${esc(r.dow)}</text>
      ${seg(0, p.n, VIOLET)}${seg(p.n, p.n + p.d, AMBER)}
      <text x="${(W - R + 10)}" y="${y + 18}" fill="${r.ratio >= 1.5 ? INK : MUTED}" font-size="11.5" font-family="var(--font-data)">${r.ratio.toFixed(2)}×</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Each anchor's attention spike split into more Indonesia coverage and a smaller world crawl">
    <rect x="${L - 200}" y="8" width="11" height="11" fill="${VIOLET}" rx="2"/><text x="${L - 184}" y="18" fill="${MUTED}" font-size="11">more coverage of Indonesia</text>
    <rect x="${L + 24}" y="8" width="11" height="11" fill="${AMBER}" rx="2"/><text x="${L + 40}" y="18" fill="${MUTED}" font-size="11">a smaller world news crawl</text>
    <text x="${W - R + 10}" y="18" fill="${MUTED}" font-size="10">published</text>
    <line x1="${zx.toFixed(1)}" y1="${T - 4}" x2="${zx.toFixed(1)}" y2="${H - 28}" stroke="${GRID}"/>
    ${body}
    <text x="${zx.toFixed(1)}" y="${H - 10}" fill="${MUTED}" font-size="10.5" text-anchor="middle">baseline</text>
    <text x="${W - R}" y="${H - 10}" fill="${MUTED}" font-size="10.5" text-anchor="end">log contribution to the published attention ratio →</text>
  </svg>`;
}

/* ── Fig 4 · the thirty loudest days ─────────────────────────────────────── */
function fig4() {
  const W = 720, H = 420, L = 62, R = 34, T = 34, B = 82;
  const pts = A.spikes.top;
  const lx = pts.map((p: any) => Math.log(p.numer)), ly = pts.map((p: any) => Math.log(p.denom));
  const x0 = Math.min(...lx) - 0.16, x1 = Math.max(...lx) + 0.16;
  const y0 = Math.min(...ly, -0.12) - 0.05, y1 = Math.max(...ly) + 0.18;
  const sx = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
  const sy = (v: number) => H - B - ((v - y0) / (y1 - y0)) * (H - T - B);
  const diag = [2, 3, 4].map((k) => {
    const c = Math.log(k);
    const ax = Math.max(x0, c - y1), bx = Math.min(x1, c - y0);
    if (bx <= ax) return "";
    return `<line x1="${sx(ax).toFixed(1)}" y1="${sy(c - ax).toFixed(1)}" x2="${sx(bx).toFixed(1)}" y2="${sy(c - bx).toFixed(1)}" stroke="${GRID}" stroke-dasharray="2 5"/>
      <text x="${(sx(ax) + 5).toFixed(1)}" y="${(sy(c - ax) + 12).toFixed(1)}" fill="${MUTED}" font-size="9.5" font-family="var(--font-data)">${k}×</text>`;
  }).join("");
  const dots = pts.map((p: any) => {
    const wk = p.dow === "Sat" || p.dow === "Sun" || p.dow === "Mon";
    return `<circle class="dd" cx="${sx(Math.log(p.numer)).toFixed(1)}" cy="${sy(Math.log(p.denom)).toFixed(1)}" r="${wk ? 6 : 4.6}"
      fill="${wk ? VIOLET : SLATE}" opacity="${wk ? 0.85 : 0.7}" data-d="${esc(p.day)}" data-w="${esc(p.dow)}"
      data-s="${p.share.toFixed(2)}" data-n="${p.numer.toFixed(2)}" data-m="${p.denom.toFixed(2)}"/>`;
  }).join("");
  const tickx = [-0.4, -0.2, 0, 0.4, 0.8, 1.2].filter((v) => v > x0 && v < x1).map((v) =>
    `<text x="${sx(v).toFixed(1)}" y="${H - B + 17}" fill="${MUTED}" font-size="10" text-anchor="middle">${Math.exp(v).toFixed(1)}×</text>`).join("");
  const ticky = [0, 0.3, 0.6, 0.9, 1.2].filter((v) => v > y0 && v < y1).map((v) =>
    `<text x="${L - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">${Math.exp(v).toFixed(1)}×</text>`).join("");
  // call out the single most denominator-driven day in the top thirty
  const worst = pts.reduce((a: any, b: any) => (b.numer < a.numer ? b : a), pts[0]);
  const wx = sx(Math.log(worst.numer)), wy = sy(Math.log(worst.denom));
  const note = `<line x1="${(wx + 9).toFixed(1)}" y1="${wy.toFixed(1)}" x2="${(wx + 42).toFixed(1)}" y2="${wy.toFixed(1)}" stroke="${AMBER}" stroke-width="1.2"/>
    <text x="${(wx + 48).toFixed(1)}" y="${(wy - 3).toFixed(1)}" fill="${AMBER}" font-size="10" font-family="var(--font-data)">${esc(worst.day)} · share ${worst.share.toFixed(2)}%</text>
    <text x="${(wx + 48).toFixed(1)}" y="${(wy + 10).toFixed(1)}" fill="${AMBER}" font-size="10">Indonesia coverage ${worst.numer.toFixed(2)}× · crawl ${worst.denom.toFixed(1)}× smaller</text>`;
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Of the thirty loudest days, twenty-four fall on a Saturday, Sunday or Monday">
    <line x1="${L}" y1="${sy(0).toFixed(1)}" x2="${W - R}" y2="${sy(0).toFixed(1)}" stroke="${GRID}"/>
    <line x1="${sx(0).toFixed(1)}" y1="${T}" x2="${sx(0).toFixed(1)}" y2="${H - B}" stroke="${GRID}"/>
    ${diag}${tickx}${ticky}${note}${dots}
    <text x="${L}" y="${T - 14}" fill="${MUTED}" font-size="10">↑ world crawl smaller than usual · → Indonesia covered more than usual · dotted: equal published ratio</text>
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${H - B + 36}" fill="${MUTED}" font-size="11" text-anchor="middle">Indonesia coverage vs its own trailing median →</text>
    <g><circle cx="${L + 14}" cy="${H - 18}" r="6" fill="${VIOLET}" opacity="0.85"/><text x="${L + 26}" y="${H - 14}" fill="${MUTED}" font-size="10.5">Sat / Sun / Mon (${A.spikes.weekend_mon} of ${A.spikes.n_top})</text>
       <circle cx="${L + 236}" cy="${H - 18}" r="4.6" fill="${SLATE}" opacity="0.7"/><text x="${L + 246}" y="${H - 14}" fill="${MUTED}" font-size="10.5">Tue–Fri (${A.spikes.n_top - A.spikes.weekend_mon})</text></g>
  </svg>`;
}

/* ── Fig 5 · who publishes "the world's news about Indonesia" ─────────────── */
function fig5() {
  const rows = pub.top;
  const W = 720, L = 172, R = 78, T = 30, rh = 20;
  const H = T + rows.length * rh + 26;
  const max = Math.max(...rows.map((r: any) => r.share));
  const bw = W - L - R;
  const body = rows.map((r: any, i: number) => {
    const y = T + i * rh, w = (r.share / max) * bw;
    const state = r.site === "antaranews.com" || r.site === "rri.co.id";
    return `<text x="${L - 10}" y="${y + 14}" fill="${r.origin === "indonesia" ? INK : TEAL}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">${esc(r.site)}</text>
      <rect class="pb" x="${L}" y="${y + 4}" width="${w.toFixed(1)}" height="12" rx="1.5"
        fill="${r.origin === "indonesia" ? VIOLET : TEAL}" opacity="${state ? 1 : 0.72}"
        data-s="${esc(r.site)}" data-n="${nf(r.n)}" data-p="${(r.share * 100).toFixed(2)}" data-t="${r.tone.toFixed(2)}"/>
      ${state ? `<rect x="${(L + w + 5).toFixed(1)}" y="${y + 6}" width="8" height="8" fill="${AMBER}" rx="1.5"/>` : ""}
      <text x="${(L + w + (state ? 18 : 7)).toFixed(1)}" y="${y + 14}" fill="${MUTED}" font-size="10" font-family="var(--font-data)">${(r.share * 100).toFixed(2)}%</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Twenty-three of the twenty-five largest publishers are based in Indonesia">
    <rect x="${L}" y="8" width="11" height="11" fill="${VIOLET}" rx="2"/><text x="${L + 16}" y="18" fill="${MUTED}" font-size="11">published in Indonesia</text>
    <rect x="${L + 168}" y="8" width="11" height="11" fill="${TEAL}" rx="2"/><text x="${L + 184}" y="18" fill="${MUTED}" font-size="11">published abroad</text>
    <rect x="${L + 316}" y="8" width="11" height="11" fill="${AMBER}" rx="2"/><text x="${L + 332}" y="18" fill="${MUTED}" font-size="11">Indonesian state media</text>
    ${body}
    <text x="${W - R}" y="${H - 6}" fill="${MUTED}" font-size="10.5" text-anchor="end">share of all ${nf(pub.n_rows)} Indonesia events kept →</text>
  </svg>`;
}

/* ── Fig 6 · two attention series that point opposite ways ────────────────── */
function fig6() {
  const W = 720, H = 320, L = 52, R = 176, T = 40, B = 46;
  const rows = fp.map((r: any, i: number) => ({
    y: r.year, f: 100 * r.foreign / fpFirst.foreign,
    a: 100 * cy[i].share / first.share }));
  const hi = 150, lo = 50;
  const sx = (i: number) => L + (i / (rows.length - 1)) * (W - L - R);
  const sy = (v: number) => H - B - ((v - lo) / (hi - lo)) * (H - T - B);
  const line = (k: string, col: string) =>
    `<path fill="none" stroke="${col}" stroke-width="2.6" d="${rows.map((r: any, i: number) =>
      `${i ? "L" : "M"}${sx(i).toFixed(1)} ${sy(r[k]).toFixed(1)}`).join("")}"/>` +
    rows.map((r: any, i: number) => `<circle cx="${sx(i).toFixed(1)}" cy="${sy(r[k]).toFixed(1)}" r="3" fill="${col}"/>`).join("");
  const gl = [50, 75, 100, 125, 150].map((v) =>
    `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="${v === 100 ? 1 : 0.5}" ${v === 100 ? 'stroke-dasharray="3 4"' : ""}/>
     <text x="${L - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">${v}</text>`).join("");
  const xt = rows.map((r: any, i: number) => i % 2 === 0
    ? `<text x="${sx(i).toFixed(1)}" y="${H - B + 18}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${String(r.y).slice(2)}</text>` : "").join("");
  const lastRow = rows[rows.length - 1];
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="The published attention share rises 29 percent while foreign-published coverage of Indonesia falls 28 percent">
    <text x="${L}" y="18" fill="${MUTED}" font-size="11">Both indexed to ${first.year} = 100</text>
    ${gl}${xt}${line("a", VIOLET)}${line("f", TEAL)}
    <text x="${(W - R + 10).toFixed(1)}" y="${(sy(lastRow.a) - 4).toFixed(1)}" fill="${VIOLET}" font-size="11.5" font-family="var(--font-data)">${lastRow.a.toFixed(0)}</text>
    <text x="${(W - R + 10).toFixed(1)}" y="${(sy(lastRow.a) + 12).toFixed(1)}" fill="${MUTED}" font-size="10">the published share</text>
    <text x="${(W - R + 10).toFixed(1)}" y="${(sy(lastRow.f) - 4).toFixed(1)}" fill="${TEAL}" font-size="11.5" font-family="var(--font-data)">${lastRow.f.toFixed(0)}</text>
    <text x="${(W - R + 10).toFixed(1)}" y="${(sy(lastRow.f) + 12).toFixed(1)}" fill="${MUTED}" font-size="10">coverage published</text>
    <text x="${(W - R + 10).toFixed(1)}" y="${(sy(lastRow.f) + 25).toFixed(1)}" fill="${MUTED}" font-size="10">outside Indonesia</text>
  </svg>`;
}

/* ── Fig 7 · the anchors, re-tested on foreign publishers only ────────────── */
function fig7() {
  const W = 720, L = 208, R = 96, T = 34, rh = 30;
  const H = T + af.length * rh + 32;
  const vals = af.flatMap((a: any) => [a.published_api_ratio ?? 1, a.foreign.ratio ?? 1]);
  const lo = Math.log(Math.min(...vals) * 0.9), hi = Math.log(Math.max(...vals) * 1.08);
  const sx = (v: number) => L + ((Math.log(v) - lo) / (hi - lo)) * (W - L - R);
  const body = af.map((a: any, i: number) => {
    const y = T + i * rh + 14;
    const p = a.published_api_ratio, f = a.foreign.ratio;
    const col = f > p ? TEAL : CORAL;
    return `<text x="${L - 12}" y="${y - 2}" fill="${INK}" font-size="11.5" text-anchor="end">${esc(a.label)}</text>
      <text x="${L - 12}" y="${y + 10}" fill="${MUTED}" font-size="9.5" text-anchor="end" font-family="var(--font-data)">${esc(a.day)}</text>
      <line x1="${sx(p).toFixed(1)}" y1="${y}" x2="${sx(f).toFixed(1)}" y2="${y}" stroke="${col}" stroke-width="2" opacity="0.55"/>
      <circle cx="${sx(p).toFixed(1)}" cy="${y}" r="4" fill="${SLATE}"/>
      <circle cx="${sx(f).toFixed(1)}" cy="${y}" r="6.5" fill="${col}"/>
      <text x="${W - R + 10}" y="${y + 4}" fill="${col}" font-size="11" font-family="var(--font-data)">${f.toFixed(2)}×</text>`;
  }).join("");
  const thr = sx(1.5), one = sx(1);
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Re-running each anchor on foreign publishers only changes four failed verdicts to large spikes and turns one passed verdict into a fall">
    <circle cx="${L - 190}" cy="14" r="4" fill="${SLATE}"/><text x="${L - 180}" y="18" fill="${MUTED}" font-size="11">published, all publishers</text>
    <circle cx="${L + 20}" cy="14" r="6.5" fill="${TEAL}"/><text x="${L + 32}" y="18" fill="${MUTED}" font-size="11">foreign publishers only</text>
    <line x1="${one.toFixed(1)}" y1="${T}" x2="${one.toFixed(1)}" y2="${H - 26}" stroke="${GRID}"/>
    <line x1="${thr.toFixed(1)}" y1="${T}" x2="${thr.toFixed(1)}" y2="${H - 26}" stroke="${AMBER}" stroke-dasharray="3 4" opacity="0.75"/>
    <text x="${thr.toFixed(1)}" y="${H - 10}" fill="${AMBER}" font-size="10" text-anchor="middle">1.5× threshold</text>
    <text x="${one.toFixed(1)}" y="${H - 10}" fill="${MUTED}" font-size="10" text-anchor="middle">no change</text>
    ${body}
  </svg>`;
}

/* ── Fig 8 · where the warming came from ─────────────────────────────────── */
function fig8() {
  const W = 720, H = 300, T = 54, B = 74, L = 40, R = 30;
  const steps = [
    { k: `${dec.year_a} tone`, v: dec.T_a, abs: true, col: SLATE },
    { k: "same outlets,", k2: "warmer copy", v: dec.within, col: VIOLET },
    { k: "survivors", k2: "reweighted", v: dec.between, col: AMBER },
    { k: "new outlets", k2: "arriving", v: dec.entry, col: AMBER },
    { k: "outlets that", k2: "dropped out", v: dec.exit, col: AMBER },
    { k: `${dec.year_b} tone`, v: dec.T_b, abs: true, col: SLATE },
  ];
  const lo = -1.6, hi = 0.35;
  const sy = (v: number) => H - B - ((v - lo) / (hi - lo)) * (H - T - B);
  const bw = (W - L - R) / steps.length;
  let run = 0;
  const links: string[] = [];
  const body = steps.map((s: any, i: number) => {
    const x = L + i * bw + bw * 0.18, w = bw * 0.64;
    let y0v: number, y1v: number;
    if (s.abs) { y0v = 0; y1v = s.v; run = s.v; }
    else { y0v = run; y1v = run + s.v; run = y1v; }
    const yTop = sy(Math.max(y0v, y1v)), yBot = sy(Math.min(y0v, y1v));
    const h = Math.max(3, yBot - yTop);
    const lab = s.abs ? s.v.toFixed(2) : sg(s.v, 3);
    // connector from this bar's running total to the next bar's start
    if (i < steps.length - 1) {
      links.push(`<line x1="${x.toFixed(1)}" y1="${sy(run).toFixed(1)}" x2="${(x + bw).toFixed(1)}" y2="${sy(run).toFixed(1)}" stroke="${GRID}" stroke-dasharray="2 3"/>`);
    }
    return `<rect x="${x.toFixed(1)}" y="${yTop.toFixed(1)}" width="${w.toFixed(1)}" height="${h.toFixed(1)}" fill="${s.col}" rx="2" opacity="0.92"/>
      <text x="${(x + w / 2).toFixed(1)}" y="${(yTop - 7).toFixed(1)}" fill="${s.col}" font-size="11.5" text-anchor="middle" font-family="var(--font-data)">${lab}</text>
      <text x="${(x + w / 2).toFixed(1)}" y="${H - B + 18}" fill="${INK}" font-size="10.5" text-anchor="middle">${esc(s.k)}</text>
      ${s.k2 ? `<text x="${(x + w / 2).toFixed(1)}" y="${H - B + 31}" fill="${INK}" font-size="10.5" text-anchor="middle">${esc(s.k2)}</text>` : ""}`;
  }).join("");
  const cx0 = L + 2 * bw + bw * 0.1, cx1 = L + 5 * bw - bw * 0.1;
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Two thirds of the tone rise is the same outlets writing more warmly, one third is a change of which outlets GDELT reads">
    ${[0, -0.5, -1, -1.5].map((v) => `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="${v === 0 ? 1 : 0.5}"/>
      <text x="${L - 6}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="9.5" text-anchor="end" font-family="var(--font-data)">${v === 0 ? "0" : v.toFixed(1)}</text>`).join("")}
    ${links.join("")}${body}
    <path d="M${cx0.toFixed(1)} ${T - 22} L${cx0.toFixed(1)} ${T - 30} L${cx1.toFixed(1)} ${T - 30} L${cx1.toFixed(1)} ${T - 22}" fill="none" stroke="${AMBER}" stroke-width="1.3"/>
    <text x="${((cx0 + cx1) / 2).toFixed(1)}" y="${T - 36}" fill="${AMBER}" font-size="11" text-anchor="middle" font-family="var(--font-data)">source mix ${sg(composition, 3)} · ${(100 * composition / dec.delta).toFixed(0)}% of the move</text>
    <text x="${L + bw * 0.5}" y="${H - 12}" fill="${MUTED}" font-size="10" text-anchor="middle">start</text>
    <text x="${(L + 5.5 * bw).toFixed(1)}" y="${H - 12}" fill="${MUTED}" font-size="10" text-anchor="middle">end</text>
  </svg>`;
}

/* ── Fig 9 · the biggest continuous voices, and their own tone ────────────── */
function fig9() {
  const W = 720, H = 340, L = 52, R = 168, T = 26, B = 46;
  const yrs = attr.years;
  const shown = attr.stable_publishers.slice(0, 6);
  const agg = A.crawl.by_year.map((r: any) => r.ev_tone);
  const all = shown.flatMap((s: any) => s.tone).concat(agg.filter((v: any) => v != null));
  const lo = Math.min(...all) - 0.3, hi = Math.max(...all) + 0.3;
  const sx = (i: number) => L + (i / (yrs.length - 1)) * (W - L - R);
  const sy = (v: number) => H - B - ((v - lo) / (hi - lo)) * (H - T - B);
  const draw = (vals: number[], col: string, w: number, op: number) =>
    `<path fill="none" stroke="${col}" stroke-width="${w}" opacity="${op}" d="${vals.map((v, i) =>
      `${i ? "L" : "M"}${sx(i).toFixed(1)} ${sy(v).toFixed(1)}`).join("")}"/>`;
  const others = shown.filter((s: any) => s.site !== "antaranews.com");
  const body = others.map((s: any) => draw(s.tone, SLATE, 1.6, 0.55)).join("")
    + draw(agg as number[], INK, 1.8, 0.85)
    + (antara ? draw(antara.tone, VIOLET, 3, 1) : "")
    + (antara ? antara.tone.map((v: number, i: number) => `<circle cx="${sx(i).toFixed(1)}" cy="${sy(v).toFixed(1)}" r="3.2" fill="${VIOLET}"/>`).join("") : "");
  // right-edge labels, nudged apart so none can sit on another
  const av0 = antara ? antara.tone[antara.tone.length - 1] : 0;
  const ag0 = agg[agg.length - 1] as number;
  const items = [
    { y: sy(av0), t: "antaranews.com", c: VIOLET, big: true, sub: `state wire · ${pc(pub.top.find((p: any) => p.site === "antaranews.com").share, 1)} of all rows` },
    { y: sy(ag0), t: "all publishers", c: INK, big: false, sub: "" },
    ...others.map((s: any) => ({ y: sy(s.tone[s.tone.length - 1]), t: s.site, c: MUTED, big: false, sub: "" })),
  ].sort((a, b) => a.y - b.y);
  for (let i = 1; i < items.length; i++) {
    const gap = items[i - 1].sub ? 30 : 15;      // the highlighted row carries a second line
    if (items[i].y - items[i - 1].y < gap) items[i].y = items[i - 1].y + gap;
  }
  const over = items[items.length - 1].y - (H - B);
  if (over > 0) items.forEach((it) => { it.y -= over; });
  const labs = items.map((it) =>
    `<text x="${(W - R + 8).toFixed(1)}" y="${(it.y + 3.5).toFixed(1)}" fill="${it.c}" font-size="${it.big ? 11 : 9.5}" font-family="var(--font-data)">${esc(it.t)}</text>` +
    (it.sub ? `<text x="${(W - R + 8).toFixed(1)}" y="${(it.y + 15).toFixed(1)}" fill="${MUTED}" font-size="9">${esc(it.sub)}</text>` : "")).join("");
  const gl = [-3, -2, -1, 0, 1].filter((v) => v > lo && v < hi).map((v) =>
    `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="${v === 0 ? 1 : 0.45}"/>
     <text x="${L - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">${sg(v, 0)}</text>`).join("");
  const xt = yrs.map((y: number, i: number) => i % 2 === 0
    ? `<text x="${sx(i).toFixed(1)}" y="${H - B + 18}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${String(y).slice(2)}</text>` : "").join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="The state news agency ANTARA's own tone rises from zero to plus one across the decade">
    ${gl}${xt}${body}${labs}
    <text x="${L}" y="${H - 10}" fill="${MUTED}" font-size="10.5">mean tone of every Indonesia event a publisher carried that year</text>
  </svg>`;
}

/* ── Fig 10 · loud and dark, at two resolutions ──────────────────────────── */
function fig10() {
  const W = 720, H = 300, T = 44, B = 62;
  const midX = 356;
  const d1 = A.loud_dark.deciles;
  const L1 = 46, R1 = midX - 24;
  const ext = Math.max(...d1.map((r: any) => Math.abs(r.tone))) * 1.25;
  const sy1 = (v: number) => (T + (H - T - B) / 2) - (v / ext) * ((H - T - B) / 2);
  const bw1 = (R1 - L1) / d1.length;
  const bars1 = d1.map((r: any, i: number) => {
    const x = L1 + i * bw1 + bw1 * 0.14, w = bw1 * 0.72;
    const y0 = sy1(0), y1 = sy1(r.tone);
    return `<rect x="${x.toFixed(1)}" y="${Math.min(y0, y1).toFixed(1)}" width="${w.toFixed(1)}" height="${Math.max(2, Math.abs(y1 - y0)).toFixed(1)}"
      fill="${r.tone < 0 ? CORAL : TEAL}" rx="1.5" opacity="${i === 9 ? 1 : 0.7}"/>`;
  }).join("");
  const yr = A.loud_dark.by_year;
  const L2 = midX + 46, R2 = W - 22;
  const ext2 = Math.max(...yr.map((r: any) => Math.abs(r.r)), Math.abs(A.loud_dark.monthly_r)) * 1.2;
  const sy2 = (v: number) => (T + (H - T - B) / 2) - (v / ext2) * ((H - T - B) / 2);
  const bw2 = (R2 - L2) / yr.length;
  const bars2 = yr.map((r: any, i: number) => {
    const x = L2 + i * bw2 + bw2 * 0.14, w = bw2 * 0.72;
    const y0 = sy2(0), y1 = sy2(r.r);
    return `<rect x="${x.toFixed(1)}" y="${Math.min(y0, y1).toFixed(1)}" width="${w.toFixed(1)}" height="${Math.max(2, Math.abs(y1 - y0)).toFixed(1)}"
      fill="${r.r < 0 ? CORAL : TEAL}" rx="1.5" opacity="0.8"/>
      <text x="${(x + w / 2).toFixed(1)}" y="${H - B + 16}" fill="${MUTED}" font-size="9" text-anchor="middle">${String(r.year).slice(2)}</text>`;
  }).join("");
  const mline = sy2(A.loud_dark.monthly_r);
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="The quietest and loudest days differ in tone; within every early year the correlation is negative while the monthly figure the page prints is positive">
    <text x="${L1}" y="18" fill="${INK}" font-size="11.5">Mean tone by attention decile, daily</text>
    <text x="${L1}" y="32" fill="${MUTED}" font-size="10">quietest tenth of days → loudest tenth</text>
    <line x1="${L1}" y1="${sy1(0).toFixed(1)}" x2="${R1}" y2="${sy1(0).toFixed(1)}" stroke="${GRID}"/>
    ${bars1}
    <text x="${(L1 + 9.5 * bw1).toFixed(1)}" y="${(sy1(d1[9].tone) + 14).toFixed(1)}" fill="${CORAL}" font-size="10.5" text-anchor="middle" font-family="var(--font-data)">${d1[9].tone.toFixed(2)}</text>
    <text x="${L1}" y="${H - B + 18}" fill="${MUTED}" font-size="10">quietest</text>
    <text x="${R1}" y="${H - B + 18}" fill="${MUTED}" font-size="10" text-anchor="end">loudest</text>
    <line x1="${midX}" y1="14" x2="${midX}" y2="${H - 34}" stroke="${GRID}"/>
    <text x="${L2}" y="18" fill="${INK}" font-size="11.5">Daily correlation of attention with tone, by year</text>
    <text x="${L2}" y="32" fill="${MUTED}" font-size="10">negative = louder days are darker</text>
    <line x1="${L2}" y1="${sy2(0).toFixed(1)}" x2="${R2}" y2="${sy2(0).toFixed(1)}" stroke="${GRID}"/>
    <line x1="${L2}" y1="${mline.toFixed(1)}" x2="${R2}" y2="${mline.toFixed(1)}" stroke="${VIOLET}" stroke-dasharray="4 4"/>
    <line x1="${R2 - 234}" y1="${T + 8}" x2="${R2 - 218}" y2="${T + 8}" stroke="${VIOLET}" stroke-dasharray="4 4"/>
    <text x="${R2 - 212}" y="${T + 12}" fill="${VIOLET}" font-size="10" font-family="var(--font-data)">monthly r ${sg(A.loud_dark.monthly_r, 2)} — what the page prints</text>
    ${bars2}
    <text x="${L2 - 8}" y="${(sy2(0) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">0</text>
    <text x="${L2 - 8}" y="${(sy2(-0.6) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">−0.6</text>
  </svg>`;
}

/* ── Fig 11 · what actually landed ───────────────────────────────────────── */
function fig11() {
  const rows = A.themes.rows;
  const missing = A.themes.n_requested - A.themes.n_landed;
  const W = 720, L = 156, R = 92, T = 30, rh = 22;
  const H = T + (rows.length + 1) * rh + 26;
  const bw = W - L - R;
  const full = A.themes.full_months;
  const body = rows.map((r: any, i: number) => {
    const y = T + i * rh, w = (r.months / full) * bw;
    const short = r.months < full - 12;
    return `<text x="${L - 10}" y="${y + 14}" fill="${short ? CORAL : INK}" font-size="11" text-anchor="end">${esc(r.label)}</text>
      <rect x="${L}" y="${y + 4}" width="${bw.toFixed(1)}" height="13" fill="${GRID}" rx="1.5" opacity="0.6"/>
      <rect x="${L}" y="${y + 4}" width="${w.toFixed(1)}" height="13" fill="${short ? CORAL : VIOLET}" rx="1.5" opacity="0.85"/>
      <text x="${(L + bw + 8).toFixed(1)}" y="${y + 14}" fill="${MUTED}" font-size="10" font-family="var(--font-data)">${r.months} mo · ${(r.share_mean * 100).toFixed(2)}%</text>`;
  }).join("");
  const y9 = T + rows.length * rh;
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Eleven of the twenty theme curves landed, and one of them holds only thirteen months">
    <text x="${L}" y="18" fill="${MUTED}" font-size="11">months of data out of ${full} in the window</text>
    ${body}
    <text x="${L - 10}" y="${y9 + 14}" fill="${MUTED}" font-size="11" text-anchor="end">${missing} never landed</text>
    <rect x="${L}" y="${y9 + 4}" width="${bw.toFixed(1)}" height="13" fill="${GRID}" rx="1.5" opacity="0.6"/>
    <text x="${(L + bw + 8).toFixed(1)}" y="${y9 + 14}" fill="${MUTED}" font-size="10" font-family="var(--font-data)">0 mo</text>
    <text x="${L}" y="${H - 6}" fill="${MUTED}" font-size="10">coral = window too short to compare against the others</text>
  </svg>`;
}

const FL = figL();
const F1 = fig1(), F2 = fig2(), F3 = fig3(), F4 = fig4(), F5 = fig5(), F6 = fig6();
const F7 = fig7(), F8 = fig8(), F9 = fig9(), F10 = fig10(), F11 = fig11();
---
<html lang="en" data-case="narrative" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Whose Attention? Measuring Indonesia in the World's News</title>
    <meta name="description" content="An adversarial review of a GDELT-derived attention, tone and theme index for Indonesia, 2017-2026: the denominator problem, the news-hole artefact, and who is actually speaking." />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" />
