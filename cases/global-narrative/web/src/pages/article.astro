    <script>
      /* Hover read-outs. Pure SVG + DOM, no GPU path anywhere. */
      const tip = document.getElementById("tip");
      const show = (html, e) => {
        tip.innerHTML = html; tip.hidden = false;
        const r = tip.getBoundingClientRect();
        let x = e.clientX + 14, y = e.clientY + 14;
        if (x + r.width > innerWidth - 8) x = e.clientX - r.width - 14;
        if (y + r.height > innerHeight - 8) y = e.clientY - r.height - 14;
        tip.style.left = x + "px"; tip.style.top = y + "px";
      };
      const hide = () => { tip.hidden = true; };
      document.querySelectorAll(".dd").forEach((el) => {
        el.addEventListener("mousemove", (e) => {
          const d = el.dataset;
          show(`<b>${d.d}</b> · ${d.w}<br>share of world news ${d.s}%<br>` +
               `Indonesia coverage ${d.n}× baseline<br>world crawl ${d.m}× smaller`, e);
        });
        el.addEventListener("mouseleave", hide);
      });
      document.querySelectorAll(".pb").forEach((el) => {
        el.addEventListener("mousemove", (e) => {
          const d = el.dataset;
          show(`<b>${d.s}</b><br>${d.n} events · ${d.p}% of the archive<br>mean tone ${d.t}`, e);
        });
        el.addEventListener("mouseleave", hide);
      });
    </script>
  
