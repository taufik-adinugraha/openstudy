        g.append("rect").attr("x", M.l).attr("y", 3).attr("height", BH - 7).attr("width", (d) => x(d.n) - M.l).attr("fill", (d) => (conflict(d.code) ? NEG : POS)).attr("rx", 2).attr("opacity", 0.85)
