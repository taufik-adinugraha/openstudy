        hoverRect(svg, M, W, H, (e) => { const i = nearestIdx(months, x.invert(d3.pointer(e)[0])); if (fs[i] == null) return; guide.style("display", null).attr("x1", x(months[i])).attr("x2", x(months[i])); showTip(e, `<b>${fMon(months[i])}</b><br>foreign ${d3.format(".0%")(fs[i])} · domestic ${d3.format(".0%")(1 - fs[i])}<br>tone: foreign ${sgn(p.foreign_tone?.[i])} · domestic ${sgn(p.domestic_tone?.[i])}`); }, () => { guide.style("display", "none"); hideTip(); });
      });

      sect("languages", () => {
