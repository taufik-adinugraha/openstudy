      sect("event map", () => {
        const canvas = document.getElementById("map-canvas"), note = document.getElementById("map-note"), tip = document.getElementById("map-tip");
        if (!map?.all?.length) { canvas.parentElement.insertAdjacentHTML("afterbegin", `<div class="pending">Event map pending — appears once the event layer has streamed.</div>`); canvas.style.display = "none"; return; }
        const ctx = canvas.getContext("2d"), dpr = devicePixelRatio || 1;
        const LAT = [-11.5, 6.5], LON = [94.5, 141.5];
        let mode = "n", year = "all", W, H, sx, sy, cellW, cellH, cells = map.all, index = new Map();
        const CITIES = [["Jakarta", -6.2, 106.85], ["Surabaya", -7.25, 112.75], ["Medan", 3.6, 98.67], ["Makassar", -5.13, 119.42], ["Denpasar", -8.65, 115.22], ["Jayapura", -2.53, 140.72], ["Palu", -0.9, 119.87], ["Banda Aceh", 5.55, 95.32], ["Balikpapan", -1.27, 116.83], ["Ambon", -3.7, 128.18], ["Kupang", -10.17, 123.6], ["Pontianak", -0.02, 109.34]];
        const size = () => { W = canvas.clientWidth; H = Math.round(W * (LAT[1] - LAT[0]) / (LON[1] - LON[0])); canvas.style.height = H + "px"; canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); sx = d3.scaleLinear(LON, [0, W]); sy = d3.scaleLinear(LAT, [H, 0]); cellW = sx(0.25) - sx(0); cellH = sy(0) - sy(0.25); };
        const setData = () => { cells = year === "all" ? map.all : (map.byYear[year] ?? []); index = new Map(cells.map((c) => [c[0] + "," + c[1], c])); };
        const draw = () => {
          ctx.fillStyle = GROUND; ctx.fillRect(0, 0, W, H);
          ctx.strokeStyle = HAIR; ctx.lineWidth = 0.5; ctx.beginPath();
          for (let lo = 95; lo <= 141; lo += 5) { ctx.moveTo(sx(lo), 0); ctx.lineTo(sx(lo), H); }
          for (let la = -10; la <= 5; la += 5) { ctx.moveTo(0, sy(la)); ctx.lineTo(W, sy(la)); }
          ctx.stroke();
          const nmax = d3.quantile(cells.map((c) => c[2]).sort(d3.ascending), 0.995) || 1;
          const pmax = d3.quantile(cells.map((c) => c[4]).sort(d3.ascending), 0.995) || 1;
          const cN = d3.scaleSequentialLog([1, nmax], d3.interpolateRgb("#2A1B45", VIOLET)).clamp(true);
          const cP = d3.scaleSequentialSqrt([0, pmax], d3.interpolateRgb("#2A1B45", NEG)).clamp(true);
          const cT = d3.scaleDiverging([-6, -3, 0], [NEG, "#3A2F55", POS]).clamp(true);
          for (const c of cells) {
            const [lat, lon, n, t, p] = c;
            ctx.fillStyle = mode === "n" ? cN(n) : mode === "protest" ? (p ? cP(p) : "#1B1430") : (t == null ? "#1B1430" : cT(t));
            ctx.fillRect(sx(lon - 0.125), sy(lat + 0.125), Math.max(1, cellW - 0.4), Math.max(1, cellH - 0.4));
          }
          ctx.fillStyle = INK; ctx.font = "12px 'IBM Plex Mono', monospace"; ctx.globalAlpha = 0.85;
          for (const [name, la, lo] of CITIES) { ctx.beginPath(); ctx.arc(sx(lo), sy(la), 1.6, 0, Math.PI * 2); ctx.fill(); ctx.textAlign = sx(lo) > W - 80 ? "right" : "left"; ctx.fillText(name, sx(lo) + (sx(lo) > W - 80 ? -5 : 5), sy(la) - 4); ctx.textAlign = "left"; }
          ctx.globalAlpha = 1;
          ctx.fillStyle = MUTED; ctx.font = "12px 'IBM Plex Mono', monospace";
          ctx.fillText(mode === "n" ? "colour: events per cell (log)" : mode === "protest" ? "colour: protest events per cell" : "colour: mean tone (coral −6 … teal 0)", 10, H - 10);
          note.textContent = `${d3.sum(cells, (c) => c[2]).toLocaleString()} LOCATED EVENTS IN ${cells.length.toLocaleString()} CELLS${year === "all" ? ` · ${map.country_level_only?.toLocaleString()} MORE GEOCODED ONLY TO “INDONESIA” (NOT SHOWN)` : ` · ${year}`}`;
        };
        size(); setData(); draw();
        addEventListener("resize", () => { size(); draw(); });
        const nameOf = (c) => (c[5] ? c[5].split(",")[0] : `${c[0].toFixed(2)}, ${c[1].toFixed(2)}`);
        canvas.addEventListener("mousemove", (e) => {
          const r = canvas.getBoundingClientRect(); const lon = sx.invert(e.clientX - r.left), lat = sy.invert(e.clientY - r.top);
          const key = (Math.round(lat * 4) / 4) + "," + (Math.round(lon * 4) / 4);
          const c = index.get(key); const all = map.all.find((a) => a[0] + "," + a[1] === key);
          if (!c) { tip.hidden = true; return; }
          tip.hidden = false; tip.style.left = e.clientX - r.left + 14 + "px"; tip.style.top = e.clientY - r.top + 14 + "px";
          tip.innerHTML = `<b>${all ? nameOf(all) : nameOf(c)}</b><br>${c[2].toLocaleString()} events${year === "all" ? "" : " in " + year} · ${c[4]} protest<br>mean tone ${sgn(c[3], 1)}`;
        });
        canvas.addEventListener("mouseleave", () => { tip.hidden = true; });
        document.querySelectorAll("#map-mode button").forEach((b) => b.addEventListener("click", () => { mode = b.dataset.mode; document.querySelectorAll("#map-mode button").forEach((q) => q.classList.toggle("on", q === b)); draw(); }));
        const yb = document.getElementById("map-years");
        yb.innerHTML = `<button data-y="all" class="on">ALL</button>` + map.years.map((y) => `<button data-y="${y}">${y}</button>`).join("");
        yb.querySelectorAll("button").forEach((b) => b.addEventListener("click", () => { year = b.dataset.y; yb.querySelectorAll("button").forEach((q) => q.classList.toggle("on", q === b)); setData(); draw(); }));
      });

