        if (idn) svg.append("text").attr("class", "annot").attr("x", W - M.r).attr("y", 14).attr("text-anchor", "end").text(`Indonesia’s own press: ${pct(idn.mean, 1)} of its output — shown below, not here.`);
      });

      sect("press split", () => {
        const el = document.getElementById("press-chart");
