        g.selectAll("rect").data((d) => d.values.map((v, i) => ({ v, i, name: d.name }))).join("rect")
          .attr("x", (c) => x(months[c.i])).attr("y", 1).attr("width", Math.max(1, cw - 0.5)).attr("height", RH - 2).attr("fill", (c) => (c.v == null ? GROUND : color(c.v)))
          .on("mousemove", (e, c) => showTip(e, `<b>${c.name}</b> · ${fMon(months[c.i])}<br>${pct(c.v, 2)} of its monitored articles mention Indonesia`))
          .on("mouseleave", hideTip);
