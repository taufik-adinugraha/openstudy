        svg.append("path").datum(months).attr("d", d3.area().defined((d, i) => fs[i] != null).x((d) => x(d)).y0((d, i) => y(fs[i])).y1(M.t).curve(d3.curveMonotoneX)).attr("fill", MUTED).attr("opacity", 0.12);
        svg.append("path").datum(months).attr("d", d3.line().defined((d, i) => fs[i] != null).x((d) => x(d)).y((d, i) => y(fs[i])).curve(d3.curveMonotoneX)).attr("fill", "none").attr("stroke", VIOLET).attr("stroke-width", 1.6);
        svg.append("text").attr("class", "annot").attr("x", M.l + 6).attr("y", M.t + 10).text("domestic press (sourcecountry:ID)");
        svg.append("text").attr("class", "annot").attr("x", M.l + 6).attr("y", H - M.b - 8).attr("fill", VIOLET).text("foreign press share");
