      sect("gates", () => {
        const el = document.getElementById("gates");
        const stats = status?.gates ? status : null;
        if (!stats) { el.innerHTML = `<div class="pending">Gate results appear after <code>make validate</code>.</div>`; return; }
        load("stats.json").then((s) => {
          const g = s.gates ?? {};
          const V = (v) => `<span class="verdict ${v}">${v}</span>`;
          const d1 = g["G-D1"] ?? {}, d3g = g["G-D3"] ?? {}, d4 = g["G-D4"] ?? {}, d2 = g["G-D2"] ?? {};
          el.innerHTML = `
            <div class="gate">${V(d1.verdict)}<div><b>Normalization honesty.</b> Crawl size drifts <b>${num(d1.crawl_size_drift_max_over_min, 2)}×</b> across years (${Object.entries(d1.monitored_articles_per_day_by_year ?? {}).map(([y, v]) => `${y}: ${d3.format(".2s")(v)}`).join(" · ")} articles/day). All attention charts are shares.</div></div>
            <div class="gate">${V(d2.verdict)}<div><b>Anchor events.</b> ${d2.pass ?? 0} pass · ${d2.fail ?? 0} fail · ${d2.pending ?? 0} pending of ${d2.anchors?.length ?? 0}, each against a trailing ${d2.baseline_days}-day baseline.
              <br><span class="caution">Read the attention column with care: it is a share, so a quiet world news day inflates it. Our review recomputes every one of these on foreign publishers only and ${el.dataset.flipped || "several"} of them change verdict.</span>
              <div class="table-scroll"><table class="rank small anchors"><thead><tr><th>Anchor</th><th>Attention ×</th><th>Δ tone</th><th>Protest ×</th><th>Verdict</th></tr></thead><tbody>${(d2.anchors ?? []).map((a) => { const s = a.signatures; const mark = (k) => (a.gated?.includes(k) ? (s[k].verdict === "PASS" ? "✓" : s[k].verdict === "FAIL" ? "✗" : "…") : "<i>info</i>"); const th = a.gated?.find((k) => k.startsWith("theme_")); return `<tr><td>${a.day} · ${a.label}</td><td class="num">${s.attention ? `${num(s.attention.ratio, 1)} ${mark("attention")}` : "—"}${th && s[th] ? `<br><i>${th.replace("theme_", "")} ${s[th].ratio != null ? num(s[th].ratio, 1) + "×" : "…"} ${mark(th)}</i>` : ""}</td><td class="num">${s.tone_drop ? `${sgn(-s.tone_drop.delta)} ${s.tone_drop.verdict === "PASS" ? "✓" : s.tone_drop.verdict === "FAIL" ? "✗" : "…"}` : a.report_only?.tone_rise ? `<i>${sgn(a.report_only.tone_rise.delta)} (report only)</i>` : "—"}</td><td class="num">${s.protest ? `${num(s.protest.ratio, 1)} ${s.protest.verdict === "PASS" ? "✓" : s.protest.verdict === "FAIL" ? "✗" : "…"}` : "—"}</td><td>${V(a.verdict)}</td></tr>`; }).join("")}</tbody></table></div></div></div>
            <div class="gate">${V(d3g.verdict)}<div><b>Two-source coherence.</b> Event-layer Indonesia share (own denominator) vs the API’s normalized volume: Spearman ρ = <b>${d3g.share_all?.spearman_rho ?? "pending"}</b> over ${d3g.share_all?.n_days ?? 0} shared days (threshold ${d3g.threshold}).${d3g.share_en ? ` English feed ρ ${d3g.share_en.spearman_rho ?? "—"}, translated ρ ${d3g.share_trans?.spearman_rho ?? "—"}.` : ""}</div></div>
            <div class="gate">${V(d4.verdict)}<div><b>Language honesty.</b> Foreign press carries <b>${d4.api_foreign_share_mean != null ? d3.format(".0%")(d4.api_foreign_share_mean) : "—"}</b> of Indonesia coverage; the translated (non-English) feed supplies <b>${d4.event_layer_translated_share != null ? d3.format(".0%")(d4.event_layer_translated_share) : "—"}</b> of kept events. Both are charted in chapter 04.</div></div>`;
        }).catch(() => { el.innerHTML = `<div class="pending">stats.json not exported yet.</div>`; });
      });

