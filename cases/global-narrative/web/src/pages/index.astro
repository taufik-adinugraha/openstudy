      /* ---------- methodology: raw vs normalized (G-D1) ---------- */
      sect("norm chart", () => {
        const el = document.getElementById("norm-chart");
        if (!pulse?.raw?.some((v) => v != null)) { pending("norm-chart", "Pending API curve TimelineVolRaw."); return; }
        const dates = pulse.dates.map(P);
        const sm = (arr, w = 28) => arr.map((v, i) => { const s = arr.slice(Math.max(0, i - w), i + 1).filter((q) => q != null); return s.length ? d3.mean(s) : null; });
        const raw = sm(pulse.raw), norm = sm(pulse.norm), vol = sm(pulse.vol);
        const M = { t: 18, r: 56, b: 30, l: 56 }, { svg, W, H } = mkSvg(el, 260);
        const x = d3.scaleTime(d3.extent(dates), [M.l, W - M.r]);
        const yN = d3.scaleLinear([0, d3.max(norm) * 1.1], [H - M.b, M.t]);
