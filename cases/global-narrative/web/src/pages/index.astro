        g.append("rect").attr("x", M.l).attr("y", 3).attr("height", BH - 8).attr("width", (d) => x(d.mean) - M.l).attr("fill", (d) => (d.name === "English" ? MUTED : VIOLET)).attr("rx", 2)
          .on("mousemove", (e, d) => showTip(e, `<b>${d.name}</b><br>${pct(d.mean, 2)} of monitored ${d.name} articles mention Indonesia`)).on("mouseleave", hideTip);
        g.append("text").attr("class", "annot").attr("x", (d) => x(d.mean) + 6).attr("y", BH / 2 + 4).text((d) => pct(d.mean, 2));
      });

      sect("outlets", () => {
        const el = document.getElementById("outlets");
        const o = sources?.outlets; if (!o?.en?.length) { el.innerHTML = `<div class="pending">Outlet league tables appear once the event layer has streamed.</div>`; return; }
        const table = (rows, title) => `<div><h3>${title}</h3><div class="table-scroll"><table class="rank small"><thead><tr><th>Outlet</th><th>Events</th><th>Tone</th></tr></thead><tbody>${rows.slice(0, 12).map((r) => `<tr><td>${r.domain}</td><td class="num">${r.n.toLocaleString()}</td><td class="num" style="color:${r.tone < -2 ? NEG : INK}">${sgn(r.tone, 1)}</td></tr>`).join("")}</tbody></table></div></div>`;
        el.innerHTML = table(o.en, "Most Indonesia events · English feed") + table(o.trans, "Most Indonesia events · translated feed");
      });

      /* ---------- chapter 5: event layer ---------- */
      const cov = events?.coverage;
      if (cov) {
        const st = document.getElementById("events-status");
        st.textContent = cov.days ? `${cov.rows?.toLocaleString()} INDONESIA EVENTS · ${cov.first} → ${cov.last} · ${cov.months_done.length}/${cov.months_total} MONTHS STREAMED${cov.complete ? "" : " · BACKFILL RUNNING (NEWEST FIRST)"} · TRANSLATED FEED ${d3.format(".0%")(cov.translated_share ?? 0)}`
          : "EVENT LAYER PENDING — the 15-minute feed is being streamed on the server.";
      }
      const monthsDone = new Set(cov?.months_done ?? []);
      const allMonths = d3.timeMonths(new Date(2017, 0, 1), new Date());
      const gapBands = (svg, x, M, H) => {
        const gaps = allMonths.filter((m) => !monthsDone.has(d3.timeFormat("%Y%m")(m)));
        svg.selectAll("rect.gap").data(gaps).join("rect").attr("class", "gap").attr("x", (m) => x(m)).attr("y", M.t).attr("width", (m) => Math.max(0, x(d3.timeMonth.offset(m, 1)) - x(m))).attr("height", H - M.t - M.b).attr("fill", "url(#hatch)").attr("opacity", 0.5);
        if (gaps.length) svg.append("text").attr("class", "annot").attr("x", x(gaps[Math.floor(gaps.length / 2)])).attr("y", M.t + 12).attr("text-anchor", "middle").text("not yet streamed");
      };
      const hatch = defs.append("pattern").attr("id", "hatch").attr("width", 6).attr("height", 6).attr("patternUnits", "userSpaceOnUse").attr("patternTransform", "rotate(45)");
      hatch.append("rect").attr("width", 6).attr("height", 6).attr("fill", SURFACE);
      hatch.append("line").attr("x1", 0).attr("y1", 0).attr("x2", 0).attr("y2", 6).attr("stroke", HAIR).attr("stroke-width", 2);

      sect("quad chart", () => {
        const el = document.getElementById("quad-chart");
        const m = events?.monthly; if (!m?.n_events) { pending("quad-chart", "Event layer pending — QuadClass mix appears as months stream in."); return; }
        const months = events.months.map(PM);
        const keys = ["quad_verbal_coop", "quad_material_coop", "quad_verbal_conflict", "quad_material_conflict"];
        const labels = { quad_verbal_coop: "verbal cooperation", quad_material_coop: "material cooperation", quad_verbal_conflict: "verbal conflict", quad_material_conflict: "material conflict" };
        const colors = { quad_verbal_coop: "#3E9E91", quad_material_coop: POS, quad_verbal_conflict: "#C9584A", quad_material_conflict: NEG };
        const rows = months.map((d, i) => { const tot = keys.reduce((s, k) => s + (m[k][i] ?? 0), 0) || 1; const r = { d, i, tot }; keys.forEach((k) => (r[k] = (m[k][i] ?? 0) / tot)); return r; });
        const M = { t: 18, r: 16, b: 30, l: 40 }, { svg, W, H } = mkSvg(el, 260);
        const x = d3.scaleTime([new Date(2017, 0, 1), d3.timeMonth.offset(allMonths.at(-1), 1)], [M.l, W - M.r]);
        const y = d3.scaleLinear([0, 1], [H - M.b, M.t]);
        gapBands(svg, x, M, H);
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - M.b})`).call(yearAxis(x));
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`).call(d3.axisLeft(y).ticks(4).tickFormat(d3.format(".0%")));
        const stack = d3.stack().keys(keys)(rows);
        svg.selectAll("g.s").data(stack).join("g").attr("class", "s").attr("fill", (s) => colors[s.key])
          .selectAll("rect").data((s) => s.map((d) => ({ ...d, key: s.key }))).join("rect")
          .attr("x", (d) => x(d.data.d) + 0.5).attr("width", (d) => Math.max(1, x(d3.timeMonth.offset(d.data.d, 1)) - x(d.data.d) - 1)).attr("y", (d) => y(d[1])).attr("height", (d) => Math.max(0, y(d[0]) - y(d[1])))
          .on("mousemove", (e, d) => showTip(e, `<b>${fMon(d.data.d)}</b> · ${d.data.tot.toLocaleString()} events<br>${keys.map((k) => `<span style="color:${colors[k]}">■</span> ${labels[k]} ${d3.format(".0%")(d.data[k])}`).join("<br>")}<br>Goldstein ${num(m.goldstein_mean?.[d.data.i], 2)} · tone ${sgn(m.tone_mean?.[d.data.i])}`))
          .on("mouseleave", hideTip);
        svg.append("text").attr("class", "annot").attr("x", W - M.r).attr("y", M.t - 5).attr("text-anchor", "end").text("teal = cooperation · coral = conflict · darker = words, brighter = deeds");
      });

      sect("protest chart", () => {
        const el = document.getElementById("protest-chart");
        const m = events?.monthly; if (!m?.protest_n) { pending("protest-chart", "Event layer pending."); return; }
        const months = events.months.map(PM);
        const dim = events.days_in_month;
        const vals = m.protest_n.map((v, i) => (v == null ? null : v / Math.max(1, dim[i]) * 30));   // per-30-days, so partial months compare
        const M = { t: 18, r: 16, b: 30, l: 44 }, { svg, W, H } = mkSvg(el, 240);
        const x = d3.scaleTime([new Date(2017, 0, 1), d3.timeMonth.offset(allMonths.at(-1), 1)], [M.l, W - M.r]);
        const y = d3.scaleLinear([0, d3.max(vals) * 1.15 || 1], [H - M.b, M.t]);
        gapBands(svg, x, M, H);
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - M.b})`).call(yearAxis(x));
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`).call(d3.axisLeft(y).ticks(4).tickFormat(d3.format("~s")));
        svg.append("text").attr("class", "annot").attr("x", M.l + 6).attr("y", M.t + 8).text("protest events per 30 days");
        svg.selectAll("rect.p").data(months.map((d, i) => ({ d, i }))).join("rect").attr("class", "p")
          .attr("x", (d) => x(d.d) + 0.5).attr("width", (d) => Math.max(1, x(d3.timeMonth.offset(d.d, 1)) - x(d.d) - 1)).attr("y", (d) => y(vals[d.i] ?? 0)).attr("height", (d) => H - M.b - y(vals[d.i] ?? 0)).attr("fill", VIOLET).attr("opacity", 0.85)
          .on("mousemove", (e, d) => showTip(e, `<b>${fMon(d.d)}</b><br>${m.protest_n[d.i]} protest events in ${dim[d.i]} days<br>${m.n_events[d.i]?.toLocaleString()} Indonesia events total`)).on("mouseleave", hideTip);
        const top = vals.map((v, i) => ({ v, i })).filter((d) => d.v != null).sort((a, b) => b.v - a.v);
        const picked = []; for (const t of top) { if (picked.every((p) => Math.abs(p.i - t.i) > 5)) picked.push(t); if (picked.length >= 4) break; }
        svg.selectAll("text.pk").data(picked).join("text").attr("class", "annot pk").attr("x", (d) => x(months[d.i]) + 4).attr("y", (d) => y(d.v) - 5).attr("fill", INK).text((d) => `${fMon(months[d.i])} · ${Math.round(d.v)}`)
          .each(function (d) { if (x(months[d.i]) > W * 0.8) d3.select(this).attr("text-anchor", "end").attr("x", x(months[d.i]) - 2); });
      });

      sect("event map", () => {
        const canvas = document.getElementById("map-canvas"), note = document.getElementById("map-note"), tip = document.getElementById("map-tip");
        if (!map?.all?.length) { canvas.parentElement.insertAdjacentHTML("afterbegin", `<div class="pending">Event map pending — appears once the event layer has streamed.</div>`); canvas.style.display = "none"; return; }
        const ctx = canvas.getContext("2d"), dpr = devicePixelRatio || 1;
        const LAT = [-11.5, 6.5], LON = [94.5, 141.5];
        let mode = "n", year = "all", W, H, sx, sy, cellW, cellH, cells = map.all, index = new Map();
        const CITIES = [["Jakarta", -6.2, 106.85], ["Surabaya", -7.25, 112.75], ["Medan", 3.6, 98.67], ["Makassar", -5.13, 119.42], ["Denpasar", -8.65, 115.22], ["Jayapura", -2.53, 140.72], ["Palu", -0.9, 119.87], ["Banda Aceh", 5.55, 95.32], ["Balikpapan", -1.27, 116.83], ["Ambon", -3.7, 128.18], ["Kupang", -10.17, 123.6], ["Pontianak", -0.02, 109.34]];
        const size = () => { W = canvas.clientWidth; H = Math.round(W * (LAT[1] - LAT[0]) / (LON[1] - LON[0])); canvas.style.height = H + "px"; canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); sx = d3.scaleLinear(LON, [0, W]); sy = d3.scaleLinear(LAT, [H, 0]); cellW = sx(0.25) - sx(0); cellH = sy(0) - sy(0.25); };
        const setData = () => { cells = year === "all" ? map.all : (map.byYear[year] ?? []); index = new Map(cells.map((c) => [c[0] + "," + c[1], c])); };
        const draw = () => {
          ctx.fillStyle = GROUND; ctx.fillRect(0, 0, W, H);
          ctx.strokeStyle = HAIR; ctx.lineWidth = 0.5; ctx.beginPath();
          for (let lo = 95; lo <= 141; lo += 5) { ctx.moveTo(sx(lo), 0); ctx.lineTo(sx(lo), H); }
          for (let la = -10; la <= 5; la += 5) { ctx.moveTo(0, sy(la)); ctx.lineTo(W, sy(la)); }
          ctx.stroke();
          const nmax = d3.quantile(cells.map((c) => c[2]).sort(d3.ascending), 0.995) || 1;
          const pmax = d3.quantile(cells.map((c) => c[4]).sort(d3.ascending), 0.995) || 1;
          const cN = d3.scaleSequentialLog([1, nmax], d3.interpolateRgb("#2A1B45", VIOLET)).clamp(true);
          const cP = d3.scaleSequentialSqrt([0, pmax], d3.interpolateRgb("#2A1B45", NEG)).clamp(true);
          const cT = d3.scaleDiverging([-6, -3, 0], [NEG, "#3A2F55", POS]).clamp(true);
          for (const c of cells) {
            const [lat, lon, n, t, p] = c;
            ctx.fillStyle = mode === "n" ? cN(n) : mode === "protest" ? (p ? cP(p) : "#1B1430") : (t == null ? "#1B1430" : cT(t));
            ctx.fillRect(sx(lon - 0.125), sy(lat + 0.125), Math.max(1, cellW - 0.4), Math.max(1, cellH - 0.4));
          }
          ctx.fillStyle = INK; ctx.font = "11px 'IBM Plex Mono', monospace"; ctx.globalAlpha = 0.85;
          for (const [name, la, lo] of CITIES) { ctx.beginPath(); ctx.arc(sx(lo), sy(la), 1.6, 0, Math.PI * 2); ctx.fill(); ctx.textAlign = sx(lo) > W - 80 ? "right" : "left"; ctx.fillText(name, sx(lo) + (sx(lo) > W - 80 ? -5 : 5), sy(la) - 4); ctx.textAlign = "left"; }
          ctx.globalAlpha = 1;
          ctx.fillStyle = MUTED; ctx.font = "10.5px 'IBM Plex Mono', monospace";
          ctx.fillText(mode === "n" ? "colour: events per cell (log)" : mode === "protest" ? "colour: protest events per cell" : "colour: mean tone (coral −6 … teal 0)", 10, H - 10);
          note.textContent = `${d3.sum(cells, (c) => c[2]).toLocaleString()} LOCATED EVENTS IN ${cells.length.toLocaleString()} CELLS${year === "all" ? ` · ${map.country_level_only?.toLocaleString()} MORE GEOCODED ONLY TO “INDONESIA” (NOT SHOWN)` : ` · ${year}`}`;
        };
        size(); setData(); draw();
        addEventListener("resize", () => { size(); draw(); });
        const nameOf = (c) => (c[5] ? c[5].split(",")[0] : `${c[0].toFixed(2)}, ${c[1].toFixed(2)}`);
        canvas.addEventListener("mousemove", (e) => {
          const r = canvas.getBoundingClientRect(); const lon = sx.invert(e.clientX - r.left), lat = sy.invert(e.clientY - r.top);
          const key = (Math.round(lat * 4) / 4) + "," + (Math.round(lon * 4) / 4);
          const c = index.get(key); const all = map.all.find((a) => a[0] + "," + a[1] === key);
          if (!c) { tip.hidden = true; return; }
          tip.hidden = false; tip.style.left = e.clientX - r.left + 14 + "px"; tip.style.top = e.clientY - r.top + 14 + "px";
          tip.innerHTML = `<b>${all ? nameOf(all) : nameOf(c)}</b><br>${c[2].toLocaleString()} events${year === "all" ? "" : " in " + year} · ${c[4]} protest<br>mean tone ${sgn(c[3], 1)}`;
        });
        canvas.addEventListener("mouseleave", () => { tip.hidden = true; });
        document.querySelectorAll("#map-mode button").forEach((b) => b.addEventListener("click", () => { mode = b.dataset.mode; document.querySelectorAll("#map-mode button").forEach((q) => q.classList.toggle("on", q === b)); draw(); }));
        const yb = document.getElementById("map-years");
        yb.innerHTML = `<button data-y="all" class="on">ALL</button>` + map.years.map((y) => `<button data-y="${y}">${y}</button>`).join("");
        yb.querySelectorAll("button").forEach((b) => b.addEventListener("click", () => { year = b.dataset.y; yb.querySelectorAll("button").forEach((q) => q.classList.toggle("on", q === b)); setData(); draw(); }));
      });

      sect("actors", () => {
        const el = document.getElementById("actors");
        const A = events?.actors?.rows; if (!A?.length) { pending("actors", "Event layer pending."); return; }
        const rows = A.slice(0, 16);
        const M = { t: 6, r: 70, b: 6, l: 48 }, BH = 20, { svg, W, H } = mkSvg(el, M.t + rows.length * BH + M.b);
        const x = d3.scaleLinear([0, d3.max(rows, (r) => r.n)], [M.l, W - M.r]);
        const g = svg.selectAll("g").data(rows).join("g").attr("transform", (d, i) => `translate(0,${M.t + i * BH})`);
        g.append("text").attr("class", "annot").attr("x", M.l - 8).attr("y", BH / 2 + 4).attr("text-anchor", "end").attr("fill", INK).text((d) => d.country);
        g.append("rect").attr("x", M.l).attr("y", 3).attr("height", BH - 7).attr("width", (d) => x(d.n) - M.l).attr("fill", VIOLET).attr("rx", 2).attr("opacity", (d, i) => 1 - i * 0.035)
          .on("mousemove", (e, d) => showTip(e, `<b>${d.country}</b> · ${d.n.toLocaleString()} events<br>${events.actors.years.map((y, i) => `${y}: ${d.by_year[i].toLocaleString()}`).join(" · ")}`)).on("mouseleave", hideTip);
        g.append("text").attr("class", "annot").attr("x", (d) => x(d.n) + 6).attr("y", BH / 2 + 4).text((d) => d.n.toLocaleString());
      });

      sect("root mix", () => {
        const el = document.getElementById("roots");
        const R = events?.root_mix; if (!R?.length) { pending("roots", "Event layer pending."); return; }
        const rows = [...R].sort((a, b) => b.n - a.n).slice(0, 16);
        const tot = d3.sum(R, (r) => r.n);
        const M = { t: 6, r: 60, b: 6, l: 178 }, BH = 20, { svg, W, H } = mkSvg(el, M.t + rows.length * BH + M.b);
        const x = d3.scaleLinear([0, d3.max(rows, (r) => r.n)], [M.l, W - M.r]);
        const conflict = (c) => +c >= 13;
        const g = svg.selectAll("g").data(rows).join("g").attr("transform", (d, i) => `translate(0,${M.t + i * BH})`);
        g.append("text").attr("class", "annot").attr("x", M.l - 8).attr("y", BH / 2 + 4).attr("text-anchor", "end").attr("fill", INK).text((d) => `${d.code} ${d.label}`);
        g.append("rect").attr("x", M.l).attr("y", 3).attr("height", BH - 7).attr("width", (d) => x(d.n) - M.l).attr("fill", (d) => (conflict(d.code) ? NEG : POS)).attr("rx", 2).attr("opacity", 0.85)
          .on("mousemove", (e, d) => showTip(e, `<b>${d.code} · ${d.label}</b><br>${d.n.toLocaleString()} events · ${d3.format(".1%")(d.n / tot)}`)).on("mouseleave", hideTip);
        g.append("text").attr("class", "annot").attr("x", (d) => x(d.n) + 6).attr("y", BH / 2 + 4).text((d) => d3.format(".0%")(d.n / tot));
      });

      /* ---------- methodology: raw vs normalized (G-D1) ---------- */
      sect("norm chart", () => {
        const el = document.getElementById("norm-chart");
        if (!pulse?.raw?.some((v) => v != null)) { pending("norm-chart", "Pending API curve TimelineVolRaw."); return; }
        const dates = pulse.dates.map(P);
        const sm = (arr, w = 28) => arr.map((v, i) => { const s = arr.slice(Math.max(0, i - w), i + 1).filter((q) => q != null); return s.length ? d3.mean(s) : null; });
        const raw = sm(pulse.raw), norm = sm(pulse.norm), vol = sm(pulse.vol);
        const M = { t: 18, r: 56, b: 30, l: 56 }, { svg, W, H } = mkSvg(el, 260);
        const x = d3.scaleTime(d3.extent(dates), [M.l, W - M.r]);
        const yN = d3.scaleLinear([0, d3.max(norm) * 1.1], [H - M.b, M.t]);
        const yV = d3.scaleLinear([0, d3.max(vol) * 1.1], [H - M.b, M.t]);
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - M.b})`).call(yearAxis(x));
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`).call(d3.axisLeft(yN).ticks(4).tickFormat(d3.format("~s")));
        svg.append("g").attr("class", "axis").attr("transform", `translate(${W - M.r},0)`).call(d3.axisRight(yV).ticks(4).tickFormat((v) => v.toFixed(1) + "%"));
        svg.append("path").datum(dates).attr("d", d3.area().defined((d, i) => norm[i] != null).x((d) => x(d)).y0(H - M.b).y1((d, i) => yN(norm[i]))).attr("fill", MUTED).attr("opacity", 0.16);
        const yR = d3.scaleLinear([0, d3.max(raw) * 1.1], [H - M.b, M.t]);
        svg.append("path").datum(dates).attr("d", d3.line().defined((d, i) => raw[i] != null).x((d) => x(d)).y((d, i) => yR(raw[i]))).attr("fill", "none").attr("stroke", INK).attr("stroke-width", 1).attr("opacity", 0.7);
        svg.append("path").datum(dates).attr("d", d3.line().defined((d, i) => vol[i] != null).x((d) => x(d)).y((d, i) => yV(vol[i]))).attr("fill", "none").attr("stroke", VIOLET).attr("stroke-width", 1.6);
        svg.append("text").attr("class", "annot").attr("x", M.l + 6).attr("y", M.t + 10).text("grey area: all articles GDELT monitored per day (left axis) · white: raw Indonesia articles (own scale) · violet: normalized share (right axis) · 28-day means");
        const guide = svg.append("line").attr("y1", M.t).attr("y2", H - M.b).attr("stroke", INK).attr("stroke-opacity", 0.5).style("display", "none");
        hoverRect(svg, M, W, H, (e) => { const i = nearestIdx(dates, x.invert(d3.pointer(e)[0])); if (norm[i] == null) return; guide.style("display", null).attr("x1", x(dates[i])).attr("x2", x(dates[i])); showTip(e, `<b>${fDay(dates[i])}</b> (28-day means)<br>monitored ${d3.format(",.0f")(norm[i])} articles/day<br>Indonesia raw ${d3.format(",.0f")(raw[i])}/day · share ${pct(vol[i], 3)}`); }, () => { guide.style("display", "none"); hideTip(); });
      });

      sect("gates", () => {
        const el = document.getElementById("gates");
        const stats = status?.gates ? status : null;
        if (!stats) { el.innerHTML = `<div class="pending">Gate results appear after <code>make validate</code>.</div>`; return; }
        load("stats.json").then((s) => {
          const g = s.gates ?? {};
          const V = (v) => `<span class="verdict ${v}">${v}</span>`;
          const d1 = g["G-D1"] ?? {}, d3g = g["G-D3"] ?? {}, d4 = g["G-D4"] ?? {}, d2 = g["G-D2"] ?? {};
          el.innerHTML = `
            <div class="gate">${V(d1.verdict)}<div><b>G-D1 Normalization honesty.</b> Crawl size drifts <b>${num(d1.crawl_size_drift_max_over_min, 2)}×</b> across years (${Object.entries(d1.monitored_articles_per_day_by_year ?? {}).map(([y, v]) => `${y}: ${d3.format(".2s")(v)}`).join(" · ")} articles/day). All attention charts are shares.</div></div>
            <div class="gate">${V(d2.verdict)}<div><b>G-D2 Anchors.</b> ${d2.pass ?? 0} pass · ${d2.fail ?? 0} fail · ${d2.pending ?? 0} pending of ${d2.anchors?.length ?? 0}, each against a trailing ${d2.baseline_days}-day baseline.
              <div class="table-scroll"><table class="rank small anchors"><thead><tr><th>Anchor</th><th>Attention ×</th><th>Δ tone</th><th>Protest ×</th><th>Verdict</th></tr></thead><tbody>${(d2.anchors ?? []).map((a) => { const s = a.signatures; const mark = (k) => (a.gated?.includes(k) ? (s[k].verdict === "PASS" ? "✓" : s[k].verdict === "FAIL" ? "✗" : "…") : "<i>info</i>"); const th = a.gated?.find((k) => k.startsWith("theme_")); return `<tr><td>${a.day} · ${a.label}</td><td class="num">${s.attention ? `${num(s.attention.ratio, 1)} ${mark("attention")}` : "—"}${th && s[th] ? `<br><i>${th.replace("theme_", "")} ${s[th].ratio != null ? num(s[th].ratio, 1) + "×" : "…"} ${mark(th)}</i>` : ""}</td><td class="num">${s.tone_drop ? `${sgn(-s.tone_drop.delta)} ${s.tone_drop.verdict === "PASS" ? "✓" : s.tone_drop.verdict === "FAIL" ? "✗" : "…"}` : a.report_only?.tone_rise ? `<i>${sgn(a.report_only.tone_rise.delta)} (report only)</i>` : "—"}</td><td class="num">${s.protest ? `${num(s.protest.ratio, 1)} ${s.protest.verdict === "PASS" ? "✓" : s.protest.verdict === "FAIL" ? "✗" : "…"}` : "—"}</td><td>${V(a.verdict)}</td></tr>`; }).join("")}</tbody></table></div></div></div>
            <div class="gate">${V(d3g.verdict)}<div><b>G-D3 Two-source coherence.</b> Event-layer Indonesia share (own denominator) vs the API’s normalized volume: Spearman ρ = <b>${d3g.share_all?.spearman_rho ?? "pending"}</b> over ${d3g.share_all?.n_days ?? 0} shared days (threshold ${d3g.threshold}).${d3g.share_en ? ` English feed ρ ${d3g.share_en.spearman_rho ?? "—"}, translated ρ ${d3g.share_trans?.spearman_rho ?? "—"}.` : ""}</div></div>
            <div class="gate">${V(d4.verdict)}<div><b>G-D4 Language honesty.</b> Foreign press carries <b>${d4.api_foreign_share_mean != null ? d3.format(".0%")(d4.api_foreign_share_mean) : "—"}</b> of Indonesia coverage; the translated (non-English) feed supplies <b>${d4.event_layer_translated_share != null ? d3.format(".0%")(d4.event_layer_translated_share) : "—"}</b> of kept events. Both are charted in chapter 04.</div></div>`;
        }).catch(() => { el.innerHTML = `<div class="pending">stats.json not exported yet.</div>`; });
      });

      // theme query list for the methodology
      if (themes?.themes) {
        const q = Object.values(themes.themes).map((t) => `<code>${t.query.replace(/</g, "&lt;")}</code>`).join(" · ");
        document.getElementById("method-text").insertAdjacentHTML("beforeend", ` <b>Theme queries:</b> ${q}.`);
      }
    </script>

    <style is:global>
      html { scroll-behavior: smooth; }
      body { margin: 0; }
      a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
      .stamp { font-family: var(--font-data); font-size: 0.7rem; letter-spacing: 0.12em; color: var(--accent); }
      .stamp.dim { color: var(--ink-muted); }
      .eyebrow { font-family: var(--font-data); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
      .violet { color: var(--accent); } .dim { color: var(--ink-muted); }
      .stamp-bar { position: fixed; inset: 0 0 auto 0; z-index: 20; display: flex; justify-content: space-between; gap: 16px; padding: 12px 20px; background: linear-gradient(color-mix(in srgb, var(--ground) 86%, transparent), transparent); pointer-events: none; }
      .stamp-bar .stamp { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      .hero { position: relative; min-height: 100vh; display: flex; flex-direction: column; justify-content: flex-end; background: radial-gradient(ellipse at 70% 20%, #1c1330 0%, var(--ground) 55%); }
      .hero-copy { padding: 14vh 6vw 2vh; max-width: 40rem; display: flex; flex-direction: column; gap: 14px; }
      .hero-copy h1 { font-size: clamp(1.9rem, 4.4vw, 3.2rem); margin: 0; line-height: 1.08; letter-spacing: -0.015em; }
      .hero-copy p { margin: 0; color: var(--ink-muted); font-size: 1.05rem; max-width: 36rem; }
      .pulse { width: 100%; }
      .pulse svg { display: block; }

      .chapter { max-width: 46rem; margin: 0 auto; padding: 12vh 24px 0; display: flex; flex-direction: column; gap: 18px; }
      .chapter.wide { max-width: 72rem; }
      .chapter h2 { font-size: 1.7rem; margin: 0; }
      .chapter h3, .method h3 { font-size: 1.05rem; margin: 18px 0 0; }
      .chapter p { margin: 0; line-height: 1.65; max-width: 46rem; }
      .footnote { font-size: 0.85rem; color: var(--ink-muted); }
      .chart { width: 100%; position: relative; }
      .axis { font-family: var(--font-data); font-size: 12px; color: var(--ink-muted); }
      .axis text { fill: var(--ink-muted); }
      .axis path, .axis line { stroke: var(--hairline); }
      .axis.tiny { font-size: 10px; }
      .annot { font-family: var(--font-data); font-size: 12px; fill: var(--ink-muted); letter-spacing: 0.03em; }
      .alabel { font-size: 11.5px; paint-order: stroke; stroke: var(--ground); stroke-width: 3px; stroke-linejoin: round; }
      .pending { border: 1px dashed var(--hairline); border-radius: 8px; padding: 18px; font-family: var(--font-data); font-size: 0.75rem; letter-spacing: 0.06em; color: var(--ink-muted); background: var(--surface); }
      #chart-tip { position: absolute; z-index: 30; pointer-events: none; background: var(--surface-raised); border: 1px solid var(--hairline); border-radius: 4px; padding: 8px 11px; font-family: var(--font-data); font-size: 0.72rem; line-height: 1.6; color: var(--ink); max-width: 280px; }

      .era-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
      .era { border: 1px solid var(--hairline); border-top: 2px solid var(--c); border-radius: 8px; padding: 16px; background: linear-gradient(160deg, var(--surface), var(--ground)); display: flex; flex-direction: column; gap: 10px; }
      .era h3 { margin: 0; font-size: 1.05rem; }
      .era-stat b, .era-row b { font-family: var(--font-display); font-size: 1.15rem; display: block; margin-top: 2px; font-variant-numeric: tabular-nums; }
      .era-row { display: flex; gap: 18px; } .era-row b { font-size: 0.95rem; }
      .bar { height: 4px; background: var(--hairline); border-radius: 2px; margin-top: 6px; } .bar i { display: block; height: 100%; background: var(--c); border-radius: 2px; }
      .chips { display: flex; flex-wrap: wrap; gap: 6px; }
      .chip { font-family: var(--font-data); font-size: 0.66rem; letter-spacing: 0.04em; border: 1px solid var(--hairline); border-radius: 12px; padding: 3px 8px; color: var(--ink); } .chip i { color: var(--ink-muted); font-style: normal; }

      .day-list { display: flex; flex-direction: column; gap: 10px; } .day-list h3 { margin-bottom: 4px; }
      .day { border-left: 2px solid var(--tone-neg); padding: 8px 14px; background: linear-gradient(90deg, color-mix(in srgb, var(--tone-neg) 8%, transparent), transparent); border-radius: 0 6px 6px 0; }
      .day-head { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: baseline; } .day-head b { font-family: var(--font-display); }
      .day ul { margin: 6px 0 0; padding-left: 1.1em; font-size: 0.86rem; line-height: 1.5; } .day li i { color: var(--ink-muted); font-style: normal; font-family: var(--font-data); font-size: 0.68rem; margin-left: 6px; }
      .day a { color: var(--ink); }

      .theme-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(215px, 1fr)); gap: 10px; }
      .panel { border: 1px solid var(--hairline); border-radius: 6px; padding: 8px 8px 2px; background: var(--surface); cursor: crosshair; }
      .panel-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 0.86rem; } .panel-head b { font-family: var(--font-display); }
      .panel svg { display: block; width: 100%; }
      .table-scroll { overflow-x: auto; }
      table.rank { border-collapse: collapse; width: 100%; font-family: var(--font-data); font-size: 0.78rem; }
      table.rank th { text-align: left; font-weight: 600; font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); padding: 8px 10px 8px 0; border-bottom: 1px solid var(--ink-muted); }
      table.rank td { padding: 8px 10px 8px 0; border-bottom: 1px solid var(--hairline); vertical-align: top; }
      table.rank td span { display: block; color: var(--ink); } table.rank td i { color: var(--ink-muted); font-style: normal; font-size: 0.68rem; }
      table.rank td.era-name { color: var(--accent); white-space: nowrap; }
      table.rank.small { font-size: 0.74rem; } table.rank td.num { text-align: right; font-variant-numeric: tabular-nums; } table.rank th:not(:first-child) { text-align: right; } table.rank.anchors th:last-child, table.rank.anchors td:last-child { text-align: right; }
      table.rank.anchors th:not(:first-child) { text-align: right; }
      .two-up { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px 40px; align-items: start; } .two-up h3 { margin-top: 0; }

      .map-controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
      .toggle { display: flex; flex-wrap: wrap; }
      .toggle button { background: var(--surface); color: var(--ink-muted); border: 1px solid var(--hairline); padding: 6px 10px; font-family: var(--font-data); font-size: 0.66rem; letter-spacing: 0.08em; cursor: pointer; margin-left: -1px; }
      .toggle button:first-child { border-radius: 4px 0 0 4px; margin-left: 0; } .toggle button:last-child { border-radius: 0 4px 4px 0; }
      .toggle button.on { background: var(--accent-ink); color: var(--accent); border-color: var(--accent); position: relative; z-index: 1; }
      .map-wrap { position: relative; border: 1px solid var(--hairline); border-radius: 8px; overflow: hidden; }
      #map-canvas { width: 100%; display: block; cursor: crosshair; }
      #map-tip { position: absolute; z-index: 5; pointer-events: none; background: var(--surface-raised); border: 1px solid var(--hairline); border-radius: 4px; padding: 8px 11px; font-family: var(--font-data); font-size: 0.72rem; line-height: 1.55; color: var(--ink); }
      .map-note { position: absolute; right: 12px; top: 10px; }

      .method { max-width: 72rem; margin: 0 auto; padding: 12vh 24px 10vh; display: flex; flex-direction: column; gap: 14px; }
      .method p { margin: 0; font-size: 0.9rem; line-height: 1.7; color: var(--ink-muted); max-width: 72rem; }
      .method code { font-size: 0.8em; background: var(--surface-raised); padding: 1px 5px; border-radius: 3px; color: var(--ink); }
      .gates { display: flex; flex-direction: column; gap: 10px; }
      .gate { display: grid; grid-template-columns: 82px 1fr; gap: 14px; border: 1px solid var(--hairline); border-radius: 8px; padding: 12px 14px; background: var(--surface); font-size: 0.88rem; line-height: 1.6; color: var(--ink-muted); }
      .gate b { color: var(--ink); }
      .verdict { font-family: var(--font-data); font-size: 0.66rem; letter-spacing: 0.1em; border-radius: 4px; padding: 4px 8px; height: fit-content; text-align: center; border: 1px solid var(--hairline); }
      .verdict.PASS { color: var(--tone-pos); border-color: var(--tone-pos); } .verdict.FAIL { color: var(--tone-neg); border-color: var(--tone-neg); } .verdict.PENDING { color: var(--ink-muted); }
      @media (max-width: 640px) { .gate { grid-template-columns: 1fr; } .stamp-bar { flex-direction: column; gap: 2px; } }
    </style>
  </body>
