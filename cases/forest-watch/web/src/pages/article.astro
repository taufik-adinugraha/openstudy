---
/* Review article — the case, stress-tested against the literature and against itself.
 *
 * Every figure is built here in frontmatter from data/article.json, which pipeline/article.py
 * derives from the case's own published outputs (data/stats.json, data/baserate.json and the
 * event table itself). Nothing on this page is a hand-typed statistic, so the prose cannot
 * drift from the pipeline. SVG only: no WebGL, no canvas.
 */
import "../styles/tokens.css";
import A from "../data/article.json";

const GREEN = "#57B26A", LOSS = "#B4552A", EMBER = "#E0A63F";
const TEAL = "#4BB8A9", SLATE = "#7C93B8", RUBBER = "#8F6FB0";
const INK = "#E7ECE6", MUTED = "#93A394", GRID = "#243025";

const pct = (x: number | null, d = 1) => (x == null ? "—" : `${(x * 100).toFixed(d)}%`);
const num = (x: number | null, d = 0) =>
  x == null ? "—" : x.toLocaleString("en-GB", { minimumFractionDigits: d, maximumFractionDigits: d });
const mha = (x: number | null, d = 2) => (x == null ? "—" : `${(x / 1e6).toFixed(d)} Mha`);
const esc = (s: unknown) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;")
  .replace(/>/g, "&gt;").replace(/"/g, "&quot;");

const L = A.loss, C = A.catchment, F = A.floor, ID = A.identifiability;
const D = A.domain, S = A.sensors, R = A.record, DI = A.deforested_islands;
const H = C.headline;

/* Published benchmarks, transcribed from the papers cited in §14. Kept in one block so
   every literature number on the page has a single, checkable origin. */
const LIT = {
  gaveau: { palmShareOfLoss: 0.32, lossMha: 9.79, toPalmMha: 3.09, palmMha: 16.24, adjMha: 18.83 },
  austin: { palm: 0.23, lo: 0.18, hi: 0.25, grass: 0.20, smallAg: 0.22, timber: 0.14,
            otherPlant: 0.07, logging: 0.10, other: 0.05, palmPeak: 0.40, palmLate: 0.15 },
  curtis: { commodity: 0.27, forestry: 0.26, shifting: 0.24, wildfire: 0.23 },
  descals: { mappedMha: 11.54, estMha: 12.05, industrial: 0.668 },
  radd: { falsePos: 0.02, falseNeg: 0.05, mmuHa: 0.1, revisitLo: 6, revisitHi: 12 },
};

/* ── Figure 1 · two decades of loss, split by what the land already was ──────────── */
function fig1() {
  const W = 720, Hh = 430, Lm = 66, Rm = 54, T = 54, B = 46;
  const ys = L.years as number[];
  const n = ys.length;
  const iw = (W - Lm - Rm) / n, bw = Math.min(20, iw * 0.74);
  const max = Math.max(...(L.total_ha as number[]));
  const sy = (v: number) => Hh - B - (v / max) * (Hh - T - B);
  const sx = (i: number) => Lm + i * iw + iw / 2;
  const stack = [
    { k: "oil_palm_ha", c: LOSS, lab: "oil palm" },
    { k: "wood_fibre_ha", c: EMBER, lab: "wood fibre" },
    { k: "rubber_ha", c: RUBBER, lab: "rubber" },
    { k: "outside_plantation_ha", c: "#3C5A42", lab: "outside mapped plantation" },
  ];
  let bars = "";
  ys.forEach((y, i) => {
    let base = 0;
    const parts = stack.map((s) => {
      const v = (L as any)[s.k][i] as number;
      const y0 = sy(base + v), y1 = sy(base);
      base += v;
      return `<rect x="${(sx(i) - bw / 2).toFixed(1)}" y="${y0.toFixed(1)}" width="${bw.toFixed(1)}" ` +
             `height="${Math.max(0.4, y1 - y0).toFixed(1)}" fill="${s.c}" opacity="0.92"/>`;
    }).join("");
    bars += `<g class="yr" data-y="${y}" data-t="${num(L.total_ha[i])}" data-p="${num(L.oil_palm_ha[i])}" ` +
      `data-w="${num(L.wood_fibre_ha[i])}" data-r="${num(L.rubber_ha[i])}" ` +
      `data-o="${num(L.outside_plantation_ha[i])}" data-s="${pct(L.in_plantation_share[i], 1)}">` +
      `${parts}<rect x="${(sx(i) - iw / 2).toFixed(1)}" y="${T}" width="${iw.toFixed(1)}" ` +
      `height="${Hh - T - B}" fill="transparent"/></g>`;
  });
  const shareLine = `<path fill="none" stroke="${GREEN}" stroke-width="2.2" stroke-dasharray="5 3" d="${
    ys.map((_, i) => `${i ? "L" : "M"}${sx(i).toFixed(1)} ${(Hh - B - (L.in_plantation_share[i] / 0.7) * (Hh - T - B)).toFixed(1)}`).join("")}"/>`;
  const yt = [0, 0.5e6, 1e6, 1.5e6, 2e6, 2.4e6].map((v) =>
    `<line x1="${Lm}" y1="${sy(v).toFixed(1)}" x2="${W - Rm}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.7"/>
     <text x="${Lm - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10.5" text-anchor="end">${(v / 1e6).toFixed(1)}M</text>`).join("");
  const rt = [0, 0.35, 0.7].map((v) =>
    `<text x="${W - Rm + 8}" y="${(Hh - B - (v / 0.7) * (Hh - T - B) + 4).toFixed(1)}" fill="${GREEN}" font-size="10.5">${(v * 100).toFixed(0)}%</text>`).join("");
  const xt = ys.map((y, i) => (y % 4 === 1 || i === n - 1)
    ? `<text x="${sx(i).toFixed(1)}" y="${Hh - B + 18}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${String(y).slice(2)}</text>` : "").join("");
  const leg = stack.map((s, i) =>
    `<rect x="${Lm + i * 152}" y="14" width="10" height="10" rx="2" fill="${s.c}"/>
     <text x="${Lm + i * 152 + 15}" y="23" fill="${MUTED}" font-size="10.5">${s.lab}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Indonesian tree-cover loss 2001 to 2025, split into loss inside mapped oil palm, wood fibre and rubber plantations and loss outside mapped plantation">
    ${yt}${rt}${leg}
    <text x="${Lm}" y="42" fill="${GREEN}" font-size="10.5" font-family="var(--font-data)">— — share of the year's loss inside mapped plantation (right axis)</text>
    ${bars}${shareLine}${xt}
    <text x="${Lm - 46}" y="${(T + Hh - B) / 2}" fill="${MUTED}" font-size="11" text-anchor="middle" transform="rotate(-90 ${Lm - 46} ${(T + Hh - B) / 2})">hectares of tree-cover loss</text>
  </svg>`;
}

/* ── Figure 2 · the base rate ────────────────────────────────────────────────────── */
function fig2() {
  const W = 720, Hh = 400, Lm = 58, Rm = 168, T = 22, B = 52;
  const bins = C.bins_km as number[];
  const XMAX = 150;
  const sx = (v: number) => Lm + (v / XMAX) * (W - Lm - Rm);
  const sy = (v: number) => Hh - B - v * (Hh - T - B);
  const series = [
    { k: "land", c: SLATE, lab: "all Indonesian land" },
    { k: "domain", c: TEAL, lab: "where an alert is possible" },
    { k: "unfiltered", c: EMBER, lab: "alerted ha, no size floor" },
    { k: "alert", c: LOSS, lab: "alerted ha, published events" },
  ];
  const paths = series.map((s) => {
    const c = (C.cum as any)[s.k] as number[];
    let d = `M${sx(0)} ${sy(0)}`;
    for (let i = 0; i < bins.length - 1 && bins[i + 1] <= XMAX; i++)
      d += `L${sx(bins[i + 1]).toFixed(1)} ${sy(c[i]).toFixed(1)}`;
    return `<path fill="none" stroke="${s.c}" stroke-width="2.4" d="${d}"/>`;
  }).join("");
  const i50 = bins.indexOf(50) - 1;
  const dots = series.map((s) => {
    const v = (C.cum as any)[s.k][i50] as number;
    return `<circle cx="${sx(50).toFixed(1)}" cy="${sy(v).toFixed(1)}" r="4.6" fill="${s.c}" stroke="#0C120D" stroke-width="1.4"/>`;
  }).join("");
  const rows = series.slice().reverse().map((s, i) => {
    const v = (C.cum as any)[s.k][i50] as number;
    const y = T + 26 + i * 30;
    return `<rect x="${W - Rm + 8}" y="${y - 9}" width="9" height="9" rx="2" fill="${s.c}"/>
      <text x="${W - Rm + 22}" y="${y}" fill="${INK}" font-size="11.5" font-family="var(--font-data)">${pct(v, 1)}</text>
      <text x="${W - Rm + 22}" y="${y + 13}" fill="${MUTED}" font-size="10">${s.lab}</text>`;
  }).join("");
  const gl = [0, 0.25, 0.5, 0.75, 1].map((v) =>
    `<line x1="${Lm}" y1="${sy(v).toFixed(1)}" x2="${W - Rm}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.7"/>
     <text x="${Lm - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10.5" text-anchor="end">${(v * 100).toFixed(0)}%</text>`).join("");
  const xt = [0, 25, 50, 75, 100, 125, 150].map((v) =>
    `<text x="${sx(v).toFixed(1)}" y="${Hh - B + 18}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${v}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Cumulative share of area within a given distance of the nearest palm mill, for all land, the alert detection domain, and alerted hectares">
    ${gl}
    <line x1="${sx(50).toFixed(1)}" y1="${T}" x2="${sx(50).toFixed(1)}" y2="${Hh - B}" stroke="${MUTED}" stroke-dasharray="3 4" opacity="0.65"/>
    <text x="${(sx(50) + 6).toFixed(1)}" y="${T + 11}" fill="${MUTED}" font-size="10" font-family="var(--font-data)">50 km — the published radius</text>
    ${paths}${dots}${rows}${xt}
    <text x="${((Lm + W - Rm) / 2).toFixed(1)}" y="${Hh - 12}" fill="${MUTED}" font-size="11.5" text-anchor="middle">kilometres to the nearest of ${num(A.record.n_mills)} Universal Mill List mills →</text>
  </svg>`;
}

/* ── Figure 4 · lift by radius ───────────────────────────────────────────────────── */
function figLift() {
  const W = 720, Hh = 300, Lm = 56, Rm = 26, T = 26, B = 52;
  const radii = C.radii as number[];
  const iw = (W - Lm - Rm) / radii.length;
  const max = 3.4;
  const sy = (v: number) => Hh - B - (v / max) * (Hh - T - B);
  const bars = radii.map((rr, i) => {
    const nat = (C.national as any)[String(rr)];
    const v = nat.lift_vs_domain as number;
    const x = Lm + i * iw + iw * 0.22, w = iw * 0.56;
    const hot = rr === 50, best = rr === C.best_radius.km;
    return `<g class="lf" data-r="${rr}" data-l="${v.toFixed(2)}" data-b="${pct(nat.domain_base, 1)}" data-a="${pct(nat.alert_ha_share, 1)}">
      <rect x="${x.toFixed(1)}" y="${sy(v).toFixed(1)}" width="${w.toFixed(1)}" height="${(sy(0) - sy(v)).toFixed(1)}"
        fill="${best ? GREEN : hot ? LOSS : "#3C5A42"}" rx="2" opacity="${best || hot ? 0.95 : 0.75}"/>
      <text x="${(x + w / 2).toFixed(1)}" y="${(sy(v) - 7).toFixed(1)}" fill="${best ? GREEN : hot ? LOSS : MUTED}"
        font-size="11" text-anchor="middle" font-family="var(--font-data)">${v.toFixed(2)}×</text>
      <text x="${(x + w / 2).toFixed(1)}" y="${Hh - B + 18}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${rr}</text></g>`;
  }).join("");
  const one = sy(1);
  const gl = [1, 2, 3].map((v) =>
    `<line x1="${Lm}" y1="${sy(v).toFixed(1)}" x2="${W - Rm}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.7"/>
     <text x="${Lm - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10.5" text-anchor="end">${v}×</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Enrichment of alerted hectares near mills over the base rate, by catchment radius; the lift peaks at 10 kilometres and decays">
    ${gl}${bars}
    <line x1="${Lm}" y1="${one.toFixed(1)}" x2="${W - Rm}" y2="${one.toFixed(1)}" stroke="${MUTED}" stroke-dasharray="4 4"/>
    <text x="${W - Rm}" y="14" fill="${MUTED}" font-size="10" text-anchor="end" font-family="var(--font-data)">dashed rule at 1.00× — no information</text>
    <text x="${((Lm + W - Rm) / 2).toFixed(1)}" y="${Hh - 12}" fill="${MUTED}" font-size="11.5" text-anchor="middle">catchment radius, km →</text>
  </svg>`;
}

/* ── Figure 3 · province by province ─────────────────────────────────────────────── */
function figProv() {
  const rows = (C.provinces as any[]).filter((p) => p.lift_50 != null)
    .sort((a, b) => b.lift_50 - a.lift_50).slice(0, 16);
  const W = 720, Lm = 152, Rm = 92, T = 30, rh = 22;
  const Hh = T + rows.length * rh + 34;
  const sx = (v: number) => Lm + v * (W - Lm - Rm);
  const body = rows.map((p, i) => {
    const y = T + i * rh + rh / 2;
    const a = sx(p.domain_base_50), b = sx(p.alert_share_50);
    const up = p.alert_share_50 >= p.domain_base_50;
    return `<g class="pv" data-n="${esc(p.province)}" data-b="${pct(p.domain_base_50, 1)}" data-a="${pct(p.alert_share_50, 1)}" data-l="${p.lift_50.toFixed(2)}" data-h="${num(p.alert_ha)}">
      <rect x="0" y="${y - rh / 2}" width="${W}" height="${rh}" fill="transparent"/>
      <text x="${Lm - 12}" y="${y + 4}" fill="${INK}" font-size="11.5" text-anchor="end">${esc(p.province)}</text>
      <line x1="${Math.min(a, b).toFixed(1)}" y1="${y}" x2="${Math.max(a, b).toFixed(1)}" y2="${y}"
        stroke="${up ? LOSS : SLATE}" stroke-width="2.6" opacity="0.75"/>
      <circle cx="${a.toFixed(1)}" cy="${y}" r="4" fill="${TEAL}"/>
      <circle cx="${b.toFixed(1)}" cy="${y}" r="4" fill="${up ? LOSS : SLATE}"/>
      <text x="${W - Rm + 14}" y="${y + 4}" fill="${p.lift_50 >= 1.3 ? LOSS : MUTED}" font-size="11"
        font-family="var(--font-data)">${p.lift_50.toFixed(2)}×</text></g>`;
  }).join("");
  const gl = [0, 0.25, 0.5, 0.75, 1].map((v) =>
    `<line x1="${sx(v).toFixed(1)}" y1="${T - 8}" x2="${sx(v).toFixed(1)}" y2="${Hh - 30}" stroke="${GRID}" opacity="0.6"/>
     <text x="${sx(v).toFixed(1)}" y="${Hh - 14}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${(v * 100).toFixed(0)}%</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="For each province, the share of the detection domain within 50 kilometres of a mill against the share of alerted hectares, with the ratio">
    ${gl}
    <circle cx="${Lm}" cy="14" r="4" fill="${TEAL}"/><text x="${Lm + 10}" y="18" fill="${MUTED}" font-size="10.5">base rate</text>
    <circle cx="${Lm + 92}" cy="14" r="4" fill="${LOSS}"/><text x="${Lm + 102}" y="18" fill="${MUTED}" font-size="10.5">alerted hectares</text>
    <text x="${W - Rm + 14}" y="18" fill="${MUTED}" font-size="10.5">lift</text>
    ${body}
  </svg>`;
}

/* ── Figure 5 · the size floor ───────────────────────────────────────────────────── */
function fig5() {
  const rows = F.by_size as any[];
  const W = 720, Lm = 96, Rm = 150, T = 66, rh = 34;
  const Hh = T + rows.length * rh + 26;
  const sx = (v: number) => Lm + v * (W - Lm - Rm);
  const maxHa = Math.max(...rows.map((b) => b.ha));
  const body = rows.map((b, i) => {
    const y = T + i * rh;
    const bh = 6 + Math.sqrt(b.ha / maxHa) * 20;
    return `<g class="sz" data-b="${esc(b.band)}" data-e="${num(b.events)}" data-h="${num(b.ha)}" data-w="${pct(b.within_50km_ha_share, 1)}" data-m="${b.median_mill_km}">
      <rect x="0" y="${y}" width="${W}" height="${rh}" fill="transparent"/>
      <text x="${Lm - 12}" y="${(y + rh / 2 + 4).toFixed(1)}" fill="${INK}" font-size="11.5" text-anchor="end">${esc(b.band)} ha</text>
      <rect x="${Lm}" y="${(y + rh / 2 - bh / 2).toFixed(1)}" width="${(sx(b.within_50km_ha_share) - Lm).toFixed(1)}"
        height="${bh.toFixed(1)}" fill="${LOSS}" opacity="0.9" rx="2"/>
      <text x="${(sx(b.within_50km_ha_share) - 9).toFixed(1)}" y="${(y + rh / 2 + 4).toFixed(1)}" fill="#170A04" font-size="11" text-anchor="end" font-family="var(--font-data)">${pct(b.within_50km_ha_share, 1)}</text>
      <text x="${W - 6}" y="${(y + rh / 2 + 4).toFixed(1)}" fill="${MUTED}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">median ${b.median_mill_km} km · ${num(b.ha)} ha</text></g>`;
  }).join("");
  const marks = [
    { v: C.headline.domain_base as number, c: TEAL, lab: "base rate" },
    { v: F.unfiltered_within_50 as number, c: EMBER, lab: "no size floor" },
    { v: F.filtered_within_50 as number, c: INK, lab: "published" },
  ].map((m, i) => `<line x1="${sx(m.v).toFixed(1)}" y1="${T - 12}" x2="${sx(m.v).toFixed(1)}" y2="${Hh - 22}"
      stroke="${m.c}" stroke-dasharray="3 4" opacity="0.8"/>
    <text x="${sx(m.v).toFixed(1)}" y="${18 + i * 15}" fill="${m.c}" font-size="10" text-anchor="middle" font-family="var(--font-data)">${m.lab} ${pct(m.v, 1)}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Share of alerted hectares within 50 kilometres of a mill, by event size; small events sit further from mills than large ones">
    ${marks}${body}
    <text x="${Lm}" y="${Hh - 4}" fill="${MUTED}" font-size="10.5">bar height is the hectares in the band · bar length is the share inside a catchment</text>
  </svg>`;
}

/* ── Figure 6 · how many mills claim the same hectare ────────────────────────────── */
function fig6() {
  const W = 720, Hh = 246;
  const m = ID.mills as any;
  const only1 = 1 - (m.share_of_catchment_ha_with_2plus_mills as number);
  const sx = (v: number) => 22 + v * 250;
  const bars = [
    { k: "one mill only", v: only1 },
    { k: "two or more mills", v: m.share_of_catchment_ha_with_2plus_mills },
    { k: "five or more mills", v: m.share_of_catchment_ha_with_5plus_mills },
  ].map((b, i) => {
    const y = 92 + i * 44;
    return `<text x="22" y="${y - 6}" fill="${INK}" font-size="11.5">${b.k}</text>
      <rect x="22" y="${y}" width="${(sx(b.v) - 22).toFixed(1)}" height="15" rx="2" fill="${LOSS}" opacity="${0.55 + i * 0.18}"/>
      <text x="${(sx(b.v) + 9).toFixed(1)}" y="${y + 12}" fill="${LOSS}" font-size="11" font-family="var(--font-data)">${pct(b.v, 1)}</text>`;
  }).join("");
  const x0 = 380, bwMax = W - x0 - 24;
  const big = Math.max(ID.pressure_sum_ha as number, ID.in_catchment_12m_ha as number);
  const b1 = ((ID.in_catchment_12m_ha as number) / big) * bwMax;
  const b2 = ((ID.pressure_sum_ha as number) / big) * bwMax;
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Most alerted hectares inside a catchment fall inside several catchments at once, and the published per-mill pressure sums to seven times the hectares that exist">
    <text x="22" y="24" fill="${MUTED}" font-size="10.5" font-family="var(--font-data)">IN-CATCHMENT ALERTED HECTARES, CLAIMED BY…</text>
    <text x="22" y="48" fill="${INK}" font-size="12.5">mean ${m.mean_over_alert_ha_in_catchment.toFixed(2)} mills per hectare</text>
    <text x="22" y="68" fill="${MUTED}" font-size="11">median ${m.median} · 90th percentile ${m.p90} · most ${m.max}</text>
    ${bars}
    <line x1="352" y1="14" x2="352" y2="${Hh - 14}" stroke="${GRID}"/>
    <text x="${x0}" y="24" fill="${MUTED}" font-size="10.5" font-family="var(--font-data)">THE RANKING'S OWN ARITHMETIC</text>
    <text x="${x0}" y="56" fill="${INK}" font-size="11">alerted ha inside any catchment, 12 months</text>
    <rect x="${x0}" y="64" width="${b1.toFixed(1)}" height="16" rx="2" fill="${TEAL}"/>
    <text x="${(x0 + b1 + 8).toFixed(1)}" y="${76}" fill="${TEAL}" font-size="11" font-family="var(--font-data)">${num(ID.in_catchment_12m_ha)}</text>
    <text x="${x0}" y="112" fill="${INK}" font-size="11">the per-mill pressure the page publishes, summed</text>
    <rect x="${x0}" y="120" width="${b2.toFixed(1)}" height="16" rx="2" fill="${LOSS}"/>
    <text x="${(x0 + b2 - 8).toFixed(1)}" y="${132}" fill="#170A04" font-size="11" text-anchor="end" font-family="var(--font-data)">${num(ID.pressure_sum_ha)}</text>
    <text x="${x0}" y="176" fill="${LOSS}" font-size="20" font-family="var(--font-display)">${ID.double_count}×</text>
    <text x="${x0 + 62}" y="176" fill="${LOSS}" font-size="11.5">over-count in the ranked column</text>
    <text x="${x0}" y="202" fill="${MUTED}" font-size="10.5">${ID.n_mills_with_pressure} of ${ID.n_mills} mills carry a</text>
    <text x="${x0}" y="218" fill="${MUTED}" font-size="10.5">non-zero score.</text>
  </svg>`;
}

/* ── Figure 7 · what the sensor is allowed to see ────────────────────────────────── */
function fig7() {
  const W = 720, Hh = 296, Lm = 208, Rm = 92, T = 52;
  const rows = [
    { k: "SDPT v2 · this case's layer", v: (D.sdpt_palm_ha as number) / 1e6, c: LOSS },
    { k: "Gaveau 2022 · adjusted", v: D.gaveau_adjusted_mha as number, c: SLATE },
    { k: "Gaveau 2022 · mapped", v: D.gaveau_mapped_mha as number, c: SLATE },
    { k: "Descals 2021 · estimate", v: D.descals_estimate_mha as number, c: SLATE },
    { k: "Descals 2021 · mapped", v: D.descals_mapped_mha as number, c: SLATE },
    { k: "…of SDPT inside the domain", v: (D.palm_in_domain_ha as number) / 1e6, c: TEAL },
  ];
  const max = Math.max(...rows.map((r0) => r0.v));
  const rh = 38;
  const sx = (v: number) => Lm + (v / max) * (W - Lm - Rm);
  const body = rows.map((r0, i) => {
    const y = T + i * rh;
    return `<text x="${Lm - 12}" y="${y + 17}" fill="${i === 5 ? TEAL : INK}" font-size="11.5" text-anchor="end">${r0.k}</text>
      <rect x="${Lm}" y="${y + 5}" width="${(sx(r0.v) - Lm).toFixed(1)}" height="17" rx="2" fill="${r0.c}" opacity="${i === 0 || i === 5 ? 0.95 : 0.55}"/>
      <text x="${(sx(r0.v) + 9).toFixed(1)}" y="${y + 18}" fill="${i === 5 ? TEAL : i === 0 ? LOSS : MUTED}" font-size="11" font-family="var(--font-data)">${r0.v.toFixed(2)} Mha</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Indonesian oil palm extent in the layer this case uses against two published remote-sensed maps, and the small fraction of it that lies inside the alert detection domain">
    <text x="${Lm - 12}" y="24" fill="${MUTED}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">MAPPED INDONESIAN OIL PALM</text>
    <line x1="${Lm}" y1="${T - 10}" x2="${Lm}" y2="${T + rows.length * rh - 6}" stroke="${GRID}"/>
    <line x1="${Lm}" y1="${T + 5 * rh - 4}" x2="${W - Rm}" y2="${T + 5 * rh - 4}" stroke="${GRID}" stroke-dasharray="3 3"/>
    ${body}
    <text x="${Lm}" y="${T + rows.length * rh + 20}" fill="${TEAL}" font-size="10.5">${pct(1 - (D.palm_in_domain_share as number), 1)} of the estate is invisible to this instrument.</text>
  </svg>`;
}

/* ── Figure 8 · what two-sensor agreement measures ───────────────────────────────── */
function fig8() {
  const rows = S.by_size as any[];
  const W = 720, Hh = 300, Lm = 56, Rm = 150, T = 30, B = 50;
  const iw = (W - Lm - Rm) / rows.length;
  const sy = (v: number) => Hh - B - v * (Hh - T - B);
  const bars = rows.map((b, i) => {
    const x = Lm + i * iw + iw * 0.2, w = iw * 0.6;
    const inGate = ["5-20", "20-100", "100+"].includes(b.band);
    return `<g class="ag" data-b="${esc(b.band)}" data-e="${num(b.events)}" data-a="${pct(b.agree, 1)}">
      <rect x="${x.toFixed(1)}" y="${sy(b.agree).toFixed(1)}" width="${w.toFixed(1)}" height="${(sy(0) - sy(b.agree)).toFixed(1)}"
        rx="2" fill="${inGate ? TEAL : "#3C5A42"}" opacity="0.9"/>
      <text x="${(x + w / 2).toFixed(1)}" y="${(sy(b.agree) - 7).toFixed(1)}" fill="${inGate ? TEAL : MUTED}" font-size="10.5" text-anchor="middle" font-family="var(--font-data)">${pct(b.agree, 0)}</text>
      <text x="${(x + w / 2).toFixed(1)}" y="${Hh - B + 17}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${esc(b.band)}</text>
      <text x="${(x + w / 2).toFixed(1)}" y="${Hh - B + 31}" fill="${MUTED}" font-size="9.5" text-anchor="middle" opacity="0.75">${num(b.events)}</text></g>`;
  }).join("");
  const gl = [0, 0.25, 0.5, 0.75, 1].map((v) =>
    `<line x1="${Lm}" y1="${sy(v).toFixed(1)}" x2="${W - Rm}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.7"/>
     <text x="${Lm - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10.5" text-anchor="end">${(v * 100).toFixed(0)}%</text>`).join("");
  const gate = sy(S.gate_share as number), all = sy(S.agree_all_events as number);
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Optical confirmation of radar alerts rises steadily with event size, from 43 percent for the smallest events to 87 percent for the largest">
    ${gl}${bars}
    <line x1="${Lm}" y1="${gate.toFixed(1)}" x2="${W - Rm}" y2="${gate.toFixed(1)}" stroke="${TEAL}" stroke-dasharray="4 4"/>
    <line x1="${Lm}" y1="${all.toFixed(1)}" x2="${W - Rm}" y2="${all.toFixed(1)}" stroke="${MUTED}" stroke-dasharray="4 4"/>
    <text x="${W - Rm + 10}" y="${(gate + 4).toFixed(1)}" fill="${TEAL}" font-size="10.5" font-family="var(--font-data)">${pct(S.gate_share, 1)} published</text>
    <text x="${W - Rm + 10}" y="${(gate + 18).toFixed(1)}" fill="${MUTED}" font-size="9.5">${pct(S.gate_event_share, 1)} of events</text>
    <text x="${W - Rm + 10}" y="${(all + 4).toFixed(1)}" fill="${MUTED}" font-size="10.5" font-family="var(--font-data)">${pct(S.agree_all_events, 1)} all events</text>
    <text x="${((Lm + W - Rm) / 2).toFixed(1)}" y="${Hh - 6}" fill="${MUTED}" font-size="11" text-anchor="middle">event size band, hectares (event count beneath)</text>
  </svg>`;
}

/* ── Figure 9 · how far radar leads optical ──────────────────────────────────────── */
function fig9() {
  const W = 720, Hh = 280, Lm = 54, Rm = 26, T = 44, B = 52;
  const hist = S.lead_hist as number[], edges = S.lead_edges as number[];
  const max = Math.max(...hist);
  const iw = (W - Lm - Rm) / hist.length;
  const sy = (v: number) => Hh - B - (v / max) * (Hh - T - B);
  const bars = hist.map((v, i) => {
    const x = Lm + i * iw + 1.5, w = iw - 3;
    const first = edges[i] >= 0;
    return `<g class="ld" data-a="${edges[i]}" data-b="${edges[i + 1]}" data-n="${num(v)}">
      <rect x="${x.toFixed(1)}" y="${sy(v).toFixed(1)}" width="${w.toFixed(1)}" height="${(sy(0) - sy(v)).toFixed(1)}"
        rx="1.5" fill="${first ? LOSS : SLATE}" opacity="0.88"/></g>`;
  }).join("");
  const zx = Lm + 6 * iw;
  const medX = Lm + ((S.lead.median as number) + 60) / 120 * (W - Lm - Rm);
  const xt = [-60, -40, -20, 0, 20, 40, 60].map((v) =>
    `<text x="${(Lm + (v + 60) / 120 * (W - Lm - Rm)).toFixed(1)}" y="${Hh - B + 18}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${v > 0 ? "+" + v : v}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Distribution of the number of days by which the radar alert precedes the optical alert for the same clearing; the median lead is 20 days">
    <text x="${Lm}" y="20" fill="${SLATE}" font-size="10.5" font-family="var(--font-data)">← optical first</text>
    <text x="${W - Rm}" y="20" fill="${LOSS}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">radar first → ${pct(S.lead.share_radar_first, 0)} of pairs</text>
    ${bars}
    <line x1="${zx.toFixed(1)}" y1="${T - 8}" x2="${zx.toFixed(1)}" y2="${Hh - B}" stroke="${MUTED}" opacity="0.8"/>
    <line x1="${medX.toFixed(1)}" y1="${T - 8}" x2="${medX.toFixed(1)}" y2="${Hh - B}" stroke="${INK}" stroke-dasharray="3 3"/>
    <text x="${(medX - 7).toFixed(1)}" y="${T - 12}" fill="${INK}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">median +${S.lead.median} days</text>
    <text x="${Lm - 6}" y="${(sy(max) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end" font-family="var(--font-data)">${num(max)}</text>
    <text x="${Lm - 6}" y="${(sy(0) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end" font-family="var(--font-data)">0</text>
    ${xt}
    <text x="${((Lm + W - Rm) / 2).toFixed(1)}" y="${Hh - 12}" fill="${MUTED}" font-size="11.5" text-anchor="middle">days between the radar detection and the optical one, ${num(S.lead.n_in_window)} matched events →</text>
  </svg>`;
}

/* ── Figure 10 · what reconciles ─────────────────────────────────────────────────── */
function fig10() {
  const W = 720, Hh = 232, Lm = 190, Rm = 106, T = 44, rh = 44;
  const pairs = [
    { k: "Tree-cover loss 2023", ours: A.divergence.gfw_tree_cover_loss_ha["2023"], ref: A.divergence.gfw_published_ha["2023"] },
    { k: "Tree-cover loss 2024", ours: A.divergence.gfw_tree_cover_loss_ha["2024"], ref: A.divergence.gfw_published_ha["2024"] },
    { k: "Primary-forest loss 2023", ours: L.our_primary_loss["2023"], ref: L.gfw_published_primary_loss["2023"] },
    { k: "Primary-forest loss 2024", ours: L.our_primary_loss["2024"], ref: L.gfw_published_primary_loss["2024"] },
  ];
  const max = Math.max(...pairs.map((p) => Math.max(p.ours, p.ref)));
  const sx = (v: number) => Lm + (v / max) * (W - Lm - Rm);
  const body = pairs.map((p, i) => {
    const y = T + i * rh;
    const d = 100 * (p.ours / p.ref - 1);
    return `<text x="${Lm - 12}" y="${y + 16}" fill="${INK}" font-size="11.5" text-anchor="end">${p.k}</text>
      <rect x="${Lm}" y="${y + 3}" width="${(sx(p.ours) - Lm).toFixed(1)}" height="11" rx="2" fill="${LOSS}" opacity="0.9"/>
      <rect x="${Lm}" y="${y + 17}" width="${(sx(p.ref) - Lm).toFixed(1)}" height="11" rx="2" fill="${TEAL}" opacity="0.9"/>
      <text x="${W - Rm + 10}" y="${y + 19}" fill="${MUTED}" font-size="11" font-family="var(--font-data)">${d >= 0 ? "+" : ""}${d.toFixed(2)}%</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Our independently recomputed hectares against Global Forest Watch's own published totals, agreeing to under one percent in all four comparisons">
    <rect x="${Lm}" y="14" width="10" height="10" rx="2" fill="${LOSS}"/><text x="${Lm + 15}" y="23" fill="${MUTED}" font-size="10.5">this pipeline, recomputed from the tiles</text>
    <rect x="${Lm + 250}" y="14" width="10" height="10" rx="2" fill="${TEAL}"/><text x="${Lm + 265}" y="23" fill="${MUTED}" font-size="10.5">GFW published</text>
    ${body}
  </svg>`;
}

const F1 = fig1(), F2 = fig2(), F3 = figProv(), F4 = figLift(), F5 = fig5();
const F6 = fig6(), F7 = fig7(), F8 = fig8(), F9 = fig9(), F10 = fig10();

const BASE = "/forest";
const lossYears = `${L.years[0]}–${L.years[L.years.length - 1]}`;
const riau = (C.provinces as any[]).find((p) => p.province === "Riau");
const nkal = (C.provinces as any[]).find((p) => p.province === "North Kalimantan");
const jambi = (C.provinces as any[]).find((p) => p.province === "Jambi");
const wpap = (C.provinces as any[]).find((p) => p.province === "West Papua");
const g1 = A.gates["G-H1"], g2 = A.gates["G-H2"], g3 = A.gates["G-H3"], g4 = A.gates["G-H4"];
const tclDiff24 = ((A.divergence.gfw_tree_cover_loss_ha["2024"] /
  A.divergence.gfw_published_ha["2024"] - 1) * 100).toFixed(2);
/* How the published radius ranks among the radii tested, worst-first — stated rather than
   asserted, because "least informative" would be wrong (75 and 100 km are worse). */
const liftRank = (C.radii as number[])
  .map((k) => ({ km: k, lift: (C.national as any)[String(k)].lift_vs_domain as number }))
  .sort((a, b) => a.lift - b.lift);
const worseThan50 = liftRank.filter((r0) => r0.lift < (C.national as any)["50"].lift_vs_domain)
  .sort((a, b) => a.km - b.km).map((r0) => `${r0.km} km`).join(" and ");
---
<html lang="en" data-case="forest" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Does a Mill Catchment Tell You Anything?</title>
    <meta name="description" content="An adversarial review of radar deforestation alerts linked to palm-mill catchments in Indonesia: base rates, size floors, and what spatial coincidence can and cannot support." />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" />
  </head>
  <body>
    <header class="bar">
      <a class="back" href={`${BASE}/`}>← The instrument</a>
      <span class="stamp dim">REVIEW ARTICLE · {A.vintages.radd}</span>
    </header>

    <article>
      <div class="masthead">
        <span class="eyebrow">METHODS &amp; VALIDATION · FOREST &amp; COMMODITY WATCH</span>
        <h1>Does a mill catchment tell you anything?</h1>
        <p class="standfirst">The case reports that <b>{pct(R.linked_share_ha, 1)} of alerted hectares
        fall inside a palm-mill sourcing catchment</b>. A conditional share is only informative
        against its base rate, and nobody had computed one. We do — and then ask the same question of
        every other number on the page.</p>
        <div class="byline">
          <span>Demo Lab · FMV</span>
          <span>{A.vintages.radd}</span>
          <span>{num(R.events)} events · {num(R.ha)} ha</span>
        </div>
      </div>

      <section class="abstract">
        <h2>Abstract</h2>
        <p><b>Question.</b> Weekly radar alerts can say <i>where</i> forest was disturbed. The case
        goes further and says <i>whose commodity system it was disturbed in</i>. We ask how much of
        that second claim survives the base rate, the size filter, and the difference between
        tree-cover loss and deforestation.</p>
        <p><b>Method.</b> We re-derive every headline from the case's own published outputs, then add
        three tests it never ran: a lattice sample of the alert instrument's entire detection domain
        with the distance to the nearest of {num(R.n_mills)} mills at every point ({num(C.domain_ha)} ha
        sampled at {C.lattice_m} m); a crossing of {lossYears} Hansen tree-cover loss with mapped
        plantation extent and the 2001 primary-forest mask at native 30 m; and a recomputation of
        the catchment share with the {R.min_cluster_ha} ha event floor removed.</p>
        <p><b>Findings.</b> <b>{pct(H.domain_base, 1)}</b> of the land where an alert
        can physically be raised is <i>already</i> within {R.mill_radius_km} km of a mill, and
        {pct(H.land_base, 1)} of all Indonesian land is. The observed {pct(H.alert, 1)} is therefore a
        lift of <b>{H.lift}×</b> over chance, not a finding of near-universal palm linkage — and on
        unfiltered alert hectares it falls to {pct(H.unfiltered, 1)}, a lift of {H.unfiltered_lift}×.
        The lift is <b>{C.best_radius.lift}×</b> at {C.best_radius.km} km — of the
        {(C.radii as number[]).length} radii tested only {worseThan50} discriminate less than the
        published {R.mill_radius_km} km. In Riau, where the case's own linkage check passes at
        {pct(g4.riau_linked_share, 1)}, the base rate is {pct(riau.domain_base_50, 1)}: the check
        cannot fail. Attribution is not identified either — a mean of
        <b>{ID.mills.mean_over_alert_ha_in_catchment.toFixed(2)} mills</b> claim every in-catchment
        hectare, and the per-mill pressure the page ranks sums to <b>{ID.double_count}×</b> the
        hectares that exist. Separately, <b>{pct(L.grand_plantation_share, 1)}</b> of Indonesia's
        {mha(L.grand_total_ha)} of {lossYears} tree-cover loss falls inside land already mapped as
        plantation — the loss-is-not-deforestation gap, measured rather than asserted. The pipeline
        itself reconciles: our recomputed primary-forest loss lands within
        {L.primary_reconciliation_pct["2024"]}% of GFW's published Indonesian figure.</p>
        <p><b>Conclusion.</b> This is a <i>triage</i> instrument, not an <i>attribution</i>
        instrument. Read as "which weeks and which frontiers deserve a look", it is strong and
        unusually well plumbed. Read as "three-quarters of this clearing belongs to the palm supply
        chain", it says less than it appears to, and in the palm heartland it says nothing at all.</p>
      </section>

      <nav class="toc">
        <a href="#s1">1 · The claim under test</a><a href="#s2">2 · What the literature attributes</a>
        <a href="#s3">3 · Data and instrument</a><a href="#s4">4 · Loss is not deforestation</a>
        <a href="#s5">5 · The base rate</a><a href="#s6">6 · The wrong radius</a>
        <a href="#s7">7 · The size floor</a><a href="#s8">8 · Eight mills per hectare</a>
        <a href="#s9">9 · The sensor's domain</a><a href="#s10">10 · What agreement measures</a>
        <a href="#s11">11 · What reconciles</a><a href="#s12">12 · What follows for decisions</a>
        <a href="#s13">13 · Corrections</a><a href="#refs">References</a>
