    <script>
      /* Hover read-outs. Pure SVG + DOM, no GPU path anywhere on this page. */
      const tip = document.getElementById("tip");
      const show = (html, e) => {
        tip.innerHTML = html; tip.hidden = false;
        const r = tip.getBoundingClientRect();
        let x = e.clientX + 14, y = e.clientY + 14;
        if (x + r.width > innerWidth - 8) x = Math.max(8, e.clientX - r.width - 14);
        if (y + r.height > innerHeight - 8) y = Math.max(8, e.clientY - r.height - 14);
        tip.style.left = x + "px"; tip.style.top = y + "px";
      };
      const bind = (sel, fmt) => document.querySelectorAll(sel).forEach((el) => {
        el.addEventListener("mousemove", (e) => show(fmt(el.dataset), e));
        el.addEventListener("mouseleave", () => { tip.hidden = true; });
      });
      bind(".yr", (d) => `<b>${d.y}</b><br>total ${d.t} ha<br>oil palm ${d.p}<br>wood fibre ${d.w}` +
        `<br>rubber ${d.r}<br>outside plantation ${d.o}<br>inside plantation ${d.s}`);
      bind(".lf", (d) => `<b>${d.r} km catchment</b><br>base rate ${d.b}<br>alerted ${d.a}<br>lift ${d.l}×`);
      bind(".pv", (d) => `<b>${d.n}</b><br>${d.h} alerted ha<br>base rate ${d.b}<br>alerted ${d.a}<br>lift ${d.l}×`);
      bind(".sz", (d) => `<b>${d.b} ha events</b><br>${d.e} events · ${d.h} ha<br>inside a catchment ${d.w}<br>median mill ${d.m} km`);
      bind(".ag", (d) => `<b>${d.b} ha events</b><br>${d.e} events<br>optical confirms ${d.a}`);
      bind(".ld", (d) => `<b>${d.a} to ${d.b} days</b><br>${d.n} events`);
    </script>
  
