      .smallmults { display: grid; gap: 12px;
                    grid-template-columns: repeat(auto-fill, minmax(178px, 1fr)); }
      .sm { border: 1px solid var(--hairline); border-radius: 8px; padding: 10px 12px 6px;
            background: color-mix(in srgb, var(--ground) 40%, transparent);
            transition: transform .25s cubic-bezier(.2,.8,.3,1), border-color .25s, box-shadow .25s; }
      .sm:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--loss) 55%, var(--hairline));
