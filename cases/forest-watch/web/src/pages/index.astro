                       color: var(--ink); cursor: pointer; }
      input[type=checkbox] { accent-color: var(--loss); width: 15px; height: 15px; cursor: pointer; }
      .count { color: var(--ink) !important; font-size: 12px !important; }
      .dl { font-family: var(--font-data); font-size: 11px; letter-spacing: 0.06em; }
      .mapwrap { grid-area: map; position: relative; border: 1px solid var(--hairline);
