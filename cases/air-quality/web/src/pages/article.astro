    <script>
      /* Hover read-outs. Pure SVG and DOM — no GPU path anywhere on this page. */
      const tip = document.getElementById("tip");
      const show = (html, e) => {
        tip.innerHTML = html;
        tip.hidden = false;
        const r = tip.getBoundingClientRect();
        let x = e.clientX + 14, y = e.clientY + 14;
        if (x + r.width > innerWidth - 8) x = Math.max(8, e.clientX - r.width - 14);
        if (y + r.height > innerHeight - 8) y = Math.max(8, e.clientY - r.height - 14);
        tip.style.left = x + "px";
        tip.style.top = y + "px";
      };
      const hide = () => { tip.hidden = true; };
      document.querySelectorAll(".hv").forEach((el) => {
        el.addEventListener("pointermove", (e) => {
          const d = el.dataset;
          show(`<b>${d.t}</b><br>${d.b}`, e);
        });
        el.addEventListener("pointerleave", hide);
      });
      document.querySelectorAll(".cp").forEach((el) => {
        el.addEventListener("pointermove", (e) => {
          const d = el.dataset;
          show(`${d.a} vs ${d.b} µg/m³<br>difference ${(Number(d.a) - Number(d.b)).toFixed(1)}`, e);
        });
        el.addEventListener("pointerleave", hide);
      });
      addEventListener("scroll", hide, { passive: true });
    </script>
  
