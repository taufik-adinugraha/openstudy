---
/* Review article — the case, stress-tested against the published literature.
 *
 * Every figure is built in frontmatter from data/article.json, which pipeline/article.py
 * derives from the case's own published output and from pipeline/replicate.py's
 * independent re-derivation. Nothing here is drawn by hand, so the prose cannot drift
 * from the numbers. SVG only: no WebGL, no canvas.
 */
import "../styles/tokens.css";
import { glossaryFor } from "../data/glossary.js";
import __src from "./article.astro?raw";
import A from "../data/article.json";

const CYAN = "#6FC7D6", CORAL = "#E08B54", TEAL = "#4BB8A9", AMBER = "#E0A63F", SLATE = "#6B7CA6";
const INK = "#E9EBEE", MUTED = "#97A1AC", GRID = "#262E3A";

const pct = (x: number, d = 1) => `${(x * 100).toFixed(d)}%`;
const spct = (x: number, d = 1) => `${x >= 0 ? "+" : ""}${(x * 100).toFixed(d)}%`;
const n1 = (x: number) => x.toFixed(1);
const n2 = (x: number) => x.toFixed(2);
const n0 = (x: number) => Math.round(x).toLocaleString("en-US");
const esc = (s: any) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;")
  .replace(/>/g, "&gt;").replace(/"/g, "&quot;");

const L = A.lit;
const G = Object.fromEntries(A.gates.map((g: any) => [g.id, g]));
const H = Object.fromEntries(A.horizons.map((r: any) => [r.horizon_h, r]));
const h24 = H[24], e24 = A.model.h24, GR = A.gateRetest, BT = A.bootstrap24;
const CO = A.colocation, FM = A.panel.fmqo, EP = A.episodes;
const ceil24 = EP.ceiling.find((c: any) => c.horizon_h === 24);
const rung = (t: number) => EP.ladder.find((r: any) => r.threshold === t);
const bl24 = Object.fromEntries(h24.baselines.map((b: any) => [b.key, b]));
const prov = Object.fromEntries(A.providers.rows.map((p: any) => [p.provider, p]));
const bjs = L.beijing.rows.find((r: any) => r.h === 24);
const fresh = A.unseen.fresh[0];
const acfAt = (l: number) => A.acf.find((a: any) => a.lag === l).r;
const peakCov = Math.max(...A.panel.coverage.map((c: any) => c.n_80));
const euPoints = Math.round(L.standards.jabodetabek_millions * L.standards.eu_points_per_million);
const lastMonths = A.panel.months.filter((m: any) => m.ym >= "2026-03");
const lastMonthRows = lastMonths.reduce((s: number, m: any) => s + m.n_rows, 0);
const fireAug = A.fire.monthly[A.fire.monthly.length - 1];
const augObsHours = A.panel.coverage[A.panel.coverage.length - 1];
const seenSkill = A.unseen.seen_mean_skill, seenPI = A.unseen.seen_mean_pi80;
/* Where the co-located pair stops agreeing, and on how much evidence. Stated so the
   reader can weigh it: the divergence is large but the shared hours behind it are few,
   because the surviving instrument's own reporting collapsed at the same time. */
const coBreak = CO.monthly.findIndex((m: any) => Math.abs(m.a - m.b) > 3 * CO.mae);
const coAfter = CO.monthly.slice(Math.max(0, coBreak));
const coAfterHours = coAfter.reduce((s: number, m: any) => s + m.n, 0);
const coBefore = CO.monthly.slice(0, Math.max(0, coBreak));
const coBeforeHours = coBefore.reduce((s: number, m: any) => s + m.n, 0);
const coLast = CO.monthly[CO.monthly.length - 1];
const nGates = A.gates_total, nPass = A.gates_passed;

/* ── Figure 1 · the observing system, month by month ───────────────────────── */
function fig1() {
  const W = 720, Ht = 330, ML = 46, MR = 122, MT = 22, MB = 54;
  const rows = A.panel.coverage;
  const n = rows.length;
  const ymax = Math.max(...rows.map((r: any) => r.n_any), 10);
  const sx = (i: number) => ML + (i / (n - 1)) * (W - ML - MR);
  const sy = (v: number) => Ht - MB - (v / ymax) * (Ht - MT - MB);
  const cutIdx = rows.findIndex((r: any) => r.ym >= A.vintage.cut.slice(0, 7));
  const line = (key: string, col: string, w = 2.2) =>
    `<path fill="none" stroke="${col}" stroke-width="${w}" stroke-linejoin="round" d="${rows.map((r: any, i: number) =>
      `${i ? "L" : "M"}${sx(i).toFixed(1)} ${sy(r[key]).toFixed(1)}`).join("")}"/>`;
  const area = `<path fill="${CYAN}" opacity="0.1" d="M${sx(0).toFixed(1)} ${sy(0)} ${rows.map((r: any, i: number) =>
    `L${sx(i).toFixed(1)} ${sy(r.n_any).toFixed(1)}`).join("")} L${sx(n - 1).toFixed(1)} ${sy(0)} Z"/>`;
  const grid = [0, 3, 6, 9].filter((v) => v <= ymax).map((v) =>
    `<line x1="${ML}" y1="${sy(v).toFixed(1)}" x2="${W - MR}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.6"/>
     <text x="${ML - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10.5" text-anchor="end">${v}</text>`).join("");
  const epa = `<line x1="${ML}" y1="${sy(3).toFixed(1)}" x2="${W - MR}" y2="${sy(3).toFixed(1)}" stroke="${CORAL}" stroke-dasharray="4 4" stroke-width="1.4"/>
    <text x="${ML + 4}" y="${(sy(3) - 9).toFixed(1)}" fill="${CORAL}" font-size="10" font-family="var(--font-data)">US minimum · 3</text>`;
  const ticks = rows.map((r: any, i: number) => (r.ym.endsWith("-01") || r.ym.endsWith("-07"))
    ? `<text x="${sx(i).toFixed(1)}" y="${Ht - MB + 18}" fill="${MUTED}" font-size="9.5" text-anchor="middle" font-family="var(--font-data)">${r.ym.slice(2).replace("-", "·")}</text>` : "").join("");
  const cut = cutIdx > 0
    ? `<line x1="${sx(cutIdx).toFixed(1)}" y1="${MT}" x2="${sx(cutIdx).toFixed(1)}" y2="${Ht - MB}" stroke="${MUTED}" stroke-dasharray="3 4" opacity="0.65"/>
       <text x="${(sx(cutIdx) + 5).toFixed(1)}" y="${MT + 10}" fill="${MUTED}" font-size="9.5" font-family="var(--font-data)">training cut</text>` : "";
  const dots = rows.map((r: any, i: number) =>
    `<circle class="hv" cx="${sx(i).toFixed(1)}" cy="${sy(r.n_any).toFixed(1)}" r="7" fill="transparent"
      data-t="${r.ym}" data-b="${r.n_any} reporting · ${r.n_80} at 80% completeness · ${n0(r.obs_hours)} observed hours"/>`).join("");
  const key = [["reporting at all", CYAN], ["≥50% complete", TEAL], ["≥80% complete", AMBER]]
    .map(([t, c], i) => `<line x1="${W - MR + 8}" y1="${MT + 16 + i * 20}" x2="${W - MR + 22}" y2="${MT + 16 + i * 20}" stroke="${c}" stroke-width="2.4"/>
      <text x="${W - MR + 28}" y="${MT + 20 + i * 20}" fill="${MUTED}" font-size="10">${t}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Ht}" class="fig" role="img" aria-label="Number of Jabodetabek PM2.5 stations reporting each month, rising to nine in 2024 and falling to one by 2026">
    ${grid}${area}${epa}${cut}
    ${line("n_any", CYAN)}${line("n_50", TEAL, 1.8)}${line("n_80", AMBER, 1.8)}
    ${dots}${ticks}${key}
    <text x="${((ML + W - MR) / 2).toFixed(1)}" y="${Ht - 12}" fill="${MUTED}" font-size="11" text-anchor="middle">stations returning PM2.5 in each calendar month</text>
  </svg>`;
}

/* ── Figure 2 · the diurnal echo, and what it does to persistence ──────────── */
function fig2() {
  const W = 720, Ht = 400, ML = 52, MR = 22, MT = 24, GAP = 46;
  const topH = 168, botY = MT + topH + GAP, botH = 118;
  const maxLag = 72;
  const sx = (l: number) => ML + ((l - 1) / (maxLag - 1)) * (W - ML - MR);
  const a0 = 0, a1 = 0.9;
  const say = (v: number) => MT + topH - ((v - a0) / (a1 - a0)) * topH;
  const acfPath = A.acf.map((a: any, i: number) => `${i ? "L" : "M"}${sx(a.lag).toFixed(1)} ${say(a.r).toFixed(1)}`).join("");
  const peaks = [24, 48, 72], troughs = [12, 36, 60];
  const mark = (l: number, col: string, lab: string) => {
    const r = acfAt(l);
    return `<circle cx="${sx(l).toFixed(1)}" cy="${say(r).toFixed(1)}" r="4" fill="${col}"/>
      <text x="${sx(l).toFixed(1)}" y="${(say(r) + (col === AMBER ? -11 : 16)).toFixed(1)}" fill="${col}" font-size="10" text-anchor="middle" font-family="var(--font-data)">${lab}</text>`;
  };
  const agrid = [0, 0.3, 0.6, 0.9].map((v) =>
    `<line x1="${ML}" y1="${say(v).toFixed(1)}" x2="${W - MR}" y2="${say(v).toFixed(1)}" stroke="${GRID}" opacity="0.6"/>
     <text x="${ML - 8}" y="${(say(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">${v.toFixed(1)}</text>`).join("");
  // lower panel — MAE by horizon, model vs persistence, on the same lag axis
  const hs = A.echo;
  const m0 = 0, m1 = Math.max(...hs.map((r: any) => r.persist_mae)) * 1.12;
  const my = (v: number) => botY + botH - ((v - m0) / (m1 - m0)) * botH;
  const mgrid = [0, 10, 20].map((v) =>
    `<line x1="${ML}" y1="${my(v).toFixed(1)}" x2="${W - MR}" y2="${my(v).toFixed(1)}" stroke="${GRID}" opacity="0.6"/>
     <text x="${ML - 8}" y="${(my(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">${v}</text>`).join("");
  const mpath = (key: string, col: string) =>
    `<path fill="none" stroke="${col}" stroke-width="2.2" d="${hs.map((r: any, i: number) =>
      `${i ? "L" : "M"}${sx(r.h).toFixed(1)} ${my(r[key]).toFixed(1)}`).join("")}"/>` +
    hs.map((r: any) => `<circle class="hv" cx="${sx(r.h).toFixed(1)}" cy="${my(r[key]).toFixed(1)}" r="4.5" fill="${col}"
      data-t="${key === "persist_mae" ? "Persistence" : "Model"} at ${r.h} h" data-b="MAE ${n2(r[key])} µg/m³ · lag-${r.h} autocorrelation ${r.acf ? r.acf.toFixed(2) : "—"}"/>`).join("");
  const guides = [...peaks, ...troughs].map((l) =>
    `<line x1="${sx(l).toFixed(1)}" y1="${MT}" x2="${sx(l).toFixed(1)}" y2="${botY + botH}" stroke="${peaks.includes(l) ? AMBER : SLATE}" stroke-dasharray="2 5" opacity="0.35"/>`).join("");
  const xt = [1, 12, 24, 36, 48, 60, 72].map((l) =>
    `<text x="${sx(l).toFixed(1)}" y="${botY + botH + 18}" fill="${MUTED}" font-size="10" text-anchor="middle" font-family="var(--font-data)">${l}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Ht}" class="fig" role="img" aria-label="Hourly PM2.5 autocorrelation peaks at 24, 48 and 72 hours and troughs at 12, 36 and 60, and persistence error mirrors it exactly">
    ${guides}${agrid}
    <path fill="none" stroke="${CYAN}" stroke-width="2" d="${acfPath}"/>
    ${peaks.map((l) => mark(l, AMBER, `${l}h`)).join("")}
    ${troughs.map((l) => mark(l, SLATE, `${l}h`)).join("")}
    <text x="${ML}" y="${MT - 8}" fill="${INK}" font-size="11.5">Autocorrelation of hourly PM2.5, by lag</text>
    ${mgrid}${mpath("persist_mae", CORAL)}${mpath("model_mae", CYAN)}
    <text x="${ML}" y="${botY - 10}" fill="${INK}" font-size="11.5">Mean absolute error at that lead, µg/m³</text>
    <text x="${(W - MR - 6).toFixed(1)}" y="${botY - 10}" fill="${CORAL}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">persistence</text>
    <text x="${(W - MR - 92).toFixed(1)}" y="${botY - 10}" fill="${CYAN}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">model</text>
    ${xt}
    <text x="${((ML + W - MR) / 2).toFixed(1)}" y="${Ht - 8}" fill="${MUTED}" font-size="11" text-anchor="middle">lead time / lag, hours →</text>
  </svg>`;
}

/* ── Figure 3 · skill by horizon under two rulers ──────────────────────────── */
function fig3() {
  const W = 720, Ht = 322, ML = 50, MR = 162, MT = 26, MB = 52;
  const hs = A.echo, n = hs.length;
  const sx = (i: number) => ML + (i / (n - 1)) * (W - ML - MR);
  const y0 = 0, y1 = 0.34;
  const sy = (v: number) => Ht - MB - ((v - y0) / (y1 - y0)) * (Ht - MT - MB);
  const grid = [0, 0.1, 0.2, 0.3].map((v) =>
    `<line x1="${ML}" y1="${sy(v).toFixed(1)}" x2="${W - MR}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.6"/>
     <text x="${ML - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">${(v * 100).toFixed(0)}%</text>`).join("");
  const gate = `<line x1="${ML}" y1="${sy(GR.threshold).toFixed(1)}" x2="${W - MR}" y2="${sy(GR.threshold).toFixed(1)}" stroke="${AMBER}" stroke-dasharray="5 4" stroke-width="1.5"/>
    <text x="${ML + 4}" y="${(sy(GR.threshold) - 7).toFixed(1)}" fill="${AMBER}" font-size="10" font-family="var(--font-data)">the case's own threshold · ${pct(GR.threshold, 0)}</text>`;
  const path = (key: string, col: string) =>
    `<path fill="none" stroke="${col}" stroke-width="2.4" d="${hs.map((r: any, i: number) =>
      `${i ? "L" : "M"}${sx(i).toFixed(1)} ${sy(r[key]).toFixed(1)}`).join("")}"/>`;
  const dots = (key: string, col: string, nameKey: string | null) => hs.map((r: any, i: number) =>
    `<circle class="hv" cx="${sx(i).toFixed(1)}" cy="${sy(r[key]).toFixed(1)}" r="4.6" fill="${col}"
      data-t="${r.h} hours ahead" data-b="${spct(r[key])} against ${nameKey ? esc(r[nameKey]) : "persistence"}${nameKey ? ` (MAE ${n2(r.best_mae)})` : ` (MAE ${n2(r.persist_mae)})`}"/>`).join("");
  const xt = hs.map((r: any, i: number) =>
    `<text x="${sx(i).toFixed(1)}" y="${Ht - MB + 19}" fill="${MUTED}" font-size="10.5" text-anchor="middle" font-family="var(--font-data)">${r.h}h</text>`).join("");
  const key = [["vs persistence,", "as published", CORAL], ["vs the best", "trivial rule", CYAN]]
    .map(([t1, t2, c], i) => `<line x1="${W - MR + 8}" y1="${MT + 16 + i * 34}" x2="${W - MR + 22}" y2="${MT + 16 + i * 34}" stroke="${c}" stroke-width="2.4"/>
      <text x="${W - MR + 28}" y="${MT + 20 + i * 34}" fill="${MUTED}" font-size="10">${t1}</text>
      <text x="${W - MR + 28}" y="${MT + 32 + i * 34}" fill="${MUTED}" font-size="10">${t2}</text>`).join("");
  const shortName = (s: string) => s.replace("Last 24 h mean", "last 24 h mean")
    .replace("Diurnal climatology", "diurnal clim.").replace("Persistence", "persistence");
  const note = `<text x="${W - MR + 8}" y="${MT + 92}" fill="${MUTED}" font-size="9.5" font-family="var(--font-data)">best trivial rule:</text>` +
    hs.map((r: any, i: number) => `<text x="${W - MR + 8}" y="${MT + 108 + i * 15}" fill="${MUTED}" font-size="9" font-family="var(--font-data)">${r.h}h · ${esc(shortName(r.best_name))}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Ht}" class="fig" role="img" aria-label="Skill against persistence peaks at 31 percent at 12 hours; against the best trivial baseline it is flat near 11 percent">
    ${grid}${gate}${path("skill_persist", CORAL)}${path("skill_best", CYAN)}
    ${dots("skill_persist", CORAL, null)}${dots("skill_best", CYAN, "best_name")}
    ${xt}${key}${note}
    <text x="${((ML + W - MR) / 2).toFixed(1)}" y="${Ht - 12}" fill="${MUTED}" font-size="11" text-anchor="middle">forecast lead time →</text>
  </svg>`;
}

/* ── Figure 4 · the 24-hour baseline ladder, with intervals ────────────────── */
function fig4() {
  const rows = [{ key: "model", name: "The model", mae: h24.model_mae, skill: null as any, lo: null as any, hi: null as any }]
    .concat(h24.baselines.map((b: any) => ({
      key: b.key, name: b.name, mae: b.mae, skill: b.skill_mae,
      lo: BT[b.key]?.lo ?? null, hi: BT[b.key]?.hi ?? null,
    })).sort((x: any, y: any) => x.mae - y.mae));
  const W = 720, rh = 34, MT = 34, Ht = MT + rows.length * rh + 70;
  const NL = 198, BW = 214, SL = NL + BW + 62, SW = W - SL - 24;
  const mmax = Math.max(...rows.map((r: any) => r.mae)) * 1.03;
  const smax = 0.30;
  const ssx = (v: number) => SL + (v / smax) * SW;
  const body = rows.map((r: any, i: number) => {
    const y = MT + i * rh;
    const isM = r.key === "model";
    const col = isM ? CYAN : (r.mae === Math.min(...rows.filter((q: any) => q.key !== "model").map((q: any) => q.mae)) ? AMBER : SLATE);
    const w = (r.mae / mmax) * BW;
    const bar = `<rect x="${NL}" y="${y + 7}" width="${w.toFixed(1)}" height="16" rx="2" fill="${col}" opacity="${isM ? 1 : 0.72}"/>
      <text x="${(NL + w + 7).toFixed(1)}" y="${y + 20}" fill="${col}" font-size="10.5" font-family="var(--font-data)">${n2(r.mae)}</text>`;
    const sk = r.skill === null ? "" :
      `<line x1="${ssx(Math.max(0, r.lo)).toFixed(1)}" y1="${y + 15}" x2="${ssx(Math.min(smax, r.hi)).toFixed(1)}" y2="${y + 15}" stroke="${col}" stroke-width="1.6" opacity="0.6"/>
       <line x1="${ssx(Math.max(0, r.lo)).toFixed(1)}" y1="${y + 10}" x2="${ssx(Math.max(0, r.lo)).toFixed(1)}" y2="${y + 20}" stroke="${col}" stroke-width="1.6" opacity="0.6"/>
       <line x1="${ssx(Math.min(smax, r.hi)).toFixed(1)}" y1="${y + 10}" x2="${ssx(Math.min(smax, r.hi)).toFixed(1)}" y2="${y + 20}" stroke="${col}" stroke-width="1.6" opacity="0.6"/>
       <circle cx="${ssx(Math.min(smax, r.skill)).toFixed(1)}" cy="${y + 15}" r="4.2" fill="${col}"/>`;
    return `<text x="${NL - 12}" y="${y + 20}" fill="${isM ? INK : MUTED}" font-size="12" text-anchor="end"${isM ? ' font-weight="600"' : ""}>${esc(r.name)}</text>${bar}${sk}`;
  }).join("");
  const gate = `<line x1="${ssx(GR.threshold).toFixed(1)}" y1="${MT - 4}" x2="${ssx(GR.threshold).toFixed(1)}" y2="${MT + rows.length * rh + 4}" stroke="${AMBER}" stroke-dasharray="4 4" stroke-width="1.5"/>
    <text x="${ssx(GR.threshold).toFixed(1)}" y="${MT + rows.length * rh + 31}" fill="${AMBER}" font-size="9.5" text-anchor="middle" font-family="var(--font-data)">↑ ${pct(GR.threshold, 0)} gate</text>`;
  const sticks = [0, 0.1, 0.2, 0.3].map((v) =>
    `<text x="${ssx(v).toFixed(1)}" y="${MT + rows.length * rh + 18}" fill="${MUTED}" font-size="9.5" text-anchor="middle">${(v * 100).toFixed(0)}%</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Ht}" class="fig" role="img" aria-label="At 24 hours the model beats the best trivial baseline by 11.6 percent, whose interval lies entirely below the 15 percent gate">
    <text x="${NL}" y="${MT - 12}" fill="${MUTED}" font-size="10.5" font-family="var(--font-data)">MAE, µg/m³</text>
    <text x="${SL}" y="${MT - 12}" fill="${MUTED}" font-size="10.5" font-family="var(--font-data)">model's skill · 95% interval</text>
    ${gate}${body}${sticks}
    <text x="16" y="${Ht - 12}" fill="${MUTED}" font-size="10.5">Held-out 24-hour forecasts, ${n0(h24.n)} station-hours.</text>
    <text x="${SL}" y="${Ht - 12}" fill="${MUTED}" font-size="10.5">Intervals: day-block bootstrap, ${n0(BT.n_blocks)} blocks.</text>
  </svg>`;
}

/* ── Figure 5 · the held-out window is a shrinking panel ───────────────────── */
function fig5() {
  const months = A.panel.months;
  const ids = A.panel.by_station.map((s: any) => s.location_id);
  const names = Object.fromEntries(A.panel.by_station.map((s: any) => [s.location_id, s.name]));
  const PAL = [CYAN, AMBER, TEAL, CORAL, SLATE, "#B58BD1", "#8FBF6E", "#D97B9B"];
  const W = 720, Ht = 344, ML = 62, MR = 128, MT = 38, MB = 56;
  const n = months.length;
  const bw = (W - ML - MR) / n * 0.7;
  const step = (W - ML - MR) / n;
  const ymax = Math.max(...months.map((m: any) => m.n_rows)) * 1.06;
  const sy = (v: number) => Ht - MB - (v / ymax) * (Ht - MT - MB);
  const bars = months.map((m: any, i: number) => {
    const x = ML + i * step + (step - bw) / 2;
    let acc = 0;
    const segs = ids.map((id: number, k: number) => {
      if (!m.stations.includes(id)) return "";
      // rows are not published per station per month, so each present station is
      // drawn as an equal share of that month's scored hours — the count of bands
      // is the honest signal here, and the total height is exact.
      const v = m.n_rows / m.stations.length;
      const y0 = sy(acc + v), y1 = sy(acc); acc += v;
      return `<rect class="hv" x="${x.toFixed(1)}" y="${y0.toFixed(1)}" width="${bw.toFixed(1)}" height="${Math.max(0.6, y1 - y0).toFixed(1)}"
        fill="${PAL[k % PAL.length]}" opacity="0.85" data-t="${m.ym} · ${esc(names[id])}" data-b="${m.n_stations} station${m.n_stations === 1 ? "" : "s"} scored · ${n0(m.n_rows)} hours that month"/>`;
    }).join("");
    return segs;
  }).join("");
  // Station count sits on its own rule above the bars, so it never crosses them.
  const cnt = months.map((m: any, i: number) =>
    `<text x="${(ML + i * step + step / 2).toFixed(1)}" y="${MT - 6}" fill="${m.n_stations === 1 ? CORAL : INK}" font-size="9.5" text-anchor="middle" font-family="var(--font-data)">${m.n_stations}</text>`).join("") +
    `<text x="${ML - 8}" y="${MT - 6}" fill="${MUTED}" font-size="9" text-anchor="end" font-family="var(--font-data)">stations</text>`;
  const grid = [0, 1000, 2000, 3000].filter((v) => v <= ymax).map((v) =>
    `<line x1="${ML}" y1="${sy(v).toFixed(1)}" x2="${W - MR}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.55"/>
     <text x="${ML - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="9.5" text-anchor="end">${v ? v / 1000 + "k" : "0"}</text>`).join("");
  const xt = months.map((m: any, i: number) => i % 2 === 0
    ? `<text x="${(ML + i * step + step / 2).toFixed(1)}" y="${Ht - MB + 17}" fill="${MUTED}" font-size="9" text-anchor="middle" font-family="var(--font-data)">${m.ym.slice(2)}</text>` : "").join("");
  const key = A.panel.by_station.slice(0, 8).map((s: any, k: number) =>
    `<rect x="${W - MR + 6}" y="${MT + 6 + k * 17}" width="9" height="9" rx="2" fill="${PAL[k % PAL.length]}"/>
     <text x="${W - MR + 19}" y="${MT + 14 + k * 17}" fill="${MUTED}" font-size="9">${esc(s.name.length > 18 ? s.name.slice(0, 17) + "…" : s.name)}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Ht}" class="fig" role="img" aria-label="Scored hours per month in the held-out window fall from six stations to one, with almost nothing after early 2026">
    ${grid}${bars}${cnt}${xt}${key}
    <text x="${((ML + W - MR) / 2).toFixed(1)}" y="${Ht - 14}" fill="${MUTED}" font-size="11" text-anchor="middle">held-out 24-hour forecasts scored, by month</text>
  </svg>`;
}

/* ── Figure 6 · station by station: what transfers, and what does not ──────── */
function fig6() {
  const rows = A.unseen.rows.slice().sort((a: any, b: any) => b.n_test - a.n_test);
  const W = 720, rh = 33, MT = 46, Ht = MT + rows.length * rh + 44;
  const NL = 206, TW = 60, MW = 150, PR = 706;
  const TX = NL + 12, MX = TX + TW + 58;
  const maxTrain = Math.max(...rows.map((r: any) => r.n_train));
  const mqiMax = 1.2;
  const short = (s: string, n: number) => (s.length > n ? s.slice(0, n - 1) + "…" : s);
  const body = rows.map((r: any, i: number) => {
    const y = MT + i * rh;
    const st = A.panel.by_station.find((s: any) => s.location_id === r.location_id);
    const mqi = st ? st.mqi_f : 1;
    const fail = mqi > 1;
    const thin = r.n_test < 1000;
    const col = fail ? CORAL : (r.n_train === 0 ? AMBER : CYAN);
    const tw = (r.n_train / maxTrain) * TW;
    const mw = Math.min(mqi, mqiMax) / mqiMax * MW;
    return `<text x="${NL - 12}" y="${y + 17}" fill="${thin ? MUTED : INK}" font-size="11.5" text-anchor="end">${esc(short(r.name, 24))}</text>
      <text x="${NL - 12}" y="${y + 29}" fill="${MUTED}" font-size="8.5" text-anchor="end" font-family="var(--font-data)">${esc(short(r.provider, 18))} · ${n0(r.n_test)} h scored</text>
      <rect x="${TX}" y="${y + 8}" width="${Math.max(1.5, tw).toFixed(1)}" height="12" rx="2" fill="${r.n_train ? SLATE : AMBER}" opacity="0.8"/>
      <text x="${(TX + Math.max(1.5, tw) + 6).toFixed(1)}" y="${y + 18}" fill="${r.n_train ? MUTED : AMBER}" font-size="9" font-family="var(--font-data)">${r.n_train ? n0(r.n_train) : "never seen"}</text>
      <rect class="hv" x="${MX}" y="${y + 8}" width="${mw.toFixed(1)}" height="12" rx="2" fill="${col}" opacity="0.9"
        data-t="${esc(r.name)}" data-b="MQI ${mqi.toFixed(2)} · skill vs persistence ${spct(r.skill_persist)} · 80% interval covers ${pct(r.pi80, 0)}"/>
      <text x="${(MX + mw - 6).toFixed(1)}" y="${y + 18}" fill="#10131A" font-size="9.5" font-weight="600" text-anchor="end" font-family="var(--font-data)">${mqi.toFixed(2)}</text>
      <text x="${PR}" y="${y + 18}" fill="${r.pi80 < 0.72 ? CORAL : TEAL}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">${pct(r.pi80, 0)}</text>`;
  }).join("");
  const one = MX + (1 / mqiMax) * MW;
  return `<svg viewBox="0 0 ${W} ${Ht}" class="fig" role="img" aria-label="Per-station forecast quality: seven of eight stations meet Europe's acceptance threshold, and the one that fails is the only one still reporting">
    <text x="${TX}" y="${MT - 26}" fill="${MUTED}" font-size="9" font-family="var(--font-data)">TRAINING HOURS</text>
    <text x="${MX}" y="${MT - 26}" fill="${MUTED}" font-size="9" font-family="var(--font-data)">MQI · MODEL RMSE ÷ PERSISTENCE RMSE</text>
    <text x="${PR}" y="${MT - 26}" fill="${MUTED}" font-size="9" text-anchor="end" font-family="var(--font-data)">80% BAND COVERS</text>
    <line x1="${one.toFixed(1)}" y1="${MT - 14}" x2="${one.toFixed(1)}" y2="${MT + rows.length * rh}" stroke="${CORAL}" stroke-dasharray="4 4" stroke-width="1.4"/>
    <text x="${(one + 5).toFixed(1)}" y="${MT - 6}" fill="${CORAL}" font-size="9" font-family="var(--font-data)">1.00 — must be at or below</text>
    ${body}
    <text x="${TX}" y="${Ht - 14}" fill="${MUTED}" font-size="10.5">Europe requires MQI ≤ 1.00 at ${pct(FM.threshold, 0)} of stations. This panel reaches
      <tspan fill="${FM.passes ? TEAL : CORAL}">${pct(FM.share_pass, 1)}</tspan>.</text>
  </svg>`;
}

/* ── Figure 7 · what the forecast can and cannot say ───────────────────────── */
function fig7() {
  const W = 720, Ht = 336, ML = 56, MR = 26, MT = 30;
  const reachY = MT + 16, reachH = 22;
  const cmax = 350;
  const sx = (v: number) => ML + (v / cmax) * (W - ML - MR);
  const bands = [
    { t: 0, c: "#3D9970" }, { t: 9, c: "#C8B02E" }, { t: 35.5, c: "#D98A2B" },
    { t: 55.5, c: "#C6483C" }, { t: 125.5, c: "#8E4FA8" }, { t: 225.5, c: "#7A3040" },
  ];
  const strip = bands.map((b, i) => {
    const x0 = sx(b.t), x1 = sx(i + 1 < bands.length ? bands[i + 1].t : cmax);
    return `<rect x="${x0.toFixed(1)}" y="${MT - 12}" width="${(x1 - x0).toFixed(1)}" height="7" fill="${b.c}" opacity="0.55"/>`;
  }).join("");
  const rows = [
    { k: "What the air did", p99: ceil24.obs_p99, max: ceil24.obs_max, col: CORAL },
    { k: "What the forecast said", p99: ceil24.pred_p99, max: ceil24.pred_max, col: CYAN },
  ];
  const reach = rows.map((r, i) => {
    const y = reachY + i * (reachH + 16);
    const mx = sx(r.max), near = mx > W - 96;
    return `<rect x="${ML}" y="${y}" width="${(mx - ML).toFixed(1)}" height="${reachH}" rx="3" fill="${r.col}" opacity="0.2"/>
      <rect x="${ML}" y="${y}" width="${(sx(r.p99) - ML).toFixed(1)}" height="${reachH}" rx="3" fill="${r.col}" opacity="0.55"/>
      <text x="${ML + 8}" y="${y + 15}" fill="#10131A" font-size="10.5" font-weight="600">${r.k}</text>
      <line x1="${mx.toFixed(1)}" y1="${y - 3}" x2="${mx.toFixed(1)}" y2="${y + reachH + 3}" stroke="${r.col}" stroke-width="2"/>
      <text x="${(near ? mx - 6 : mx + 6).toFixed(1)}" y="${y + (near ? -6 : 15)}" fill="${r.col}" font-size="10"
        text-anchor="${near ? "end" : "start"}" font-family="var(--font-data)">max ${n1(r.max)}</text>`;
  }).join("");
  const thr = bands.slice(2).map((b) =>
    `<line x1="${sx(b.t).toFixed(1)}" y1="${MT - 12}" x2="${sx(b.t).toFixed(1)}" y2="${reachY + 2 * (reachH + 16) + 4}" stroke="${MUTED}" stroke-dasharray="2 4" opacity="0.5"/>
     <text x="${sx(b.t).toFixed(1)}" y="${MT - 18}" fill="${MUTED}" font-size="9" text-anchor="middle" font-family="var(--font-data)">${b.t}</text>`).join("");
  // lower half: the ladder
  const LY = 176, lrh = 34;
  const lmax = Math.max(...EP.ladder.map((r: any) => Math.max(r.n_observed, r.n_predicted)));
  const lw = 214, LX = 250;
  const ladder = EP.ladder.map((r: any, i: number) => {
    const y = LY + i * lrh;
    const wo = Math.max(1.5, (r.n_observed / lmax) * lw);
    const wp = Math.max(0, (r.n_predicted / lmax) * lw);
    const ok = (r.recall ?? 0) > 0;
    return `<text x="${LX - 12}" y="${y + 13}" fill="${INK}" font-size="11.5" text-anchor="end">${esc(r.label)}</text>
      <text x="${LX - 12}" y="${y + 25}" fill="${MUTED}" font-size="9" text-anchor="end" font-family="var(--font-data)">≥ ${r.threshold} µg/m³</text>
      <rect x="${LX}" y="${y + 3}" width="${wo.toFixed(1)}" height="10" rx="2" fill="${CORAL}" opacity="0.85"/>
      <text x="${(LX + wo + 6).toFixed(1)}" y="${y + 12}" fill="${CORAL}" font-size="9.5" font-family="var(--font-data)">${n0(r.n_observed)} h happened</text>
      <rect x="${LX}" y="${y + 16}" width="${Math.max(wp, 0).toFixed(1)}" height="10" rx="2" fill="${CYAN}" opacity="0.85"/>
      <text x="${(LX + Math.max(wp, 0) + 6).toFixed(1)}" y="${y + 25}" fill="${ok ? CYAN : CORAL}" font-size="9.5" font-family="var(--font-data)">${n0(r.n_predicted)} h forecast${ok ? ` · caught ${pct(r.recall, 0)}` : " · caught none"}</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${Ht}" class="fig" role="img" aria-label="The model never predicts above 99 micrograms while the air reached 338, and it forecast zero of the 247 very unhealthy hours">
    ${strip}${thr}${reach}
    <text x="${ML}" y="${reachY + 2 * (reachH + 16) + 20}" fill="${MUTED}" font-size="10">solid to the 99th percentile, faint to the maximum · concentration µg/m³ →</text>
    ${ladder}
    <text x="${ML}" y="${Ht - 10}" fill="${MUTED}" font-size="10.5">Held-out 24-hour forecasts. The ${L.standards.us_unhealthy} µg/m³ rung is, to within ${(L.standards.us_unhealthy - L.standards.id_daily).toFixed(1)} µg/m³, Indonesia's own daily limit.</text>
  </svg>`;
}

/* ── Figure 8 · the noise floor, measured at 43 metres ─────────────────────── */
function fig8() {
  const W = 720, Ht = 356, ML = 56, MR = 190, MT = 20, MB = 48;
  const pts = CO.scatter;
  const lim = Math.max(...pts.map((p: number[]) => Math.max(p[0], p[1]))) * 1.02;
  const sx = (v: number) => ML + (v / lim) * (W - ML - MR);
  const sy = (v: number) => Ht - MB - (v / lim) * (Ht - MT - MB);
  const dots = pts.map((p: number[]) =>
    `<circle class="cp" cx="${sx(p[0]).toFixed(1)}" cy="${sy(p[1]).toFixed(1)}" r="2.1" data-a="${p[0]}" data-b="${p[1]}"/>`).join("");
  const diag = `<line x1="${sx(0)}" y1="${sy(0)}" x2="${sx(lim).toFixed(1)}" y2="${sy(lim).toFixed(1)}" stroke="${MUTED}" stroke-dasharray="4 4" opacity="0.65"/>`;
  const ticks = [0, 50, 100, 150].filter((v) => v < lim).map((v) =>
    `<text x="${sx(v).toFixed(1)}" y="${Ht - MB + 17}" fill="${MUTED}" font-size="10" text-anchor="middle">${v}</text>
     <text x="${ML - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">${v}</text>
     <line x1="${ML}" y1="${sy(v).toFixed(1)}" x2="${W - MR}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.4"/>`).join("");
  const scale = [
    { k: "these two, same hour", v: CO.mae, c: TEAL },
    { k: "the model, 1 h ahead", v: H[1].model_mae, c: CYAN },
    { k: "the model, 24 h ahead", v: H[24].model_mae, c: CYAN },
    { k: "raw vs reference, Accra", v: L.accra.clarity_mae_raw, c: CORAL },
  ];
  const bmax = Math.max(...scale.map((s) => s.v)) * 1.4, bw = 116, BX = W - MR + 10;
  const bars = scale.map((s, i) => {
    const y = MT + 142 + i * 40;
    return `<text x="${BX}" y="${y}" fill="${MUTED}" font-size="9.5">${s.k}</text>
      <rect x="${BX}" y="${y + 5}" width="${((s.v / bmax) * bw).toFixed(1)}" height="10" rx="2" fill="${s.c}" opacity="0.85"/>
      <text x="${(BX + (s.v / bmax) * bw + 6).toFixed(1)}" y="${y + 14}" fill="${s.c}" font-size="9.5" font-family="var(--font-data)">${n2(s.v)}</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${Ht}" class="fig" role="img" aria-label="Two co-located sensors 43 metres apart agree to 6.85 micrograms, close to the model's one-hour forecast error">
    ${ticks}${diag}<g class="cloud">${dots}</g>
    <text x="${((ML + W - MR) / 2).toFixed(1)}" y="${Ht - 12}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${esc(CO.a_name)} · ${esc(CO.a_provider)}, µg/m³ →</text>
    <text x="14" y="${((MT + Ht - MB) / 2).toFixed(1)}" fill="${MUTED}" font-size="10.5" text-anchor="middle" transform="rotate(-90 14 ${((MT + Ht - MB) / 2).toFixed(1)})">${esc(CO.b_name)} · ${esc(CO.b_provider)} →</text>
    <text x="${BX}" y="${MT + 16}" fill="${INK}" font-size="11.5">${n0(CO.n)} hours both reported</text>
    <text x="${BX}" y="${MT + 36}" fill="${MUTED}" font-size="10" font-family="var(--font-data)">separation ${CO.m} m</text>
    <text x="${BX}" y="${MT + 54}" fill="${MUTED}" font-size="10" font-family="var(--font-data)">MAE ${n2(CO.mae)} · RMSE ${n2(CO.rmse)}</text>
    <text x="${BX}" y="${MT + 72}" fill="${MUTED}" font-size="10" font-family="var(--font-data)">bias ${CO.bias >= 0 ? "+" : ""}${n2(CO.bias)} · r ${CO.r.toFixed(3)}</text>
    <text x="${BX}" y="${MT + 90}" fill="${MUTED}" font-size="10" font-family="var(--font-data)">${CO.first} → ${CO.last}</text>
    <text x="${BX}" y="${MT + 122}" fill="${INK}" font-size="10.5">Mean absolute error, µg/m³</text>
    ${bars}
  </svg>`;
}

/* ── Figure 9 · the last witness ───────────────────────────────────────────── */
function fig9() {
  const m = CO.monthly;
  const W = 720, Ht = 316, ML = 48, MR = 152, MT = 26, MB = 62;
  const n = m.length;
  const sx = (i: number) => ML + (i / (n - 1)) * (W - ML - MR);
  const ymax = Math.max(...m.map((r: any) => Math.max(r.a, r.b))) * 1.14;
  const sy = (v: number) => Ht - MB - (v / ymax) * (Ht - MT - MB);
  // the month agreement breaks: first month where the two differ by more than 3x the pooled MAE
  const breakIdx = m.findIndex((r: any) => Math.abs(r.a - r.b) > 3 * CO.mae);
  const shade = breakIdx > 0
    ? `<rect x="${sx(breakIdx - 0.5).toFixed(1)}" y="${MT}" width="${(sx(n - 1) - sx(breakIdx - 0.5)).toFixed(1)}" height="${Ht - MT - MB}" fill="${CORAL}" opacity="0.09"/>` : "";
  const path = (k: string, col: string) =>
    `<path fill="none" stroke="${col}" stroke-width="2.3" d="${m.map((r: any, i: number) =>
      `${i ? "L" : "M"}${sx(i).toFixed(1)} ${sy(r[k]).toFixed(1)}`).join("")}"/>`;
  const dots = (k: string, col: string, who: string) => m.map((r: any, i: number) =>
    `<circle class="hv" cx="${sx(i).toFixed(1)}" cy="${sy(r[k]).toFixed(1)}" r="4" fill="${col}"
      data-t="${r.ym} · ${who}" data-b="${n1(r[k])} µg/m³ over ${r.n} hour${r.n === 1 ? "" : "s"} both reported"/>`).join("");
  const grid = [0, 20, 40, 60].filter((v) => v < ymax).map((v) =>
    `<line x1="${ML}" y1="${sy(v).toFixed(1)}" x2="${W - MR}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.55"/>
     <text x="${ML - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">${v}</text>`).join("");
  const xt = m.map((r: any, i: number) => i % 3 === 0
    ? `<text x="${sx(i).toFixed(1)}" y="${Ht - MB + 17}" fill="${MUTED}" font-size="9" text-anchor="middle" font-family="var(--font-data)">${r.ym.slice(2)}</text>` : "").join("") +
    m.map((r: any, i: number) => i >= Math.max(0, breakIdx)
      ? `<text x="${sx(i).toFixed(1)}" y="${Ht - MB + 31}" fill="${MUTED}" font-size="8" text-anchor="middle" font-family="var(--font-data)">${r.n}h</text>` : "").join("");
  const brk = breakIdx > 0
    ? `<line x1="${sx(breakIdx - 0.5).toFixed(1)}" y1="${MT}" x2="${sx(breakIdx - 0.5).toFixed(1)}" y2="${Ht - MB}" stroke="${CORAL}" stroke-dasharray="4 4"/>
       <text x="${(sx(breakIdx - 0.5) - 6).toFixed(1)}" y="${MT + 12}" fill="${CORAL}" font-size="9.5" text-anchor="end" font-family="var(--font-data)">they stop agreeing</text>` : "";
  return `<svg viewBox="0 0 ${W} ${Ht}" class="fig" role="img" aria-label="For fourteen months the two co-located sensors agree; from March 2025 one reads a fifth of the other, and then the second one dies">
    ${shade}${grid}${brk}${path("b", CYAN)}${path("a", AMBER)}${dots("b", CYAN, esc(CO.b_name))}${dots("a", AMBER, esc(CO.a_name))}${xt}
    <text x="${sx(Math.max(0, breakIdx)).toFixed(1)}" y="${Ht - MB + 42}" fill="${MUTED}" font-size="8" font-family="var(--font-data)">hours both reported</text>
    <line x1="${W - MR + 6}" y1="${MT + 12}" x2="${W - MR + 20}" y2="${MT + 12}" stroke="${AMBER}" stroke-width="2.4"/>
    <text x="${W - MR + 26}" y="${MT + 16}" fill="${MUTED}" font-size="10">${esc(CO.a_name)}</text>
    <text x="${W - MR + 26}" y="${MT + 28}" fill="${MUTED}" font-size="9">still reporting</text>
    <line x1="${W - MR + 6}" y1="${MT + 50}" x2="${W - MR + 20}" y2="${MT + 50}" stroke="${CYAN}" stroke-width="2.4"/>
    <text x="${W - MR + 26}" y="${MT + 54}" fill="${MUTED}" font-size="10">${esc(CO.b_name)}</text>
    <text x="${W - MR + 26}" y="${MT + 66}" fill="${MUTED}" font-size="9">silent since ${CO.last}</text>
    <text x="${W - MR + 6}" y="${MT + 96}" fill="${CORAL}" font-size="9" font-family="var(--font-data)">last shared month:</text>
    <text x="${W - MR + 6}" y="${MT + 110}" fill="${CORAL}" font-size="9" font-family="var(--font-data)">${n1(m[n - 1].a)} vs ${n1(m[n - 1].b)} µg/m³</text>
    <text x="${((ML + W - MR) / 2).toFixed(1)}" y="${Ht - 12}" fill="${MUTED}" font-size="10.5" text-anchor="middle">monthly mean over the hours both instruments reported</text>
  </svg>`;
}

/* ── Figure 10 · the record smoke month, and the missing witness ───────────── */
function fig10() {
  const fm = A.fire.monthly, cov = A.panel.coverage;
  const covBy = Object.fromEntries(cov.map((c: any) => [c.ym, c]));
  const W = 720, Ht = 300, ML = 52, MR = 56, MT = 26, MB = 54;
  const n = fm.length;
  const step = (W - ML - MR) / n, bw = step * 0.68;
  const fmax = Math.max(...fm.map((r: any) => r.n)) * 1.06;
  const sy = (v: number) => Ht - MB - (v / fmax) * (Ht - MT - MB);
  const omax = Math.max(...cov.map((c: any) => c.obs_hours)) * 1.06;
  const oy = (v: number) => Ht - MB - (v / omax) * (Ht - MT - MB);
  const bars = fm.map((r: any, i: number) => {
    const peak = r.n === A.fire.peak_n;
    const c = covBy[r.m];
    return `<rect class="hv" x="${(ML + i * step + (step - bw) / 2).toFixed(1)}" y="${sy(r.n).toFixed(1)}"
      width="${bw.toFixed(1)}" height="${(Ht - MB - sy(r.n)).toFixed(1)}" rx="1.5"
      fill="${peak ? CORAL : "#8695B0"}" opacity="${peak ? 0.98 : 0.9}"
      data-t="${r.m}" data-b="${n0(r.n)} hotspots · ${c ? n0(c.obs_hours) : 0} observed station-hours"/>`;
  }).join("");
  const obs = `<path fill="none" stroke="${CYAN}" stroke-width="1.4" stroke-dasharray="5 3" opacity="0.6" d="${fm.map((r: any, i: number) => {
    const c = covBy[r.m];
    return `${i ? "L" : "M"}${(ML + i * step + step / 2).toFixed(1)} ${oy(c ? c.obs_hours : 0).toFixed(1)}`;
  }).join("")}"/>`;
  const yl = [0, 30000, 60000].map((v) =>
    `<line x1="${ML}" y1="${sy(v).toFixed(1)}" x2="${W - MR}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.5"/>
     <text x="${ML - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="#8695B0" font-size="9.5" text-anchor="end">${v ? v / 1000 + "k" : "0"}</text>`).join("");
  const yr = [0, 2500, 5000].map((v) =>
    `<text x="${W - MR + 8}" y="${(oy(v) + 4).toFixed(1)}" fill="${CYAN}" font-size="9.5">${v ? v / 1000 + "k" : "0"}</text>`).join("");
  const xt = fm.map((r: any, i: number) => r.m.endsWith("-01")
    ? `<text x="${(ML + i * step + step / 2).toFixed(1)}" y="${Ht - MB + 17}" fill="${MUTED}" font-size="9.5" text-anchor="middle" font-family="var(--font-data)">${r.m.slice(0, 4)}</text>` : "").join("");
  const pi = fm.findIndex((r: any) => r.n === A.fire.peak_n);
  const px = ML + pi * step + step / 2;
  return `<svg viewBox="0 0 ${W} ${Ht}" class="fig" role="img" aria-label="Fire hotspots peak at 87,541 in August 2026, the largest month on record, when only 44 station-hours of ground PM2.5 were observed">
    ${yl}${bars}${obs}${yr}${xt}
    <text x="${(px - 8).toFixed(1)}" y="${(sy(A.fire.peak_n) + 14).toFixed(1)}" fill="${CORAL}" font-size="10" text-anchor="end" font-family="var(--font-data)">${A.fire.peak_month} · ${n0(A.fire.peak_n)}</text>
    <text x="${(px - 8).toFixed(1)}" y="${(sy(A.fire.peak_n) + 28).toFixed(1)}" fill="${CORAL}" font-size="10" text-anchor="end" font-family="var(--font-data)">${A.fire.ratio_to_median.toFixed(0)}× the median month</text>
    <text x="${ML}" y="${MT - 8}" fill="#8695B0" font-size="10">▮ VIIRS hotspots in the airshed, per month</text>
    <text x="${(W - MR).toFixed(1)}" y="${MT - 8}" fill="${CYAN}" font-size="10" text-anchor="end">- - ground PM2.5 hours observed</text>
    <text x="${((ML + W - MR) / 2).toFixed(1)}" y="${Ht - 12}" fill="${MUTED}" font-size="10.5" text-anchor="middle">the smoke signal and the capacity to check it, on the same calendar</text>
  </svg>`;
}

const F1 = fig1(), F2 = fig2(), F3 = fig3(), F4 = fig4(), F5 = fig5();
const F6 = fig6(), F7 = fig7(), F8 = fig8(), F9 = fig9(), F10 = fig10();
