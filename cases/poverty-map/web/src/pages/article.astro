/* ── Figure 7 · does the province offset track the price level? ─────────────── */
function fig7() {
  const W = 720, H = 380, L = 66, R = 22, T = 22, B = 56;
  const xs = provSorted.map((p: any) => p.line), ys = provSorted.map((p: any) => p.offset);
  const x0 = Math.min(...xs) * 0.97, x1 = Math.max(...xs) * 1.03;
  const y0 = Math.min(...ys, 0) - 0.6, y1 = Math.max(...ys, 0) + 0.6;
  const sx = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
  const sy = (v: number) => H - B - ((v - y0) / (y1 - y0)) * (H - T - B);
  const fit = ols(xs, ys);
  const dots = provSorted.map((p: any) =>
    `<circle class="d2" cx="${sx(p.line).toFixed(1)}" cy="${sy(p.offset).toFixed(1)}" r="5" fill="${p.offset >= 0 ? OCHRE : SLATE}" opacity="0.9" ` +
    `data-n="${esc(p.name)}" data-o="${f2(p.offset)}" data-l="${esc(idr(p.line))}" data-r="${p.rho == null ? "—" : f2(p.rho)}" data-c="${p.n}"/>`).join("");
  const xt = [x0, (x0 + x1) / 2, x1].map((v) =>
    `<text x="${sx(v).toFixed(1)}" y="${H - B + 20}" fill="${MUTED}" font-size="11" text-anchor="middle" font-family="var(--font-data)">${(v / 1000).toFixed(0)}k</text>`).join("");
  const yt = [-12, -10, -8, -6, -4, -2, 0, 2, 4, 6, 8, 10].filter((v) => v > y0 && v < y1).map((v) =>
    `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="${v === 0 ? 1 : 0.5}"/>
     <text x="${L - 9}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="11" text-anchor="end">${v > 0 ? "+" : ""}${v}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Each province's constant prediction offset against its official poverty line">
    ${yt}${xt}
    <line x1="${sx(x0).toFixed(1)}" y1="${sy(fit.intercept + fit.slope * x0).toFixed(1)}" x2="${sx(x1).toFixed(1)}" y2="${sy(fit.intercept + fit.slope * x1).toFixed(1)}" stroke="${CORAL}" stroke-width="2"/>
    <g class="dots">${dots}</g>
    <line x1="${L}" y1="${H - B}" x2="${W - R}" y2="${H - B}" stroke="${GRID}"/>
    <line x1="${L}" y1="${T}" x2="${L}" y2="${H - B}" stroke="${GRID}"/>
    <text x="${W - R - 6}" y="${T + 16}" fill="${CORAL}" font-size="11.5" text-anchor="end" font-family="var(--font-data)">R² ${f3(fit.r2)} · ${provSorted.length} provinces</text>
    <text x="${(L + W - R) / 2}" y="${H - 12}" fill="${MUTED}" font-size="11.5" text-anchor="middle">official provincial poverty line · rupiah per person per month →</text>
    <text x="15" y="${(H - B + T) / 2}" fill="${MUTED}" font-size="11.5" text-anchor="middle" transform="rotate(-90 15 ${(H - B + T) / 2})">province offset · pp →</text>
  </svg>`;
}

