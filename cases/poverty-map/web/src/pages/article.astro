    <script>
      /* Hover read-outs. Pure SVG, no GPU path. */
      const tip = document.getElementById("tip");
      const show = (html, e) => {
        tip.innerHTML = html; tip.hidden = false;
        const r = tip.getBoundingClientRect();
        let x = e.clientX + 14, y = e.clientY + 14;
        if (x + r.width > innerWidth - 8) x = e.clientX - r.width - 14;
        if (y + r.height > innerHeight - 8) y = e.clientY - r.height - 14;
        tip.style.left = x + "px"; tip.style.top = y + "px";
      };
      const hide = () => { tip.hidden = true; };
      document.querySelectorAll(".d1").forEach((el) => {
        el.addEventListener("mousemove", (e) => {
          const d = el.dataset;
          show(`<b>${d.n}</b><br>${d.v}<br>official ${d.y}% · predicted ${d.p}%`, e);
        });
        el.addEventListener("mouseleave", hide);
      });
      document.querySelectorAll(".d2").forEach((el) => {
        el.addEventListener("mousemove", (e) => {
          const d = el.dataset;
          show(`<b>${d.n}</b><br>${d.c} regencies · offset ${d.o} pp<br>poverty line ${d.l}<br>internal rank ρ ${d.r}`, e);
        });
        el.addEventListener("mouseleave", hide);
      });
    </script>
  
