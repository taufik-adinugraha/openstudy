---
/* Review article — the case, stress-tested against the literature.
 *
 * Every figure is built in frontmatter from data/article.json, which pipeline/article.py
 * derives from the case's own published output (stats.json, model_stats.json) and from
 * pipeline/review.py's independent recomputation and extra tests. Nothing here is typed
 * by hand, so the prose cannot drift from the numbers. SVG only: no WebGL, no canvas.
 */
import "../styles/tokens.css";
import A from "../data/article.json";

const f1 = (x: number) => x.toFixed(1);
const f2 = (x: number) => x.toFixed(2);
const f3 = (x: number) => x.toFixed(3);
const pct = (x: number, d = 0) => `${(x * 100).toFixed(d)}%`;
const idr = (x: number) => `Rp ${Math.round(x).toLocaleString("en-US")}`;

const OCHRE = "#D99A4E", TEAL = "#4BB8A9", CORAL = "#F26D5B", SAND = "#EBD9B8";
const SLATE = "#8994A3", INK = "#F0EAE1", MUTED = "#A99C8B", GRID = "#3A2E24";

const esc = (s: unknown) =>
  String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

function ols(x: number[], y: number[]) {
  const n = x.length;
  const mx = x.reduce((s, v) => s + v, 0) / n, my = y.reduce((s, v) => s + v, 0) / n;
  let sxx = 0, sxy = 0, syy = 0;
  for (let i = 0; i < n; i++) { sxx += (x[i] - mx) ** 2; sxy += (x[i] - mx) * (y[i] - my); syy += (y[i] - my) ** 2; }
  const b = sxy / sxx;
  return { slope: b, intercept: my - b * mx, r2: (sxy * sxy) / (sxx * syy), n };
}

const S = A.skill, TH = A.thresholds, G1 = A.gates["G-F1"], G2 = A.gates["G-F2"];
const sc = A.scatter;
const attn = ols(sc.map((d: any) => d.y), sc.map((d: any) => d.p));   // predicted on official
const lit = (k: string) => A.literature.find((l: any) => l.key === k)!;
const PUTRI = lit("putri"), SART = lit("sartirano"), JEAN = lit("jean"), JEANC = lit("jean_cons");
const YEH = lit("yeh"), CHI = lit("chi"), ENG = lit("engstrom");

const ejPts = sc.filter((d: any) => d.pv === "Jawa Timur");
const ejRmse = Math.sqrt(ejPts.reduce((s: number, d: any) => s + (d.p - d.y) ** 2, 0) / Math.max(1, ejPts.length));
const ejR = Math.sqrt(ols(ejPts.map((d: any) => d.y), ejPts.map((d: any) => d.p)).r2);
const EJ = A.eastJava;

const tA = A.testA, tB = A.testB, tC = A.testC, tD = A.testD, tE = A.testE;
const aFull = tA[tA.length - 1], aPop = tA.find((r: any) => r.label === "Population only")!;
const aLights = tA.find((r: any) => r.label === "Night lights only")!;
const aBld = tA.find((r: any) => r.label === "Buildings only")!;
const aLc = tA.find((r: any) => r.label === "Land cover only")!;
const bBase = tB[0], bProv = tB[1], bReg = tB[2];
const oe = A.offsetExplained;
const provSorted = [...A.provinces].sort((a: any, b: any) => a.offset - b.offset);

/* ── Figure 1 · held out against the official rate ─────────────────────────── */
function fig1() {
  const W = 720, H = 470, L = 58, R = 20, T = 20, B = 54;
  const hi = Math.max(...sc.map((d: any) => Math.max(d.y, d.p))) * 1.03;
  const s = (v: number) => (v / hi);
  const sx = (v: number) => L + s(v) * (W - L - R);
  const sy = (v: number) => H - B - s(v) * (H - T - B);
  const dots = sc.map((d: any) =>
    `<circle class="d1 ${d.k ? "kota" : "kab"}" cx="${sx(d.y).toFixed(1)}" cy="${sy(d.p).toFixed(1)}" r="${d.k ? 3.2 : 2.6}" ` +
    `data-n="${esc(d.n)}" data-v="${esc(d.pv)}" data-y="${f1(d.y)}" data-p="${f1(d.p)}"/>`).join("");
  const ticks = [0, 10, 20, 30, 40].filter((v) => v <= hi).map((v) =>
    `<line x1="${sx(v).toFixed(1)}" y1="${T}" x2="${sx(v).toFixed(1)}" y2="${H - B}" stroke="${GRID}" opacity="0.5"/>
     <text x="${sx(v).toFixed(1)}" y="${H - B + 19}" fill="${MUTED}" font-size="11" text-anchor="middle">${v}</text>
     <line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.5"/>
     <text x="${L - 9}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="11" text-anchor="end">${v}</text>`).join("");
  const fx0 = 0, fx1 = hi;
  const fy0 = attn.intercept, fy1 = attn.intercept + attn.slope * hi;
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Predicted against official poverty rate for 514 regencies held out province by province">
    ${ticks}
    <line x1="${sx(0)}" y1="${sy(0)}" x2="${sx(hi).toFixed(1)}" y2="${sy(hi).toFixed(1)}" stroke="${TEAL}" stroke-width="1.6" stroke-dasharray="5 4" opacity="0.85"/>
    <text x="${sx(hi * 0.86).toFixed(1)}" y="${(sy(hi * 0.86) - 10).toFixed(1)}" fill="${TEAL}" font-size="11" text-anchor="end" font-family="var(--font-data)">perfect agreement</text>
    <g class="dots">${dots}</g>
    <line x1="${sx(fx0).toFixed(1)}" y1="${sy(fy0).toFixed(1)}" x2="${sx(fx1).toFixed(1)}" y2="${sy(fy1).toFixed(1)}" stroke="${CORAL}" stroke-width="2.2"/>
    <text x="${(W - R - 4).toFixed(1)}" y="${(H - B - 26).toFixed(1)}" fill="${CORAL}" font-size="11.5" text-anchor="end" font-family="var(--font-data)">fitted slope ${f2(attn.slope)}</text>
    <text x="${(W - R - 4).toFixed(1)}" y="${(H - B - 11).toFixed(1)}" fill="${CORAL}" font-size="11.5" text-anchor="end" font-family="var(--font-data)">— the model compresses</text>
    <line x1="${L}" y1="${H - B}" x2="${W - R}" y2="${H - B}" stroke="${GRID}"/>
    <line x1="${L}" y1="${T}" x2="${L}" y2="${H - B}" stroke="${GRID}"/>
    <g><circle cx="${L + 14}" cy="${T + 12}" r="3.2" fill="${OCHRE}" opacity="0.85"/><text x="${L + 24}" y="${T + 16}" fill="${MUTED}" font-size="11">kabupaten</text>
       <circle cx="${L + 104}" cy="${T + 12}" r="3.2" fill="${SAND}" opacity="0.95"/><text x="${L + 114}" y="${T + 16}" fill="${MUTED}" font-size="11">kota (cities)</text></g>
    <text x="${(L + W - R) / 2}" y="${H - 12}" fill="${MUTED}" font-size="11.5" text-anchor="middle">official BPS poverty rate ${A.latest_year} · % of population →</text>
    <text x="14" y="${(H - B + T) / 2}" fill="${MUTED}" font-size="11.5" text-anchor="middle" transform="rotate(-90 14 ${(H - B + T) / 2})">held-out prediction · % →</text>
  </svg>`;
}

/* ── Figure 2 · the published benchmarks, sorted by what they actually validated ── */
function fig2() {
  const rows = [
    { ...JEAN, v: JEAN.r2 }, { ...YEH, v: YEH.r2 }, { ...ENG, v: ENG.r2 },
    { ...CHI, v: CHI.r2 }, { ...PUTRI, v: PUTRI.r2 }, { ...JEANC, v: JEANC.r2 },
  ].sort((a, b) => (b.v ?? 0) - (a.v ?? 0));
  const W = 720, L = 200, R = 236, T = 62, rh = 36;
  const H = T + rows.length * rh + 66;
  const bw = W - L - R;
  const DESIGN: Record<string, string> = { insample: "no hold-out", randomcv: "random CV", spatial: "spatial hold-out" };
  const body = rows.map((r: any, i: number) => {
    const y = T + i * rh;
    const w = (r.v ?? 0) * bw;
    const col = r.target === "asset" ? SLATE : OCHRE;
    return `<text x="${L - 12}" y="${y + 14}" fill="${INK}" font-size="12" text-anchor="end">${esc(r.short)}</text>
      <text x="${L - 12}" y="${y + 27}" fill="${MUTED}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">${esc(DESIGN[r.design])}</text>
      <rect x="${L}" y="${y + 5}" width="${w.toFixed(1)}" height="18" fill="${col}" rx="2"/>
      <text x="${(W - R + 10).toFixed(1)}" y="${y + 14}" fill="${col}" font-size="11.5" font-family="var(--font-data)">${f2(r.v)}</text>
      <text x="${(W - R + 48).toFixed(1)}" y="${y + 14}" fill="${MUTED}" font-size="10.5">${esc(r.target_label)}</text>`;
  }).join("");
  const mark = (v: number, lab: string, col: string, dy: number) =>
    `<line x1="${(L + v * bw).toFixed(1)}" y1="${T - 8}" x2="${(L + v * bw).toFixed(1)}" y2="${T + rows.length * rh + 4}" stroke="${col}" stroke-width="1.5" stroke-dasharray="4 3"/>
     <text x="${(L + v * bw).toFixed(1)}" y="${dy}" fill="${col}" font-size="10.5" text-anchor="middle" font-family="var(--font-data)">${esc(lab)}</text>`;
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Published satellite poverty and wealth benchmarks, ordered by R squared and labelled by validation design">
    ${body}
    ${mark(S.lopo.r2, `this case, province held out ${f2(S.lopo.r2)}`, CORAL, T - 32)}
    ${mark(S.random.r2, `this case, random fold ${f2(S.random.r2)}`, TEAL, T - 15)}
    <g><rect x="${L}" y="${H - 44}" width="11" height="11" fill="${SLATE}" rx="2"/><text x="${L + 18}" y="${H - 34}" fill="${MUTED}" font-size="11">asset / wealth index</text>
       <rect x="${L + 152}" y="${H - 44}" width="11" height="11" fill="${OCHRE}" rx="2"/><text x="${L + 170}" y="${H - 34}" fill="${MUTED}" font-size="11">monetary poverty or consumption</text></g>
    <text x="${L}" y="${H - 11}" fill="${MUTED}" font-size="11">R² reported by the paper →</text>
  </svg>`;
}

/* ── Figure 2b · same study, same data, two targets ────────────────────────── */
function figPairs() {
  const rows = A.pairs;
  const W = 720, L = 40, T = 64, rh = 106, gap = 12;
  const H = T + rows.length * rh + 30;
  const bw = W - L - 232;
  const body = rows.map((r: any, i: number) => {
    const y = T + i * rh;
    const wa = r.asset * bw, wm = r.monetary * bw;
    const drop = (r.asset - r.monetary) / r.asset;
    const by = y + 22 + gap + 26;
    return `<text x="${L}" y="${y - 8}" fill="${INK}" font-size="12.5">${esc(r.study)}</text>
      <text x="${(L + 186).toFixed(1)}" y="${y - 8}" fill="${MUTED}" font-size="10.5" font-family="var(--font-data)">${esc(r.where)}</text>
      <rect x="${L}" y="${y + 2}" width="${wa.toFixed(1)}" height="20" fill="${SLATE}" rx="2"/>
      <text x="${(L + wa + 9).toFixed(1)}" y="${y + 17}" fill="${SLATE}" font-size="11.5" font-family="var(--font-data)">${f2(r.asset)}</text>
      <text x="${(L + wa + 46).toFixed(1)}" y="${y + 17}" fill="${MUTED}" font-size="10.5">${esc(r.asset_label)}</text>
      <rect x="${L}" y="${y + 2 + 20 + gap}" width="${wm.toFixed(1)}" height="20" fill="${OCHRE}" rx="2"/>
      <text x="${(L + wm + 9).toFixed(1)}" y="${y + 37 + gap}" fill="${OCHRE}" font-size="11.5" font-family="var(--font-data)">${f2(r.monetary)}</text>
      <text x="${(L + wm + 46).toFixed(1)}" y="${y + 37 + gap}" fill="${MUTED}" font-size="10.5">${esc(r.monetary_label)}</text>
      <path d="M${(L + wm).toFixed(1)} ${by - 6} L${(L + wm).toFixed(1)} ${by} L${(L + wa).toFixed(1)} ${by} L${(L + wa).toFixed(1)} ${by - 6}" fill="none" stroke="${CORAL}" stroke-width="1.2"/>
      <text x="${(L + (wa + wm) / 2).toFixed(1)}" y="${by + 14}" fill="${CORAL}" font-size="10.5" text-anchor="middle" font-family="var(--font-data)">−${pct(drop, 0)} of the explained variance</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Three studies that measured an asset target and a monetary target on the same data">
    <g><rect x="${L}" y="14" width="11" height="11" fill="${SLATE}" rx="2"/><text x="${L + 18}" y="24" fill="${MUTED}" font-size="11.5">asset / wealth index</text>
       <rect x="${L + 160}" y="14" width="11" height="11" fill="${OCHRE}" rx="2"/><text x="${L + 178}" y="24" fill="${MUTED}" font-size="11.5">monetary poverty or consumption — same features, same units, same paper</text></g>
    ${body}
    <text x="${L}" y="${H - 14}" fill="${MUTED}" font-size="11">r² reported by the paper. In Steele et al.'s urban subset, the consumption-poverty r² is 0.00.</text>
  </svg>`;
}

/* ── Figure 4b · what holding space out costs, where it has been measured ──── */
function figPenalty() {
  const rows = [
    ...A.spatialPenalty,
    { study: "This case", field: `poverty headcount, Indonesia`, random: S.random.r2, spatial: S.lopo.r2, mine: true },
  ];
  const W = 720, L = 40, T = 64, rh = 98, gap = 12;
  const H = T + rows.length * rh + 6;
  const bw = W - L - 240;
  const body = rows.map((r: any, i: number) => {
    const y = T + i * rh;
    const wr = r.random * bw, ws = r.spatial * bw;
    const drop = (r.random - r.spatial) / r.random;
    const col = r.mine ? CORAL : OCHRE;
    const by = y + 22 + gap + 26;
    return `<text x="${L}" y="${y - 8}" fill="${r.mine ? INK : INK}" font-size="12.5">${esc(r.study)}</text>
      <text x="${(L + 176).toFixed(1)}" y="${y - 8}" fill="${MUTED}" font-size="10.5" font-family="var(--font-data)">${esc(r.field)}</text>
      <rect x="${L}" y="${y + 2}" width="${wr.toFixed(1)}" height="20" fill="${SLATE}" rx="2"/>
      <text x="${(L + wr + 9).toFixed(1)}" y="${y + 17}" fill="${SLATE}" font-size="11.5" font-family="var(--font-data)">${f2(r.random)}</text>
      <text x="${(L + wr + 46).toFixed(1)}" y="${y + 17}" fill="${MUTED}" font-size="10.5">random fold</text>
      <rect x="${L}" y="${y + 2 + 20 + gap}" width="${ws.toFixed(1)}" height="20" fill="${col}" rx="2"/>
      <text x="${(L + ws + 9).toFixed(1)}" y="${y + 37 + gap}" fill="${col}" font-size="11.5" font-family="var(--font-data)">${f2(r.spatial)}</text>
      <text x="${(L + ws + 46).toFixed(1)}" y="${y + 37 + gap}" fill="${MUTED}" font-size="10.5">space held out</text>
      <path d="M${(L + ws).toFixed(1)} ${by - 6} L${(L + ws).toFixed(1)} ${by} L${(L + wr).toFixed(1)} ${by} L${(L + wr).toFixed(1)} ${by - 6}" fill="none" stroke="${col}" stroke-width="1.2"/>
      <text x="${(L + (wr + ws) / 2).toFixed(1)}" y="${by + 14}" fill="${col}" font-size="10.5" text-anchor="middle" font-family="var(--font-data)">−${pct(drop, 0)} of the explained variance</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="R squared falling from random cross-validation to spatially held-out validation in three studies">
    <g><rect x="${L}" y="16" width="11" height="11" fill="${SLATE}" rx="2"/><text x="${L + 18}" y="26" fill="${MUTED}" font-size="11.5">random fold</text>
       <rect x="${L + 118}" y="16" width="11" height="11" fill="${OCHRE}" rx="2"/><text x="${L + 136}" y="26" fill="${MUTED}" font-size="11.5">space held out — one model, one dataset, both designs</text>
       <rect x="${L + 464}" y="16" width="11" height="11" fill="${CORAL}" rx="2"/><text x="${L + 482}" y="26" fill="${MUTED}" font-size="11.5">this case</text></g>
    ${body}
  </svg>`;
}

/* ── Figure 3 · what the fold design buys ──────────────────────────────────── */
function fig3() {
  const rows = [
    { k: "Random 10-fold", s: S.random, note: `${A.folds.random} folds, space ignored` },
    { k: "200 km blocks", s: S.block, note: `${A.folds.block_200km} blocks` },
    { k: "Leave-one-province-out", s: S.lopo, note: `${A.folds.lopo} provinces · published` },
    { k: "Ridge, same folds", s: S.lopo_ridge, note: "linear baseline" },
  ];
  const W = 720, L = 214, R = 108, T = 34, rh = 40, H = T + rows.length * rh + 46;
  const bw = W - L - R;
  const body = rows.map((r, i) => {
    const y = T + i * rh;
    const w = Math.max(0, r.s.r2) * bw;
    const hero = r.k.startsWith("Leave");
    const col = hero ? CORAL : OCHRE;
    return `<text x="${L - 12}" y="${y + 15}" fill="${hero ? INK : MUTED}" font-size="12.5" text-anchor="end">${esc(r.k)}</text>
      <text x="${L - 12}" y="${y + 29}" fill="${MUTED}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">${esc(r.note)}</text>
      <rect x="${L}" y="${y + 5}" width="${w.toFixed(1)}" height="20" fill="${col}" opacity="${hero ? 1 : 0.6}" rx="2"/>
      <text x="${(W - R + 12).toFixed(1)}" y="${y + 20}" fill="${col}" font-size="12" font-family="var(--font-data)">R² ${f3(r.s.r2)}</text>`;
  }).join("");
  const tx = L + TH.r2 * bw;
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="R squared under four cross-validation designs against the published threshold of 0.50">
    <line x1="${tx.toFixed(1)}" y1="${T - 14}" x2="${tx.toFixed(1)}" y2="${T + rows.length * rh - 2}" stroke="${TEAL}" stroke-dasharray="4 3" stroke-width="1.5"/>
    <text x="${tx.toFixed(1)}" y="${T - 20}" fill="${TEAL}" font-size="10.5" text-anchor="middle" font-family="var(--font-data)">threshold ${f2(TH.r2)}</text>
    ${body}
    <text x="${L}" y="${H - 14}" fill="${MUTED}" font-size="11">Identical model, identical rows, identical target — only the fold changes.</text>
  </svg>`;
}

/* ── Figure 4 · the target's own shape ─────────────────────────────────────── */
function fig4() {
  const W = 720, H = 246, L = 26, R = 26, T = 30;
  const bw = W - L - R;
  const bshare = A.variance.between_share, wshare = A.variance.within_share;
  const lines = provSorted.map((p: any) => p.line).sort((a: number, b: number) => a - b);
  const lo = lines[0], hiv = lines[lines.length - 1];
  const lx = (v: number) => L + ((v - lo) / (hiv - lo)) * bw;
  const strips = provSorted.map((p: any) =>
    `<line x1="${lx(p.line).toFixed(1)}" y1="139" x2="${lx(p.line).toFixed(1)}" y2="167" stroke="${OCHRE}" stroke-width="1.6" opacity="0.62"/>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Between-province and within-province share of the variance in regency poverty rates, and the spread of provincial poverty lines">
    <text x="${L}" y="16" fill="${MUTED}" font-size="11.5">Where the variation in the ${A.skill.lopo.n} regency rates lives</text>
    <rect x="${L}" y="${T}" width="${(bshare * bw).toFixed(1)}" height="30" fill="${SLATE}" rx="2"/>
    <rect x="${(L + bshare * bw).toFixed(1)}" y="${T}" width="${(wshare * bw).toFixed(1)}" height="30" fill="${OCHRE}" rx="2"/>
    <text x="${(L + 12).toFixed(1)}" y="${T + 20}" fill="#14100C" font-size="12.5" font-weight="600">between provinces · ${pct(bshare)}</text>
    <text x="${(L + bshare * bw + 12).toFixed(1)}" y="${T + 20}" fill="#14100C" font-size="12.5" font-weight="600">within · ${pct(wshare)}</text>
    <text x="${L}" y="${T + 50}" fill="${MUTED}" font-size="11">Standard deviation ${f1(A.variance.sd_total)} pp in total, ${f1(A.variance.sd_within)} pp once each province's own level is removed.</text>
    <text x="${L}" y="${T + 82}" fill="${MUTED}" font-size="11.5">The nominal poverty line each province is judged against, ${A.latest_year}</text>
    <line x1="${L}" y1="153" x2="${W - R}" y2="153" stroke="${GRID}"/>
    ${strips}
    <text x="${L}" y="188" fill="${INK}" font-size="11.5" font-family="var(--font-data)">${esc(idr(oe.line_range_idr[0]))}</text>
    <text x="${W - R}" y="188" fill="${INK}" font-size="11.5" text-anchor="end" font-family="var(--font-data)">${esc(idr(oe.line_range_idr[1]))}</text>
    <text x="${(W / 2).toFixed(1)}" y="188" fill="${MUTED}" font-size="11" text-anchor="middle">one tick per province mean · ${f2(oe.line_ratio)}× end to end (${f2(A.lineGeography.adm2_ratio)}× across all ${S.lopo.n} regencies)</text>
    <text x="${L}" y="218" fill="${MUTED}" font-size="11.5">If the case's defence is right, the ${pct(bshare)} on the left is the part a satellite cannot reach,</text>
    <text x="${L}" y="236" fill="${MUTED}" font-size="11.5">because it is set by a price level the satellite cannot observe. §7 and §8 put that to the test.</text>
  </svg>`;
}

/* ── Figure 5 · the horse race, in level skill and in rank skill ───────────── */
function fig5() {
  const W = 720, L = 220, R = 176, T = 44, rh = 34;
  const rows = tA;
  const H = T + rows.length * rh + 42;
  const bw = W - L - R;
  const lo = Math.min(...rows.map((r: any) => r.r2), 0);
  const hi = Math.max(...rows.map((r: any) => r.r2));
  const sx = (v: number) => L + ((v - lo) / (hi - lo)) * bw;
  const zero = sx(0);
  const rw = 150;                                    // rank strip, right of the bars
  const rx = (v: number) => W - R + 14 + Math.max(0, v) * (rw - 46);
  const body = rows.map((r: any, i: number) => {
    const y = T + i * rh;
    const v = r.r2 ?? 0, x = sx(v);
    const hero = i === rows.length - 1;
    const col = hero ? CORAL : (v < 0 ? SLATE : OCHRE);
    const bar = v < 0
      ? `<rect x="${x.toFixed(1)}" y="${y + 4}" width="${Math.max(1.5, zero - x).toFixed(1)}" height="17" fill="${col}" opacity="0.72" rx="2"/>`
      : `<rect x="${zero.toFixed(1)}" y="${y + 4}" width="${Math.max(1.5, x - zero).toFixed(1)}" height="17" fill="${col}" opacity="${hero ? 1 : 0.72}" rx="2"/>`;
    return `<text x="${L - 12}" y="${y + 13}" fill="${hero ? INK : MUTED}" font-size="11.5" text-anchor="end">${esc(r.label)}</text>
      <text x="${L - 12}" y="${y + 25}" fill="${MUTED}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">${r.k} feature${r.k === 1 ? "" : "s"}</text>
      ${bar}
      <text x="${(v < 0 ? zero + 7 : x + 7).toFixed(1)}" y="${y + 17}" fill="${col}" font-size="11" font-family="var(--font-data)">${v >= 0 ? "" : "−"}${f3(Math.abs(v))}</text>
      ${i === 0 ? "" : `<circle cx="${rx(r.spearman).toFixed(1)}" cy="${y + 12.5}" r="4" fill="${TEAL}" opacity="${hero ? 1 : 0.72}"/>
      <text x="${(rx(r.spearman) + 9).toFixed(1)}" y="${y + 17}" fill="${TEAL}" font-size="10.5" font-family="var(--font-data)">${f2(r.spearman)}</text>`}`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Held-out R squared and Spearman rank correlation for single feature families against the full model">
    <line x1="${zero.toFixed(1)}" y1="${T - 10}" x2="${zero.toFixed(1)}" y2="${T + rows.length * rh}" stroke="${GRID}"/>
    <text x="${zero.toFixed(1)}" y="${T - 16}" fill="${MUTED}" font-size="10.5" text-anchor="middle" font-family="var(--font-data)">0</text>
    <text x="${(L + bw / 2).toFixed(1)}" y="${T - 28}" fill="${OCHRE}" font-size="11" text-anchor="middle">R² — do the levels come out right?</text>
    <line x1="${(W - R + 6).toFixed(1)}" y1="${T - 10}" x2="${(W - R + 6).toFixed(1)}" y2="${T + rows.length * rh}" stroke="${GRID}"/>
    <text x="${(W - R + 60).toFixed(1)}" y="${T - 28}" fill="${TEAL}" font-size="11" text-anchor="middle">ρ — is the order right?</text>
    ${body}
    <text x="${L - 12}" y="${H - 12}" fill="${MUTED}" font-size="10.5" text-anchor="end">Leave-one-province-out, ${A.latest_year}</text>
    <text x="${zero.toFixed(1)}" y="${H - 12}" fill="${MUTED}" font-size="10.5">bars left of the line are worse than predicting one number for the whole country</text>
  </svg>`;
}

/* ── Figure 13 · error against how much the satellite can actually see ─────── */
function fig13() {
  const W = 720, H = 262, L = 62, R = 26, T = 30, B = 60;
  const rows = A.coverageQuintiles;
  const bw = (W - L - R) / rows.length;
  const maxm = Math.max(...rows.map((r: any) => r.mae)) * 1.16;
  const sy = (v: number) => H - B - (v / maxm) * (H - T - B);
  const body = rows.map((r: any, i: number) => {
    const x = L + i * bw + bw * 0.22;
    const w = bw * 0.56;
    const y = sy(r.mae);
    const col = i === 0 ? CORAL : OCHRE;
    return `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${w.toFixed(1)}" height="${(H - B - y).toFixed(1)}" fill="${col}" opacity="${i === 0 ? 1 : 0.78}" rx="2"/>
      <text x="${(x + w / 2).toFixed(1)}" y="${(y - 8).toFixed(1)}" fill="${col}" font-size="11.5" text-anchor="middle" font-family="var(--font-data)">${f2(r.mae)}</text>
      <text x="${(x + w / 2).toFixed(1)}" y="${H - B + 19}" fill="${INK}" font-size="10.5" text-anchor="middle" font-family="var(--font-data)">${r.bld_per_km2_median < 10 ? r.bld_per_km2_median.toFixed(1) : Math.round(r.bld_per_km2_median)}</text>
      <text x="${(x + w / 2).toFixed(1)}" y="${H - B + 33}" fill="${MUTED}" font-size="10.5" text-anchor="middle">n = ${r.n}</text>`;
  }).join("");
  const gl = [0, 2, 4, 6].filter((v) => v < maxm).map((v) =>
    `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.55"/>
     <text x="${L - 9}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10.5" text-anchor="end">${v}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Mean absolute error by quintile of building density">
    ${gl}${body}
    <line x1="${L}" y1="${H - B}" x2="${W - R}" y2="${H - B}" stroke="${GRID}"/>
    <text x="14" y="${(H - B + T) / 2}" fill="${MUTED}" font-size="11" text-anchor="middle" transform="rotate(-90 14 ${(H - B + T) / 2})">mean abs. error · pp →</text>
    <text x="${(L + W - R) / 2}" y="${H - 12}" fill="${MUTED}" font-size="11.5" text-anchor="middle">median roofs per km², by quintile of the ${S.lopo.n} regencies →</text>
  </svg>`;
}

