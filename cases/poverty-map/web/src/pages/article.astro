  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="This case inside East Java compared with Putri et al 2022 on the same province">
    <g><rect x="${pad}" y="22" width="11" height="11" fill="${CORAL}" rx="2"/>
       <text x="${pad + 18}" y="32" fill="${MUTED}" font-size="11.5">This case · East Java, ${EJ?.n ?? "—"} regencies, held out entirely (${A.latest_year})</text>
       <rect x="${pad}" y="44" width="11" height="11" fill="${SLATE}" rx="2"/>
       <text x="${pad + 18}" y="54" fill="${MUTED}" font-size="11.5">Putri et al. 2022 · East Java, ${PUTRI.n} regencies, no hold-out (2020)</text></g>
    <line x1="${pad}" y1="${base}" x2="${W - pad}" y2="${base}" stroke="${GRID}"/>
    ${body}
    <text x="${W / 2}" y="${H - 12}" fill="${MUTED}" font-size="11" text-anchor="middle">Correlation bars are scaled 0–1; the RMSE pair is scaled to 8 pp, where a shorter bar is the better result.</text>
  </svg>`;
}

