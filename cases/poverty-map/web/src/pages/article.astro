/* ── Figure 9 · take the price level away and it is still short ────────────── */
function fig9() {
  const W = 720, H = 250, pad = 54, top = 96, bh = 96, base = top + bh;
  const groups = [
    { k: "Spearman ρ", mine: EJ?.rho ?? A.withinProvince.spearman, theirs: PUTRI.spearman, max: 1 },
    { k: "Pearson r", mine: ejR, theirs: PUTRI.pearson, max: 1 },
    { k: "RMSE, pp — lower is better", mine: ejRmse, theirs: PUTRI.rmse_pp, max: 8 },
  ];
  const gw = (W - pad * 2) / 3;
  const bar = (v: number | null, x: number, col: string, max: number, invert = false) => {
    if (v == null) return `<text x="${(x + 12).toFixed(1)}" y="${base - 6}" fill="${MUTED}" font-size="10.5" text-anchor="middle">n/a</text>`;
    const frac = invert ? Math.min(1, v / max) : Math.min(1, v / max);
    const h = Math.max(2, frac * bh);
    return `<rect x="${x.toFixed(1)}" y="${(base - h).toFixed(1)}" width="26" height="${h.toFixed(1)}" fill="${col}" rx="2"/>
      <text x="${(x + 13).toFixed(1)}" y="${(base - h - 7).toFixed(1)}" fill="${col}" font-size="11" text-anchor="middle" font-family="var(--font-data)">${v.toFixed(2)}</text>`;
  };
  const body = groups.map((g, i) => {
    const xg = pad + i * gw;
    return `<text x="${(xg + gw / 2).toFixed(1)}" y="82" fill="${INK}" font-size="12" text-anchor="middle">${esc(g.k)}</text>
      ${bar(g.mine as any, xg + gw / 2 - 30, CORAL, g.max, g.invert)}
      ${bar(g.theirs as any, xg + gw / 2 + 4, SLATE, g.max, g.invert)}`;
