        max-height: 420px; overflow: auto; }
      ol.contrasts li { border-bottom: 1px solid var(--hairline); padding-bottom: 12px; }
      .cpair { display: grid; grid-template-columns: 1fr auto 90px; gap: 8px; align-items: center; font-size: 13px; }
      .cname { color: var(--ink); }
      .cpair.low .cname, .cpair.low .cval { color: var(--ink-muted); }
      .cval { font-family: var(--font-data); font-variant-numeric: tabular-nums; }
      .cbar { display: block; height: 6px; background: var(--hairline); border-radius: 3px; overflow: hidden; }
      .cbar i { display: block; height: 100%; background: linear-gradient(90deg, #7A4F1E, var(--accent)); }
      .cpair.low .cbar i { background: #4A4034; }
      .cmeta { display: block; margin-top: 6px; text-transform: uppercase; }

      /* ── prose ── */
      .prose h3 { margin: 18px 0 8px; font-size: 15px; }
      .prose h3:first-child { margin-top: 0; }
      .prose p { margin: 0 0 10px; font-size: 14px; line-height: 1.65; color: var(--ink-muted); }
      .prose p b { color: var(--ink); }
      .prose ul { margin: 0; padding-left: 18px; display: grid; gap: 7px; }
      .prose li { font-size: 13px; line-height: 1.6; color: var(--ink-muted); }
      .prose li::marker { color: var(--accent); }
      pre.code { background: #0E0B08; border: 1px solid var(--hairline); border-radius: var(--radius);
        padding: 12px 14px; overflow-x: auto; font-family: var(--font-data); font-size: 13px;
        line-height: 1.65; color: var(--ink); margin: 0 0 10px; }
      code { font-family: var(--font-data); font-size: 13px; background: var(--surface-raised);
        padding: 1px 5px; border-radius: 3px; }

      /* ── tooltip ── */
      .tooltip { position: fixed; z-index: 120; pointer-events: none; max-width: 300px;
        background: color-mix(in srgb, var(--surface-raised) 96%, transparent); backdrop-filter: blur(8px);
        border: 1px solid var(--hairline); border-left: 2px solid var(--accent); border-radius: var(--radius);
        padding: 10px 12px; font-size: 13px; line-height: 1.5; color: var(--ink);
        box-shadow: 0 16px 40px rgba(0,0,0,0.6); }
      .tooltip b { font-family: var(--font-display); font-size: 14px; }
      .t-sub { display: block; font-family: var(--font-data); font-size: 12px; color: var(--ink-muted);
        margin: 2px 0 6px; }
      .t-row { display: flex; justify-content: space-between; gap: 14px; padding: 2px 0; }
      .t-row span { color: var(--ink-muted); }
      .t-row b { font-family: var(--font-data); font-size: 13px; font-variant-numeric: tabular-nums; }

      /* ── reveals ── */
      .reveal { opacity: 0; transform: translateY(16px); transition: opacity 700ms cubic-bezier(.2,.7,.3,1),
        transform 700ms cubic-bezier(.2,.7,.3,1); }
      .reveal.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }

      /* Review hand-off — the article is a separate page, so it gets a real door. */
      .review-cta { padding-top: 4vh; }
      .review-cta .lede { color: var(--ink-muted); }
      .cta.big { display: inline-block; margin-top: 16px; font-family: var(--font-data);
        font-size: 0.82rem; letter-spacing: 0.08em; color: var(--accent);
        border: 1px solid var(--accent); border-radius: 4px; padding: 13px 22px;
        text-decoration: none; transition: background 0.18s ease, transform 0.18s ease; }
      .cta.big:hover { background: var(--accent-ink); transform: translateY(-1px); }
      @media (prefers-reduced-motion: reduce) { .cta.big { transition: none; } }

      .foot { max-width: var(--content-width); margin: 40px auto 0; padding: 20px 22px 56px;
        border-top: 1px solid var(--hairline); display: grid; gap: 8px; }

      .maplibregl-ctrl-attrib { background: color-mix(in srgb, var(--ground) 72%, transparent) !important;
        color: var(--ink-muted); font-size: 12px; }
      .maplibregl-ctrl-attrib a { color: var(--ink-muted); }
    </style>
  
    <script>
      /* A hover read-out must not outlive the hover. Each chart hides its own tooltip on
         mouseleave, but a hover can end without one ever firing: the window loses focus
         (an app switch, a screenshot), or the tab is hidden. Backstop only — it never
         second-guesses an active hover, it just closes read-outs once hovering has
         demonstrably ended. */
      (() => {
        const stale = () => [...document.querySelectorAll('[id*="tip" i],[id*="tool" i],[class*="tip" i]')]
          .filter((e) => !e.hidden && e.offsetWidth > 40 && getComputedStyle(e).position !== "static");
        const hide = () => stale().forEach((e) => { e.hidden = true; });
        addEventListener("blur", hide);
        document.addEventListener("visibilitychange", () => { if (document.hidden) hide(); });
      })();
    </script>
  
    <section class="colophon">
      <style>
        .colophon { max-width: var(--content-width, 72rem); margin: 0 auto;
          padding: 3rem 5vw 4rem; border-top: 1px solid var(--hairline, #2a2a2a);
          display: grid; gap: 1.6rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
        .colophon h3 { font-family: var(--font-data, monospace); font-size: 0.7rem;
          letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 0.6rem;
          color: var(--accent, #6fc7d6); }
        .colophon p { margin: 0 0 0.5rem; font-size: 0.86rem; line-height: 1.55;
          color: var(--ink-muted, #93a198); }
        .colophon b { color: var(--ink, #e8ede9); font-weight: 600; }
        .colophon .sm { font-size: 0.78rem; }
      </style>
      <div>
        <h3>Instrument</h3>
        <p>Method, models, evaluation and instrument · <b>Taufik Adi Nugraha</b></p>
        <p class="sm">Estimator choice, model construction, baselines and validation design.
        Implementation was AI-assisted (Claude), under the builder's direction. Thresholds
        were fixed before any result was seen, and every gate is published with its outcome
        including the failures.</p>
      </div>
      <div>
        <h3>Domain interpretation · open</h3>
        <p>This instrument has no domain author yet. Someone who knows BPS poverty measurement. The model downscales to kecamatan with spatial cross-validation. What is missing is whether estimates at that resolution can responsibly be used for targeting, what Susenas sampling actually supports, and where a sub-district figure would do harm.</p>
        <p class="sm">Write the interpretation and take <b>first author</b>; the studio is
        <b>methods co-author</b> for the analysis and evaluation already built here.</p>
      </div>
    </section>
  </body>
