      #bars text.name { font-family: var(--font-body); font-size: 13px; }
      #bars text.val { font-family: var(--font-data); font-size: 12px; font-variant-numeric: tabular-nums; }
      #bars g.row:hover rect.bg { fill: color-mix(in srgb, var(--surface-raised) 70%, transparent); }

      .table-scroll { overflow-x: auto; }
      .data-table { border-collapse: collapse; width: 100%; font-family: var(--font-data); font-size: 12px; line-height: 1.5; }
      .data-table th { text-align: left; font-weight: 600; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); padding: 8px 14px 8px 0; border-bottom: 1px solid var(--ink); }
      .data-table td { padding: 9px 14px 9px 0; border-bottom: 1px solid var(--hairline); vertical-align: top; font-variant-numeric: tabular-nums; }
      .data-table td.detail { color: var(--ink-muted); font-size: 12px; min-width: 22rem; }
      .data-table .ok { color: var(--official); font-weight: 600; } .data-table .bad { color: var(--danger); font-weight: 600; } .data-table .defer { color: var(--ink-muted); }

      #tip { position: absolute; z-index: 30; pointer-events: none; max-width: 22rem; background: var(--surface-raised); border: 1px solid var(--hairline); border-radius: 4px; padding: 8px 11px;
        font-family: var(--font-data); font-size: 12px; line-height: 1.6; color: var(--ink); }
      #tip[hidden] { display: none; }
      #kel-panel[hidden] { display: none; }
      #kel-panel { position: fixed; right: 20px; top: 50%; transform: translateY(-50%); z-index: 25; width: 300px; max-height: 88vh; overflow: auto; background: var(--surface-raised); border: 1px solid var(--hairline); border-radius: 6px; padding: 18px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 10px 40px rgba(0,0,0,0.45); }
      @media (max-width: 860px) { #kel-panel { right: 0; left: 0; top: auto; bottom: 0; transform: none; width: auto; border-radius: 10px 10px 0 0; max-height: 60vh; } }
      #kel-panel h3 { margin: 0; font-size: 1.1rem; }
      #panel-close { position: absolute; top: 8px; right: 10px; background: none; border: 0; color: var(--ink-muted); font-size: 1.2rem; cursor: pointer; }
      .panel-stats { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 5px 12px; }
      .panel-stats dt { font-family: var(--font-data); font-size: 12px; letter-spacing: 0.08em; color: var(--ink-muted); align-self: center; }
      .panel-stats dd { margin: 0; font-family: var(--font-data); font-size: 12px; font-variant-numeric: tabular-nums; }
      .panel-clock { margin: 0; font-size: 0.86rem; line-height: 1.55; }
      .spark-label { font-family: var(--font-data); font-size: 12px; fill: var(--ink-muted); }

      /* Review hand-off — the article is a separate page, so it gets a real door. */
      .review-cta { padding-top: 14vh; padding-bottom: 8vh; }
      .review-cta p { color: var(--ink-muted); }
      .cta.big { align-self: flex-start; margin-top: 8px; font-family: var(--font-data);
        font-size: 0.82rem; letter-spacing: 0.08em; color: var(--accent);
        border: 1px solid var(--accent); border-radius: 4px; padding: 13px 22px;
        text-decoration: none; transition: background 0.18s ease, transform 0.18s ease; }
      .cta.big:hover { background: var(--accent-ink); transform: translateY(-1px); }
      @media (prefers-reduced-motion: reduce) { .cta.big { transition: none; } }

      .method { max-width: 46rem; margin: 0 auto; padding: 12vh 24px 14vh; display: flex; flex-direction: column; gap: 14px; }
      .method p { margin: 0; font-size: 0.9rem; line-height: 1.7; color: var(--ink-muted); }
      .method p b { color: var(--ink); font-weight: 600; }
      .maplibregl-ctrl-attrib { background: color-mix(in srgb, var(--ground) 70%, transparent) !important; color: var(--ink-muted); font-size: 12px; }
    </style>
  
    <script>
      /* A hover read-out must not outlive the hover. Each chart hides its own tooltip on
         mouseleave, but a hover can end without one ever firing: the window loses focus
         (an app switch, a screenshot), or the tab is hidden. Backstop only — it never
         second-guesses an active hover, it just closes read-outs once hovering has
         demonstrably ended. */
      (() => {
        const stale = () => [...document.querySelectorAll('[id*="tip" i],[id*="tool" i],[class*="tip" i]')]
          .filter((e) => !e.hidden && e.offsetWidth > 40 && getComputedStyle(e).position !== "static");
        const hide = () => stale().forEach((e) => { e.hidden = true; });
        addEventListener("blur", hide);
        document.addEventListener("visibilitychange", () => { if (document.hidden) hide(); });
      })();
    </script>
  
    <section class="colophon">
