---
// Case C — page anatomy per spec §C5: hero (velocity field settles) → how fast, where →
// the clock → who is exposed → validation → methodology. Identity: bathymetric blue → cyan
// for subsidence, coral reserved for flood exposure (spec §C6).
import "../styles/tokens.css";
import "maplibre-gl/dist/maplibre-gl.css";
const S = (await import("../data/summary.json").catch(() => null))?.default ?? null;
// review findings (pipeline/review.py → pipeline/article.py). Corrections made to this
// page after the adversarial review quote these, so page and article cannot diverge.
const R = (await import("../data/article.json").catch(() => null))?.default ?? null;
const cjktEarly = R?.decel?.all?.find((s) => s.station === "CJKT");
const estMean = R?.estimator?.estimators?.mean?.["1m"]?.["2025"];
const estMin = R?.estimator?.estimators?.min?.["1m"]?.["2025"];
const radarOff = R?.ranking?.drivers?.find((d) => d.k.includes("radar"))?.rho;
const fmtN = (v) => (v == null ? "—" : Math.round(v).toLocaleString("en-US"));
const fmtM = (v) => (v == null ? "—" : `${(v / 1e6).toFixed(v >= 1e6 ? 1 : 2)} M`);
const pct = (v, d = 0) => (v == null ? "—" : `${(v * 100).toFixed(d)}%`);
const cm = (v) => (v == null ? "—" : `${v > 0 ? "+" : "−"}${Math.abs(v).toFixed(2)}`);
const fastest = S?.fastest_p10?.[0];
const soon = S?.soonest_0m?.[0];
const b1 = S?.below?.["1m"], b0 = S?.below?.["0m"];
const generated = S?.generated ?? "pending";
const gateRows = ["G-C1", "G-C2", "G-C3", "G-C4", "G-C5"].map((k) => ({ k, ...(S?.gates?.[k] ?? { label: "—", pass: null }) }));
const gateDetail = (g) => {
  const d = g.detail;
  if (!d || typeof d === "string") return d ?? "";
  if (g.k === "G-C4")
    return `${d.kelurahan_n} kelurahan · WorldPop ${fmtN(d.worldpop_total)} (${d.worldpop_vs_official > 0 ? "+" : ""}${pct(d.worldpop_vs_official, 1)} vs census ${fmtM(d.official_2020)}) · GHSL ${d.ghsl_vs_worldpop > 0 ? "+" : ""}${pct(d.ghsl_vs_worldpop, 1)} vs WorldPop · ${pct(d.mainland_covered_share)} of mainland kelurahan with ≥30% InSAR coverage`;
  if (g.k === "G-C5")
    return `Spearman ρ exposure index vs BPBD flood events = ${d.rho_index_vs_flood_events} (threshold ${d.threshold}; low-ground share ${d.rho_low1_vs_flood_events}, sinking rate ${d.rho_p10_vs_flood_events}) · 2020 flood covered ${pct(d.top20_exposure_2020_share)} of the 20 most exposed kelurahan vs ${pct(d.all_2020_share)} of all`;
  return JSON.stringify(d);
};
// spec §C4 gate ranges (G-C1): NW-coast hotspots 2–6 cm/yr; central Jakarta within ±1
const LIT = { "Muara Baru": "2–6 · gate", "Kamal Muara": "2–6 · gate", "Kosambi": "2–6 · gate", "PIK / Kapuk Muara": "2–6 · gate", "Ancol": "±1 · gate", "Monas (central)": "±1 · gate" };
const c5 = S?.gates?.["G-C5"]?.detail;
const flooded = S?.most_flooded ?? [];
---
<html lang="en" data-case="sinking" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jakarta Is Sinking</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" />
  </head>
  <body>
    <header class="stamp-bar">
      <span class="stamp">JAKARTA IS SINKING</span>
      <span class="stamp dim">SENTINEL-1 INSAR 2017–2023 · {S?.n_kel ?? 267} KELURAHAN · SNAPSHOT {generated}</span>
    </header>

    <section class="hero">
      <img id="hero-still" src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/hero.jpg`}
           alt="Greater Jakarta rendered in the bathymetric ramp — stable ground in navy, the fastest-subsiding north coast in luminous cyan" />
      <canvas id="hero-canvas" aria-hidden="true"></canvas>
      <div class="hero-copy">
        <span class="eyebrow">Land subsidence + flood exposure</span>
        <h1>The ground under Jakarta is moving.</h1>
        <p>Radar interferometry from orbit measures the city sinking — and measures it
        <b>slower than the famous numbers</b>, in different places. Over 2017–2023 the fastest
        ground loses a few centimetres a year, and much of it is inland in the west, not on the
        coast. This case turns that measurement into what a city, an insurer or a utility needs:
        <b>which kelurahan, how fast, and how much of it is still moving</b>.</p>
        <span class="stamp dim" id="hero-status">OHENHEN ET AL. 2026 · VERTICAL VELOCITY · 2017–2023 · NEGATIVE = SUBSIDENCE</span>
      </div>
      <div class="hero-hud" id="hero-hud" aria-live="off">
        <span class="hud-num" id="hud-cm">−0 cm</span>
        <span class="stamp dim">LOST SINCE 2017 · {(fastest?.name ?? "NORTH COAST").toUpperCase()} · FASTEST DECILE</span>
      </div>
      <div class="hero-legend" aria-hidden="true">
        <i></i>
        <div><span>0</span><span>−2</span><span>−4</span><span>−6 cm/yr</span></div>
      </div>
      <div class="scroll-hint" aria-hidden="true">▾</div>
    </section>

    <section class="chapter">
      <span class="eyebrow">01 · How fast, where</span>
      <h2>Where the city sinks fastest</h2>
      <p class="big-stat"><b class="cyan">{fmtN(S?.pop_fast2)}</b> people in DKI Jakarta live on ground
      sinking faster than <b class="cyan">2 cm a year</b>. In <b class="cyan">{S?.n_kel_p10_fast2 ?? "—"}</b> of
      {S?.n_ranked ?? "—"} measured kelurahan the fastest tenth of the ground drops more than that.</p>
      <p>The map colours every kelurahan by its rate over 2017–2023: the fastest decile (p10)
      shows the hotspot cores the way the literature's peak values do; the median tells the
      neighbourhood story. Fastest single decile: <b>{fastest?.name ?? "—"}</b> ({fastest?.kota ?? "—"}),
      {cm(fastest?.v_p10)} cm/yr, {cm(fastest?.v_med)} at the median.
      Toggle the velocity field to see the measurement itself — including Tangerang and Bekasi,
      which the kelurahan table does not cover.</p>
      {R?.geography && (
        <p><b>It is not only a coastal story any more.</b> Of the 20 fastest-subsiding kelurahan by
        median rate, {R.geography.top20_by_kota["Jakarta Barat"] ?? 0} are in West Jakarta and only
        {" "}{R.geography.top20_by_kota["Jakarta Utara"] ?? 0} in North Jakarta; just
        {" "}{R.geography.n_top20_coastal} of the 20 sit in the coastal belt. Across the city, sinking
        rate and low ground are close to independent (rank correlation ρ = {R.geography.rho_rate_vs_lowground}):
        the fastest ground includes inland West Jakarta kelurahan whose low ground sits several metres
        up, which is a foundation and buried-pipe problem rather than a flooding one.</p>
      )}
      <p class="footnote"><b>Why it sinks:</b> decades of groundwater extraction compacting the young
      alluvial and marine clays under the coastal plain, with the load of the built city on top —
      the mechanism is well documented (Abidin et al. 2011; Chaussard et al. 2013; Ohenhen et al. 2026).
      {cjktEarly ? ` And it has slowed: on the continuous GNSS record the central-Jakarta station CJKT drops from −${Math.abs(cjktEarly.early).toFixed(1)} mm/yr over 2010–2016 to −${Math.abs(cjktEarly.late).toFixed(1)} mm/yr over 2017–2022, and all ${R.decel.west.n} stations inside this working area slowed, while ${R.decel.east.n - R.decel.east.n_slower} of ${R.decel.east.n} elsewhere on the north Java coast got faster.` : ""}
      The 10–25 cm/yr figures still quoted for Jakarta are from the 1990s and 2000s.</p>
    </section>

    <section class="explore">
      <div class="explore-head">
        <div class="toggle" role="group" aria-label="map metric" id="metric-toggle">
          <button data-m="p10" class="on">FASTEST DECILE</button><button data-m="med">MEDIAN RATE</button><button data-m="flood">FLOOD EVENTS 2021–24</button><button data-m="low1">GROUND BELOW +1 M</button>
        </div>
        <button id="btn-field" class="chip-btn">VELOCITY FIELD</button>
      </div>
      <div class="map-wrap">
        <div id="map1" class="map"></div>
        <div class="legend" id="legend1"><i></i><div></div></div>
      </div>
      <div class="hotspots">
        <h3 class="stamp">NAMED HOTSPOTS · CM/YR · 2017–2023 · MEDIAN | FASTEST DECILE · PUBLISHED RANGE</h3>
        <ol class="ranked">
          {(S?.hotspots ?? []).slice().sort((a, b) => (a.p10 ?? 0) - (b.p10 ?? 0)).map((h) => (
            <li>
              <span class="rname">{h.name}</span>
              <span class="rbar"><i style={`width:${Math.min(100, Math.abs(h.p10 ?? 0) / 6 * 100)}%`}></i></span>
              <span class="rval">{cm(h.median)} | <b>{cm(h.p10)}</b></span>
              <span class="rlit">{LIT[h.name] ?? ""}</span>
            </li>
          ))}
        </ol>
        <p class="footnote">These rates are lower than the peaks in circulation for Jakarta, for two
        separate reasons. Part is scale: this field averages ~75 m cells, so a core reads lower than a
        persistent-scatterer point. Part is time — the ground genuinely slowed between the 2000s surveys
        and this window, which the GNSS record confirms. Contemporaneous Sentinel-1 studies of the same
        city over the same years still disagree with each other by a factor of about four, so read these
        numbers to one significant figure, not two. The review article works through both.</p>
      </div>
    </section>

    <section class="chapter">
      <span class="eyebrow">02 · The clock</span>
      <h2>Where the ground goes next — if nothing changes</h2>
      <p class="big-stat">On this model <b class="coral">{fmtM(b1?.["2025"]?.pop)}</b> people stand on
      ground below +1 m today, <b class="coral">{fmtM(b1?.["2030"]?.pop)}</b> by 2030 and
      <b class="coral">{fmtM(b1?.["2050"]?.pop)}</b> by 2050 if the 2017–2023 rates hold; below mean sea
      level, {fmtM(b0?.["2025"]?.pop)} → {fmtM(b0?.["2050"]?.pop)}.</p>
      {R?.estimator && (
        <p><b>Read those as an ordering, not as counts.</b> "Ground" here is the <i>lowest</i> of the
        roughly nine 30 m elevation pixels in each 100 m cell — a way of finding roads and yards rather
        than roofs in a surface model, but also a minimum of nine noisy samples. Computed on the cell
        mean instead, the same grid and the same population give <b>{fmtN(estMean)}</b> below +1 m rather
        than {fmtN(estMin)} — a factor of {R.estimator.min_vs_mean_1m_2025}. The published figure is,
        on the cell mean, the population below +{R.estimator.equivalent_mean_height_m} m. The
        <i>ranking</i> of kelurahan survives this; the absolute counts do not.</p>
      )}
      <p><b>This is a linear extrapolation, not a forecast</b>, and its assumptions are worth more than
      its signal. Each 100 m cell's ground drops at its measured 2017–2023 rate, year after year; cells
      without radar coverage are held still. Groundwater policy, the sea wall, drainage, rainfall and
      sea-level rise are all outside the model. Ground height comes from Copernicus GLO-30 — a 30 m
      <i>surface</i> model acquired 2011–2015, with ±2–4 m vertical accuracy.
      {soon ? ` At its median rate, ${soon.name} (${soon.kota}) — low ground at ${soon.ground_p10?.toFixed(1)} m — reaches mean sea level in about ${Math.round(soon.clock_med_0m)} years; ${S?.already_below_0m ?? 0} kelurahan already have low ground below it, and exactly ${R?.clock?.within_horizon ?? "—"} more crosses it inside the window this clock animates.` : ""}</p>
      {R?.epoch && R?.decay && (
        <p class="footnote"><b>Three assumptions, priced.</b> Correcting the twelve-year-old elevation
        model for subsidence since acquisition moves today's count from {fmtN(R.epoch.published["1m"]["2025"])}
        to {fmtN(R.epoch.counts["1m"]["2025"])} — a number this clock does not otherwise reach until
        {" "}{R.epoch.clock_year_equivalent}. Raising the sea-level datum 15 cm, within the range implied by
        measured Java Sea rise, takes 2050 to {fmtN(R.datum.pop_1m_2050[3])}. Letting the rate decay at
        the halving time the Jakarta GNSS station actually shows, instead of holding it flat, takes 2050
        down to {fmtN(R.decay.pop_1m_2050)}. Two of those make the clock optimistic and one makes it
        pessimistic: the honest 2050 bracket is {fmtN(R.decay.pop_1m_2050)}–{fmtN(R.epoch.counts["1m"]["2050"])}
        on assumptions alone. The review article works through all three.</p>
      )}
      {R?.series?.below0m && (
        <p class="footnote"><b>And one number here is a rounding artefact.</b> The elevation model pins
        water and near-shore cells to exactly 0.00 m, where {fmtN(R.estimator.pop_at_exact_zero)} people
        live. They sit one arbitrary millimetre above the mean-sea-level threshold, so the below-MSL
        count jumps {fmtN(R.series.below0m.first_step)} between 2025 and 2026 — {pct(R.series.below0m.first_share)}
        of the entire 25-year rise — and then adds a median of {fmtN(R.series.below0m.median_rest)} a year.
        Use the below-MSL series for its shape after 2026, not for its 2025 level.</p>
      )}
    </section>

    <section class="explore">
      <div class="clock-hud">
        <span class="clock-year" id="clock-year">2025</span>
        <div class="clock-stats">
          <div><span class="stamp dim">PEOPLE BELOW</span><b id="hud-pop">—</b></div>
          <div><span class="stamp dim">BUILT-UP BELOW</span><b id="hud-built">—</b></div>
          <div><span class="stamp dim">KELURAHAN MOSTLY BELOW</span><b id="hud-kel">—</b></div>
        </div>
        <div class="clock-controls">
          <div class="toggle" role="group" aria-label="threshold" id="thr-toggle">
            <button data-t="1" class="on">+1 M</button><button data-t="0">MEAN SEA LEVEL</button>
          </div>
          <button id="clock-play" class="play" aria-label="play">▶</button>
          <input type="range" id="clock-range" min="2025" max="2050" step="1" value="2025" aria-label="year" />
        </div>
      </div>
      <div class="map-wrap">
        <div id="map2" class="map"></div>
        <div class="legend" id="legend2"><i></i><div><span>0%</span><span>50%</span><span>100%</span><span class="cap">residents below threshold</span></div></div>
      </div>
      <div id="clock-chart" class="chart"></div>
      <p class="footnote">City totals by year for both thresholds; hover the chart to move the clock.
      Only kelurahan on the mainland are counted; Kepulauan Seribu lies outside the velocity field.</p>
    </section>

    <section class="chapter wide">
      <span class="eyebrow">03 · Who is exposed</span>
      <h2>Who stands on the lowest ground</h2>
      <p>Ranked by residents (WorldPop 2020) or built-up surface (GHSL 2020) on ground below the
      threshold in the clock's year. Click a bar to open the kelurahan; the maps follow.</p>
      {radarOff != null && (
        <p class="footnote"><b>What this ranking is made of.</b> It is overwhelmingly an elevation
        ranking. Recomputed with the radar switched off — every velocity set to zero — the 2050 order is
        rank-correlated ρ = {radarOff} with the published one and shares
        {" "}{R.ranking.top20_shared_no_radar} of its top 20. Against the measured sinking rate the
        published ranking correlates only ρ = {R.ranking.drivers.find((d) => d.k.includes("sinking")).rho}.
        Twenty-five years of subsidence move the city total from {fmtN(R.ranking.city_2050_without)} to
        {" "}{fmtN(R.ranking.city_2050_with)}. Treat this as a low-ground map with a subsidence
        adjustment; for the subsidence signal itself, read chapter 01.</p>
      )}
      <div class="controls">
        <div class="toggle" role="group" aria-label="quantity" id="who-toggle">
          <button data-w="pop" class="on">PEOPLE</button><button data-w="built">BUILT-UP KM²</button>
        </div>
        <span class="stamp dim" id="bars-caption"></span>
      </div>
      <div id="bars" class="chart"></div>
    </section>

    <section class="chapter">
      <span class="eyebrow">04 · Does it hold up?</span>
      <h2>Checks before the story</h2>
      <p>Three things sit beside the radar field: continuous GNSS stations (Susilo et al. 2023,
      millimetre-level vertical rates), the published literature on Jakarta's hotspots, and the
      depositors' own published statistics for the same data. Then the exposure numbers are checked
      against the census and against floods that actually happened. Two of these checks were
      misdescribed on this page before the review; the corrections are below the tables.</p>
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>GNSS station</th><th>GNSS vertical mm/yr</th><th>InSAR mm/yr</th><th>Δ</th><th>Cells</th><th>±5 mm/yr</th></tr></thead>
          <tbody>
            {(S?.gnss ?? []).map((g) => (
              <tr><td>{g.station}</td><td>{g.gnss_mm}</td><td>{g.insar_mm ?? "—"}</td>
                  <td>{g.insar_mm == null ? "—" : (g.insar_mm - g.gnss_mm).toFixed(1)}</td><td>{g.n}</td>
                  <td class={g.ok ? "ok" : "bad"}>{g.ok ? "PASS" : "FAIL"}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>#</th><th>Check</th><th>Result</th><th>Detail</th></tr></thead>
          <tbody>
            {gateRows.map((g, gi) => (
              <tr><td>{gi + 1}</td><td>{g.label}</td>
                  <td class={g.pass === true ? "ok" : g.pass === false ? "bad" : "defer"}>{g.pass === true ? "PASS" : g.pass === false ? "FAIL" : "DEFERRED"}</td>
                  <td class="detail">{gateDetail(g)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      {c5 && S?.gates?.["G-C5"]?.pass === false && (
        <p><b>The plausibility check fails, and the failure is the finding — not an apology.</b>
        Where Jakarta floods and where Jakarta sinks are different places, and an agency that plans
        drainage from a subsidence map will defend the wrong neighbourhoods. BPBD's 2021–2024 record is
        dominated by riverine floods along the Ciliwung and its tributaries in East Jakarta —
        {flooded.slice(0, 3).map((f) => `${f.name} (${f.fl_events} event dates)`).join(", ")} — kelurahan on
        higher ground that barely subside. Across the city, flood frequency is <i>inversely</i> related to
        low ground (ρ = {c5.rho_low1_vs_flood_events}) and only weakly to the sinking rate
        (ρ = {c5.rho_p10_vs_flood_events}). Subsidence-driven exposure is a coastal, tidal and drainage
        problem, and it is the January 2020 extent — one extreme event seen by Sentinel-1 — that overlaps
        the most-exposed kelurahan disproportionately: {pct(c5.top20_exposure_2020_share)} of their area
        against {pct(c5.all_2020_share)} city-wide. We keep the gate red rather than redefine it to pass.</p>
      )}
      {R?.gnss && (
        <p><b>Correction: the GNSS gap is a period gap, not a frame offset.</b> This page previously
        explained the ≈2 mm/yr difference in the table above as an InSAR reference-frame effect. That was
        wrong. The depositors transform their field into the same global frame family the GNSS solutions
        use, and the published GNSS rates are fitted over each station's <i>whole</i> record — at CJKT,
        2010–2022 — while the radar covers 2017–2023. Refitting each station on the radar's own window
        (with annual and semi-annual terms removed) collapses the disagreement from
        {" "}{R.gnss.mean_d_full > 0 ? "+" : "−"}{Math.abs(R.gnss.mean_d_full).toFixed(2)} ± {R.gnss.sd_d_full.toFixed(2)} mm/yr
        to {R.gnss.mean_d_late > 0 ? "+" : "−"}{Math.abs(R.gnss.mean_d_late).toFixed(2)} ± {R.gnss.sd_d_late.toFixed(2)}.
        The field is tied far better than the table suggests, and the residual it was hiding is the real
        signal in chapter 01 — the ground slowed down between the two windows.</p>
      )}
      {R?.replication_max_err != null && (
        <p><b>The strongest check is a replication.</b> The depositors publish per-municipality statistics
        for this same field (Ohenhen et al. 2026, table S2). Regridding their point cloud independently —
        different resampling, different boundary file, different zonal method — reproduces that table
        across all five Jakarta municipalities, with a largest disagreement in the mean of
        {" "}<b>{R.replication_max_err.toFixed(3)} cm/yr</b>. The ingest, filter, gridding and zonal
        steps are faithful.</p>
      )}
      <p class="footnote">The GNSS comparison is a consistency check rather than an independent one: the
      depositors used stations from this same archive to align their field to the global frame, so it
      cannot fail unless something is badly broken. Genuinely independent reprocessing — our own LiCSBAS
      run over LiCSAR frame 098A (2017–2024) against this deposited field — is pending; it needs a 13 GB
      download and runs after the flagships' bandwidth frees.</p>
    </section>

    <section class="chapter review-cta">
      <span class="eyebrow">05 · Review</span>
      <h2>Audited adversarially, by its own author.</h2>
      <p>A second read of the same data against the published literature, and against the GNSS record — written to attack the first. It was done by the person who built the instrument; no external reviewer has checked it — if you would like to be the first, breaking a gate here is worth more than another instrument.</p>
      <a class="cta big" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/article`}>Read the review article →</a>
    </section>

    <footer class="method">
      <span class="eyebrow">Methodology &amp; sources</span>
      <p><b>Velocity:</b> Ohenhen et al. 2026 (Science Advances), Java-wide Sentinel-1 InSAR vertical land
      motion 2017–2023, point cloud ~75 m, Zenodo 10.5281/zenodo.15786356, CC BY 4.0 — {fmtN(S?.points)} points
      in the Jakarta window, duplicates from overlapping frames averaged, points with sd &gt; 1 cm/yr dropped,
      gridded to 0.001°. Negative = subsidence. <b>Ground truth:</b> Susilo et al. 2023 (Scientific Data),
      continuous GNSS north Java, Zenodo 10.5281/zenodo.7775016, CC BY 4.0. <b>Elevation:</b> Copernicus
      GLO-30 DEM (© DLR e.V. 2010–2014 and © Airbus Defence and Space GmbH 2014–2018, provided under
      COPERNICUS by the European Union and ESA; all rights reserved) — a surface model; the per-cell minimum
      is our ground proxy. <b>Population:</b> WorldPop 2020 constrained 100 m (CC BY 4.0; totals
      {fmtM(S?.pop_total)} vs census {fmtM(S?.official_pop)}); GHSL GHS-POP E2020 as cross-check
      ({fmtM(S?.ghs_pop_total)}) and GHS-BUILT-S E2020 for built-up surface (JRC, CC BY 4.0).
      <b>Admin units and observed floods:</b> Jakarta Satu / DKI Jakarta (267 kelurahan) and BPBD DKI Jakarta
      flood history 2021–2024 (RT-level polygons, depth and date) via ArcGIS REST — no explicit licence text;
      used with attribution. <b>January 2020 flood:</b> UNOSAT FL20200101IDN Sentinel-1 water extent
      (2 Jan 2020) and EOS-ARIA Singapore flood proxy map v1.5. <b>Fusion:</b> one 100 m analysis grid
      (WorldPop's cells); kelurahan assigned by cell centre; velocity bilinear; kelurahan p10 = fastest decile
      of covered cells; flood frequency = distinct BPBD event dates with a flooded RT inside the kelurahan.
      <b>The clock:</b> ground(y) = ground(2025) + v·(y−2025), linear, no scenarios, cells without coverage
      held still, sea level held at its 2008 datum — an illustration of momentum, not a prediction; the
      assumption bracket is priced in chapter 02 and in the review. <b>Checks:</b> literature range, GNSS,
      exposure sanity and flood plausibility evaluated above, plus the eight review tests in
      <code>pipeline/review.py</code> (replication against the depositors' own district table; GNSS refits
      on matched windows; three ground estimators; elevation epoch; datum sweep; radar-off ranking; decaying
      rate). Independent interferometric reprocessing is deferred.</p>
      <span class="stamp dim">AN OPENSTUDY.ID INSTRUMENT · STATIC SNAPSHOT · GENERATED {generated} · ALL SOURCES OPEN</span>
    </footer>

    <aside id="kel-panel" hidden>
      <button id="panel-close" aria-label="close">×</button>
      <h3 id="panel-name"></h3>
      <div class="stamp dim" id="panel-sub"></div>
      <dl class="panel-stats" id="panel-stats"></dl>
      <div id="panel-spark"></div>
      <p class="panel-clock" id="panel-clock"></p>
    </aside>
    <div id="tip" hidden></div>

    <script>
      import maplibregl from "maplibre-gl";
      import * as d3 from "d3";

      /* visible failure beats silent emptiness (same pattern as the other cases) */
      const failBanner = (msg) => {
        let b = document.getElementById("err-banner");
        if (!b) {
          b = document.createElement("div"); b.id = "err-banner";
          b.style.cssText = "position:fixed;bottom:0;left:0;right:0;z-index:99;background:#3A1E1A;color:#F26D5B;font:12px ui-monospace,monospace;padding:10px 16px;border-top:1px solid #F26D5B;";
          document.body.appendChild(b);
        }
        b.textContent = "⚠ " + msg;
      };
      addEventListener("error", (e) => failBanner("Script error: " + (e.message ?? e.type)));
      addEventListener("unhandledrejection", (e) => failBanner("Load error: " + (e.reason?.message ?? e.reason)));
      const sect = (name, fn) => { try { return fn(); } catch (err) { console.error(name, err); failBanner(`${name} failed: ${err.message ?? err}`); return null; } };

      const base = import.meta.env.BASE_URL.replace(/\/$/, "");
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const GROUND = "#070D16", HAIR = "#1E2E44", INK = "#E4EBF2", MUTED = "#8CA0B5", CYAN = "#35C6E0", CORAL = "#F26D5B", NODATA = "#1B2432";
      const heroStatus = document.getElementById("hero-status");
      const load = (f) => fetch(`${base}/data/${f}`).then((r) => { if (!r.ok) throw f; return r.json(); });

      let X, geo, hot;
      try {
        [X, geo, hot] = await Promise.all(["exposure.json", "kelurahan.geojson", "hotspots.json"].map(load));
      } catch (missing) {
        heroStatus.textContent = `PIPELINE STILL RUNNING — ${missing} not yet exported. Refresh in a few minutes.`;
        throw missing;
      }
      const K = X.kel, YEARS = X.years, Y0 = X.base_year;
      const ids = geo.features.map((f) => f.properties.id);
      const rampV = d3.scaleLinear().domain(X.ramp_v.map((p) => p[0])).range(X.ramp_v.map((p) => p[1])).clamp(true).interpolate(d3.interpolateRgb);
      const rampX = d3.scaleLinear().domain([0, 0.25, 0.5, 0.75, 1]).range(X.ramp_x).clamp(true).interpolate(d3.interpolateRgb);
      const fmtN = d3.format(",.0f"), fmtP = d3.format(".0%"), fmt1 = d3.format(".1f");
      const cm = (v) => (v == null ? "—" : `${v > 0 ? "+" : "−"}${Math.abs(v).toFixed(2)}`);
      const yi = () => state.year - Y0;
      const state = { metric: "p10", field: false, year: Y0, thr: "1", who: "pop", sel: null };
      const floodMax = d3.max(ids, (id) => K[id].fl_ev) || 1;
      const METRICS = {
        p10: { label: "fastest decile", value: (k) => k.v_p10, color: (v) => (v == null ? NODATA : rampV(v)), legend: "v" },
        med: { label: "median rate", value: (k) => k.v_med, color: (v) => (v == null ? NODATA : rampV(v)), legend: "v" },
        flood: { label: "flood events 2021–24", value: (k) => k.fl_ev, color: (v) => (v == null ? NODATA : rampX(v / floodMax)), legend: "flood" },
        low1: { label: "ground below +1 m", value: (k) => k.low1, color: (v) => (v == null ? NODATA : rampX(v)), legend: "share" },
      };
      const tip = document.getElementById("tip");
      const showTip = (e, html) => { tip.hidden = false; tip.innerHTML = html; tip.style.left = e.pageX + 14 + "px"; tip.style.top = e.pageY + 14 + "px"; };
      const hideTip = () => { tip.hidden = true; };
      const kelTip = (id) => {
        const k = K[id]; if (!k) return "—";
        const v = state.metric === "p10" ? k.v_p10 : k.v_med;
        return `<b>${k.name}</b> <span class="dim">· ${k.kec} · ${k.kota}</span><br>` +
          (k.cov ? `${state.metric === "med" ? "median" : "fastest decile"} <b>${cm(v)} cm/yr</b> · 2017–2023 <span class="dim">(${fmtP(k.cov)} covered)</span>` : `<span class="dim">no InSAR coverage</span>`) +
          `<br>${fmtN(k.pop)} people · ${fmtP(k.low1 ?? 0)} of ground below +1 m<br>` +
          `${k.fl_ev ?? 0} flood events 2021–24${k.f20 > 0.005 ? ` · ${fmtP(k.f20)} flooded Jan 2020` : ""}`;
      };
      const clockTip = (id) => {
        const k = K[id]; if (!k) return "—";
        const p = k[`pop${state.thr}`]?.[yi()] ?? 0, b = k[`built${state.thr}`]?.[yi()] ?? 0;
        return `<b>${k.name}</b> <span class="dim">· ${k.kota}</span><br>${state.year}: <b>${fmtN(p)}</b> of ${fmtN(k.pop)} people (${fmtP(k.pop ? p / k.pop : 0)})<br>` +
          `${fmt1(b)} km² built-up below ${state.thr === "1" ? "+1 m" : "mean sea level"}<br><span class="dim">low ground ${k.ground_p10 == null ? "—" : fmt1(k.ground_p10) + " m"} · median ${cm(k.v_med)} cm/yr</span>`;
      };

      /* ---------- velocity field: decode the PNG once, colour on demand ---------- */
      const field = { w: 0, h: 0, v: null, canvas: document.createElement("canvas"), ready: false, bounds: X.field.bounds };
      const fieldReady = new Promise((ok) => {
        const im = new Image();
        im.onload = () => {
          field.w = im.width; field.h = im.height;
          const c = document.createElement("canvas"); c.width = im.width; c.height = im.height;
          const cx = c.getContext("2d"); cx.drawImage(im, 0, 0);
          const d = cx.getImageData(0, 0, im.width, im.height).data;
          field.v = new Float32Array(im.width * im.height);
          const { offset, scale } = X.field.encode;
          for (let i = 0; i < field.v.length; i++) field.v[i] = d[i * 4 + 3] ? (d[i * 4] - offset) / scale : NaN;
          field.canvas.width = im.width; field.canvas.height = im.height;
          field.ready = true; ok(true);
        };
        im.onerror = () => { console.warn("velocity field PNG unavailable"); ok(false); };
        im.src = `${base}/data/${X.field.file}`;
      });
      const lut = new Uint32Array(256);
      function colourField(progress = 1) {
        const { offset, scale } = X.field.encode;
        for (let b = 0; b < 256; b++) {
          const c = d3.color(rampV(((b - offset) / scale) * progress));
          lut[b] = (255 << 24) | (c.b << 16) | (c.g << 8) | c.r;
        }
        const cx = field.canvas.getContext("2d");
        const img = cx.createImageData(field.w, field.h);
        const px = new Uint32Array(img.data.buffer);
        for (let i = 0; i < field.v.length; i++) {
          const v = field.v[i];
          if (v !== v) { px[i] = 0; continue; }
          px[i] = lut[Math.max(0, Math.min(255, Math.round(v * scale + offset)))];
        }
        cx.putImageData(img, 0, 0);
      }

      /* ---------- shared projection helpers (equirectangular, lat-corrected) ---------- */
      function fitter(B, W, H, pad) {
        const cos = Math.cos(((B.s + B.n) / 2) * Math.PI / 180);
        const k = Math.min((W - 2 * pad) / ((B.e - B.w) * cos), (H - 2 * pad) / (B.n - B.s));
        const ox = (W - k * (B.e - B.w) * cos) / 2, oy = (H + k * (B.n - B.s)) / 2;
        return { k, cos, x: (lon) => ox + (lon - B.w) * k * cos, y: (lat) => oy - (lat - B.s) * k };
      }
      function drawFieldTo(ctx, P, alpha = 1) {
        if (!field.ready) return;
        const [w, s, e, n] = field.bounds;
        const x0 = P.x(w), x1 = P.x(e), y0 = P.y(n), y1 = P.y(s);
        ctx.save(); ctx.globalAlpha = alpha; ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = "high";
        ctx.drawImage(field.canvas, x0, y0, x1 - x0, y1 - y0); ctx.restore();
      }
      const polys = (f) => (f.geometry.type === "Polygon" ? [f.geometry.coordinates] : f.geometry.coordinates);

      /* ---------- hero: the field settles (3 s), a counter tallies centimetres lost ---------- */
      sect("hero", () => {
        const canvas = document.getElementById("hero-canvas"), still = document.getElementById("hero-still");
        const hud = document.getElementById("hud-cm");
        const fastest = ids.filter((id) => (K[id].cov ?? 0) >= 0.3).reduce((a, b) => (K[b].v_p10 < K[a].v_p10 ? b : a), ids[0]);
        const rate = Math.abs(K[fastest]?.v_p10 ?? 5), years = 2025 - 2017;
        const HB = { w: 106.55, s: -6.42, e: 107.15, n: -6.06 };
        const ctx = canvas.getContext("2d"), dpr = Math.min(devicePixelRatio || 1, 2);
        let P, W, H;
        function size() {
          W = canvas.clientWidth; H = canvas.clientHeight;
          canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          // cover: scale so HB fills the canvas; keep the north coast in the upper third
          const cos = Math.cos(-6.24 * Math.PI / 180);
          const k = Math.max(W / ((HB.e - HB.w) * cos), H / (HB.n - HB.s));
          const ox = (W - k * (HB.e - HB.w) * cos) / 2, oy = (H - k * (HB.n - HB.s)) / 2 + k * (HB.n - HB.s);
          P = { x: (lon) => ox + (lon - HB.w) * k * cos, y: (lat) => oy - (lat - HB.s) * k };
        }
        function draw(progress) {
          colourField(progress);
          ctx.fillStyle = GROUND; ctx.fillRect(0, 0, W, H);
          drawFieldTo(ctx, P);
          ctx.strokeStyle = "rgba(140,160,181,0.28)"; ctx.lineWidth = 0.7; ctx.beginPath();
          for (const f of geo.features) for (const poly of polys(f)) for (const ring of poly) ring.forEach(([lon, lat], j) => (j ? ctx.lineTo(P.x(lon), P.y(lat)) : ctx.moveTo(P.x(lon), P.y(lat))));
          ctx.stroke();
          hud.textContent = `−${Math.round(rate * years * progress)} cm`;
        }
        fieldReady.then((ok) => {
          if (!ok) return;
          size(); addEventListener("resize", () => { size(); draw(1); });
          const done = () => { heroStatus.textContent = `${fmtN(Object.keys(K).length)} KELURAHAN · ${fmtN(X.city.pop)} PEOPLE · FIELD SETTLED AT 2017–2023 RATES · NEGATIVE = SUBSIDENCE`; };
          if (reduced) { draw(1); still.hidden = true; done(); return; }
          const t0 = performance.now(), ms = 3200;
          const step = (t) => {
            const p = Math.min((t - t0) / ms, 1), e = 1 - Math.pow(1 - p, 3);
            draw(e); if (p === 0 || still.hidden === false) still.hidden = true;
            if (p < 1) requestAnimationFrame(step); else done();
          };
          requestAnimationFrame(step);
        });
      });

      /* ---------- choropleth factory: WebGL (MapLibre) or full 2-D canvas fallback ---------- */
      const hasWebGL = (() => { try { const c = document.createElement("canvas"); return !!(c.getContext("webgl2") || c.getContext("webgl")); } catch { return false; } })();
      const B = { w: X.bounds[0], s: X.bounds[1], e: X.bounds[2], n: X.bounds[3] };
      const maps = [];

      function canvasMap(container, opts) {
        container.innerHTML = ""; container.style.position = "relative";
        const canvas = document.createElement("canvas");
        canvas.style.cssText = "width:100%;height:100%;display:block;cursor:crosshair;";
        container.appendChild(canvas);
        const note = document.createElement("div"); note.className = "map-note";
        note.textContent = "2-D MAP (BROWSER GPU OFF) · OHENHEN ET AL. 2026 CC BY 4.0 · JAKARTA SATU";
        container.appendChild(note);
        const ctx = canvas.getContext("2d");
        const hitCtx = document.createElement("canvas").getContext("2d");
        const dpr = Math.min(devicePixelRatio || 1, 2);
        let W, H, P, paths = [], boxes = [], hoverIdx = -1, selIdx = -1;
        function project() {
          W = container.clientWidth; H = container.clientHeight;
          canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          hitCtx.canvas.width = W; hitCtx.canvas.height = H;
          P = fitter(B, W, H, 18);
          paths = []; boxes = [];
          for (const f of geo.features) {
            const p = new Path2D();
            let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
            for (const poly of polys(f)) for (const ring of poly) {
              ring.forEach(([lon, lat], j) => {
                const px = P.x(lon), py = P.y(lat);
                if (px < x0) x0 = px; if (px > x1) x1 = px; if (py < y0) y0 = py; if (py > y1) y1 = py;
                j ? p.lineTo(px, py) : p.moveTo(px, py);
              });
              p.closePath();
            }
            paths.push(p); boxes.push([x0, y0, x1, y1]);
          }
        }
        function paintAll() {
          const showField = opts.showField?.() ?? false;
          ctx.fillStyle = GROUND; ctx.fillRect(0, 0, W, H);
          if (showField) drawFieldTo(ctx, P);
          geo.features.forEach((f, i) => {
            if (!showField) { ctx.fillStyle = opts.color(opts.value(K[f.properties.id])); ctx.fill(paths[i]); }
            ctx.strokeStyle = showField ? "rgba(228,235,242,0.35)" : HAIR; ctx.lineWidth = showField ? 0.6 : 0.5; ctx.stroke(paths[i]);
          });
          if (selIdx >= 0) { ctx.strokeStyle = INK; ctx.lineWidth = 2; ctx.stroke(paths[selIdx]); }
          if (hoverIdx >= 0) { ctx.strokeStyle = opts.hover ?? CYAN; ctx.lineWidth = 1.6; ctx.stroke(paths[hoverIdx]); }
          ctx.font = "600 12px 'IBM Plex Mono', ui-monospace, monospace"; ctx.textBaseline = "middle";
          const placed = [];
          for (const L of opts.labels ?? []) {
            const x = P.x(L.lon), y0 = P.y(L.lat);
            if (x < 0 || x > W - 70 || y0 < 0 || y0 > H) continue;
            const tw = ctx.measureText(L.text).width;
            let y = y0;                                     // greedy de-collision: nudge vertically
            for (const dy of [0, -16, 16, -32, 32]) {
              y = y0 + dy;
              if (!placed.some((b) => Math.abs(b.y - y) < 15 && x + 7 < b.x + b.w && x + 13 + tw > b.x)) break;
            }
            placed.push({ x: x + 7, y, w: tw + 6 });
            ctx.fillStyle = L.kind === "gnss" ? INK : CYAN;
            if (L.kind === "gnss") { ctx.strokeStyle = INK; ctx.lineWidth = 1.2; ctx.strokeRect(x - 4, y0 - 4, 8, 8); }
            else { ctx.beginPath(); ctx.arc(x, y0, 2.6, 0, Math.PI * 2); ctx.fill(); }
            ctx.fillStyle = "rgba(7,13,22,0.75)";
            ctx.fillRect(x + 7, y - 8, Math.min(tw + 6, W - x - 9), 16);
            ctx.fillStyle = L.kind === "gnss" ? INK : "#D8F6FC"; ctx.fillText(L.text, x + 10, y);
          }
        }
        const featureAt = (px, py) => {
          for (let i = paths.length - 1; i >= 0; i--) {
            const b = boxes[i];
            if (px < b[0] || px > b[2] || py < b[1] || py > b[3]) continue;
            if (hitCtx.isPointInPath(paths[i], px, py)) return i;
          }
          return -1;
        };
        canvas.addEventListener("mousemove", (e) => {
          const r = canvas.getBoundingClientRect();
          const i = featureAt(e.clientX - r.left, e.clientY - r.top);
          if (i !== hoverIdx) { hoverIdx = i; paintAll(); }
          if (i >= 0) showTip(e, opts.tip(geo.features[i].properties.id)); else hideTip();
        });
        canvas.addEventListener("mouseleave", () => { hoverIdx = -1; hideTip(); paintAll(); });
        canvas.addEventListener("click", (e) => {
          const r = canvas.getBoundingClientRect();
          const i = featureAt(e.clientX - r.left, e.clientY - r.top);
          if (i >= 0) opts.onClick?.(geo.features[i].properties.id);
        });
        project(); paintAll();
        addEventListener("resize", () => { project(); paintAll(); });
        return {
          kind: "canvas",
          paint: paintAll,
          highlight(id) { selIdx = ids.indexOf(id); paintAll(); },
          /* debug/test hooks: hit-test in canvas pixels or by coordinate */
          at: (px, py) => { const i = featureAt(px, py); return i >= 0 ? geo.features[i].properties : null; },
          px: (lon, lat) => [P.x(lon), P.y(lat)],
          canvas,
        };
      }

      function webglMap(container, opts) {
        const g = structuredClone(geo);
        const map = new maplibregl.Map({
          container, style: { version: 8, sources: {}, layers: [{ id: "bg", type: "background", paint: { "background-color": GROUND } }] },
          bounds: [[B.w, B.s], [B.e, B.n]], fitBoundsOptions: { padding: 18 }, attributionControl: false, dragRotate: false,
        });
        map.addControl(new maplibregl.AttributionControl({ customAttribution: "Ohenhen et al. 2026 CC BY 4.0 · Jakarta Satu · WorldPop · GHSL", compact: true }));
        map.addControl(new maplibregl.NavigationControl({ showCompass: false }));
        let loaded = false, pendingSel = null;
        const [w, s, e, n] = field.bounds;
        function recolour() { for (const f of g.features) f.properties.c = opts.color(opts.value(K[f.properties.id])); }
        map.on("load", () => {
          recolour();
          map.addSource("field", { type: "image", url: `${base}/data/${X.field.rgba}`, coordinates: [[w, n], [e, n], [e, s], [w, s]] });
          map.addLayer({ id: "field", type: "raster", source: "field", paint: { "raster-opacity": 0.95 }, layout: { visibility: "none" } });
          map.addSource("kel", { type: "geojson", data: g, promoteId: "id" });
          map.addLayer({ id: "fill", type: "fill", source: "kel", paint: { "fill-color": ["get", "c"], "fill-opacity": 0.92 } });
          map.addLayer({ id: "line", type: "line", source: "kel", paint: { "line-color": HAIR, "line-width": 0.5 } });
          map.addLayer({ id: "sel", type: "line", source: "kel", paint: { "line-color": INK, "line-width": 2 }, filter: ["==", ["get", "id"], ""] });
          map.addLayer({ id: "hover", type: "line", source: "kel", paint: { "line-color": opts.hover ?? CYAN, "line-width": 1.6 }, filter: ["==", ["get", "id"], ""] });
          loaded = true; api.paint(); if (pendingSel) api.highlight(pendingSel);
        });
        map.on("mousemove", "fill", (e) => {
          const id = e.features[0].properties.id;
          map.setFilter("hover", ["==", ["get", "id"], id]); map.getCanvas().style.cursor = "pointer";
          showTip(e.originalEvent, opts.tip(id));
        });
        map.on("mouseleave", "fill", () => { map.setFilter("hover", ["==", ["get", "id"], ""]); map.getCanvas().style.cursor = ""; hideTip(); });
        map.on("click", "fill", (e) => opts.onClick?.(e.features[0].properties.id));
        const api = {
          kind: "webgl",
          paint() {
            if (!loaded) return;
            const showField = opts.showField?.() ?? false;
            recolour(); map.getSource("kel").setData(g);
            map.setLayoutProperty("field", "visibility", showField ? "visible" : "none");
            map.setPaintProperty("fill", "fill-opacity", showField ? 0 : 0.92);
            map.setPaintProperty("line", "line-color", showField ? "rgba(228,235,242,0.35)" : HAIR);
          },
          highlight(id) { if (!loaded) { pendingSel = id; return; } map.setFilter("sel", ["==", ["get", "id"], id ?? ""]); },
        };
        return api;
      }
      const makeMap = (container, opts) => {
        let api = null;
        if (hasWebGL) { try { api = webglMap(container, opts); } catch (err) { console.warn("WebGL map unavailable — 2-D canvas fallback:", err?.message ?? err); } }
        if (!api) api = sect("map (2-D fallback)", () => canvasMap(container, opts));
        if (api) maps.push(api);
        return api;
      };
      window.__jkmaps = maps;

      /* ---------- kelurahan panel (shared by both maps and the bars) ---------- */
      const panel = document.getElementById("kel-panel");
      function select(id) {
        state.sel = id;
        const k = K[id];
        if (!k) return;
        panel.hidden = false;
        document.getElementById("panel-name").textContent = k.name;
        document.getElementById("panel-sub").textContent = `${k.kec.toUpperCase()} · ${k.kota.toUpperCase()} · ${fmt1(k.area)} KM²`;
        const rows = [
          ["FASTEST DECILE", k.cov ? `${cm(k.v_p10)} cm/yr` : "no coverage"], ["MEDIAN RATE", k.cov ? `${cm(k.v_med)} cm/yr · 2017–2023` : "—"],
          ["INSAR COVERAGE", fmtP(k.cov ?? 0)], ["PEOPLE 2020", `${fmtN(k.pop)} (GHSL ${fmtN(k.ghs_pop)})`],
          ["BUILT-UP", `${fmt1(k.built)} km² · ${fmtP(k.built_share ?? 0)}`],
          ["LOW GROUND (P10)", k.ground_p10 == null ? "—" : `${fmt1(k.ground_p10)} m · median ${fmt1(k.ground_med)} m`],
          ["GROUND BELOW +1 M", fmtP(k.low1 ?? 0)], ["FLOOD EVENTS 2021–24", `${k.fl_ev ?? 0} dates · ${k.fl_rt ?? 0} RT · ${fmtP(k.fl_share ?? 0)} of area`],
          ["JAN 2020 FLOOD", fmtP(k.f20 ?? 0)],
        ];
        document.getElementById("panel-stats").innerHTML = rows.map(([a, b]) => `<dt>${a}</dt><dd>${b}</dd>`).join("");
        const yrs = (v) => (v == null ? null : `${Math.round(v)} yr (${Y0 + Math.round(v)})`);
        const line = (label, med, p10) =>
          med === 0 ? `<b>${label}:</b> low ground already below.` :
          med == null && p10 == null ? `<b>${label}:</b> not at current rates.` :
          `<b>${label}:</b> ${yrs(med) ?? "not at the median rate"}; ${yrs(p10) ?? "—"} at the fastest decile.`;
        document.getElementById("panel-clock").innerHTML = k.cov
          ? `${line("Mean sea level", k.clk_med_0m, k.clk_p10_0m)} ${line("Below +1 m", k.clk_med_1m, k.clk_p10_1m)} <span class="dim">Linear extrapolation of 2017–2023 rates from the GLO-30 low-ground proxy — momentum, not a forecast.</span>`
          : `<span class="dim">No InSAR coverage — the clock cannot run here.</span>`;
        const sp = d3.select("#panel-spark").html("");
        const Wd = 264, Hd = 76, M = { l: 44, r: 26, t: 10, b: 18 };
        const x = d3.scaleLinear([Y0, YEARS.at(-1)], [M.l, Wd - M.r]);
        const y = d3.scaleLinear([0, d3.max([...(k.pop1 ?? [0]), ...(k.pop0 ?? [0])]) || 1], [Hd - M.b, M.t]);
        const svg = sp.append("svg").attr("width", Wd).attr("height", Hd).attr("class", "spark");
        svg.append("g").attr("class", "axis").attr("transform", `translate(${M.l},0)`).call(d3.axisLeft(y).ticks(2).tickFormat(d3.format("~s")));
        svg.append("g").attr("class", "axis").attr("transform", `translate(0,${Hd - M.b})`).call(d3.axisBottom(x).tickValues([2025, 2050]).tickFormat(d3.format("d")));
        for (const [key, col, dash] of [["pop1", CORAL, null], ["pop0", "#FFCFC3", "3 3"]]) {
