      .end { margin-top: 8vh; padding-top: 26px; border-top: 1px solid var(--hairline); }
      .end p { color: var(--ink-muted); font-size: 0.9rem; }
      .cta { display: inline-block; font-family: var(--font-data); font-size: 0.78rem; letter-spacing: 0.08em;
        color: var(--accent); border: 1px solid var(--accent); border-radius: 4px; padding: 10px 18px; text-decoration: none; }
      .cta:hover { background: var(--accent-ink); }

      #tip { position: fixed; z-index: 60; pointer-events: none; background: var(--surface-raised);
        border: 1px solid var(--hairline); border-radius: 5px; padding: 8px 11px; font-family: var(--font-data);
        font-size: 0.72rem; line-height: 1.5; color: var(--ink); box-shadow: 0 8px 26px rgba(0,0,0,0.5); max-width: 17rem; }
      #tip[hidden] { display: none; }

      @media (max-width: 680px) {
        article { padding: 0 16px 10vh; }
        .masthead { padding-top: 5vh; }
        figure { padding: 14px 10px 10px; }
        h2 { font-size: 1.25rem; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>

    <script>
      /* Hover read-out for the kelurahan scatter. Pure SVG, no GPU path. */
      const tip = document.getElementById("tip");
      const show = (html, e) => {
        tip.innerHTML = html; tip.hidden = false;
        const r = tip.getBoundingClientRect();
        let x = e.clientX + 14, y = e.clientY + 14;
        if (x + r.width > innerWidth - 8) x = e.clientX - r.width - 14;
        if (y + r.height > innerHeight - 8) y = e.clientY - r.height - 14;
        tip.style.left = Math.max(6, x) + "px"; tip.style.top = Math.max(6, y) + "px";
      };
      document.querySelectorAll(".d1").forEach((el) => {
        el.addEventListener("mousemove", (e) => {
          const d = el.dataset;
          show(`<b>${d.n}</b> · ${d.k}<br>fastest decile ${d.v} cm/yr · median ${d.m}<br>` +
               `low ground ${d.g} m · ${d.p} residents<br>${d.e} below +1 m in 2050`, e);
        });
        el.addEventListener("mouseleave", () => { tip.hidden = true; });
      });
    </script>
  </body>
</html>
