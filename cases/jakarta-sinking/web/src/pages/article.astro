---
/* Review article — the Jakarta case, stress-tested against the literature and
 * against its own inputs.
 *
 * Every figure is built here in frontmatter from data/article.json, which
 * pipeline/article.py derives from what the case publishes plus the eight tests
 * in pipeline/review.py. Nothing is drawn by hand, so the prose cannot drift
 * from the numbers. SVG only — no WebGL, no canvas.
 *
 * The ONLY hand-entered numbers are the LIT and SPREAD blocks below, plus the
 * Ohenhen table S2 transcribed in pipeline/article.py — all from the published
 * papers cited in section 15.
 */
import "../styles/tokens.css";
import A from "../data/article.json";

const CYAN = "#35C6E0", PALE = "#D8F6FC", DEEP = "#144E7A", MID = "#1F8FB5";
const CORAL = "#F26D5B", PALEC = "#FFCFC3", SLATE = "#6B7CA6";
const INK = "#E4EBF2", MUTED = "#8CA0B5", GRID = "#1E2E44";

const esc = (s: any) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const n0 = (v: number) => Math.round(v).toLocaleString("en-US");
const pct = (v: number, d = 1) => `${(v * 100).toFixed(d)}%`;
const cm = (v: number, d = 2) => `${v > 0 ? "+" : "−"}${Math.abs(v).toFixed(d)}`;
const mm = (v: number, d = 2) => `${v > 0 ? "+" : "−"}${Math.abs(v).toFixed(d)}`;

/* ── Published rates, transcribed with the period each was measured over,
      because in Jakarta the period is the whole argument. ─────────────────── */
const LIT = [
  { site: "Jakarta, levelling", lo: 1, hi: 9, period: "1982–1991", method: "levelling", ref: "abidin2015" },
  { site: "Jakarta, levelling", lo: 1, hi: 25, period: "1991–1997", method: "levelling", ref: "abidin2015" },
  { site: "Jakarta, GPS campaigns", lo: 1, hi: 28, period: "1997–2011", method: "GPS", ref: "abidin2015" },
  { site: "Jakarta coast", lo: 9.5, hi: 21.5, period: "2007–2009", method: "ALOS PALSAR InSAR", ref: "chaussard" },
  { site: "Jakarta, InSAR", lo: 1, hi: 12, period: "2006–2010", method: "InSAR", ref: "abidin2015" },
  { site: "North Jakarta coast", lo: 1.16, hi: 6.2, period: "2015–2019", method: "campaign GPS", ref: "abdullah" },
];
/* Contemporaneous Sentinel-1-era studies of the same city. Each reports a
   different statistic; that is part of the finding, so each is labelled. */
const SPREAD = [
  { k: "Sidiq et al. 2025", v: 15.0, period: "2017–2023", stat: "maximum, Greater Jakarta", ref: "sidiq" },
  { k: "Lapadat et al. 2025", v: 7.85, period: "2014–2025", stat: "maximum, Muara Angke bowl", ref: "lapadat" },
  { k: "Widodo et al. 2025", v: 5.5, period: "2017–2022", stat: "average, north and north-west", ref: "widodo" },
  { k: "Ohenhen et al. 2026", v: 5.64, period: "2017–2023", stat: "fastest pixel, North Jakarta", ref: "ohenhen" },
  { k: "Ohenhen et al. 2026", v: 3.6, period: "2017–2023", stat: "maximum, 1 km coastal strip", ref: "ohenhen" },
];

const HERE = A.hotspots.filter((h: any) => h.p10 != null);
const fastestHot = HERE.slice().sort((a: any, b: any) => a.p10 - b.p10)[0];
const D = A.decel, G = A.gnss, EST = A.estimator, EP = A.epoch, DT = A.datum, DEC = A.decay;
const cjkt = D.all.find((s: any) => s.station === "CJKT");
const gnssRows = G.stations;
const meanFull = G.mean_d_full, meanLate = G.mean_d_late, meanPost = G.mean_d_late_post;
const halved = cjkt ? 1 - cjkt.late / cjkt.early : 0;
const halvedPost = cjkt && cjkt.late_post ? 1 - cjkt.late_post / cjkt.early : 0;
const minP = EST.estimators.min["1m"]["2025"], meanP = EST.estimators.mean["1m"]["2025"], q25P = EST.estimators.q25["1m"]["2025"];
const radarRho = A.ranking.drivers.find((d: any) => d.k.includes("radar")).rho;
const lowRho = A.ranking.drivers.find((d: any) => d.k.includes("low ground")).rho;
const rateRho = A.ranking.drivers.find((d: any) => d.k.includes("sinking")).rho;
const naiveRho = A.ranking.drivers.find((d: any) => d.k.includes("population ×")).rho;
/* the depositors' own table S2 is transcribed once, in pipeline/article.py, and carried
   through beside our matching regrid so the two can never drift apart */
const REP = A.replication;
const repMaxErr = A.replication_max_err;
const decayShare = 1 - (DEC.pop_1m_2050 - DEC.series_1m[0]) / (DEC.linear_1m[DEC.linear_1m.length - 1] - DEC.linear_1m[0]);

/* ── Figure 1 · the published record against this field ────────────────────── */
function figLit() {
  const W = 760, rowH = 30, T = 46, L = 218, R = 96;
  const rows = LIT.length + HERE.length + 1;
  const H = T + rows * rowH + 60;
  const max = 30;
  const sx = (v: number) => L + (v / max) * (W - L - R);
  let y = T;
  const out: string[] = [];
  out.push(`<text x="${L - 12}" y="${y + 14}" fill="${MUTED}" font-size="12" text-anchor="end" font-family="var(--font-data)">PUBLISHED</text>`);
  y += 6;
  for (const l of LIT) {
    y += rowH;
    out.push(`<text x="${L - 12}" y="${y + 2}" fill="${INK}" font-size="12" text-anchor="end">${esc(l.site)}</text>
      <rect x="${sx(l.lo).toFixed(1)}" y="${y - 8}" width="${Math.max(2, sx(l.hi) - sx(l.lo)).toFixed(1)}" height="12" fill="${PALEC}" opacity="0.55" rx="2"/>
      <text x="${(sx(l.hi) + 8).toFixed(1)}" y="${y + 3}" fill="${PALEC}" font-size="12" font-family="var(--font-data)">${l.lo}–${l.hi}</text>
      <text x="${L - 12}" y="${y + 16}" fill="${MUTED}" font-size="11" text-anchor="end" font-family="var(--font-data)">${esc(l.period)} · ${esc(l.method)}</text>`);
  }
  y += rowH * 0.7;
  out.push(`<text x="${L - 12}" y="${y + 22}" fill="${CYAN}" font-size="12" text-anchor="end" font-family="var(--font-data)">THIS FIELD · ${esc(A.window)}</text>`);
  for (const h of HERE.slice().sort((a: any, b: any) => a.p10 - b.p10)) {
    y += rowH;
    const a = Math.min(Math.abs(h.median), Math.abs(h.p10)), b = Math.max(Math.abs(h.median), Math.abs(h.p10));
    out.push(`<text x="${L - 12}" y="${y + 24}" fill="${INK}" font-size="12" text-anchor="end">${esc(h.name)}</text>
      <rect x="${sx(a).toFixed(1)}" y="${y + 13}" width="${Math.max(2, sx(b) - sx(a)).toFixed(1)}" height="12" fill="${CYAN}" opacity="0.9" rx="2"/>
      <text x="${(sx(b) + 8).toFixed(1)}" y="${y + 24}" fill="${CYAN}" font-size="12" font-family="var(--font-data)">${a.toFixed(1)}–${b.toFixed(1)}</text>`);
  }
  const xt = [0, 5, 10, 15, 20, 25, 30].map((v) =>
    `<line x1="${sx(v).toFixed(1)}" y1="${T - 4}" x2="${sx(v).toFixed(1)}" y2="${(y + 32).toFixed(1)}" stroke="${GRID}" opacity="0.45"/>
     <text x="${sx(v).toFixed(1)}" y="${(y + 50).toFixed(1)}" fill="${MUTED}" font-size="12" text-anchor="middle">${v}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Published Jakarta subsidence rates from 1982 to 2019 against the rates measured in this field for 2017 to 2023">
    ${xt}${out.join("")}
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${(y + 72).toFixed(1)}" fill="${MUTED}" font-size="12" text-anchor="middle">subsidence, cm/yr (magnitude) →</text>
  </svg>`;
}

/* ── Figure 2 · four studies, one city, one period ─────────────────────────── */
function figSpread() {
  const W = 760, T = 46, rowH = 50, L = 208, R = 78;
  const rows = SPREAD.concat([{ k: "This case", v: Math.abs(fastestHot.p10), period: A.window, stat: `fastest hotspot decile (${esc(fastestHot.name)})`, ref: "" }]);
  const H = T + rows.length * rowH + 42;
  const max = 16;
  const sx = (v: number) => L + (v / max) * (W - L - R);
  const body = rows.map((r: any, i: number) => {
    const y = T + i * rowH;
    const own = r.k === "This case";
    const col = own ? CYAN : PALEC;
    return `<text x="${L - 12}" y="${y + 6}" fill="${own ? CYAN : INK}" font-size="12.5" text-anchor="end">${esc(r.k)}</text>
      <text x="${L - 12}" y="${y + 21}" fill="${MUTED}" font-size="11" text-anchor="end" font-family="var(--font-data)">${esc(r.period)}</text>
      <text x="${L - 12}" y="${y + 34}" fill="${MUTED}" font-size="11" text-anchor="end" font-family="var(--font-data)">${esc(r.stat)}</text>
      <rect x="${L}" y="${y - 4}" width="${(sx(r.v) - L).toFixed(1)}" height="16" fill="${col}" opacity="${own ? 0.95 : 0.5}" rx="2"/>
      <text x="${(sx(r.v) + 9).toFixed(1)}" y="${y + 9}" fill="${col}" font-size="12.5" font-family="var(--font-data)">${r.v.toFixed(2)}</text>`;
  }).join("");
  const xt = [0, 4, 8, 12, 16].map((v) =>
    `<line x1="${sx(v).toFixed(1)}" y1="${T - 16}" x2="${sx(v).toFixed(1)}" y2="${T + rows.length * rowH - 12}" stroke="${GRID}" opacity="0.45"/>
     <text x="${sx(v).toFixed(1)}" y="${T + rows.length * rowH + 6}" fill="${MUTED}" font-size="12" text-anchor="middle">${v}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Peak Jakarta subsidence rate reported by five contemporaneous Sentinel-1 era studies, spanning a factor of four">
    ${xt}${body}
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${H - 10}" fill="${MUTED}" font-size="12" text-anchor="middle">reported peak subsidence, cm/yr — same city, overlapping years, different answers</text>
  </svg>`;
}

/* ── Figure 3 · our regrid against the depositors' own district table ──────── */
function figRep() {
  const W = 760, H = 380, L = 76, R = 26, T = 40, B = 60;
  const rows = REP.filter((r: any) => r.lit);
  const lo = -1.25, hi = 0.2;
  const sx = (v: number) => L + ((v - lo) / (hi - lo)) * (W - L - R);
  const sy = (v: number) => H - B - ((v - lo) / (hi - lo)) * (H - T - B);
  const diag = `<line x1="${sx(lo).toFixed(1)}" y1="${sy(lo).toFixed(1)}" x2="${sx(hi).toFixed(1)}" y2="${sy(hi).toFixed(1)}" stroke="${GRID}" stroke-dasharray="4 4"/>`;
  const body = rows.map((r: any, i: number) => {
    const x = sx(r.lit.mean), y = sy(r.mean);
    const flip = x > W - R - 240;                      // keep the read-out inside the frame
    const lx = flip ? x - 12 : x + 12, anchor = flip ? "end" : "start";
    const dy = i % 2 ? -12 : 18;
    return `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="6" fill="${CYAN}" opacity="0.9"/>
      <text x="${lx.toFixed(1)}" y="${(y + dy).toFixed(1)}" text-anchor="${anchor}" fill="${INK}" font-size="12" font-family="var(--font-data)">${esc(r.kota.replace("Jakarta ", ""))}</text>
      <text x="${lx.toFixed(1)}" y="${(y + dy + 14).toFixed(1)}" text-anchor="${anchor}" fill="${MUTED}" font-size="11" font-family="var(--font-data)">theirs ${r.lit.mean.toFixed(3)} · ours ${r.mean.toFixed(3)}</text>`;
  }).join("");
  const t = [-1.0, -0.5, 0.0].map((v) =>
    `<line x1="${sx(v).toFixed(1)}" y1="${T}" x2="${sx(v).toFixed(1)}" y2="${H - B}" stroke="${GRID}" opacity="0.4"/>
     <line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.4"/>
     <text x="${sx(v).toFixed(1)}" y="${H - B + 20}" fill="${MUTED}" font-size="12" text-anchor="middle">${v.toFixed(1)}</text>
     <text x="${L - 9}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="12" text-anchor="end">${v.toFixed(1)}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Mean subsidence per Jakarta municipality: this case's regrid against the depositors' published table, all five on the one-to-one line">
    ${t}${diag}${body}
    <text x="${L}" y="${T - 16}" fill="${CYAN}" font-size="12" font-family="var(--font-data)">largest disagreement across all five municipalities: ${repMaxErr.toFixed(3)} cm/yr</text>
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${H - 14}" fill="${MUTED}" font-size="12" text-anchor="middle">Ohenhen et al. (2026) table S2, mean cm/yr →</text>
    <text x="18" y="${H / 2}" fill="${MUTED}" font-size="12" text-anchor="middle" transform="rotate(-90 18 ${H / 2})">this case's regrid, mean cm/yr →</text>
  </svg>`;
}

/* ── Figure 4 · the same comparison, made twice ────────────────────────────── */
function figGnss() {
  const W = 760, T = 56, rowH = 56, L = 96, R = 240;
  const H = T + gnssRows.length * rowH + 42;
  const axisY = T + gnssRows.length * rowH - 8;
  const all = gnssRows.flatMap((r: any) => [r.insar, r.gnss_full, r.gnss_late]);
  const lo = Math.min(...all) - 1.2, hi = Math.max(...all) + 1.2;
  const sx = (v: number) => L + ((v - lo) / (hi - lo)) * (W - L - R);
  const zero = sx(0);
  const body = gnssRows.map((r: any, i: number) => {
    const y = T + i * rowH;
    return `
      <text x="${L - 12}" y="${y + 5}" fill="${INK}" font-size="12.5" text-anchor="end" font-family="var(--font-data)">${esc(r.station)}</text>
      <line x1="${sx(r.gnss_full).toFixed(1)}" y1="${y}" x2="${sx(r.insar).toFixed(1)}" y2="${y}" stroke="${CORAL}" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.8"/>
      <line x1="${sx(r.gnss_late).toFixed(1)}" y1="${y + 18}" x2="${sx(r.insar).toFixed(1)}" y2="${y + 18}" stroke="${CYAN}" stroke-width="1.4" opacity="0.9"/>
      <circle cx="${sx(r.gnss_full).toFixed(1)}" cy="${y}" r="4.6" fill="${PALEC}"/>
      <circle cx="${sx(r.gnss_late).toFixed(1)}" cy="${y + 18}" r="4.6" fill="${PALE}"/>
      <rect x="${(sx(r.insar) - 4).toFixed(1)}" y="${y - 4}" width="8" height="8" fill="${CYAN}" transform="rotate(45 ${sx(r.insar).toFixed(1)} ${y})"/>
      <rect x="${(sx(r.insar) - 4).toFixed(1)}" y="${y + 14}" width="8" height="8" fill="${CYAN}" transform="rotate(45 ${sx(r.insar).toFixed(1)} ${y + 18})"/>
      <text x="${W - R + 14}" y="${y + 4}" fill="${CORAL}" font-size="12" font-family="var(--font-data)">whole record · Δ ${mm(r.d_full)}</text>
      <text x="${W - R + 14}" y="${y + 22}" fill="${CYAN}" font-size="12" font-family="var(--font-data)">matched window · Δ ${mm(r.d_late)}</text>`;
  }).join("");
  const xt = [-6, -4, -2, 0, 2].filter((v) => v >= lo && v <= hi).map((v) =>
    `<text x="${sx(v).toFixed(1)}" y="${axisY + 18}" fill="${MUTED}" font-size="12" text-anchor="middle">${v}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="At all three GNSS stations the InSAR rate disagrees with the whole-record GNSS rate but matches the GNSS rate refitted on the same years">
    <line x1="${zero.toFixed(1)}" y1="${T - 22}" x2="${zero.toFixed(1)}" y2="${axisY}" stroke="${GRID}" stroke-dasharray="3 4"/>
    <g><circle cx="${L}" cy="22" r="4.6" fill="${PALEC}"/><text x="${L + 12}" y="26" fill="${MUTED}" font-size="12">GNSS, whole record</text>
      <circle cx="${L + 168}" cy="22" r="4.6" fill="${PALE}"/><text x="${L + 180}" y="26" fill="${MUTED}" font-size="12">GNSS, 2017 onward</text>
      <rect x="${L + 336}" y="18" width="8" height="8" fill="${CYAN}" transform="rotate(45 ${L + 340} 22)"/>
      <text x="${L + 352}" y="26" fill="${MUTED}" font-size="12">InSAR ${esc(A.window)}</text></g>
    ${body}${xt}
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${H - 8}" fill="${MUTED}" font-size="12" text-anchor="middle">vertical rate, mm/yr →</text>
  </svg>`;
}

/* ── Figure 5 · the ground at CJKT, and the two trends in it ───────────────── */
function figCjkt() {
  const W = 760, H = 380, L = 62, R = 26, T = 22, B = 54;
  const s = A.gnssSeries.CJKT;
  const t0 = Math.min(...s.t), t1 = Math.max(...s.t);
  const v0 = Math.min(...s.v_mm), v1 = Math.max(...s.v_mm);
  const sx = (v: number) => L + ((v - t0) / (t1 - t0)) * (W - L - R);
  const sy = (v: number) => H - B - ((v - v0) / (v1 - v0)) * (H - T - B);
  const dots = s.t.map((t: number, i: number) =>
    `<circle cx="${sx(t).toFixed(1)}" cy="${sy(s.v_mm[i]).toFixed(1)}" r="1.5" fill="${SLATE}" opacity="0.55"/>`).join("");
  const seg = (t0s: number, t1s: number, rate: number, col: string, lab: string, dy: number) => {
    const inSeg = s.t.map((t: number, i: number) => [t, s.v_mm[i]]).filter((p: number[]) => p[0] >= t0s && p[0] < t1s);
    const mt = inSeg.reduce((a: number, p: number[]) => a + p[0], 0) / inSeg.length;
    const mv = inSeg.reduce((a: number, p: number[]) => a + p[1], 0) / inSeg.length;
    const ya = mv + rate * (t0s - mt), yb = mv + rate * (t1s - mt);
    return `<line x1="${sx(t0s).toFixed(1)}" y1="${sy(ya).toFixed(1)}" x2="${sx(t1s).toFixed(1)}" y2="${sy(yb).toFixed(1)}"
              stroke="${col}" stroke-width="2.6"/>
      <text x="${((sx(t0s) + sx(t1s)) / 2).toFixed(1)}" y="${(sy((ya + yb) / 2) + dy).toFixed(1)}" fill="${col}"
        font-size="12.5" text-anchor="middle" font-family="var(--font-data)">${esc(lab)}</text>`;
  };
  const shade = `<rect x="${sx(2017).toFixed(1)}" y="${T}" width="${(sx(t1) - sx(2017)).toFixed(1)}" height="${H - T - B}"
      fill="${CYAN}" opacity="0.07"/>
    <text x="${(sx(2017) + 8).toFixed(1)}" y="${T + 14}" fill="${CYAN}" font-size="12" font-family="var(--font-data)">the radar field's window</text>`;
  const xt = [2011, 2013, 2015, 2017, 2019, 2021].map((y) =>
    `<text x="${sx(y).toFixed(1)}" y="${H - B + 20}" fill="${MUTED}" font-size="12" text-anchor="middle">${y}</text>`).join("");
  const yticks = [0, -20, -40, -60].filter((v) => v >= v0 - 6 && v <= v1 + 6).map((v) =>
    `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.6"/>
     <text x="${L - 9}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="12" text-anchor="end">${v}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Daily vertical position at the Jakarta GNSS station from 2010 to 2022, with a steep trend before 2017 and a much shallower one after">
    ${yticks}${shade}${dots}
    ${seg(t0, 2017, cjkt.early, PALEC, `${mm(cjkt.early, 1)} mm/yr`, -14)}
    ${seg(2017, t1, cjkt.late, CYAN, `${mm(cjkt.late, 1)} mm/yr`, -14)}
    ${xt}
    <text x="16" y="${H / 2}" fill="${MUTED}" font-size="12" text-anchor="middle" transform="rotate(-90 16 ${H / 2})">vertical position, mm →</text>
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${H - 12}" fill="${MUTED}" font-size="12" text-anchor="middle">CJKT · continuous GNSS, IGb14 · daily solutions, weekly samples shown</text>
  </svg>`;
}

/* ── Figure 6 · every north-Java station, before and after 2017 ────────────── */
function figDumb() {
  const rows = D.all.filter((r: any) => Math.abs(r.early) < 40 && Math.abs(r.late) < 40);
  const W = 760, T = 42, rowH = 20, L = 72, R = 132;
  const H = T + rows.length * rowH + 44;
  const lo = Math.min(...rows.flatMap((r: any) => [r.early, r.late])) - 1.5;
  const hi = Math.max(...rows.flatMap((r: any) => [r.early, r.late])) + 1.5;
  const sx = (v: number) => L + ((v - lo) / (hi - lo)) * (W - L - R);
  const body = rows.map((r: any, i: number) => {
    const y = T + i * rowH + 10;
    const col = r.west ? CYAN : SLATE;
    return `<text x="${L - 10}" y="${y + 4}" fill="${r.west ? INK : MUTED}" font-size="12" text-anchor="end" font-family="var(--font-data)">${esc(r.station)}</text>
      <line x1="${sx(r.early).toFixed(1)}" y1="${y}" x2="${sx(r.late).toFixed(1)}" y2="${y}" stroke="${col}" stroke-width="${r.west ? 2.2 : 1.4}" opacity="${r.west ? 0.95 : 0.5}"/>
      <circle cx="${sx(r.early).toFixed(1)}" cy="${y}" r="${r.west ? 3.4 : 2.6}" fill="${GRID}" stroke="${col}" stroke-width="1.2"/>
      <circle cx="${sx(r.late).toFixed(1)}" cy="${y}" r="${r.west ? 4 : 3}" fill="${col}"/>
      <text x="${W - R + 12}" y="${y + 4}" fill="${r.d > 0 ? CYAN : CORAL}" font-size="12" font-family="var(--font-data)">${mm(r.d, 1)} mm/yr</text>`;
  }).join("");
  const xt = [-20, -15, -10, -5, 0, 5].filter((v) => v >= lo && v <= hi).map((v) =>
    `<line x1="${sx(v).toFixed(1)}" y1="${T}" x2="${sx(v).toFixed(1)}" y2="${H - 40}" stroke="${GRID}" opacity="0.5"/>
     <text x="${sx(v).toFixed(1)}" y="${H - 22}" fill="${MUTED}" font-size="12" text-anchor="middle">${v}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Change in vertical rate between 2010-2016 and 2017-2022 at twenty north Java GNSS stations; the three Jakarta-area stations all slow down">
    ${xt}
    <g><circle cx="${L}" cy="20" r="3.4" fill="${GRID}" stroke="${MUTED}" stroke-width="1.2"/><text x="${L + 10}" y="24" fill="${MUTED}" font-size="12">2010–2016</text>
      <circle cx="${L + 108}" cy="20" r="4" fill="${MUTED}"/><text x="${L + 118}" y="24" fill="${MUTED}" font-size="12">2017–2022</text>
      <line x1="${L + 232}" y1="20" x2="${L + 258}" y2="20" stroke="${CYAN}" stroke-width="2.2"/><text x="${L + 266}" y="24" fill="${MUTED}" font-size="12">inside the case's own working area</text></g>
    ${body}
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${H - 6}" fill="${MUTED}" font-size="12" text-anchor="middle">vertical rate, mm/yr — Pekalongan (−105 → −118) is off scale →</text>
  </svg>`;
}

/* ── Figure 7 · fast ground and low ground are different places ────────────── */
function figScatter() {
  const W = 760, H = 470, L = 66, R = 26, T = 46, B = 56;
  const pts = A.scatter.filter((p: any) => p.v_p10 != null && p.ground != null);
  const x0 = -0.12, x1 = Math.max(...pts.map((p: any) => -p.v_p10)) * 1.06;
  const sx = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
  const BRK = 15, gmax = Math.max(...pts.map((p: any) => p.ground)) * 1.02, g0 = -4;
  const yBrk = T + (H - T - B) * 0.26, yBot = H - B;
  const sy = (v: number) => v <= BRK
    ? yBot - ((v - g0) / (BRK - g0)) * (yBot - yBrk)
    : yBrk - 12 - ((Math.min(v, gmax) - BRK) / (gmax - BRK)) * (yBrk - 12 - T);
  const dots = pts.map((p: any) => {
    const r = 2.2 + Math.sqrt(p.pop) / 130;
    return `<circle class="d1 ${p.coastal ? "co" : "in"}" cx="${sx(-p.v_p10).toFixed(1)}" cy="${sy(p.ground).toFixed(1)}" r="${r.toFixed(1)}"
      data-n="${esc(p.name)}" data-k="${esc(p.kota)}" data-v="${cm(p.v_p10)}" data-m="${cm(p.v_med)}" data-g="${p.ground.toFixed(2)}" data-p="${n0(p.pop)}" data-e="${n0(p.e50)}"/>`;
  }).join("");
  const named = A.geography.fastest_inland.slice(0, 3).concat(
    pts.filter((p: any) => p.name === "Pluit" || p.name === "Kamal Muara"));
  const labels = named.map((p: any, i: number) => {
    const x = sx(-p.v_p10), y = sy(p.ground);
    const dx = i === 4 ? -12 : 11, dy = i % 2 ? -9 : 13;
    return `<line x1="${x.toFixed(1)}" y1="${y.toFixed(1)}" x2="${(x + dx * 0.8).toFixed(1)}" y2="${(y + dy - 3).toFixed(1)}" stroke="${MUTED}" stroke-width="0.8"/>
      <text x="${(x + dx).toFixed(1)}" y="${(y + dy).toFixed(1)}" text-anchor="${dx < 0 ? "end" : "start"}" fill="${p.coastal ? PALE : PALEC}" font-size="12" font-family="var(--font-data)">${esc(p.name)}</text>`;
  }).join("");
  const thr = `<line x1="${L}" y1="${sy(1).toFixed(1)}" x2="${W - R}" y2="${sy(1).toFixed(1)}" stroke="${CORAL}" stroke-dasharray="4 4" opacity="0.8"/>
`;
  const brk = `<line x1="${L}" y1="${(yBrk - 6).toFixed(1)}" x2="${W - R}" y2="${(yBrk - 6).toFixed(1)}" stroke="${GRID}" stroke-dasharray="2 5"/>
    <text x="${W - R}" y="${(yBrk - 11).toFixed(1)}" fill="${MUTED}" font-size="11" text-anchor="end" font-family="var(--font-data)">axis compressed above +15 m · ${pts.filter((p: any) => p.ground > BRK).length} kelurahan</text>`;
  const xt = [0, 1, 2, 3, 4].filter((v) => v <= x1).map((v) =>
    `<line x1="${sx(v).toFixed(1)}" y1="${T}" x2="${sx(v).toFixed(1)}" y2="${yBot}" stroke="${GRID}" opacity="0.4"/>
     <text x="${sx(v).toFixed(1)}" y="${yBot + 20}" fill="${MUTED}" font-size="12" text-anchor="middle">${v}</text>`).join("");
  const yt = [0, 5, 10, 15, 30, 50].filter((v) => v <= gmax).map((v) =>
    `<text x="${L - 9}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="12" text-anchor="end">${v}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Scatter of kelurahan sinking rate against low-ground height; the fastest-sinking kelurahan sit on high inland ground">
    ${xt}${yt}${brk}${thr}${dots}${labels}
    <g><circle cx="${L + 4}" cy="18" r="4.5" fill="${CYAN}" opacity="0.8"/><text x="${L + 16}" y="22" fill="${MUTED}" font-size="12">coastal belt (${A.geography.n_coastal})</text>
      <circle cx="${L + 170}" cy="18" r="4.5" fill="${CORAL}" opacity="0.72"/><text x="${L + 182}" y="22" fill="${MUTED}" font-size="12">inland (${A.city.n_ranked - A.geography.n_coastal})</text>
      <line x1="${L + 288}" y1="18" x2="${L + 316}" y2="18" stroke="${CORAL}" stroke-width="1.6" stroke-dasharray="4 4"/>
      <text x="${L + 324}" y="22" fill="${MUTED}" font-size="12">the +1 m exposure line</text>
      <text x="${W - R}" y="40" fill="${MUTED}" font-size="12" text-anchor="end">circle area = residents · ρ = ${A.geography.rho_rate_vs_lowground}</text></g>
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${H - 12}" fill="${MUTED}" font-size="12" text-anchor="middle">subsidence of the fastest decile, cm/yr →</text>
    <text x="16" y="${H / 2}" fill="${MUTED}" font-size="12" text-anchor="middle" transform="rotate(-90 16 ${H / 2})">low ground, metres above mean sea level →</text>
  </svg>`;
}

/* ── Figure 8 · the exposure curve, under two ground estimators ────────────── */
function figCurve() {
  const W = 760, H = 400, L = 74, R = 132, T = 22, B = 54;
  const c = EST.curve;
  const idx = c.heights.map((_: number, i: number) => i).filter((i: number) => c.heights[i] >= -1 && c.heights[i] <= 5);
  const x0 = -1, x1 = 5, y1 = Math.max(...idx.map((i: number) => c.min_2025[i])) * 1.05;
  const sx = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
  const sy = (v: number) => H - B - (v / y1) * (H - T - B);
  const path = (key: string, col: string, w: number, dash = "") =>
    `<path fill="none" stroke="${col}" stroke-width="${w}" ${dash ? `stroke-dasharray="${dash}"` : ""} d="${idx.map((i: number, j: number) =>
      `${j ? "L" : "M"}${sx(c.heights[i]).toFixed(1)} ${sy(c[key][i]).toFixed(1)}`).join("")}"/>`;
  const at = (key: string, h: number) => {
    const i = c.heights.indexOf(h);
    return i < 0 ? 0 : c[key][i];
  };
  const marks = [1.0, 0.0].map((h) =>
    `<line x1="${sx(h).toFixed(1)}" y1="${T + 156}" x2="${sx(h).toFixed(1)}" y2="${H - B}" stroke="${CORAL}" stroke-dasharray="3 4" opacity="0.6"/>
     <text x="${(sx(h) + 5).toFixed(1)}" y="${T + 150}" fill="${CORAL}" font-size="12" font-family="var(--font-data)">${h === 0 ? "MSL" : "+1 m"}</text>`).join("");
  const bridge = `<line x1="${sx(1).toFixed(1)}" y1="${sy(at("min_2025", 1)).toFixed(1)}" x2="${sx(EST.equivalent_mean_height_m).toFixed(1)}" y2="${sy(at("min_2025", 1)).toFixed(1)}"
      stroke="${PALEC}" stroke-width="1.2" stroke-dasharray="2 3"/>
    <circle cx="${sx(EST.equivalent_mean_height_m).toFixed(1)}" cy="${sy(at("min_2025", 1)).toFixed(1)}" r="4.5" fill="${PALEC}"/>
    <text x="${(sx(EST.equivalent_mean_height_m) + 9).toFixed(1)}" y="${(sy(at("min_2025", 1)) - 9).toFixed(1)}" fill="${PALEC}" font-size="12" font-family="var(--font-data)">the cell mean reaches the same count</text>
    <text x="${(sx(EST.equivalent_mean_height_m) + 9).toFixed(1)}" y="${(sy(at("min_2025", 1)) + 6).toFixed(1)}" fill="${PALEC}" font-size="12" font-family="var(--font-data)">only at +${EST.equivalent_mean_height_m} m</text>`;
  const box = `<g>
    <text x="${L + 10}" y="${T + 18}" fill="${CYAN}" font-size="12.5" font-family="var(--font-data)">at +1 m · cell minimum · ${n0(at("min_2025", 1))} residents</text>
    <text x="${L + 10}" y="${T + 38}" fill="${SLATE}" font-size="12.5" font-family="var(--font-data)">at +1 m · cell mean · ${n0(at("mean_2025", 1))} residents</text>
    <text x="${L + 10}" y="${T + 58}" fill="${MUTED}" font-size="12" font-family="var(--font-data)">a factor of ${EST.min_vs_mean_1m_2025} on one estimator choice</text></g>`;
  const xt = [-1, 0, 1, 2, 3, 4, 5].map((v) =>
    `<text x="${sx(v).toFixed(1)}" y="${H - B + 20}" fill="${MUTED}" font-size="12" text-anchor="middle">${v}</text>`).join("");
  const yt = [0, 1e6, 2e6, 3e6].filter((v) => v <= y1).map((v) =>
    `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.5"/>
     <text x="${L - 9}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="12" text-anchor="end">${v ? `${v / 1e6}M` : 0}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Population standing below a given height, computed on the cell minimum and on the cell mean; the two curves are about two metres apart">
    ${yt}${marks}${path("mean_2025", SLATE, 2.2)}${path("min_2025", CYAN, 2.6)}${path("min_2050", PALE, 1.6, "4 3")}
    ${bridge}${box}
    <circle cx="${sx(1).toFixed(1)}" cy="${sy(at("min_2025", 1)).toFixed(1)}" r="4.5" fill="${CYAN}"/>
    <circle cx="${sx(1).toFixed(1)}" cy="${sy(at("mean_2025", 1)).toFixed(1)}" r="4.5" fill="${SLATE}"/>
    <g><line x1="${W - R + 10}" y1="${T + 14}" x2="${W - R + 36}" y2="${T + 14}" stroke="${CYAN}" stroke-width="2.6"/><text x="${W - R + 42}" y="${T + 18}" fill="${MUTED}" font-size="12">cell minimum</text>
      <line x1="${W - R + 10}" y1="${T + 36}" x2="${W - R + 36}" y2="${T + 36}" stroke="${SLATE}" stroke-width="2.2"/><text x="${W - R + 42}" y="${T + 40}" fill="${MUTED}" font-size="12">cell mean</text>
      <line x1="${W - R + 10}" y1="${T + 58}" x2="${W - R + 36}" y2="${T + 58}" stroke="${PALE}" stroke-width="1.6" stroke-dasharray="4 3"/><text x="${W - R + 42}" y="${T + 62}" fill="${MUTED}" font-size="12">minimum, 2050</text></g>
    ${xt}
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${H - 12}" fill="${MUTED}" font-size="12" text-anchor="middle">ground height, metres above EGM2008 mean sea level →</text>
    <text x="16" y="${H / 2}" fill="${MUTED}" font-size="12" text-anchor="middle" transform="rotate(-90 16 ${H / 2})">residents below that height →</text>
  </svg>`;
}

/* ── Figure 9 · the step in the case's own below-sea-level series ──────────── */
function figStep() {
  const W = 760, H = 320, L = 74, R = 196, T = 26, B = 52;
  const s = A.series.below0m.series, yr = A.series.years;
  const y1 = Math.max(...s) * 1.1;
  const sx = (i: number) => L + (i / (s.length - 1)) * (W - L - R);
  const sy = (v: number) => H - B - (v / y1) * (H - T - B);
  const line = `<path fill="none" stroke="${CORAL}" stroke-width="2.6" d="${s.map((v: number, i: number) => `${i ? "L" : "M"}${sx(i).toFixed(1)} ${sy(v).toFixed(1)}`).join("")}"/>`;
  const dots = s.map((v: number, i: number) => `<circle cx="${sx(i).toFixed(1)}" cy="${sy(v).toFixed(1)}" r="2.6" fill="${CORAL}" opacity="0.85"/>`).join("");
  const step = `<line x1="${sx(0).toFixed(1)}" y1="${sy(s[0]).toFixed(1)}" x2="${sx(0).toFixed(1)}" y2="${sy(s[1]).toFixed(1)}" stroke="${PALEC}" stroke-width="3"/>
    <text x="${(sx(0) + 12).toFixed(1)}" y="${((sy(s[0]) + sy(s[1])) / 2 + 4).toFixed(1)}" fill="${PALEC}" font-size="12.5" font-family="var(--font-data)">+${n0(A.series.below0m.first_step)} in one year</text>
    <text x="${(sx(0) + 12).toFixed(1)}" y="${((sy(s[0]) + sy(s[1])) / 2 + 22).toFixed(1)}" fill="${MUTED}" font-size="12" font-family="var(--font-data)">${pct(A.series.below0m.first_share, 0)} of the whole 25-year rise</text>`;
  const rest = `<text x="${sx(s.length - 1).toFixed(1)}" y="${(sy(s[s.length - 1]) - 12).toFixed(1)}" fill="${CORAL}" font-size="12" text-anchor="end" font-family="var(--font-data)">then a median of ${n0(A.series.below0m.median_rest)} a year</text>`;
  const zy = sy(EST.pop_at_exact_zero);
  const zeroPop = `<line x1="${L}" y1="${zy.toFixed(1)}" x2="${W - R}" y2="${zy.toFixed(1)}" stroke="${SLATE}" stroke-dasharray="4 4"/>
    <text x="${W - R + 10}" y="${(zy - 8).toFixed(1)}" fill="${SLATE}" font-size="12" font-family="var(--font-data)">${n0(EST.pop_at_exact_zero)} people stand</text>
    <text x="${W - R + 10}" y="${(zy + 8).toFixed(1)}" fill="${SLATE}" font-size="12" font-family="var(--font-data)">on ${n0(EST.cells_at_exact_zero)} cells pinned</text>
    <text x="${W - R + 10}" y="${(zy + 24).toFixed(1)}" fill="${SLATE}" font-size="12" font-family="var(--font-data)">to exactly 0.00 m</text>`;
  const xt = [0, 5, 10, 15, 20, 25].map((i) =>
    `<text x="${sx(i).toFixed(1)}" y="${H - B + 20}" fill="${MUTED}" font-size="12" text-anchor="middle">${yr[i]}</text>`).join("");
  const yt = [0, 50000, 100000, 150000, 200000].filter((v) => v <= y1).map((v) =>
    `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.5"/>
     <text x="${L - 9}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="12" text-anchor="end">${v / 1000}k</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="The published count of people below mean sea level jumps 44 thousand in the first year and then rises slowly">
    ${yt}${zeroPop}${line}${dots}${step}${rest}${xt}
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${H - 12}" fill="${MUTED}" font-size="12" text-anchor="middle">the case's published city series · residents on ground below mean sea level</text>
  </svg>`;
}

/* ── Figure 10 · what the 2050 exposure ranking is made of ─────────────────── */
function figRank() {
  const rows = A.ranking.drivers;
  const W = 760, T = 20, rowH = 34, L = 262, R = 66;
  const H = T + rows.length * rowH + 48;
  const lo = -0.2, hi = 1.0, bw = W - L - R;
  const sx = (v: number) => L + ((v - lo) / (hi - lo)) * bw;
  const zero = sx(0);
  const body = rows.map((r: any, i: number) => {
    const y = T + i * rowH;
    const col = r.rho >= 0.9 ? CORAL : r.rho >= 0.3 ? MID : SLATE;
    const x = Math.min(zero, sx(r.rho)), w = Math.max(2, Math.abs(sx(r.rho) - zero));
    const tx = r.rho >= 0 ? sx(r.rho) + 9 : sx(r.rho) - 9;
    return `<text x="${L - 14}" y="${y + 19}" fill="${INK}" font-size="12.5" text-anchor="end">${esc(r.k)}</text>
      <rect x="${x.toFixed(1)}" y="${y + 7}" width="${w.toFixed(1)}" height="17" fill="${col}" rx="2"/>
      <text x="${tx.toFixed(1)}" y="${y + 20}" fill="${col}" font-size="12" text-anchor="${r.rho >= 0 ? "start" : "end"}" font-family="var(--font-data)">${r.rho.toFixed(3)}</text>`;
  }).join("");
  const ticks = [0, 0.5, 1.0].map((v) =>
    `<text x="${sx(v).toFixed(1)}" y="${T + rows.length * rowH + 16}" fill="${MUTED}" font-size="12" text-anchor="middle">${v.toFixed(1)}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Rank correlation of the 2050 exposure ranking with each candidate driver; low ground and today's map score above 0.95 while the sinking rate scores 0.22">
    <line x1="${zero.toFixed(1)}" y1="${T}" x2="${zero.toFixed(1)}" y2="${T + rows.length * rowH}" stroke="${GRID}"/>
    ${body}${ticks}
    <text x="${L - 14}" y="${H - 8}" fill="${MUTED}" font-size="12" text-anchor="end">Spearman ρ · ${A.city.n_ranked} kelurahan →</text>
  </svg>`;
}

/* ── Figure 11 · four versions of the same clock ───────────────────────────── */
function figClocks() {
  const W = 760, H = 400, L = 74, R = 214, T = 30, B = 54;
  const yrs = DEC.years;
  const pub = DEC.linear_1m, dec = DEC.series_1m;
  const ep = [EP.published["1m"]["2025"], EP.counts["1m"]["2025"], EP.counts["1m"]["2050"]];
  const dtm = DT.pop_1m_2050;
  const y1 = Math.max(...pub, ...ep, dtm[2]) * 1.08, y0 = 350000;
  const sx = (y: number) => L + ((y - 2025) / 25) * (W - L - R);
  const sy = (v: number) => H - B - ((v - y0) / (y1 - y0)) * (H - T - B);
  const draw = (xs: number[], ys: number[], col: string, w: number, dash = "") =>
    `<path fill="none" stroke="${col}" stroke-width="${w}" ${dash ? `stroke-dasharray="${dash}"` : ""} d="${ys.map((v, i) =>
      `${i ? "L" : "M"}${sx(xs[i]).toFixed(1)} ${sy(v).toFixed(1)}`).join("")}"/>`;
  const end = (v: number, col: string, big: string, small: string, dy = 0) =>
    `<circle cx="${sx(2050).toFixed(1)}" cy="${sy(v).toFixed(1)}" r="4" fill="${col}"/>
     <text x="${(sx(2050) + 10).toFixed(1)}" y="${(sy(v) + dy - 3).toFixed(1)}" fill="${col}" font-size="12.5" font-family="var(--font-data)">${esc(big)}</text>
     <text x="${(sx(2050) + 10).toFixed(1)}" y="${(sy(v) + dy + 12).toFixed(1)}" fill="${MUTED}" font-size="11.5" font-family="var(--font-data)">${esc(small)}</text>`;
  const yt = [350000, 400000, 450000, 500000, 550000].filter((v) => v >= y0 && v <= y1).map((v) =>
    `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.5"/>
     <text x="${L - 9}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="12" text-anchor="end">${v / 1000}k</text>`).join("");
  const xt = [2025, 2030, 2035, 2040, 2045, 2050].map((y) =>
    `<text x="${sx(y).toFixed(1)}" y="${H - B + 20}" fill="${MUTED}" font-size="12" text-anchor="middle">${y}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="The published clock against three corrected versions: a decaying rate, a corrected elevation epoch, and a rising datum">
    ${yt}
    ${draw([2025, 2050], [ep[1], ep[2]], PALEC, 2.2, "5 4")}
    ${draw(yrs, pub, CORAL, 2.8)}
    ${draw(yrs, dec, CYAN, 2.4, "4 3")}
    ${draw([2025, 2050], [pub[0], dtm[3]], MID, 2, "1 4")}
    ${end(dtm[3], MID, n0(dtm[3]), "+15 cm of sea level", -14)}
    ${end(ep[2], PALEC, n0(ep[2]), "elevation epoch corrected", 6)}
    ${end(pub[pub.length - 1], CORAL, n0(pub[pub.length - 1]), "as published", 0)}
    ${end(dec[dec.length - 1], CYAN, n0(dec[dec.length - 1]), "if the rate keeps decaying", 4)}
    ${xt}
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${H - 12}" fill="${MUTED}" font-size="12" text-anchor="middle">residents on ground below +1 m — four assumptions, one measurement</text>
  </svg>`;
}

const F1 = figLit(), F2 = figSpread(), F3 = figRep(), F4 = figGnss(), F5 = figCjkt(), F6 = figDumb();
const F7 = figScatter(), F8 = figCurve(), F9 = figStep(), F10 = figRank(), F11 = figClocks();
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<html lang="en" data-case="sinking" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Is Jakarta Still Sinking?</title>
    <meta name="description" content="An adversarial review of a Sentinel-1 InSAR subsidence and exposure model for Jakarta: the measurement replicates exactly, the rate has roughly halved, the fastest ground is inland, and the exposure headline is an estimator choice." />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" />
  </head>
  <body>
    <header class="bar">
      <a class="back" href={`${BASE}/`}>← The case</a>
      <span class="stamp dim">REVIEW ARTICLE · DATA VINTAGE {A.vintage}</span>
    </header>

    <article>
      <div class="masthead">
        <span class="eyebrow">METHODS &amp; VALIDATION · JAKARTA LAND SUBSIDENCE</span>
        <h1>Is Jakarta still sinking?</h1>
        <p class="standfirst">Yes — but roughly half as fast as the decade the famous numbers come from,
        and not mainly where the story says. This is an adversarial review of the case's Sentinel-1
        field, checked against the published record and against the GNSS archive sitting unused on the
        same disk. The measurement replicates the depositors' own table almost exactly. Three of the
        headlines built on it do not survive.</p>
        <div class="byline">
          <span>Demo Lab · FMV</span><span>Field vintage {A.window}</span>
          <span>{A.city.n_ranked} kelurahan · {n0(A.points)} radar points</span>
        </div>
      </div>

      <section class="abstract">
        <h2>Abstract</h2>
        <p><b>Question.</b> The case measures Jakarta's land subsidence from Sentinel-1 interferometry and
        turns it into a kelurahan exposure index and a clock to 2050. We ask three things separately: is
        the measurement right, is the exposure product informative beyond elevation, and does the clock
        mean what a reader will take it to mean?</p>
        <p><b>Method.</b> We re-derived every headline statistic from the case's own published JSON, then
        ran eight pre-specified tests on data already on its disk: reproducing the depositors' published
        per-municipality table from our regrid; refitting all {D.n_stations} north-Java GNSS stations from
        the Susilo et al. (2023) archive over early and late sub-periods; recomputing the exposure counts
        under three ground estimators; applying the elevation-epoch correction the pipeline declines;
        sweeping the sea-level datum the clock holds fixed; switching the radar off and re-ranking; and
        re-running the clock with a decaying rate.</p>
        <p><b>Findings.</b> <b>(1)</b> The regrid is faithful: across all five Jakarta municipalities our
        mean rate differs from <a href="#ref-ohenhen">Ohenhen et al.'s</a> published table by at most
        <b>{repMaxErr.toFixed(3)} cm/yr</b>. <b>(2)</b> The field is tied to an absolute datum far better
        than the case claims. Against GNSS refitted on the <i>same years</i> the mean residual is
        {mm(meanLate)} mm/yr, not the {mm(meanFull)} mm/yr the case's validation table reports and blames
        on a reference frame. <b>(3)</b> That {mm(meanFull)} is a real signal read as an error: at CJKT the
        rate fell from {mm(cjkt.early, 1)} to {mm(cjkt.late, 1)} mm/yr, a {pct(halved, 0)} reduction,
        while {D.east.n - D.east.n_slower} of {D.east.n} stations elsewhere on the north Java coast
        accelerated. <b>(4)</b> The fastest ground is not on the coast:
        {20 - A.geography.n_top20_coastal} of the 20 fastest-sinking kelurahan are inland, and rank
        correlation between sinking rate and low ground is ρ = {A.geography.rho_rate_vs_lowground}.
        <b>(5)</b> "{n0(minP)} people live on ground below +1 m" is an estimator choice: the same grid
        gives {n0(meanP)} on the cell mean. <b>(6)</b> The 2050 exposure ranking is ρ = {radarRho}
        identical to the ranking with the radar switched off. <b>(7)</b> Two unpriced assumptions — an
        uncorrected {EP.dem_epoch} elevation epoch and a fixed sea-level datum — each move the count by
        more than a decade of the clock's own projected change.</p>
        <p><b>Conclusion.</b> The instrument is sound and its validation is stronger than the case claims.
        The <i>product</i> built on it is not: it publishes an elevation map as a subsidence map, an
        estimator artefact as a population count, and an extrapolation as a clock. The measurement's real
        news — that Jakarta's subsidence is decaying while its neighbours' is not, and that the remaining
        fast ground has moved inland to exactly the districts the current groundwater-free zone does not
        cover — is not on the case page at all.</p>
      </section>

