---
/* Review article — the case, stress-tested against its own data and the literature.
 *
 * Every figure is built here in frontmatter from data/article.json, which pipeline/article.py
 * derives from the case's published summary and from pipeline/audit.py's independent
 * recomputation. Nothing is drawn by hand, so the prose cannot drift from the numbers.
 * SVG only: no WebGL, no canvas.
 */
import "../styles/tokens.css";
import { glossaryFor } from "../data/glossary.js";
import __src from "./article.astro?raw";
import A from "../data/article.json";

const PADDY = "#A8CE3A";      /* accent — the rice signal */
const OFFICIAL = "#4BB8A9";   /* official statistics, everywhere in the lab */
const FLOOD = "#2F7E96";
const VEG = "#5FA83F";
const RIPE = "#E6B94F";
const STUBBLE = "#B4805A";
const ALERT = "#E08B54";
const INK = "#E8EEEC", MUTED = "#93A5A2", GRID = "#1F2E31";

const KCOL: Record<string, string> = {
  Indramayu: PADDY, Karawang: OFFICIAL, Subang: VEG,
  Bojonegoro: RIPE, Lamongan: ALERT, Grobogan: FLOOD,
};
void STUBBLE;

const esc = (s: unknown) =>
  String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const pct = (x: number, d = 1) => `${(x * 100).toFixed(d)}%`;
const kha = (x: number) => `${(x / 1000).toFixed(0)}k ha`;
const num = (x: number) => Math.round(x).toLocaleString("en-US");

/* ── Literature, transcribed from the published papers ──────────────────────────────
 * These are the only hand-entered numbers on the page and they are other people's.
 * Everything else comes from article.json. */
const LIT = {
  torbick: { area_ha: 6_652_111, r2: 0.78, images: 632, sensor: "Sentinel-1A", country: "Myanmar" },
  riice: { images: 127, footprints: 13, countries: 6, acc_lo: 85, acc_hi: 95, mapped_mha: 1.6 },
  opensea: { oa: 0.983, kappa: 0.870, f1: 0.879, idn_r2: 0.85, idn_mean_err_ha: 6460,
             idn_rmse_ha: 11440, sea_r2: 0.92, sea_gap_pct: 4.3 },
};

/* ── derived scalars the prose uses ──────────────────────────────────────────────── */
const H = A.headline;
const dec = A.decomposition.aggregate;
const first = dec[0], last = dec[dec.length - 1];
const cc = A.crop_class.summary;
const lad = A.thinning.ladder;
const lad0 = lad[0], lad1 = lad[1];
const wu = A.revisit.within_unit;
const bestGain = [...wu].sort((a: any, b: any) => b.gain - a.gain)[0];
const kabRows = A.decomposition.by_kabupaten;
const worstKab = [...kabRows].sort((a: any, b: any) => a.ratio_ksa - b.ratio_ksa)[0];
const meanGap: Record<string, number> = {};
for (const r of A.revisit.rows) {
  meanGap[r.kabupaten] = (meanGap[r.kabupaten] ?? 0) + r.median_gap_days / 3;
}
const vhRiseLo = Math.min(...A.kabupaten.map((k: any) => k.median_vh_rise_db));
const vhRiseHi = Math.max(...A.kabupaten.map((k: any) => k.median_vh_rise_db));
const lagBins: Record<number, number> = {};
for (const r of A.timing.rows) lagBins[r.xcorr_lag_months] = (lagBins[r.xcorr_lag_months] ?? 0) + 1;
const lagSorted = Object.entries(lagBins).map(([k, v]) => ({ lag: Number(k), n: v }))
  .sort((a, b) => b.n - a.n);
const modal = lagSorted[0];
const aliased = lagSorted.filter((r) => Math.abs(r.lag) >= 3).reduce((s, r) => s + r.n, 0);
const prfYears = A.prf.rows.filter((r: any) => r.year !== "pooled");
const prfP = [Math.min(...prfYears.map((r: any) => r.precision)),
              Math.max(...prfYears.map((r: any) => r.precision))];
const prfR = [Math.min(...prfYears.map((r: any) => r.recall)),
              Math.max(...prfYears.map((r: any) => r.recall))];
const sens = A.sensitivity;
const sensBase = sens["_baseline_two_units_ha"];
const riseUp = sens["VH rise 3 dB (looser)"] / sensBase - 1;
const riseDn = sens["VH rise 5 dB (stricter)"] / sensBase - 1;

/* ══════════════════════════════════════════════════════════════════════════════════
   Figure 1 · the shortfall factors — and it factors the other way
   ══════════════════════════════════════════════════════════════════════════════════ */
function fig1() {
  const W = 720, Hh = 440, L = 64, R = 158, T = 24, B = 56;
  const x0 = 0, x1 = 1.08, y0 = 0, y1 = 1.12;
  const sx = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
  const sy = (v: number) => Hh - B - ((v - y0) / (y1 - y0)) * (Hh - T - B);
  const iso = [0.15, 0.25, 0.5, 0.75, 1.0].map((c) => {
    const pts: string[] = [];
    for (let i = 0; i <= 60; i++) {
      const xv = x0 + 0.02 + (i / 60) * (x1 - x0 - 0.02);
      const yv = c / xv;
      if (yv > y1 || yv < y0) continue;
      pts.push(`${pts.length ? "L" : "M"}${sx(xv).toFixed(1)} ${sy(yv).toFixed(1)}`);
    }
    const lx = Math.min(x1 - 0.04, Math.max(c / y1 + 0.02, 0.06));
    return `<path d="${pts.join("")}" fill="none" stroke="${GRID}" stroke-width="1.1"
      stroke-dasharray="${c === 1 ? "none" : "3 4"}" opacity="0.9"/>
      <text x="${sx(lx).toFixed(1)}" y="${(sy(Math.min(c / lx, y1)) - 6).toFixed(1)}"
        fill="${MUTED}" font-size="9.5" font-family="var(--font-data)">${(c * 100).toFixed(0)}%</text>`;
  }).join("");
  const dots = kabRows.map((r: any) =>
    `<circle class="d1" cx="${sx(r.recall_extent).toFixed(1)}" cy="${sy(r.recall_ci).toFixed(1)}" r="5"
      fill="${KCOL[r.kabupaten] ?? PADDY}" stroke="${GRID}" stroke-width="0.8"
      data-n="${esc(r.kabupaten)} ${r.year}"
      data-t="fields found ${(r.recall_extent * 100).toFixed(0)}% · crops per field ${(r.recall_ci * 100).toFixed(0)}% · ${(r.ratio_ksa * 100).toFixed(0)}% of the benchmark"/>`).join("");
  const pred = `<g>
    <line x1="${sx(1).toFixed(1)}" y1="${(sy(0.5) - 9).toFixed(1)}" x2="${sx(1).toFixed(1)}" y2="${(sy(0.5) + 9).toFixed(1)}" stroke="${ALERT}" stroke-width="2"/>
    <line x1="${(sx(1) - 9).toFixed(1)}" y1="${sy(0.5).toFixed(1)}" x2="${(sx(1) + 9).toFixed(1)}" y2="${sy(0.5).toFixed(1)}" stroke="${ALERT}" stroke-width="2"/>
    <text x="${(sx(1) - 14).toFixed(1)}" y="${(sy(0.5) + 4).toFixed(1)}" fill="${ALERT}" font-size="10.5" text-anchor="end">what the stated</text>
    <text x="${(sx(1) - 14).toFixed(1)}" y="${(sy(0.5) + 17).toFixed(1)}" fill="${ALERT}" font-size="10.5" text-anchor="end">diagnosis predicts</text></g>`;
  const legend = Object.keys(KCOL).map((k, i) =>
    `<circle cx="${W - R + 20}" cy="${T + 12 + i * 19}" r="4.5" fill="${KCOL[k]}"/>
     <text x="${W - R + 32}" y="${T + 16 + i * 19}" fill="${MUTED}" font-size="11">${esc(k)}</text>`).join("");
  const tx = [0, 0.25, 0.5, 0.75, 1.0].map((v) =>
    `<text x="${sx(v).toFixed(1)}" y="${Hh - B + 19}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${(v * 100).toFixed(0)}%</text>`).join("");
  const ty = [0, 0.25, 0.5, 0.75, 1.0].map((v) =>
    `<text x="${L - 9}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10.5" text-anchor="end">${(v * 100).toFixed(0)}%</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Extent recall against cropping-intensity recall for every regency-year; all points sit at low extent recall, not low intensity recall">
    <line x1="${L}" y1="${Hh - B}" x2="${W - R}" y2="${Hh - B}" stroke="${GRID}"/>
    <line x1="${L}" y1="${T}" x2="${L}" y2="${Hh - B}" stroke="${GRID}"/>
    ${iso}${tx}${ty}${pred}${dots}${legend}
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${Hh - 14}" fill="${MUTED}" font-size="11.5" text-anchor="middle">share of the rice FIELDS we find →</text>
    <text x="15" y="${(Hh / 2).toFixed(1)}" fill="${MUTED}" font-size="11.5" text-anchor="middle" transform="rotate(-90 15 ${(Hh / 2).toFixed(1)})">share of the CROPS per field →</text>
    <text x="${(W - R + 12).toFixed(1)}" y="${Hh - B - 4}" fill="${MUTED}" font-size="10" font-family="var(--font-data)">dashed = share of</text>
    <text x="${(W - R + 12).toFixed(1)}" y="${Hh - B + 9}" fill="${MUTED}" font-size="10" font-family="var(--font-data)">the benchmark</text>
  </svg>`;
}

/* ══════════════════════════════════════════════════════════════════════════════════
   Figure 2 · three independent measurements, and a benchmark that does not move
   ══════════════════════════════════════════════════════════════════════════════════ */
function fig2() {
  const W = 720, Hh = 372, L = 218, R = 96;
  const bw = W - L - R;
  const yr = A.benchmark.map_vs_ksa_year;
  const rowAgg = dec.find((d: any) => d.year === yr) ?? dec[0];
  const rows = [
    { k: `BPS field survey (KSA), ${yr}`, v: rowAgg.ksa_ha, c: OFFICIAL },
    { k: "Independent 10 m rice map", v: A.benchmark.map_implied_ha, c: FLOOD },
    { k: "This instrument", v: rowAgg.detected_harvested_ha, c: PADDY },
  ];
  const max = Math.max(...rows.map((r) => r.v)) * 1.02;
  const bars = rows.map((r, i) => {
    const y = 30 + i * 34;
    const w = (r.v / max) * bw;
    return `<text x="${L - 12}" y="${y + 15}" fill="${INK}" font-size="11.5" text-anchor="end">${esc(r.k)}</text>
      <rect x="${L}" y="${y + 3}" width="${w.toFixed(1)}" height="17" fill="${r.c}" rx="2"/>
      <text x="${(L + w + 9).toFixed(1)}" y="${y + 16}" fill="${r.c}" font-size="11" font-family="var(--font-data)">${num(r.v)} ha</text>`;
  }).join("");
  const gapPct = A.benchmark.map_vs_ksa_pct;

  /* lower panel — the national KSA series, with the 2018 method break drawn as a break */
  const ser = A.benchmark.national_ksa_mha as Record<string, number>;
  const yrs = Object.keys(ser).map(Number).sort((a, b) => a - b);
  const pT = 196, pB = Hh - 40, pL = 60, pR = 40;
  const preY = 2015, allYrs = [preY, ...yrs];
  const sxp = (y: number) => pL + ((y - preY) / (yrs[yrs.length - 1] - preY)) * (W - pL - pR);
  const vmax = 15.2, vmin = 9.4;
  const syp = (v: number) => pB - ((v - vmin) / (vmax - vmin)) * (pB - pT);
  const line = yrs.map((y, i) => `${i ? "L" : "M"}${sxp(y).toFixed(1)} ${syp(ser[String(y)]).toFixed(1)}`).join("");
  const dots = yrs.map((y) =>
    `<circle cx="${sxp(y).toFixed(1)}" cy="${syp(ser[String(y)]).toFixed(1)}" r="3.2" fill="${OFFICIAL}"/>`).join("");
  const preHa = A.benchmark.pre_ksa_ha / 1e6;
  const ticks = allYrs.filter((y) => y % 2 === 1 || y === 2018 || y === 2025).map((y) =>
    `<text x="${sxp(y).toFixed(1)}" y="${pB + 17}" fill="${MUTED}" font-size="10" text-anchor="middle">${String(y).slice(2)}</text>`).join("");
  const gl = [10, 12, 14].map((v) =>
    `<line x1="${pL}" y1="${syp(v).toFixed(1)}" x2="${W - pR}" y2="${syp(v).toFixed(1)}" stroke="${GRID}" opacity="0.6"/>
     <text x="${pL - 8}" y="${(syp(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10" text-anchor="end">${v}</text>`).join("");
  const openX = sxp(2022) + ((sxp(2023) - sxp(2022)) / 2);
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="The official survey, an independent satellite rice map and this instrument, for the same six regencies; and the national official series showing the 2018 method break sits outside the record">
    <text x="16" y="18" fill="${MUTED}" font-size="10.5" font-family="var(--font-data)">HARVESTED AREA, SIX REGENCIES</text>
    ${bars}
    <text x="${L}" y="${30 + 3 * 34 + 14}" fill="${MUTED}" font-size="11">The two independent benchmarks agree within ${Math.abs(gapPct).toFixed(1)}% of each other.</text>
    <line x1="16" y1="176" x2="${W - 16}" y2="176" stroke="${GRID}"/>
    <text x="16" y="${pT - 12}" fill="${MUTED}" font-size="10.5" font-family="var(--font-data)">NATIONAL HARVESTED AREA, Mha</text>
    ${gl}${ticks}
    <circle cx="${sxp(preY).toFixed(1)}" cy="${syp(preHa).toFixed(1)}" r="3.6" fill="${MUTED}"/>
    <text x="${(sxp(preY) + 8).toFixed(1)}" y="${(syp(preHa) - 7).toFixed(1)}" fill="${MUTED}" font-size="10">old method ${preHa.toFixed(2)}</text>
    <line x1="${(sxp(preY) + 2).toFixed(1)}" y1="${syp(preHa).toFixed(1)}" x2="${(sxp(2018) - 2).toFixed(1)}" y2="${syp(ser["2018"]).toFixed(1)}" stroke="${ALERT}" stroke-width="1.4" stroke-dasharray="2 5"/>
    <text x="${sxp(2016.5).toFixed(1)}" y="${((syp(preHa) + syp(ser["2018"])) / 2 - 8).toFixed(1)}" fill="${ALERT}" font-size="10.5" text-anchor="middle">method change ${A.benchmark.break_pct}%</text>
    <path d="${line}" fill="none" stroke="${OFFICIAL}" stroke-width="2.2"/>${dots}
    <line x1="${openX.toFixed(1)}" y1="${pT - 4}" x2="${openX.toFixed(1)}" y2="${pB}" stroke="${PADDY}" stroke-dasharray="3 4" stroke-width="1.4"/>
    <text x="${(openX + 6).toFixed(1)}" y="${pT + 8}" fill="${PADDY}" font-size="10.5">our record opens</text>
  </svg>`;
}

/* ══════════════════════════════════════════════════════════════════════════════════
   Figure 3 · detection against the independent map's own crop count
   ══════════════════════════════════════════════════════════════════════════════════ */
function fig3() {
  const W = 720, Hh = 286;
  const names = ["single-crop", "double-crop", "triple-crop"];
  const cls = ["1", "2", "3"];
  const counts = A.mask.class_counts as Record<string, number>;
  /* left panel — how many of these cells we detect at all */
  const aL = 60, aR = 336, aT = 56, aB = 216;
  const bwA = (aR - aL) / 3;
  const left = cls.map((c, i) => {
    const v = cc[c].detect_rate;
    const h = v * (aB - aT);
    const x = aL + i * bwA + bwA * 0.22;
    return `<rect x="${x.toFixed(1)}" y="${(aB - h).toFixed(1)}" width="${(bwA * 0.56).toFixed(1)}" height="${h.toFixed(1)}" fill="${PADDY}" rx="2"/>
      <text x="${(x + bwA * 0.28).toFixed(1)}" y="${(aB - h - 7).toFixed(1)}" fill="${PADDY}" font-size="11" text-anchor="middle" font-family="var(--font-data)">${(v * 100).toFixed(1)}%</text>
      <text x="${(x + bwA * 0.28).toFixed(1)}" y="${aB + 16}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${names[i].split("-")[0]}</text>
      <text x="${(x + bwA * 0.28).toFixed(1)}" y="${aB + 29}" fill="${MUTED}" font-size="9.5" text-anchor="middle" font-family="var(--font-data)">${(counts[c] / 1000).toFixed(0)}k cells</text>`;
  }).join("");
  const glA = [0.25, 0.5, 0.75, 1].map((v) =>
    `<line x1="${aL}" y1="${(aB - v * (aB - aT)).toFixed(1)}" x2="${aR}" y2="${(aB - v * (aB - aT)).toFixed(1)}" stroke="${GRID}" opacity="0.6"/>
     <text x="${aL - 7}" y="${(aB - v * (aB - aT) + 4).toFixed(1)}" fill="${MUTED}" font-size="9.5" text-anchor="end">${(v * 100).toFixed(0)}%</text>`).join("");
  /* right panel — how many crops we count where we do find them */
  const bL = 424, bR = 700, bT = 56, bB = 216;
  const bwB = (bR - bL) / 3, ymax = 3.2;
  const right = cls.map((c, i) => {
    const v = cc[c].cond;
    const truth = Number(c);
    const h = (v / ymax) * (bB - bT);
    const th = (truth / ymax) * (bB - bT);
    const x = bL + i * bwB + bwB * 0.22;
    const w = bwB * 0.56;
    return `<rect x="${x.toFixed(1)}" y="${(bB - th).toFixed(1)}" width="${w.toFixed(1)}" height="${th.toFixed(1)}" fill="${FLOOD}" opacity="0.3" rx="2"/>
      <line x1="${x.toFixed(1)}" y1="${(bB - th).toFixed(1)}" x2="${(x + w).toFixed(1)}" y2="${(bB - th).toFixed(1)}" stroke="${FLOOD}" stroke-width="2"/>
      <rect x="${(x + w * 0.18).toFixed(1)}" y="${(bB - h).toFixed(1)}" width="${(w * 0.64).toFixed(1)}" height="${h.toFixed(1)}" fill="${PADDY}" rx="2"/>
      <text x="${(x + w / 2).toFixed(1)}" y="${(bB - h - 7).toFixed(1)}" fill="${PADDY}" font-size="11" text-anchor="middle" font-family="var(--font-data)">${v.toFixed(2)}</text>
      <text x="${(x + w / 2).toFixed(1)}" y="${bB + 16}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${names[i].split("-")[0]}</text>
      <text x="${(x + w / 2).toFixed(1)}" y="${bB + 29}" fill="${FLOOD}" font-size="9.5" text-anchor="middle" font-family="var(--font-data)">map says ${truth}</text>`;
  }).join("");
  const glB = [1, 2, 3].map((v) =>
    `<line x1="${bL}" y1="${(bB - (v / ymax) * (bB - bT)).toFixed(1)}" x2="${bR}" y2="${(bB - (v / ymax) * (bB - bT)).toFixed(1)}" stroke="${GRID}" opacity="0.6"/>
     <text x="${bL - 7}" y="${(bB - (v / ymax) * (bB - bT) + 4).toFixed(1)}" fill="${MUTED}" font-size="9.5" text-anchor="end">${v}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="We detect 3.6 percent of single-crop cells and 37.8 percent of double-crop cells; where we detect them we count 1.07, 1.49 and 1.15 crops against a map that says one, two and three">
    <text x="${aL}" y="26" fill="${INK}" font-size="12">Cells we find at all</text>
    <text x="${aL}" y="41" fill="${MUTED}" font-size="10.5">of every cell the map calls rice</text>
    <text x="${bL}" y="26" fill="${INK}" font-size="12">Crops we count where we find them</text>
    <text x="${bL}" y="41" fill="${MUTED}" font-size="10.5">against the map's own crop count</text>
    ${glA}${glB}
    <line x1="${aL}" y1="${aB}" x2="${aR}" y2="${aB}" stroke="${GRID}"/>
    <line x1="${bL}" y1="${bB}" x2="${bR}" y2="${bB}" stroke="${GRID}"/>
    ${left}${right}
    <text x="${W / 2}" y="${Hh - 8}" fill="${MUTED}" font-size="11" text-anchor="middle">classes of the independent 10 m map, ${A.full_years[0]}–${A.full_years[A.full_years.length - 1]} mean</text>
  </svg>`;
}

/* ══════════════════════════════════════════════════════════════════════════════════
   Figure 4 · the deficit through the year
   ══════════════════════════════════════════════════════════════════════════════════ */
function fig4() {
  const W = 720, Hh = 436, L = 56, R = 132, T = 34, B = 156;
  const m = A.seasonal.by_month;
  const adj = A.seasonal.by_month_lag_corrected;
  const adjTot = adj.reduce((s: number, r: any) => s + r.ours_ha, 0);
  const sx = (mm: number) => L + ((mm - 1) / 11) * (W - L - R);
  const ymax = Math.max(...m.map((r: any) => Math.max(r.share_ours, r.share_ksa))) * 1.15;
  const sy = (v: number) => Hh - B - (v / ymax) * (Hh - T - B);
  const path = (vals: number[], col: string, dash: string) =>
    `<path d="${vals.map((v, i) => `${i ? "L" : "M"}${sx(i + 1).toFixed(1)} ${sy(v).toFixed(1)}`).join("")}"
      fill="none" stroke="${col}" stroke-width="2.2" stroke-dasharray="${dash}"/>`;
  const band = (m0: number, m1: number, lab: string, col: string) =>
    `<rect x="${sx(m0).toFixed(1)}" y="${T - 8}" width="${(sx(m1) - sx(m0)).toFixed(1)}" height="${(Hh - B - T + 8).toFixed(1)}" fill="${col}" opacity="0.07"/>
     <text x="${((sx(m0) + sx(m1)) / 2).toFixed(1)}" y="${T - 12}" fill="${col}" font-size="10.5" text-anchor="middle">${lab}</text>`;
  const rb0 = Hh - B + 56, rbH = 58;
  const rmax = Math.max(...m.map((r: any) => r.ratio ?? 0)) * 1.1;
  const ratio = m.map((r: any) => {
    const v = r.ratio ?? 0;
    const h = (v / rmax) * rbH;
    return `<rect x="${(sx(r.month) - 11).toFixed(1)}" y="${(rb0 + rbH - h).toFixed(1)}" width="22" height="${h.toFixed(1)}" fill="${PADDY}" opacity="0.8" rx="1.5"/>
      <text x="${sx(r.month).toFixed(1)}" y="${(rb0 + rbH - h - 4).toFixed(1)}" fill="${MUTED}" font-size="9" text-anchor="middle" font-family="var(--font-data)">${(v * 100).toFixed(0)}</text>`;
  }).join("");
  const MM = ["J", "F", "M", "A", "M", "J", "J", "A", "S", "O", "N", "D"];
  const ticks = MM.map((s, i) =>
    `<text x="${sx(i + 1).toFixed(1)}" y="${Hh - B + 18}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${s}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Monthly share of harvest, ours against the official survey, and the recovery ratio per month">
    ${band(2, 5, "rendeng harvest", OFFICIAL)}${band(7, 10, "gadu harvest", RIPE)}
    <line x1="${L}" y1="${Hh - B}" x2="${W - R}" y2="${Hh - B}" stroke="${GRID}"/>
    ${ticks}
    ${path(m.map((r: any) => r.share_ksa), OFFICIAL, "none")}
