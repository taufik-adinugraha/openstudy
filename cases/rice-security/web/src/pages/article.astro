    return `<text x="${L - 12}" y="${y + 4}" fill="${INK}" font-size="11.5" text-anchor="end">${esc(r.kabupaten)}</text>
      <line x1="${x1.toFixed(1)}" y1="${y}" x2="${x2.toFixed(1)}" y2="${y}" stroke="${moved ? PADDY : MUTED}" stroke-width="2" opacity="0.55"/>
      <circle cx="${x1.toFixed(1)}" cy="${y}" r="4.4" fill="${MUTED}"/>
      <circle cx="${x2.toFixed(1)}" cy="${y}" r="5.4" fill="${moved ? PADDY : MUTED}"/>
      <text x="${(W - R + 8).toFixed(1)}" y="${y + 4}" fill="${MUTED}" font-size="9.5" font-family="var(--font-data)">${r.gap_first}→${r.gap_last} d gap · ${r.acq_first}→${r.acq_last} looks</text>
      <text x="${(W - 14).toFixed(1)}" y="${y + 4}" fill="${moved ? PADDY : MUTED}" font-size="11" text-anchor="end" font-family="var(--font-data)">×${r.gain.toFixed(2)}</text>`;
  }).join("");
  const ticks = [0, 0.2, 0.4, 0.6].map((v) =>
    `<line x1="${sx(v).toFixed(1)}" y1="${T - 4}" x2="${sx(v).toFixed(1)}" y2="${Hh - 26}" stroke="${GRID}" opacity="0.6"/>
     <text x="${sx(v).toFixed(1)}" y="${Hh - 10}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${(v * 100).toFixed(0)}%</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Share of rice fields found in 2023 against 2025 for each regency, with the change in revisit gap">
    ${ticks}${body}
    <text x="${L - 12}" y="${T - 6}" fill="${MUTED}" font-size="10" text-anchor="end" font-family="var(--font-data)">${A.full_years[0]} → ${A.full_years[A.full_years.length - 1]}</text>
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${T - 6}" fill="${MUTED}" font-size="10.5" text-anchor="middle">share of the rice fields found</text>
  </svg>`;
}

