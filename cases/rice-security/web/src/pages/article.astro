}

/* ══════════════════════════════════════════════════════════════════════════════════
   Figure 5 · the controlled test — same fields, fewer looks
   ══════════════════════════════════════════════════════════════════════════════════ */
function fig5() {
  const W = 720, Hh = 400, L = 62, R = 156, T = 26, B = 56;
  const x0 = 2.5, x1 = 26, y0 = 0, y1 = 0.78;
  const sx = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
  const sy = (v: number) => Hh - B - ((v - y0) / (y1 - y0)) * (Hh - T - B);
  const line = lad.map((r: any, i: number) =>
    `${i ? "L" : "M"}${sx(r.median_gap_days).toFixed(1)} ${sy(r.extent_recall_vs_prior).toFixed(1)}`).join("");
  const ladDots = lad.map((r: any) =>
    `<circle class="d1" cx="${sx(r.median_gap_days).toFixed(1)}" cy="${sy(r.extent_recall_vs_prior).toFixed(1)}" r="6"
       fill="${PADDY}" stroke="${GRID}" stroke-width="1"
       data-n="${esc(A.thinning.kabupaten)}, thinned to 1 look in ${r.thin}"
       data-t="${r.n_acquisitions} looks · ${r.median_gap_days} d gap · ${(r.extent_recall_vs_prior * 100).toFixed(1)}% of fields found"/>
     <text x="${(sx(r.median_gap_days) - 10).toFixed(1)}" y="${(sy(r.extent_recall_vs_prior) - 10).toFixed(1)}" fill="${PADDY}" font-size="10.5" text-anchor="end" font-family="var(--font-data)">${(r.extent_recall_vs_prior * 100).toFixed(1)}%</text>`).join("");
  const obs = A.revisit.overlay.map((r: any) =>
    `<circle class="d1" cx="${sx(r.gap).toFixed(1)}" cy="${sy(r.recall).toFixed(1)}" r="4.2"
      fill="${KCOL[r.kabupaten] ?? MUTED}" opacity="0.9" stroke="${GRID}" stroke-width="0.7"
      data-n="${esc(r.kabupaten)} ${r.year}"
      data-t="${r.acq} looks · ${r.gap} d gap · ${(r.recall * 100).toFixed(1)}% of fields found"/>`).join("");
  const tx = [4, 6, 8, 12, 18, 24].map((v) =>
    `<line x1="${sx(v).toFixed(1)}" y1="${Hh - B}" x2="${sx(v).toFixed(1)}" y2="${Hh - B + 4}" stroke="${GRID}"/>
     <text x="${sx(v).toFixed(1)}" y="${Hh - B + 18}" fill="${MUTED}" font-size="10.5" text-anchor="middle">${v}</text>`).join("");
  const ty = [0, 0.2, 0.4, 0.6].map((v) =>
    `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.6"/>
     <text x="${L - 8}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10.5" text-anchor="end">${(v * 100).toFixed(0)}%</text>`).join("");
  const legend = Object.keys(KCOL).map((k, i) =>
    `<circle cx="${W - R + 20}" cy="${T + 66 + i * 18}" r="4" fill="${KCOL[k]}"/>
     <text x="${W - R + 31}" y="${T + 70 + i * 18}" fill="${MUTED}" font-size="10.5">${esc(k)}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${Hh}" class="fig" role="img" aria-label="Share of rice fields found against the median revisit gap; the controlled thinning curve and the six regencies' own observed points fall together">
    ${ty}${tx}
    <line x1="${L}" y1="${Hh - B}" x2="${W - R}" y2="${Hh - B}" stroke="${GRID}"/>
    <path d="${line}" fill="none" stroke="${PADDY}" stroke-width="2.6" opacity="0.85"/>
    ${ladDots}${obs}
    <g><circle cx="${W - R + 20}" cy="${T + 12}" r="6" fill="${PADDY}"/>
      <text x="${W - R + 31}" y="${T + 16}" fill="${MUTED}" font-size="10.5">${esc(A.thinning.kabupaten)},</text>
      <text x="${W - R + 31}" y="${T + 29}" fill="${MUTED}" font-size="10.5">looks removed</text>
      <text x="${W - R + 12}" y="${T + 52}" fill="${MUTED}" font-size="10.5">observed:</text></g>
    ${legend}
    <text x="${((L + W - R) / 2).toFixed(1)}" y="${Hh - 14}" fill="${MUTED}" font-size="11.5" text-anchor="middle">median days between radar looks →</text>
    <text x="15" y="${(Hh / 2).toFixed(1)}" fill="${MUTED}" font-size="11.5" text-anchor="middle" transform="rotate(-90 15 ${(Hh / 2).toFixed(1)})">share of the rice fields found →</text>
  </svg>`;
}

/* ══════════════════════════════════════════════════════════════════════════════════
   Figure 6 · revisit rose inside the sample, and detection rose with it
   ══════════════════════════════════════════════════════════════════════════════════ */
function fig6() {
  const rows = [...wu].sort((a: any, b: any) => b.gain - a.gain);
  const W = 720, L = 108, R = 216, T = 34, rh = 34;
