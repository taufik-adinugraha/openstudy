          tipEl.style.top = Math.max(8, y - r.height - 12) + "px";
        },
        hide() { tipEl.style.opacity = "0"; tipEl.setAttribute("aria-hidden", "true"); },
      };

      /* ══════════════════════════════════════════════════════════════════════════════
         CanvasMap — the renderer that actually ships.  The owner's browser runs with
         WebGL off, so this is not a degraded path: it does hover, click, hit-testing
         with Path2D + isPointInPath, polylines and a quantised grid, all in 2-D.

         Three invariants worth stating, because each is a silent bug otherwise:
          1. A SEPARATE hit-test context with an identity transform.  The paint context
             carries setTransform(dpr,...), so isPointInPath on it needs px/dpr.
          2. The hit canvas MUST be sized to W x H — isPointInPath returns false for any
             point outside the bitmap, and an unsized (300x150) canvas silently kills
             hit testing below and right of that box.
          3. Longitude cosine correction.  Over 24 degrees of longitude at the equator an
             uncorrected projection is fine, but the AOI runs to 9S and the distortion
             shows in trajectory angles, which is exactly what this page is about.
         ══════════════════════════════════════════════════════════════════════════════ */
      function CanvasMap(container, bbox, label) {
        container.querySelectorAll("canvas").forEach((c) => c.remove());
        const canvas = document.createElement("canvas");
        canvas.style.cssText = "width:100%;height:100%;display:block;";
        // a canvas is opaque to assistive technology, so it carries the description and the
        // numbers it shows are all repeated in the panel or table beside it
        canvas.setAttribute("role", "img");
        canvas.setAttribute("aria-label", label ?? "Map of the Indonesian fire and haze domain");
        container.insertBefore(canvas, container.firstChild);
        const ctx = canvas.getContext("2d");
        const hit = document.createElement("canvas").getContext("2d");
        const dpr = Math.min(devicePixelRatio || 1, 2);
        const B = { w: bbox[0], s: bbox[1], e: bbox[2], n: bbox[3] };
        let W = 0, H = 0, k = 1, ox = 0, oy = 0, lonC = 1;
        const layers = [];

        function project() {
          W = container.clientWidth || 640;
          H = container.clientHeight || 400;
          canvas.width = Math.max(1, W * dpr);
          canvas.height = Math.max(1, H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          hit.canvas.width = W; hit.canvas.height = H;
          const pad = 8;
          lonC = Math.cos((((B.n + B.s) / 2) * Math.PI) / 180);
          k = Math.min((W - 2 * pad) / ((B.e - B.w) * lonC), (H - 2 * pad) / (B.n - B.s));
          ox = (W - k * (B.e - B.w) * lonC) / 2;
          oy = (H + k * (B.n - B.s)) / 2;
        }
        const X = (lon) => ox + (lon - B.w) * lonC * k;
        const Y = (lat) => oy - (lat - B.s) * k;

        function paint() {
          ctx.fillStyle = C.ground;
          ctx.fillRect(0, 0, W, H);
          for (const l of layers) l.draw(ctx, X, Y, k);
        }
        project();
        let raf = 0;
        const redraw = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(paint); };
        addEventListener("resize", () => { project(); for (const l of layers) l.reproject?.(X, Y, k); redraw(); });
        return {
          canvas, ctx, hit, X, Y, get k() { return k; }, get W() { return W; }, get H() { return H; },
          add(l) { layers.push(l); l.reproject?.(X, Y, k); return l; },
          clearLayers() { layers.length = 0; },
          redraw, project,
          pxOf(e) { const r = canvas.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; },
        };
      }

      /* Coastline / province layer, with exact point-in-polygon hit testing. */
      function polyLayer(geo, opts = {}) {
        let paths = [], boxes = [];
        return {
          geo, paths, boxes,
          reproject(X, Y) {
            paths = []; boxes = [];
            for (const f of geo.features) {
              const p = new Path2D();
              let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
              const polys = f.geometry.type === "Polygon" ? [f.geometry.coordinates] : f.geometry.coordinates;
              for (const poly of polys)
                for (const ring of poly) {
                  ring.forEach(([lon, lat], j) => {
                    const px = X(lon), py = Y(lat);
                    if (px < x0) x0 = px; if (px > x1) x1 = px;
                    if (py < y0) y0 = py; if (py > y1) y1 = py;
                    j ? p.lineTo(px, py) : p.moveTo(px, py);
                  });
                  p.closePath();
                }
              paths.push(p); boxes.push([x0, y0, x1, y1]);
            }
            this.paths = paths; this.boxes = boxes;
          },
          draw(ctx) {
            for (let i = 0; i < paths.length; i++) {
              ctx.fillStyle = opts.fill ?? C.surface;
              ctx.fill(paths[i]);
              ctx.strokeStyle = opts.stroke ?? C.hair;
              ctx.lineWidth = opts.lw ?? 0.7;
              ctx.stroke(paths[i]);
            }
            if (opts.hoverIdx != null && opts.hoverIdx >= 0 && paths[opts.hoverIdx]) {
              ctx.strokeStyle = C.accent; ctx.lineWidth = 1.6; ctx.stroke(paths[opts.hoverIdx]);
            }
          },
          featureAt(hit, px, py) {
            for (let i = paths.length - 1; i >= 0; i--) {
              const b = boxes[i];
              if (px < b[0] - 1 || px > b[2] + 1 || py < b[1] - 1 || py > b[3] + 1) continue;
              if (hit.isPointInPath(paths[i], px, py)) return i;
            }
            return -1;
          },
        };
      }

      /* ══════════════════════════════════════════════════════════════════════════════ */
      (async function main() {
        const [grid, days, geo, stats, skill, receptors, mask, firesYear, national] =
          await Promise.all([
            soft("grid.json"), soft("days.json"), soft("adm1.geo.json"), soft("stats.json"),
            soft("skill.json"), soft("receptors.json"), soft("mask.json"),
            soft("fires_year.json"), soft("national.json"),
          ]);

        if (!grid) {
          // A designed pending state, not a hole.  The page still says what it WILL show and
          // what has to happen first, because a blank panel and a broken panel look identical.
          const msg = "Pipeline output not exported yet — run <code>make rebuild</code> in " +
                      "<code>cases/fire-haze/</code>. Thresholds on this page were fixed before " +
                      "any result was seen and are not moved to fit an outcome.";
          document.querySelectorAll(".loading").forEach((el) => {
            el.className = "empty"; el.innerHTML = msg;
          });
          document.querySelectorAll(".mapbox").forEach((el) => {
            el.insertAdjacentHTML("afterbegin",
              `<div class="empty" style="position:absolute;inset:18px;display:grid;place-content:center;border-style:dashed">${msg}</div>`);
          });
          ["skill-block", "plume-block", "receptors", "anchors", "removal-comp", "shap",
           "ch-year", "ch-reliability", "ch-gap"].forEach((id) => {
            const el = document.getElementById(id);
            if (el && !el.querySelector(".empty")) { el.className = "empty"; el.innerHTML = msg; }
          });
          const tb = document.querySelector("#episode-table tbody");
          if (tb) tb.innerHTML = `<tr><td class="muted">${msg}</td></tr>`;
          sect("gates", () => renderGates(stats));
          sect("vintage", () => vintageTable(stats));
          return;
        }
        const BBOX = grid.bbox ?? [95, -9, 119, 6];

        /* ── hero: blame the wind ───────────────────────────────────────────────── */
        sect("hero", () => heroMap(grid, days, geo, BBOX));
        /* ── 01 ─────────────────────────────────────────────────────────────────── */
        sect("mask map", () => maskMap(mask, geo, BBOX));
        sect("removal", () => removalComposition(firesYear));
        sect("fires by year", () => firesByYear(firesYear));
        /* ── 02 ─────────────────────────────────────────────────────────────────── */
        sect("risk map", () => riskMap(grid, days, geo, BBOX));
        sect("shap", () => shapFamilies(skill));
        sect("reliability", () => reliability(skill));
        /* ── 03 ─────────────────────────────────────────────────────────────────── */
        sect("skill", () => skillTable(skill));
        sect("gap", () => foresightGap(skill));
        /* ── 04 ─────────────────────────────────────────────────────────────────── */
        sect("plume", () => plumeBlock(stats, national));
        /* ── 05 ─────────────────────────────────────────────────────────────────── */
        sect("receptors", () => receptorPanels(receptors, stats));
        /* ── 06 ─────────────────────────────────────────────────────────────────── */
        sect("anchors", () => anchorBlock(stats, national));
        /* ── explore + method ───────────────────────────────────────────────────── */
        sect("explore", () => exploreTable(days));
        sect("gates", () => renderGates(stats));
        sect("vintage", () => vintageTable(stats));

        /* ────────────────────────────────────────────────────────────────────────── */
        function heroMap(grid, days, geo, bbox) {
          const el = document.getElementById("hero-map");
          const eps = days?.episodes ?? [];
          const recSel = document.getElementById("pick-receptor");
          const epSel = document.getElementById("pick-episode");
          const attr = document.getElementById("hero-attr");
          if (!eps.length) {
            el.insertAdjacentHTML("afterbegin",
              '<div class="empty" style="margin:24px">No trajectory episodes exported yet — the transport stage has not run.</div>');
            return;
          }
          const map = CanvasMap(el, bbox,
            "Back-trajectory fan from the selected receptor over Sumatra, Kalimantan and the "
            + "Java Sea, with the fire detections burning beneath it. Every number it shows is "
            + "repeated in the attribution panel beside it.");
          const land = geo ? map.add(polyLayer(geo, { fill: C.surface, stroke: C.hair })) : null;

          const recs = [...new Set(eps.map((e) => e.receptor))];
          recSel.innerHTML = recs.map((r) => `<option value="${r}">${title(r)}</option>`).join("");
          let state = { rec: recs.includes("singapore") ? "singapore" : recs[0], dir: "back", ep: null };

          function fillEpisodes() {
            const list = eps.filter((e) => e.receptor === state.rec)
              .sort((a, b) => (b.exposure ?? 0) - (a.exposure ?? 0));
            epSel.innerHTML = list.map((e) =>
              `<option value="${e.day}">${e.day}${e.anchor ? " · anchor" : ""}</option>`).join("");
            state.ep = list[0]?.day ?? null;
          }
          fillEpisodes();
          recSel.value = state.rec;

          const traj = { paths: [], fires: [], src: [] };
          let progress = 1;

          /* For each fire, the normalised moment the fan first sweeps within reach of it.
             Computed ONCE per episode (700 fires x 30 parcels x 25 steps is nothing) so the
             per-frame draw is a comparison rather than a nearest-neighbour search — which is
             what lets the fires ignite in step with the parcels at 60 fps. */
          function computeIgnition() {
            const R2 = 0.45 * 0.45;          // ~50 km at this latitude
            for (const f of traj.fires) {
              let best = 1;
              for (const p of traj.paths) {
                for (let i = 0; i < p.length; i++) {
                  const dy = p[i][0] - f[0], dx = p[i][1] - f[1];
                  if (dy * dy + dx * dx < R2) {
                    const t = i / Math.max(1, p.length - 1);
                    if (t < best) best = t;
                    break;
                  }
                }
              }
              f[3] = best;
            }
          }

          const trajLayer = {
            draw(ctx, X, Y) {
              // hotspots first, under the parcels — --fire is for point detections only
              ctx.fillStyle = C.fire;
              for (const f of traj.fires) {
                const [la, lo, w, lit] = f;
                if (lit != null && progress < lit) continue;
                const age = lit == null ? 1 : Math.min(1, (progress - lit) * 6);
                ctx.globalAlpha = 0.35 + 0.5 * age;
                ctx.beginPath();
                ctx.arc(X(lo), Y(la),
                        Math.max(1.6, Math.min(5, Math.sqrt(w) * 0.35)) * (0.4 + 0.6 * age),
                        0, 6.284);
                ctx.fill();
              }
              ctx.globalAlpha = 1;
              ctx.lineWidth = 1.1;
              ctx.lineJoin = "round";
              for (const p of traj.paths) {
                const n = Math.max(2, Math.round(p.length * progress));
                const g = ctx.createLinearGradient(X(p[0][1]), Y(p[0][0]),
                                                   X(p[n - 1][1]), Y(p[n - 1][0]));
                g.addColorStop(0, C.ramp[4]);
                g.addColorStop(1, C.accent);
                ctx.strokeStyle = g;
                ctx.globalAlpha = 0.55;
                ctx.beginPath();
                for (let i = 0; i < n; i++) {
                  const [la, lo] = p[i];
                  i ? ctx.lineTo(X(lo), Y(la)) : ctx.moveTo(X(lo), Y(la));
                }
                ctx.stroke();
              }
              ctx.globalAlpha = 1;
              // the receptor itself
              const r = RECEPTOR_XY[state.rec];
              if (r) {
                ctx.fillStyle = C.clean;
                ctx.beginPath(); ctx.arc(X(r[1]), Y(r[0]), 5, 0, 6.284); ctx.fill();
                ctx.strokeStyle = C.ground; ctx.lineWidth = 2; ctx.stroke();
              }
            },
          };
          map.add(trajLayer);

          const RECEPTOR_XY = {};
          for (const [k, v] of Object.entries(receptors?.receptors ?? {}))
            RECEPTOR_XY[k] = [v.lat, v.lon];

          async function draw() {
            if (!state.ep) return;
            attr.innerHTML = '<h3>Attribution</h3><div class="loading skel" style="height:150px"></div>';
            try {
              if (state.dir === "back") {
                const d = await load(`back/${state.rec}/${state.ep}.json`);
                traj.paths = d.parcels;
                traj.src = [];
                // the fires that were burning under the parcels over the same window — the
                // whole point of the interaction is that the lines LAND on something
                traj.fires = (d.fires ?? []).map(([la, lo, frp]) => [la, lo, frp]);
                renderAttr(d);
              } else {
                const d = await load(`fwd/${state.ep}.json`);
                traj.paths = d.parcels.map((p) => p.path);
                traj.fires = d.parcels.map((p) => [p.src[0], p.src[1], p.w]);
                renderFwd(d);
              }
            } catch (err) {
              traj.paths = []; traj.fires = [];
              attr.innerHTML = `<h3>Attribution</h3><div class="empty">No ${
                state.dir === "back" ? "back" : "forward"}-trajectory set for ${state.ep}.</div>`;
            }
            if (state.dir === "back") computeIgnition();
            else for (const f of traj.fires) f[3] = 0;   // sources are lit from the start
            animate();
          }

          function animate() {
            if (REDUCED) { progress = 1; map.redraw(); return; }
            progress = 0;
            const t0 = performance.now();
            const step = (t) => {
              progress = Math.min(1, (t - t0) / 900);
              map.redraw();
              if (progress < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }

          function renderAttr(d) {
            // attribution values are {share, agreement, n_parcels}; older exports were bare
            // numbers, so normalise rather than assume
            const norm = Object.fromEntries(Object.entries(d.attribution ?? {}).map(
              ([k, v]) => [k, typeof v === "number" ? { share: v, agreement: null } : v]));
            const rows = Object.entries(norm).sort((a, b) => b[1].share - a[1].share);
            if (!rows.length || rows[0][0] === "no attributable source") {
              attr.innerHTML = `<h3>Attribution</h3>
                <p class="muted" style="font-size:13px">
                  <b>No attributable source.</b> The 72-hour back-trajectory from
                  ${title(state.rec)} on ${d.day} passed over no detected fire. That is the
                  correct answer on the many bad-air days that are local rather than
                  transboundary — and saying so is the point of publishing it.</p>`;
              return;
            }
            const max = rows[0][1].share;
            const nP = d.parcels.length;
            attr.innerHTML = `<h3>Where the air came from</h3>
              <p class="muted" style="font-size:12.5px;margin-bottom:10px">
                ${title(state.rec)} · ${d.day} · 72 h back · ${nP} parcels</p>` +
              rows.slice(0, 8).map(([p, v]) => {
                const ag = v.agreement;
                return `
                <div style="margin-bottom:9px">
                  <div style="display:flex;justify-content:space-between;font-family:var(--font-data);font-size:12px">
                    <span>${p}</span><span class="muted">${(v.share * 100).toFixed(1)}%</span></div>
                  <div style="height:7px;background:var(--surface-raised);border-radius:4px;overflow:hidden;margin-top:3px">
                    <div style="height:100%;width:${(v.share / max) * 100}%;background:${C.accent};border-radius:4px"></div>
                  </div>
                  ${ag == null ? "" : `<div class="muted" style="font-family:var(--font-data);font-size:12px;margin-top:3px">
                    ${Math.round(ag * nP)} of ${nP} parcels crossed its fires</div>`}
                </div>`;
              }).join("") +
              `<p class="muted" style="font-size:12px;margin-top:12px;margin-bottom:0">
                 Province shares are a statement about where the air came from, weighted by
                 residence time times the fire radiative power beneath — not about who lit the
                 fire. The parcel count beneath each bar is the ensemble's agreement: a large
                 share carried by three parcels of thirty is a weaker claim than a smaller one
                 carried by twenty-eight.</p>`;
          }

          function renderFwd(d) {
            const tot = d.parcels.reduce((a, p) => a + p.w, 0);
            attr.innerHTML = `<h3>Forward from ${d.day}</h3>
              <p class="muted" style="font-size:12.5px">
                ${d.parcels.length} parcels released above the strongest fire cells, weighted by
                fire radiative power (${Math.round(tot).toLocaleString()} MW in view), integrated
                72 hours forward on the same engine that ran backwards a moment ago.</p>
              <p class="muted" style="font-size:12.5px;margin-bottom:0">
                Forward and backward sharing one integrator is exactly what the <b>transport-direction check</b>
                tests: if the two disagree about where the smoke came from, that is a bug, and the
                gate is how we would find out.</p>`;
          }

          const setDir = (d) => {
            state.dir = d;
            document.getElementById("dir-back").setAttribute("aria-pressed", String(d === "back"));
            document.getElementById("dir-fwd").setAttribute("aria-pressed", String(d === "fwd"));
            document.getElementById("hero-tag").textContent =
              d === "back" ? "2-D canvas · 72 h back-trajectories" : "2-D canvas · 72 h forward";
            draw();
          };
          document.getElementById("dir-back").onclick = () => setDir("back");
          document.getElementById("dir-fwd").onclick = () => setDir("fwd");
          recSel.onchange = () => { state.rec = recSel.value; fillEpisodes(); draw(); };
          epSel.onchange = () => { state.ep = epSel.value; draw(); };

          // hover a province
          map.canvas.addEventListener("pointermove", (e) => {
            if (!land) return;
            const [px, py] = map.pxOf(e);
            const i = land.featureAt(map.hit, px, py);
            land.geo && (land.paths, 0);
            if (i >= 0) {
              const f = land.geo.features[i].properties;
              tip.show(`<b>${f.adm1_name ?? "—"}</b><br><span class="r">${f.country ?? ""}</span>`,
                       e.clientX, e.clientY);
            } else tip.hide();
          });
          map.canvas.addEventListener("pointerleave", tip.hide);
          draw();
        }

        /* ── 01 · the mask, drawn ───────────────────────────────────────────────── */
        function maskMap(mask, geo, bbox) {
          const el = document.getElementById("mask-map");
          if (!mask) { el.insertAdjacentHTML("afterbegin", '<div class="empty" style="margin:24px">No mask exported.</div>'); return; }
          const map = CanvasMap(el, bbox,
            `The static exclusion mask: ${mask.n_core.toLocaleString()} persistent-source cells, `
            + "tracing Indonesia's volcanic arc plus the gas flares and landfills the hotspot "
            + "record otherwise reports as fires every day of the year.");
          if (geo) map.add(polyLayer(geo, { fill: C.surface, stroke: C.hair }));
          map.add({
            draw(ctx, X, Y) {
              ctx.fillStyle = C.fire;
              ctx.globalAlpha = 0.9;
              for (const [la, lo] of mask.cells) {
                ctx.fillRect(X(lo) - 1.4, Y(la) - 1.4, 2.8, 2.8);
              }
              ctx.globalAlpha = 1;
            },
          });
          map.redraw();
          el.insertAdjacentHTML("beforeend",
            `<div class="maplegend"><span><i style="background:var(--fire)"></i>${
              mask.n_core.toLocaleString()} persistent-source cells</span></div>`);
        }

        function removalComposition(fy) {
          const el = document.getElementById("removal-comp");
          if (!fy?.removed_composition) { el.className = "empty"; el.textContent = "No filter audit."; return; }
          const rows = Object.entries(fy.removed_composition).sort((a, b) => b[1] - a[1]);
          const tot = rows.reduce((a, r) => a + r[1], 0);
          const LABEL = {
            low_confidence: "Low confidence",
            static_mask: "Static mask (the NRT fix)",
            type_static: "type 2 · static land source",
            type_volcano: "type 1 · volcano",
            type_offshore: "type 3 · offshore",
          };
          el.className = "";
          el.innerHTML =
            `<div style="font-family:var(--font-data);font-size:12px;color:var(--ink-muted);margin-bottom:10px">
               ${tot.toLocaleString()} detections removed · ${(fy.removed_share * 100).toFixed(2)}% of the record</div>` +
            rows.map(([k, v]) => `
              <div style="margin-bottom:9px">
                <div style="display:flex;justify-content:space-between;font-family:var(--font-data);font-size:12px">
                  <span>${LABEL[k] ?? k}</span><span class="muted">${v.toLocaleString()}</span></div>
                <div style="height:7px;background:var(--surface-raised);border-radius:4px;overflow:hidden;margin-top:3px">
                  <div style="height:100%;width:${(v / rows[0][1]) * 100}%;background:${
                    k === "static_mask" ? C.accent : C.muted};border-radius:4px"></div></div></div>`).join("") +
            `<p class="muted" style="font-size:12px;margin:10px 0 0">
               Only <b>3.2 %</b> of VIIRS detections are high-confidence, so filtering to high
               confidence — a tempting-looking quality step — would discard 97 % of the signal.
               It is explicitly not done.</p>`;
        }

        function firesByYear(fy) {
          const host = document.getElementById("ch-year");
          if (!fy?.detections) { host.innerHTML = '<div class="empty">No yearly counts.</div>'; return; }
          const data = Object.entries(fy.detections)
            .map(([y, n]) => ({ y: +y, n, mb: fy.bulk_mb?.[y] ?? null }))
            .sort((a, b) => a.y - b.y);
          const W = 900, Hh = 260, m = { t: 14, r: 16, b: 34, l: 58 };
          const x = d3.scaleBand().domain(data.map((d) => d.y)).range([m.l, W - m.r]).padding(0.32);
          const y = d3.scaleLinear().domain([0, d3.max(data, (d) => d.n) * 1.08]).range([Hh - m.b, m.t]);
          const svg = d3.select(host).html("").append("svg")
            .attr("viewBox", `0 0 ${W} ${Hh}`).attr("role", "img")
            .attr("aria-label", "Retained VIIRS detections per year");
          svg.append("g").attr("class", "grid")
            .selectAll("line").data(y.ticks(4)).join("line")
            .attr("x1", m.l).attr("x2", W - m.r).attr("y1", y).attr("y2", y);
          svg.append("g").attr("class", "axis").attr("transform", `translate(0,${Hh - m.b})`)
            .call(d3.axisBottom(x).tickSizeOuter(0));
          svg.append("g").attr("class", "axis").attr("transform", `translate(${m.l},0)`)
            .call(d3.axisLeft(y).ticks(4).tickFormat(d3.format("~s")));
          svg.selectAll("rect.b").data(data).join("rect").attr("class", "b")
            .attr("x", (d) => x(d.y)).attr("width", x.bandwidth())
            .attr("y", (d) => y(d.n)).attr("height", (d) => Hh - m.b - y(d.n))
            .attr("rx", 4)
            .attr("fill", (d) => ([2015, 2019].includes(d.y) ? C.accent : C.ramp[1]))
            .on("pointermove", (e, d) => tip.show(
              `<b>${d.y}</b><br>${d.n.toLocaleString()} detections${
                d.mb ? `<br><span class="r">bulk CSV ${d.mb} MB</span>` : ""}`,
              e.clientX, e.clientY))
            .on("pointerleave", tip.hide);
          // direct labels on the two anchors — never a number on every bar
          svg.selectAll("text.lbl").data(data.filter((d) => [2015, 2019].includes(d.y)))
            .join("text").attr("class", "lbl")
            .attr("x", (d) => x(d.y) + x.bandwidth() / 2).attr("y", (d) => y(d.n) - 7)
            .attr("text-anchor", "middle").attr("fill", C.accent)
            .attr("font-family", "var(--font-data)").attr("font-size", 12)
            .text((d) => `${d.y} anchor`);
        }

        /* ── 02 · the risk surface ──────────────────────────────────────────────── */
        function riskMap(grid, days, geo, bbox) {
          const el = document.getElementById("risk-map");
          const list = (days?.risk_days ?? []).slice().sort((a, b) => a.day.localeCompare(b.day));
          if (!list.length) {
            el.insertAdjacentHTML("afterbegin", '<div class="empty" style="margin:24px">No risk surfaces exported.</div>');
            return;
          }
          const map = CanvasMap(el, bbox,
            "Ignition probability per 0.25 degree cell for the selected day and lead, with that "
            + "day's detections drawn on top. Hover any cell for its probability, province and "
            + "peat depth.");
          if (geo) map.add(polyLayer(geo, { fill: C.surface, stroke: C.hair }));
          let vals = null, fires = [], lead = "1", hoverIdx = -1;
          const half = grid.deg / 2;

          map.add({
            draw(ctx, X, Y, k) {
              if (!vals) return;
              const wpx = Math.max(2, (grid.deg * k) * Math.cos((((bbox[1] + bbox[3]) / 2) * Math.PI) / 180)) + 0.6;
              const hpx = Math.max(2, grid.deg * k) + 0.6;
              for (let i = 0; i < vals.length; i++) {
                const v = vals[i] / 255;
                if (v < 0.012) continue;
                const [la, lo] = grid.cells[i];
                ctx.fillStyle = rampScale(Math.min(1, v * 3.2));
                ctx.globalAlpha = 0.42 + 0.58 * Math.min(1, v * 3.2);
                ctx.fillRect(X(lo - half), Y(la + half), wpx, hpx);
              }
              ctx.globalAlpha = 1;
              ctx.fillStyle = C.fire;
              for (const [i, n] of fires) {
                const [la, lo] = grid.cells[i];
                ctx.beginPath();
                ctx.arc(X(lo), Y(la), Math.max(1.4, Math.min(4.5, Math.sqrt(n) * 0.55)), 0, 6.284);
                ctx.fill();
              }
              if (hoverIdx >= 0 && vals) {
                const [la, lo] = grid.cells[hoverIdx];
                ctx.strokeStyle = C.ink; ctx.lineWidth = 1.4;
                ctx.strokeRect(X(lo - half), Y(la + half), wpx, hpx);
              }
            },
          });

          const scrub = document.getElementById("day-scrub");
          const label = document.getElementById("day-label");
          scrub.max = String(list.length - 1);
          // default to the worst day in the record — the page should open on the story
          let idx = list.reduce((best, d, i) => (d.fires > list[best].fires ? i : best), 0);
          scrub.value = String(idx);

          async function show(i) {
            idx = i;
            const d = list[i];
            label.textContent = `${d.day}${d.anchor ? " · anchor year" : ""} · ${d.fires.toLocaleString()} detections`;
            try {
              const j = await load(`risk/${d.day}.json`);
              vals = j.leads[lead] ?? j.leads["1"];
              fires = j.fires ?? [];
            } catch { vals = null; fires = []; }
            map.redraw();
          }
          scrub.addEventListener("input", () => show(+scrub.value));
          document.querySelectorAll("[data-lead]").forEach((b) => {
            b.onclick = () => {
              lead = b.dataset.lead;
              document.querySelectorAll("[data-lead]").forEach((o) =>
                o.setAttribute("aria-pressed", String(o === b)));
              document.getElementById("risk-tag").textContent =
                `Ignition probability · ${lead}-day lead · 0.25°`;
              show(idx);
            };
          });
          map.canvas.addEventListener("pointermove", (e) => {
            if (!vals) return;
            const [px, py] = map.pxOf(e);
            let best = -1, bd = 1e9;
            for (let i = 0; i < grid.cells.length; i++) {
              const dx = map.X(grid.cells[i][1]) - px, dy = map.Y(grid.cells[i][0]) - py;
              const dd = dx * dx + dy * dy;
              if (dd < bd) { bd = dd; best = i; }
            }
            if (bd > 900) { hoverIdx = -1; tip.hide(); map.redraw(); return; }
            hoverIdx = best;
            const p = vals[best] / 255;
            tip.show(`<b>${(p * 100).toFixed(1)}% ignition probability</b><br>
              <span class="r">${grid.province[best] || "—"} · ${grid.cells[best][0].toFixed(2)}, ${grid.cells[best][1].toFixed(2)}<br>
              peat ${grid.peat_m[best].toFixed(2)} m · ${lead}-day lead</span>`, e.clientX, e.clientY);
            map.redraw();
          });
          map.canvas.addEventListener("pointerleave", () => { hoverIdx = -1; tip.hide(); map.redraw(); });

          document.getElementById("risk-legend").innerHTML =
            `<span style="display:flex;align-items:center;gap:4px">low` +
            C.ramp.map((c) => `<i style="background:${c};width:15px;margin:0"></i>`).join("") +
            `high</span>` +
            '<span><i style="background:var(--fire);border-radius:50%"></i>fire detected</span>';
          show(idx);
        }

        function shapFamilies(skill) {
          const el = document.getElementById("shap");
          const sh = skill?.shap?.share;
          if (!sh || !Object.keys(sh).length) {
            el.className = "empty"; el.textContent = "SHAP not computed yet."; return;
          }
          const rows = Object.entries(sh).sort((a, b) => b[1] - a[1]);
          const LAB = {
            dryness: "Dryness · rain deficit, SPI",
            atmosphere: "Atmosphere · VPD, RH, wind, BLH",
            soil: "Soil moisture",
            fuel: "Fuel · peat depth, land cover",
            fire_history: "Fire history · this cell + neighbours",
            season: "Season · day-of-year as sin/cos",
            ocean: "Ocean state · ENSO, SOI, IOD",
            foresight: "Lead-window weather (reanalysis path only)",
          };
          el.className = "";
          el.innerHTML = rows.map(([k, v]) => `
            <div style="margin-bottom:9px">
              <div style="display:flex;justify-content:space-between;font-family:var(--font-data);font-size:12px">
                <span>${LAB[k] ?? k}</span><span class="muted">${(v * 100).toFixed(0)}%</span></div>
              <div style="height:7px;background:var(--surface-raised);border-radius:4px;overflow:hidden;margin-top:3px">
                <div style="height:100%;width:${(v / rows[0][1]) * 100}%;background:${C.accent};border-radius:4px"></div>
              </div></div>`).join("");
        }

        function reliability(skill) {
          const host = document.getElementById("ch-reliability");
          const bins = skill?.leads?.["1"]?.forecast?.reliability ?? [];
          if (!bins.length) { host.innerHTML = '<div class="empty">Reliability not computed yet.</div>'; return; }
          const W = 900, Hh = 300, m = { t: 26, r: 24, b: 46, l: 92 };
          const hi = Math.max(d3.max(bins, (d) => d.p_mean), d3.max(bins, (d) => d.observed)) * 1.1;
          const x = d3.scaleLinear().domain([0, hi]).range([m.l, W - m.r]);
          const y = d3.scaleLinear().domain([0, hi]).range([Hh - m.b, m.t]);
          const svg = d3.select(host).html("").append("svg")
            .attr("viewBox", `0 0 ${W} ${Hh}`).attr("role", "img")
            .attr("aria-label", "Reliability diagram: predicted probability against observed frequency");
          svg.append("g").attr("class", "grid").selectAll("line").data(y.ticks(5)).join("line")
            .attr("x1", m.l).attr("x2", W - m.r).attr("y1", y).attr("y2", y);
          svg.append("line").attr("x1", x(0)).attr("y1", y(0)).attr("x2", x(hi)).attr("y2", y(hi))
            .attr("stroke", C.muted).attr("stroke-dasharray", "4 4").attr("stroke-width", 1.5);
          const lx = x(hi * 0.42), ly = y(hi * 0.42) + 22;
          svg.append("text").attr("x", lx).attr("y", ly)
            .attr("fill", C.muted).attr("font-family", "var(--font-data)").attr("font-size", 12)
            .attr("transform", `rotate(-36, ${lx}, ${ly})`)
            .text("perfect calibration");
          svg.append("g").attr("class", "axis").attr("transform", `translate(0,${Hh - m.b})`)
            .call(d3.axisBottom(x).ticks(6).tickFormat(d3.format(".1%")));
          svg.append("g").attr("class", "axis").attr("transform", `translate(${m.l},0)`)
            .call(d3.axisLeft(y).ticks(5).tickFormat(d3.format(".1%")));
          svg.append("text").attr("x", (m.l + W - m.r) / 2).attr("y", Hh - 6)
            .attr("text-anchor", "middle").attr("fill", C.muted)
            .attr("font-family", "var(--font-data)").attr("font-size", 12)
            .text("predicted probability");
          svg.append("text").attr("transform", "rotate(-90)").attr("x", -(Hh - m.b + m.t) / 2)
            .attr("y", 14).attr("text-anchor", "middle").attr("fill", C.muted)
            .attr("font-family", "var(--font-data)").attr("font-size", 12)
            .attr("dominant-baseline", "hanging")
            .text("observed frequency");
          svg.append("path").datum(bins).attr("fill", "none").attr("stroke", C.accent)
            .attr("stroke-width", 2).attr("stroke-linejoin", "round")
            .attr("d", d3.line().x((d) => x(d.p_mean)).y((d) => y(d.observed)));
          svg.selectAll("circle").data(bins).join("circle")
            .attr("cx", (d) => x(d.p_mean)).attr("cy", (d) => y(d.observed))
            .attr("r", 5).attr("fill", C.accent).attr("stroke", C.ground).attr("stroke-width", 2)
            .on("pointermove", (e, d) => tip.show(
              `<b>predicted ${(d.p_mean * 100).toFixed(2)}%</b><br>
               observed ${(d.observed * 100).toFixed(2)}%<br>
               <span class="r">${d.n.toLocaleString()} cell-days in this bin</span>`,
              e.clientX, e.clientY))
            .on("pointerleave", tip.hide);
        }

        /* ── 03 · skill ─────────────────────────────────────────────────────────── */
        function skillTable(skill) {
          const host = document.getElementById("skill-block");
          const leads = skill?.leads;
          if (!leads || !Object.keys(leads).length) {
            host.innerHTML = '<div class="empty">The risk model has not been scored yet.</div>'; return;
          }
          const fwi = skill.fwi ?? {};
          const fwiPer = fwi.per_lead ?? {};
          skill.folds = skill.folds ?? (skill.panel?.years?.length ?? null);
          const rows = Object.keys(leads).sort((a, b) => +a - +b).map((L) => {
            const f = leads[L].forecast ?? {}, r = leads[L].reanalysis ?? {};
            const w = fwiPer[L] ?? {};
            return { L, f, r, w };
          });
          host.innerHTML = `
            <div class="legend">
              <span style="color:${C.accent}"><i style="background:${C.accent}"></i>our model</span>
              <span style="color:${C.up}"><i style="background:${C.up}"></i>day-of-year climatology</span>
              <span style="color:${C.down}"><i style="background:${C.down}"></i>persistence</span>
              <span style="color:${C.official}"><i style="background:${C.official}"></i>CEMS Canadian FWI</span>
            </div>
            <div class="tscroll"><table><thead><tr>
              <th>Lead</th><th>Path</th><th class="n">AUC</th><th class="n">Brier</th>
              <th class="n">BSS vs climatology</th><th class="n">BSS vs persistence</th>
              <th class="n">BSS vs CEMS FWI</th><th class="n">Base rate</th></tr></thead>
              <tbody>${rows.map((d) => ["forecast", "reanalysis"].map((p, i) => {
                const m = d[p === "forecast" ? "f" : "r"];
                const bssF = p === "forecast" ? d.w.bss_vs_fwi : null;
                const ok = (v, t) => v == null ? '<span class="muted">—</span>'
                  : `<span style="color:${v > t ? C.official : C.alert}">${v >= 0 ? "+" : ""}${v.toFixed(3)}</span>`;
                return `<tr>
                  ${i === 0 ? `<td rowspan="2"><b>${d.L} d</b></td>` : ""}
                  <td>${p}</td>
                  <td class="n" style="color:${m.auc >= 0.8 ? C.official : C.alert}">${m.auc?.toFixed(3) ?? "—"}</td>
                  <td class="n">${m.brier != null ? m.brier.toExponential(2) : "—"}</td>
                  <td class="n">${ok(m.bss_vs_climatology, 0)}</td>
                  <td class="n">${ok(m.bss_vs_persistence, 0)}</td>
                  <td class="n">${p === "forecast" ? ok(bssF, 0) : '<span class="muted">n/a</span>'}</td>
                  <td class="n muted">${m.base_rate != null ? (m.base_rate * 100).toFixed(2) + "%" : "—"}</td>
                </tr>`;
              }).join("")).join("")}</tbody></table></div>
            ${fwi.status && fwi.status !== "ok"
              ? `<p class="muted" style="font-size:13px;margin-top:12px">
                   <b>The CEMS FWI half of the ignition-skill check is PENDING.</b> ${fwi.reason ?? ""}</p>`
              : `<p class="muted" style="font-size:13px;margin-top:12px">
                   <b>Both external baselines are calibrated before they are beaten.</b> The CEMS
                   FWI and the persistence rule ("it burned here in the last 7 days") are each
                   isotonically mapped to a probability on the same held-out season the model is,
                   so each is compared at its best. A raw index or a bare 0/1 rule scored as if it
                   were a probability collects an appalling Brier score and hands us a skill
                   number that means nothing.</p>`}
            ${skill.panel?.path_note ? `<p class="muted" style="font-size:13px">
               ${skill.panel.path_note}</p>` : ""}
            ${skill.fold_caveat || (skill.folds && skill.folds < 5)
              ? `<p class="muted" style="font-size:13px">
                   <b>${skill.folds ?? "—"} blocked-by-season folds.</b> The ERA5 record is bounded
                   by the Copernicus queue, not by the method, so these numbers carry more sampling
                   variance than the same numbers on a full fifteen-year record would. Re-running
                   the pipeline lengthens the record and this figure with it.</p>`
              : ""}`;
        }

        function foresightGap(skill) {
          const host = document.getElementById("ch-gap");
          const leads = skill?.leads;
          if (!leads) { host.innerHTML = '<div class="empty">Not scored yet.</div>'; return; }
          const data = Object.keys(leads).sort((a, b) => +a - +b).map((L) => ({
            L: +L,
            f: leads[L].forecast?.auc ?? null,
            r: leads[L].reanalysis?.auc ?? null,
          })).filter((d) => d.f != null && d.r != null);
          if (!data.length) { host.innerHTML = '<div class="empty">Not scored yet.</div>'; return; }
          const W = 900, Hh = 260, m = { t: 18, r: 120, b: 40, l: 58 };
          const x = d3.scalePoint().domain(data.map((d) => d.L)).range([m.l, W - m.r]).padding(0.6);
          const lo = Math.min(0.75, d3.min(data, (d) => Math.min(d.f, d.r)) - 0.03);
          const y = d3.scaleLinear().domain([lo, 1]).range([Hh - m.b, m.t]);
          const svg = d3.select(host).html("").append("svg")
            .attr("viewBox", `0 0 ${W} ${Hh}`).attr("role", "img")
            .attr("aria-label", "AUC by lead for the reanalysis and forecast paths");
          svg.append("g").attr("class", "grid").selectAll("line").data(y.ticks(5)).join("line")
            .attr("x1", m.l).attr("x2", W - m.r).attr("y1", y).attr("y2", y);
          svg.append("line").attr("x1", m.l).attr("x2", W - m.r)
            .attr("y1", y(0.8)).attr("y2", y(0.8))
            .attr("stroke", C.alert).attr("stroke-dasharray", "5 4").attr("stroke-width", 1.5);
          svg.append("text").attr("x", W - m.r + 6).attr("y", y(0.8) + 4)
            .attr("fill", C.alert).attr("font-family", "var(--font-data)").attr("font-size", 12)
            .text("threshold 0.80");
          svg.append("g").attr("class", "axis").attr("transform", `translate(0,${Hh - m.b})`)
            .call(d3.axisBottom(x).tickFormat((d) => `${d} day`));
          svg.append("g").attr("class", "axis").attr("transform", `translate(${m.l},0)`)
            .call(d3.axisLeft(y).ticks(5).tickFormat(d3.format(".2f")));
          // the gap itself, as a band — the thing the chapter is about
          svg.selectAll("line.gap").data(data).join("line").attr("class", "gap")
            .attr("x1", (d) => x(d.L)).attr("x2", (d) => x(d.L))
            .attr("y1", (d) => y(d.f)).attr("y2", (d) => y(d.r))
            .attr("stroke", C.hair).attr("stroke-width", 8).attr("stroke-linecap", "round");
          for (const [key, col, lab, dash] of [["r", C.up, "reanalysis path (perfect weather foresight)", null],
                                               ["f", C.accent, "forecast path (information at t only)", "5 4"]]) {
            svg.append("path").datum(data).attr("fill", "none").attr("stroke", col)
              .attr("stroke-width", 2).attr("stroke-dasharray", dash)
              .attr("d", d3.line().x((d) => x(d.L)).y((d) => y(d[key])));
            svg.selectAll(`circle.${key}`).data(data).join("circle").attr("class", key)
              .attr("cx", (d) => x(d.L)).attr("cy", (d) => y(d[key])).attr("r", 5)
              .attr("fill", col).attr("stroke", C.ground).attr("stroke-width", 2)
              .on("pointermove", (e, d) => tip.show(
                `<b>${lab.split(" (")[0]}</b><br>lead ${d.L} d · AUC ${d[key].toFixed(3)}`,
                e.clientX, e.clientY))
              .on("pointerleave", tip.hide);
            svg.append("text").attr("x", x(data[data.length - 1].L) + 10)
              .attr("y", y(data[data.length - 1][key]) + 4)
              .attr("fill", col).attr("font-family", "var(--font-data)").attr("font-size", 12)
              .text(key === "r" ? "reanalysis" : "forecast");
          }
        }

        /* ── 04 · the plume ─────────────────────────────────────────────────────── */
        function plumeBlock(stats, national) {
          const host = document.getElementById("plume-block");
          const t = stats?.transport_meta ?? {};
          const cmp = t.cams_comparison ?? {};
          const gj3 = stats?.gates?.["G-J3"] ?? {};
          let html = `<div class="tiles">
            <div class="tile"><div class="v">${t.gfas_height_share != null ? (t.gfas_height_share * 100).toFixed(0) + "%" : "—"}</div>
              <div class="k">Parcels released at a GFAS height</div>
              <div class="s">the rest use a parameterised plume rise, and the share is reported</div></div>
            <div class="tile"><div class="v">${t.parcels ? t.parcels.toLocaleString() : "—"}</div>
              <div class="k">Parcels integrated</div>
              <div class="s">${t.scheme ?? "Petterssen 2nd-order"} · ${t.hours ?? 72} h · ${t.dt_min ?? 60} min steps</div></div>
            <div class="tile ${gj3.pass === false ? "warn" : ""}"><div class="v">${
              gj3.share_within != null ? (gj3.share_within * 100).toFixed(0) + "%" : "—"}</div>
              <div class="k">Forward/backward bearing agreement</div>
              <div class="s">within ±30°, threshold 70% — transport-direction check</div></div>
            <div class="tile"><div class="v">${t.escaped_domain_share != null ? (t.escaped_domain_share * 100).toFixed(1) + "%" : "—"}</div>
              <div class="k">Parcels that left the domain</div>
              <div class="s">terminated and counted, never clamped to the boundary</div></div>
          </div>`;
          // G-J3's per-receptor breakdown is the diagnosis, not a footnote: it says WHERE the
          // integrator agrees with itself and where it does not, and the pattern is physical.
          const pr = gj3.per_receptor ?? {};
          if (Object.keys(pr).length) {
            const rows = Object.entries(pr).sort((a, b) => b[1].share_within - a[1].share_within);
            const best = rows[0], worst = rows[rows.length - 1];
            html += `<h3 style="margin-top:var(--space-4)">Where the two directions agree — and
              where they do not</h3>
              <p class="muted" style="font-size:14px">
                The transport-direction check runs the same integrator forwards from the fires and backwards from the
                receptor and asks whether they agree about where the smoke came from. Pooled, they
                agree on <b>${(gj3.share_within * 100).toFixed(1)} %</b> of episode days at a
                median difference of <b>${gj3.median_diff_deg?.toFixed(1)}°</b> — inside the ±30°
                tolerance, but below the 70 % share the gate demands, so <b style="color:${C.alert}">it
                ships red</b>. Broken out, the failure has a shape: agreement is highest at
                <b>${title(best[0])}</b> (${(best[1].share_within * 100).toFixed(0)} %,
                median ${best[1].median_diff_deg.toFixed(1)}°) and lowest at
                <b>${title(worst[0])}</b> (${(worst[1].share_within * 100).toFixed(0)} %,
                median ${worst[1].median_diff_deg.toFixed(1)}°). The receptors sitting in the fire
                belt agree; the ones the smoke has to travel furthest to reach do not. That is what
                a kinematic trajectory model is expected to do — error accumulates with path
                length and with curvature — and it is the honest bound on how far this method can
                be pushed.</p>
              <div class="tscroll"><table><thead><tr><th>Receptor</th>
                <th class="n">Episode days</th><th class="n">Within ±30°</th>
                <th class="n">Median difference</th></tr></thead><tbody>${
                rows.map(([k, v]) => `<tr><td>${title(k)}</td>
                  <td class="n">${v.n.toLocaleString()}</td>
                  <td class="n" style="color:${v.share_within >= 0.7 ? C.official : C.alert}">${
                    (v.share_within * 100).toFixed(1)}%</td>
                  <td class="n">${v.median_diff_deg.toFixed(1)}°</td></tr>`).join("")
              }</tbody></table></div>`;
          }
          if (cmp.status === "ok" && Object.keys(cmp.by_receptor ?? {}).length) {
            html += `<h3 style="margin-top:var(--space-4)">Beside a real chemistry-transport model</h3>
              <p class="muted" style="font-size:14px">
                Spearman correlation between our trajectory exposure and the CAMS PM2.5 forecast,
                <b>aligned by issue time and lead</b> — comparing our day-3 forecast against CAMS's
                analysis would flatter us by exactly the amount that makes the comparison
                worthless. This is published as agreement and divergence, not as a score we claim
                to win.</p>
              <div class="tscroll"><table><thead><tr><th>Receptor</th>${
                (cmp.by_receptor[Object.keys(cmp.by_receptor)[0]] ?? []).map((r) =>
                  `<th class="n">+${r.lead_h} h</th>`).join("")}</tr></thead><tbody>${
                Object.entries(cmp.by_receptor).map(([k, rows]) =>
                  `<tr><td>${title(k)}</td>${rows.map((r) =>
                    `<td class="n">${r.spearman?.toFixed(2) ?? "—"}</td>`).join("")}</tr>`).join("")
              }</tbody></table></div>`;
          } else {
            html += `<div class="empty" style="margin-top:var(--space-3)">
              The CAMS chemistry comparison is not available in this build${
                cmp.status ? ` (${cmp.status})` : ""}. It is a pluggable stage: when the CAMS
              forecast parts land, this table fills in without any other change.</div>`;
          }
          host.innerHTML = html;
        }

        /* ── 05 · receptors ─────────────────────────────────────────────────────── */
        function receptorPanels(receptors, stats) {
          const host = document.getElementById("receptors");
          const recs = receptors?.receptors;
          if (!recs) { host.innerHTML = '<div class="empty">No receptor series exported.</div>'; return; }
          const order = Object.entries(recs).sort((a, b) => a[1].tier - b[1].tier);
          host.innerHTML = `
            <div class="legend">
              <span style="color:${C.clean}"><i style="background:${C.clean}"></i>observed PM2.5 (µg/m³)</span>
              <span style="color:${C.accent}"><i class="dash" style="color:${C.accent}"></i>modelled exposure (index)</span>
            </div>
            <p class="muted" style="font-size:12.5px;margin-top:-6px">
              Two series, two mark styles and two direct labels — the observed/modelled pair sits
              at ΔE 7.7 under deuteranopia, which is legal only with secondary encoding, so it has
              some.
            </p>
            <div class="tscroll"><table><thead><tr>
              <th>Receptor</th><th>Tier</th><th>Comparison</th><th class="n">Spearman ρ</th>
              <th>Coverage</th></tr></thead><tbody>${
              order.map(([k, v]) => `<tr>
                <td><b>${title(k)}</b>${v.note ? `<br><span class="muted" style="font-size:12px">${v.note}</span>` : ""}</td>
                <td><span class="tier tier-${v.tier}">TIER ${v.tier} · ${v.kind?.startsWith("model") ? "MODEL" : "INSTRUMENT"}</span></td>
                <td class="muted">${v.comparison ?? (v.tier === 3 ? "model vs model" : "model vs instrument")}</td>
                <td class="n" style="color:${v.rho == null ? C.muted : v.rho >= 0.5 ? C.official : C.alert}">${
                  v.rho == null ? "—" : v.rho.toFixed(3)}</td>
                <td class="muted">${v.meta?.first ?? v.coverage ?? "—"}${v.meta?.last ? ` → ${v.meta.last}` : ""}</td>
              </tr>`).join("")}</tbody></table></div>
            <div id="rec-charts" style="margin-top:var(--space-4)"></div>
            <p class="muted" style="font-size:13px;margin-top:var(--space-3)">
              ${receptors.unmonitored_note ?? ""}
            </p>`;
          const chartHost = document.getElementById("rec-charts");
          for (const [k, v] of order) {
            if (!v.observed?.day?.length || !v.modelled?.day?.length) continue;
            const div = document.createElement("div");
            div.className = "chart";
            div.style.marginBottom = "var(--space-4)";
            div.innerHTML = `<h3>${title(k)} <span class="tier tier-${v.tier}">TIER ${v.tier}</span></h3>`;
            chartHost.appendChild(div);
            drawReceptor(div, k, v);
          }
        }

        function drawReceptor(host, key, v) {
          const obs = v.observed.day.map((d, i) => ({ d: new Date(d), y: v.observed.pm25[i] }))
            .filter((r) => r.y != null);
          const mod = v.modelled.day.map((d, i) => ({ d: new Date(d), y: v.modelled.exposure[i] }))
            .filter((r) => r.y != null);
          if (!obs.length || !mod.length) return;
          const lo = new Date(Math.max(d3.min(obs, (r) => r.d), d3.min(mod, (r) => r.d)));
          const hi = new Date(Math.min(d3.max(obs, (r) => r.d), d3.max(mod, (r) => r.d)));
          const O = obs.filter((r) => r.d >= lo && r.d <= hi);
          const M = mod.filter((r) => r.d >= lo && r.d <= hi);
          if (!O.length || !M.length) return;
          const W = 900, Hh = 220, m = { t: 14, r: 74, b: 32, l: 56 };
          const x = d3.scaleTime().domain([lo, hi]).range([m.l, W - m.r]);
          const y1 = d3.scaleLinear().domain([0, d3.max(O, (r) => r.y) * 1.1]).range([Hh - m.b, m.t]);
          // ONE axis is drawn.  The modelled series is normalised onto the observed scale and
          // labelled as an index, rather than shipping a dual-axis chart.
          const mmax = d3.max(M, (r) => r.y) || 1;
          const omax = d3.max(O, (r) => r.y) || 1;
          const y2 = (v2) => y1((v2 / mmax) * omax);
          const svg = d3.select(host).append("svg")
            .attr("viewBox", `0 0 ${W} ${Hh}`).attr("role", "img")
            .attr("aria-label", `${key}: observed PM2.5 against modelled smoke exposure`);
          svg.append("g").attr("class", "grid").selectAll("line").data(y1.ticks(4)).join("line")
            .attr("x1", m.l).attr("x2", W - m.r).attr("y1", y1).attr("y2", y1);
          svg.append("g").attr("class", "axis").attr("transform", `translate(0,${Hh - m.b})`)
            .call(d3.axisBottom(x).ticks(7));
          svg.append("g").attr("class", "axis").attr("transform", `translate(${m.l},0)`)
            .call(d3.axisLeft(y1).ticks(4));
          // A GAP IS A GAP, NOT A LINE.  Both records have holes — OpenAQ units go offline, and
          // the modelled series only exists on days with a steering field — and joining across
          // them draws a straight ramp that reads as data.  Any step over 5 days breaks the path.
          const GAP_DAYS = 5 * 864e5;
          const broken = (rows) => rows.map((r, i) => ({
            ...r, gap: i > 0 && r.d - rows[i - 1].d > GAP_DAYS,
          }));
          const Ob = broken(O), Mb = broken(M);
          svg.append("path").datum(Ob).attr("fill", "none").attr("stroke", C.clean)
            .attr("stroke-width", 2)
            .attr("d", d3.line().defined((r) => !r.gap).x((r) => x(r.d)).y((r) => y1(r.y)));
          svg.append("path").datum(Mb).attr("fill", "none").attr("stroke", C.accent)
            .attr("stroke-width", 2).attr("stroke-dasharray", "5 4")
            .attr("d", d3.line().defined((r) => !r.gap).x((r) => x(r.d)).y((r) => y2(r.y)));
          svg.append("text").attr("x", W - m.r + 6).attr("y", y1(O[O.length - 1].y) + 4)
            .attr("fill", C.clean).attr("font-family", "var(--font-data)").attr("font-size", 12)
            .text(v.tier === 3 ? "EAC4 (model)" : "observed");
          svg.append("text").attr("x", W - m.r + 6).attr("y", y2(M[M.length - 1].y) + 4)
            .attr("fill", C.accent).attr("font-family", "var(--font-data)").attr("font-size", 12)
            .text("modelled");
          const bis = d3.bisector((r) => r.d).left;
          const cross = svg.append("line").attr("y1", m.t).attr("y2", Hh - m.b)
            .attr("stroke", C.muted).attr("stroke-width", 1).style("opacity", 0);
          svg.append("rect").attr("x", m.l).attr("y", m.t).attr("width", W - m.r - m.l)
            .attr("height", Hh - m.b - m.t).attr("fill", "transparent")
            .on("pointermove", function (e) {
              const [px] = d3.pointer(e, this);
              const d0 = x.invert(px + m.l);
              const io = Math.min(O.length - 1, bis(O, d0));
              const im = Math.min(M.length - 1, bis(M, d0));
              cross.attr("x1", x(O[io].d)).attr("x2", x(O[io].d)).style("opacity", 1);
              tip.show(`<b>${O[io].d.toISOString().slice(0, 10)}</b><br>
                <span style="color:${C.clean}">●</span> ${
                  v.tier === 3 ? "EAC4 PM2.5 (model)" : "observed PM2.5"} ${O[io].y.toFixed(1)} µg/m³<br>
                <span style="color:${C.accent}">●</span> modelled exposure ${M[im].y.toFixed(2)}`,
                e.clientX, e.clientY);
            })
            .on("pointerleave", () => { cross.style("opacity", 0); tip.hide(); });
        }

        /* ── 06 · anchors ───────────────────────────────────────────────────────── */
        function anchorBlock(stats, national) {
          const host = document.getElementById("anchors");
          const g = stats?.gates?.["G-J5"];
          if (!g?.anchors) { host.innerHTML = '<div class="empty">The anchor replay has not run.</div>'; return; }
          const modelled = g.seasonal_series_modelled ?? {};
          const observed = g.seasonal_series_observed ?? {};
          const years = Object.keys(observed).map(Number).sort();
          let html = `<div class="tiles">${Object.entries(g.anchors).map(([y, a]) => `
            <div class="tile ${a.pass ? "" : "warn"}">
              <div class="v">${a.modelled_percentile != null ? (a.modelled_percentile * 100).toFixed(0) + "th" : "—"}</div>
              <div class="k">${y} · modelled severity percentile</div>
              <div class="s">${a.observed_detections.toLocaleString()} detections observed · never trained on</div>
            </div>`).join("")}</div>
            <p class="muted" style="font-size:13px">${g.anchors["2015"]?.reference ?? ""}</p>
            ${g.structural_note ? `<p class="muted" style="font-size:13px">
              <b style="color:${C.alert}">This gate ships red, and the shape of the failure is
              arithmetic before it is modelling.</b> ${g.structural_note}</p>` : ""}
            ${g.observed_reference ? `<p class="muted" style="font-size:13px">
              ${g.observed_reference}.</p>` : ""}`;
          host.innerHTML = html;
          if (!years.length) return;
          const div = document.createElement("div");
          div.className = "chart";
          host.appendChild(div);
          const W = 900, Hh = 280, m = { t: 16, r: 20, b: 38, l: 62 };
          const x = d3.scaleBand().domain(years).range([m.l, W - m.r]).padding(0.3);
          const y = d3.scaleLinear().domain([0, d3.max(years, (yy) => observed[yy]) * 1.1])
            .range([Hh - m.b, m.t]);
          const ym = d3.scaleLinear()
            .domain([0, d3.max(years, (yy) => modelled[yy] ?? 0) * 1.25 || 1])
            .range([Hh - m.b, m.t]);
          const svg = d3.select(div).append("svg").attr("viewBox", `0 0 ${W} ${Hh}`)
            .attr("role", "img").attr("aria-label", "Seasonal fire severity by year, observed and modelled");
          svg.append("g").attr("class", "grid").selectAll("line").data(y.ticks(4)).join("line")
            .attr("x1", m.l).attr("x2", W - m.r).attr("y1", y).attr("y2", y);
          svg.append("g").attr("class", "axis").attr("transform", `translate(0,${Hh - m.b})`)
            .call(d3.axisBottom(x).tickSizeOuter(0));
          svg.append("g").attr("class", "axis").attr("transform", `translate(${m.l},0)`)
            .call(d3.axisLeft(y).ticks(4).tickFormat(d3.format("~s")));
          svg.selectAll("rect").data(years).join("rect")
            .attr("x", (yy) => x(yy)).attr("width", x.bandwidth())
            .attr("y", (yy) => y(observed[yy])).attr("height", (yy) => Hh - m.b - y(observed[yy]))
            .attr("rx", 4)
            .attr("fill", (yy) => (g.anchors[yy] ? C.accent : C.ramp[1]))
            .on("pointermove", (e, yy) => tip.show(
              `<b>${yy} fire season</b><br>${observed[yy].toLocaleString()} detections observed<br>
               <span class="r">modelled mean risk ${(modelled[yy] ?? 0).toFixed(4)}</span>`,
              e.clientX, e.clientY))
            .on("pointerleave", tip.hide);
          // Only some seasons have a model — the ERA5 record is shorter than the FIRMS record —
          // and drawing a line across the missing ones would assert a value that does not exist.
          svg.append("path").datum(years)
            .attr("fill", "none").attr("stroke", C.up).attr("stroke-width", 2)
            .attr("d", d3.line().defined((yy) => modelled[yy] != null)
              .x((yy) => x(yy) + x.bandwidth() / 2).y((yy) => ym(modelled[yy] ?? 0)));
          svg.selectAll("circle.mk").data(years.filter((yy) => modelled[yy] != null))
            .join("circle").attr("class", "mk")
            .attr("cx", (yy) => x(yy) + x.bandwidth() / 2).attr("cy", (yy) => ym(modelled[yy]))
            .attr("r", 4).attr("fill", C.up).attr("stroke", C.ground).attr("stroke-width", 2);
          svg.append("text").attr("x", W - m.r).attr("y", m.t + 2).attr("text-anchor", "end")
            .attr("fill", C.up).attr("font-family", "var(--font-data)").attr("font-size", 12)
            .text(`modelled seasonal risk · ${
              years.filter((yy) => modelled[yy] != null).length} of ${years.length} seasons`);
        }

        /* ── explore ────────────────────────────────────────────────────────────── */
        function exploreTable(days) {
          const tb = document.querySelector("#episode-table tbody");
          const eps = days?.episodes ?? [];
          if (!eps.length) {
            tb.innerHTML = '<tr><td class="muted">No episodes exported yet.</td></tr>'; return;
          }
          let sort = "exp";
          function render() {
            const rows = eps.slice().sort((a, b) =>
              sort === "exp" ? (b.exposure ?? 0) - (a.exposure ?? 0) : b.day.localeCompare(a.day));
            tb.innerHTML = `<tr><th>Receptor</th><th>Day</th>
              <th class="n">Exposure (index)</th>
              <th>Top source province</th><th class="n">Share</th>
              <th class="n">Ensemble agreement</th></tr>` +
              rows.map((e) => `<tr>
                <td>${title(e.receptor)}${e.anchor ? ' <span class="anchor-tag">ANCHOR</span>' : ""}</td>
                <td>${e.day}</td>
                <td class="n">${(e.exposure ?? 0).toFixed(2)}</td>
                <td>${e.top_province ?? '<span class="muted">no attributable source</span>'}</td>
                <td class="n">${e.top_share != null ? (e.top_share * 100).toFixed(1) + "%" : "—"}</td>
                <td class="n">${e.top_agreement != null
                  ? (e.top_agreement * 100).toFixed(0) + "% of parcels" : "—"}</td>
              </tr>`).join("");
          }
          document.getElementById("sort-exp").onclick = () => {
            sort = "exp";
            document.getElementById("sort-exp").setAttribute("aria-pressed", "true");
            document.getElementById("sort-day").setAttribute("aria-pressed", "false");
            render();
          };
          document.getElementById("sort-day").onclick = () => {
            sort = "day";
            document.getElementById("sort-day").setAttribute("aria-pressed", "true");
            document.getElementById("sort-exp").setAttribute("aria-pressed", "false");
            render();
          };
          document.getElementById("dl").onclick = () => {
            const q = (v) => (v == null ? "" : /[",]/.test(String(v))
              ? `"${String(v).replace(/"/g, '""')}"` : String(v));
            const csv = "receptor,day,exposure,top_province,top_share,ensemble_agreement,anchor\n" +
              eps.map((e) => [e.receptor, e.day, e.exposure ?? "", q(e.top_province),
                              e.top_share ?? "", e.top_agreement ?? "", e.anchor].join(",")).join("\n");
            const a = document.createElement("a");
            a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
            a.download = "fire-haze-episodes.csv";
            a.click();
          };
          render();
        }

        /* ── gates + vintages ───────────────────────────────────────────────────── */
        function renderGates(stats) {
          const g = stats?.gates ?? {};
          document.querySelectorAll(".gate").forEach((el) => {
            const id = el.dataset.gate;
            const r = g[id];
            const badge = el.querySelector(".badge");
            const why = el.querySelector(".why");
            if (!r) { why.textContent = "Not evaluated in this build."; return; }
            const state = r.pass === true ? "ok" : r.pass === false ? "bad" : "na";
            el.className = `gate ${state}`;
            badge.className = `badge ${r.pass === true ? "pass" : r.pass === false ? "fail" : "pending"}`;
            badge.textContent = r.pass === true ? "PASS" : r.pass === false ? "FAIL"
              : (r.status ?? "PENDING").toUpperCase();
            const bits = [];
            if (id === "G-J1" && r.removed_share != null)
              bits.push(`removed ${(r.removed_share * 100).toFixed(2)}% overall, ${
                (r.nrt_removed_share * 100).toFixed(2)}% of the NRT tail; ${
                r.retained_inside_mask} retained inside the mask`);
            if (id === "G-J2" && r.per_lead?.["1"])
              bits.push(`lead 1 d forecast AUC ${r.per_lead["1"].forecast.auc?.toFixed(3) ?? "—"}, BSS vs climatology ${
                r.per_lead["1"].forecast.bss_vs_climatology?.toFixed(3) ?? "—"}`);
            if (id === "G-J3" && r.share_within != null)
              bits.push(`${(r.share_within * 100).toFixed(1)}% of ${r.episode_days} episode days within ±${
                r.threshold?.within_deg ?? 30}°, median ${r.median_diff_deg?.toFixed(1)}°`);
            if (id === "G-J4" && r.singapore_rho != null)
              bits.push(`Singapore ρ = ${r.singapore_rho.toFixed(3)} (tier 1, instrument)`);
            if (id === "G-J5" && r.anchors)
              bits.push(Object.entries(r.anchors).map(([y, a]) =>
                `${y} at the ${a.modelled_percentile != null
                  ? (a.modelled_percentile * 100).toFixed(0) + "th" : "—"} percentile`).join(", "));
            if (id === "G-J5" && r.structural_note) bits.push(r.structural_note);
            if (r.reason) bits.push(`<span style="color:${C.alert}">${r.reason}</span>`);
            why.innerHTML = bits.join(" · ");
          });
        }

        function vintageTable(stats) {
          const tb = document.querySelector("#vintage tbody");
          const man = stats?.manifest ?? {};
          const audit = stats?.fires_audit ?? {};
          const im = stats?.indices_meta ?? {};
          const cm = stats?.cams_meta ?? {};
          const gm = stats?.ground_meta ?? {};
          const rows = [
            ["FIRMS VIIRS SNPP", `SP ${audit.seam?.VIIRS_SNPP_SP?.join(" → ") ?? "—"}; NRT ${
              audit.seam?.VIIRS_SNPP_NRT?.join(" → ") ?? "—"}`],
            ["ERA5 single levels", (man.era5?.sl_years ?? []).join(", ") || "—"],
            ["ERA5 precipitation", (man.era5?.tp_years ?? []).join(", ") || "—"],
            ["ERA5 pressure levels", (man.era5?.pl_years ?? []).join(", ") || "—"],
            ["CHIRPS v3 monthly", `${im.chirps?.first ?? "—"} → ${im.chirps?.last ?? "—"} (${
              im.chirps?.base_period_years ?? "—"}-year SPI base)`],
            ["CEMS fire indices (EWDS)", im.fwi?.status === "complete" || im.fwi?.rows
              ? `${im.fwi.years ?? "—"} years, ${(im.fwi.rows ?? 0).toLocaleString()} cell-days`
              : `PENDING — ${im.fwi?.status ?? "not run"}`],
            ["CAMS GFAS injection heights", `ends ${cm.coverage_notes?.gfas_ends ?? "—"}`],
            ["CAMS EAC4", `ends ${cm.coverage_notes?.eac4_ends ?? "—"}`],
            ["Singapore NEA", `${gm.receptors?.singapore?.first ?? "—"} → ${
              gm.receptors?.singapore?.last ?? "—"}`],
          ];
          tb.innerHTML = `<tr><th>Source</th><th>Vintage</th></tr>` +
            rows.map(([k, v]) => `<tr><td>${k}</td><td class="muted">${v}</td></tr>`).join("");

          const lic = stats?.gates ? null : null;
          const licHost = document.getElementById("licences");
          const L = {
            "NASA FIRMS": "public domain / free and open",
            "Copernicus ERA5, CAMS, CEMS": "CC BY 4.0",
            "CHIRPS (UCSB/CHC)": "public-domain dedication",
            "ESA WorldCover v200": "CC BY 4.0",
            "PEATGRIDS (Widyastuti et al. 2025)": "CC BY 4.0 · 10.5281/zenodo.12559239",
            "Singapore NEA": "Singapore Open Data Licence v1.0 — commercial use explicitly permitted",
            "OpenAQ": "CC BY 4.0",
            "geoBoundaries": "CC BY 4.0",
            "OpenStreetMap (volcano nodes)": "ODbL",
            "NOAA CPC / PSL": "US Government public domain",
            "Long Paddock daily SOI": "CC BY 4.0 (State of Queensland)",
          };
          licHost.innerHTML = Object.entries(L).map(([k, v]) =>
            `<div style="padding:5px 0;border-bottom:1px solid var(--hairline)"><b>${k}</b> — ${v}</div>`).join("") +
            `<p style="margin-top:12px">Excluded on licence grounds and named rather than quietly
             dropped: AQICN (forbids commercial use — so Malaysia is a genuine hole and the
             transboundary claim here is Indonesia → Singapore only), SPEIbase (ODbL share-alike),
             the DLR Sentinel-5P aerosol product (a CC-BY vs CC-BY-NC conflict inside its own
             metadata), and KLHK land cover (no open licence).</p>`;
        }

        function title(s) {
          return String(s).replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
        }

        /* headline number in chapter 01 */
        const nrt = document.getElementById("m-nrt");
        if (firesYear?.nrt_removed_share != null)
          nrt.textContent = (firesYear.nrt_removed_share * 100).toFixed(1) + "%";

        /* TOC current-section highlight */
        const links = [...document.querySelectorAll("nav.toc a")];
        const obs = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            links.forEach((a) => a.removeAttribute("aria-current"));
            const a = links.find((l) => l.getAttribute("href") === "#" + e.target.id);
            a?.setAttribute("aria-current", "true");
          }
        }, { rootMargin: "-45% 0px -50% 0px" });
        document.querySelectorAll("section[id]").forEach((s) => obs.observe(s));
      })();
    </script>
  
    <script>
      /* A hover read-out must not outlive the hover. Each chart hides its own tooltip on
         mouseleave, but a hover can end without one ever firing: the window loses focus
         (an app switch, a screenshot), or the tab is hidden. Backstop only — it never
         second-guesses an active hover, it just closes read-outs once hovering has
         demonstrably ended. */
      (() => {
        const stale = () => [...document.querySelectorAll('[id*="tip" i],[id*="tool" i],[class*="tip" i]')]
          .filter((e) => !e.hidden && e.offsetWidth > 40 && getComputedStyle(e).position !== "static");
        const hide = () => stale().forEach((e) => { e.hidden = true; });
        addEventListener("blur", hide);
        document.addEventListener("visibilitychange", () => { if (document.hidden) hide(); });
      })();
    </script>
  
    <section class="colophon">
      <style>
        .colophon { max-width: var(--content-width, 72rem); margin: 0 auto;
          padding: 3rem 5vw 4rem; border-top: 1px solid var(--hairline, #2a2a2a);
          display: grid; gap: 1.6rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
        .colophon h3 { font-family: var(--font-data, monospace); font-size: 0.7rem;
          letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 0.6rem;
          color: var(--accent, #6fc7d6); }
        .colophon p { margin: 0 0 0.5rem; font-size: 0.86rem; line-height: 1.55;
          color: var(--ink-muted, #93a198); }
        .colophon b { color: var(--ink, #e8ede9); font-weight: 600; }
        .colophon .sm { font-size: 0.78rem; }
      </style>
      <div>
        <h3>Instrument</h3>
        <p>Method, models, evaluation and instrument · <b><a href="https://openstudy.id/people/#taufik-adi-nugraha" style="color:inherit">Taufik Adi Nugraha</a></b>
        <br /><span class="sm">ORCID <a href="https://orcid.org/0009-0006-0753-4496"
        style="color:inherit">0009-0006-0753-4496</a></span></p>
        <p class="sm">Estimator choice, model construction, baselines and validation design.
        Implementation was AI-assisted (Claude), under the builder's direction. Thresholds
        were fixed before any result was seen, and every gate is published with its outcome
        including the failures.</p>
      </div>
      <div>
        <h3>Domain interpretation · open</h3>
        <p>This instrument has no domain author yet. Someone who knows Indonesian fire management and peat hydrology. The ignition model clears both climatology and the Fire Weather Index, but the transport-direction and anchor-replay gates fail. What is missing is whether those failures matter operationally — what BNPB and KLHK actually act on, and whether 2015 and 2019 are the right blind test.</p>
