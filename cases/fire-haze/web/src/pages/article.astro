---
/* Review article — the case, stress-tested against the published literature.
 *
 * Every figure is built in frontmatter from data/article.json, which pipeline/article.py
 * derives from the case's own published stats.json and from pipeline/review.py — the
 * adversarial re-scoring. Nothing here is drawn by hand, so the prose cannot drift from the
 * numbers. SVG only: no WebGL, no canvas, anywhere on this page.
 */
import "../styles/tokens.css";
import A from "../data/article.json";

/* The case's validated chart palette, unchanged: model / climatology / persistence / CEMS FWI.
   --fire is never used for a series here either, so a hot dot still means "something burned". */
const MODEL = "#E2569E", CLIM = "#E0A63F", PERSIST = "#6B7CA6", FWI = "#4BB8A9";
const BLOCKED = "#F6C9DE", ALERT = "#E08B54", CLEAN = "#7FB2C9";
const INK = "#EFEAE6", MUTED = "#A79C93", GRID = "#2C2724";

const pct = (x: number, d = 1) => `${(x * 100).toFixed(d)}%`;
const sig = (x: number, d = 3) => x.toFixed(d);
const esc = (s: any) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;")
  .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const nf = (n: number) => n.toLocaleString("en-US");
const title = (s: string) => s.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

/* Published benchmarks, transcribed from the papers cited in §2 and the reference list.
   These are the only numbers on this page that do not come from the case's own data, and each
   one is a value read out of a named table or figure rather than a recollection. */
const LIT = {
  /* Mortelmans et al. (2025, IJWF 34, WF24057) Fig. 3 — ROC-AUC for fire occurrence over
     peninsular Malaysia, Sumatra and Borneo (7°S 95°E to 7.4°N 120°E), 2002–2018, 9 km. */
  mortelmans: { fwi_undrained: 0.79, fwi_drained: 0.75, dc_undrained: 0.83, dc_drained: 0.79,
                tau_days: 42, box: "7°S 95°E to 7.4°N 120°E" },
  /* Shmuel et al. (2025, npj Nat. Hazards 2:74) Supp. Table 1 — Indonesia, 0.25° daily
     ignition grid, but class-balanced by random undersampling and a random 20% holdout. */
  shmuel: { fwi_indonesia: 0.89, calibrated: 0.91, lightgbm: 0.96, n: 68025, global_fwi: 0.69 },
  /* Di Giuseppe et al. (2020, NHESS 20:2365) §3.2 — ECMWF operational FWI over equatorial Asia. */
  digiuseppe: { eqas_pod: 0.2 },
  /* Ploton et al. (2020, Nat. Commun. 11:4540) — random vs spatially blocked cross-validation. */
  ploton: { random_r2: 0.53, spatial_r2: 0.14 },
  /* Saito & Rehmsmeier (2015, PLoS ONE 10:e0118432) Table 5, dataset T2 (prevalence 0.0082). */
  saito: { rnamicro_roc: 0.886, rnamicro_prc: 0.054, mirfinder_roc: 0.772, mirfinder_prc: 0.106 },
  /* Stohl (1998, Atmos. Environ. 32:947) — error as a share of travel distance, from Stohl (1996a),
     one year of 96-hour back trajectories at 800 m AGL. */
  stohl: { h24: 0.16, h48: 0.26, h72: 0.36, typical: 0.20 },
  /* Hansen et al. (2019, ACP 19:5363) p.15 — NAME source attribution of Singapore PM10, ASO 2015,
     at two stations 25 km apart (NTU west, Temasek Poly east). */
  hansen: { s_sumatra: [0.3822, 0.2182], c_kalimantan: [0.3119, 0.4145],
            bangka: [0.1132, 0.1364], w_kalimantan: [0.0664, 0.0941], jambi: [0.0653, 0.0598],
            r_ntu: 0.35, r_tp: 0.32 },
  /* Crippa et al. (2016, Sci. Rep. 6:37074) — WRF-Chem at 10 km, full chemistry, Sep–Nov 2015. */
  crippa: { singapore_r_daily: 0.55, singapore_r_hourly: 0.45 },
  /* de Groot et al. (2007, Mitig. Adapt. Strateg. Glob. Change 12:165) Tables 1–2 — the
     Indonesian/Malaysian FDRS in operational use, unchanged, at METMalaysia and BMKG today. */
  degroot: { dc_extreme: 350, ffmc_extreme: 83, hotspots_above_ffmc78: 0.85 },
};

const L1 = A.rescore.per_lead["1"], L3 = A.rescore.per_lead["3"], L7 = A.rescore.per_lead["7"];
const P1 = A.published.per_lead["1"], P7 = A.published.per_lead["7"];
const S1 = A.spatial.per_lead["1"], S7 = A.spatial.per_lead["7"];
const FW1 = A.fwi.per_lead["1"], FW3 = A.fwi.per_lead["3"], FW7 = A.fwi.per_lead["7"];
const RB = A.fwi.reviewed_build;   // the CEMS record as the reviewed build had it
const TR = A.traj, SG = A.traj.singapore;
const cellsPerDay = Math.round(L1.scores.model.k1 / (L1.n / A.rescore.n_cells));

/* ── Figure 1 · the two metrics rank the baselines in opposite orders ──────────────── */
function fig1() {
  const W = 700, H = 292, T = 62, rowH = 62, xa = 232, xb = 470;
  const rows = [
    { k: "our model", col: MODEL, auc: L1.scores.model.auc, ap: L1.scores.model.ap },
    { k: "day-of-year climatology", col: CLIM, auc: L1.scores.climatology.auc, ap: L1.scores.climatology.ap },
    { k: "persistence (burned in 7 d)", col: PERSIST, auc: L1.scores.persistence.auc, ap: L1.scores.persistence.ap },
  ];
  const rankAuc = [...rows].sort((a, b) => b.auc - a.auc);
  const rankAp = [...rows].sort((a, b) => b.ap - a.ap);
  const yOf = (i: number) => T + i * rowH;
  const body = rows.map((r) => {
    const ia = rankAuc.indexOf(r), ib = rankAp.indexOf(r);
    const ya = yOf(ia), yb = yOf(ib);
    return `<path d="M${xa} ${ya} C${xa + 84} ${ya} ${xb - 84} ${yb} ${xb} ${yb}" fill="none"
        stroke="${r.col}" stroke-width="2.6" opacity="0.9"/>
      <circle cx="${xa}" cy="${ya}" r="5.5" fill="${r.col}"/>
      <circle cx="${xb}" cy="${yb}" r="5.5" fill="${r.col}"/>
      <text x="${xa - 14}" y="${ya - 3}" fill="${INK}" font-size="12.5" text-anchor="end">${esc(r.k)}</text>
      <text x="${xa - 14}" y="${ya + 13}" fill="${r.col}" font-size="11.5" text-anchor="end"
        font-family="var(--font-data)">AUC ${sig(r.auc)}</text>
      <text x="${xb + 14}" y="${yb - 3}" fill="${INK}" font-size="12.5">${esc(r.k)}</text>
      <text x="${xb + 14}" y="${yb + 13}" fill="${r.col}" font-size="11.5"
        font-family="var(--font-data)">AP ${sig(r.ap)}</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Ranked by AUC climatology beats persistence; ranked by average precision the order reverses">
    <text x="${xa}" y="30" fill="${MUTED}" font-size="12" text-anchor="middle"
      font-family="var(--font-data)" letter-spacing="0.06em">RANKED BY AUC</text>
    <text x="${xb}" y="30" fill="${MUTED}" font-size="12" text-anchor="middle"
      font-family="var(--font-data)" letter-spacing="0.06em">RANKED BY AVERAGE PRECISION</text>
    <line x1="${xa}" y1="40" x2="${xa}" y2="${T + 2 * rowH + 22}" stroke="${GRID}"/>
    <line x1="${xb}" y1="40" x2="${xb}" y2="${T + 2 * rowH + 22}" stroke="${GRID}"/>
    ${body}
    <text x="${W / 2}" y="${H - 10}" fill="${MUTED}" font-size="11.5" text-anchor="middle">1-day lead · ${nf(L1.n)} held-out cell-days · base rate ${pct(L1.base_rate, 2)}</text>
  </svg>`;
}

/* ── Figure 2 · what an alert budget actually buys ─────────────────────────────────── */
function fig2() {
  const W = 700, H = 296, L = 116, R = 152, T = 56;
  const bw = W - L - R, rowH = 66;
  const leads = [
    { L: 1, m: L1.scores.model, p: L1.scores.persistence },
    { L: 3, m: L3.scores.model, p: L3.scores.persistence },
    { L: 7, m: L7.scores.model, p: L7.scores.persistence },
  ];
  const body = leads.map((d, i) => {
    const y = T + i * rowH;
    const hit = d.m.p1 * bw;
    const px = L + d.p.p1 * bw;
    return `<text x="${L - 16}" y="${y + 17}" fill="${INK}" font-size="12.5" text-anchor="end">${d.L}-day lead</text>
      <rect x="${L}" y="${y}" width="${bw}" height="24" fill="${GRID}" rx="3"/>
      <rect x="${L}" y="${y}" width="${hit.toFixed(1)}" height="24" fill="${MODEL}" rx="3"/>
      <text x="${(L + 9).toFixed(1)}" y="${y + 17}" fill="#2A0A18" font-size="12"
        font-weight="600" font-family="var(--font-data)">${(d.m.p1 * 100).toFixed(0)} real</text>
      <text x="${(L + bw - 9).toFixed(1)}" y="${y + 17}" fill="${MUTED}" font-size="12"
        text-anchor="end" font-family="var(--font-data)">${(100 - d.m.p1 * 100).toFixed(0)} false alarms</text>
      <line x1="${px.toFixed(1)}" y1="${y - 6}" x2="${px.toFixed(1)}" y2="${y + 30}"
        stroke="#100D0C" stroke-width="4.5"/>
      <line x1="${px.toFixed(1)}" y1="${y - 6}" x2="${px.toFixed(1)}" y2="${y + 30}"
        stroke="${PERSIST}" stroke-width="2" stroke-dasharray="3 3"/>
      <text x="${(L + bw + 14).toFixed(1)}" y="${y + 11}" fill="${MODEL}" font-size="11.5"
        font-family="var(--font-data)">catches ${pct(d.m.r1, 1)}</text>
      <text x="${(L + bw + 14).toFixed(1)}" y="${y + 26}" fill="${MUTED}" font-size="11">of the season's fires</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Out of 100 alerts at a one percent budget, the model is right 53 times at one day and 37 at seven">
    <text x="${L}" y="24" fill="${INK}" font-size="12.5">Out of 100 alerts, at an alert budget of 1% of cell-days</text>
    <text x="${L}" y="41" fill="${MUTED}" font-size="11.5">≈ ${cellsPerDay} of ${nf(A.rescore.n_cells)} land cells a day</text>
    ${body}
    <line x1="${L}" y1="${H - 34}" x2="${L + 22}" y2="${H - 34}" stroke="${PERSIST}"
      stroke-width="2" stroke-dasharray="3 3"/>
    <text x="${L + 30}" y="${H - 30}" fill="${MUTED}" font-size="11.5">dashed: the same budget spent on "it burned here in the last 7 days"</text>
  </svg>`;
}

/* ── Figure 3 · where the skill lives once the easy variation is removed ───────────── */
function fig3() {
  const W = 700, H = 300, L = 214, R = 74, T = 52;
  const x0 = 0.6, x1 = 0.9;
  const sx = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
  const rows = [
    { k: "The published ROC", s: "every cell-day against every other", d: L1.scores },
    { k: "Within one day", s: "given a day, does it find the right cells?", d: null, key: "day" },
    { k: "Within one cell", s: "given a cell, does it find the right days?", d: null, key: "cell" },
  ];
  const series = [
    { k: "model", col: MODEL }, { k: "climatology", col: CLIM }, { k: "persistence", col: PERSIST },
  ];
  const rowH = 62;
  const body = rows.map((r, i) => {
    const y = T + i * rowH;
    const dots = series.map((s) => {
      const v = r.d ? (r.d as any)[s.k].auc : (L1.decomposition as any)[s.k][(r as any).key];
      return `<circle cx="${sx(v).toFixed(1)}" cy="${y}" r="6" fill="${s.col}"
        data-t="${esc(s.k)} · AUC ${sig(v)}"/>`;
    }).join("");
    return `<text x="${L - 16}" y="${y - 2}" fill="${INK}" font-size="12.5" text-anchor="end">${esc(r.k)}</text>
      <text x="${L - 16}" y="${y + 14}" fill="${MUTED}" font-size="10.5" text-anchor="end">${esc(r.s)}</text>
      <line x1="${L}" y1="${y}" x2="${W - R}" y2="${y}" stroke="${GRID}"/>${dots}`;
  }).join("");
  const cy = T + 3 * rowH;
  const cr = A.rescore.per_lead["1"].cell_rate_only;
  const ticks = [0.6, 0.7, 0.8, 0.9].map((v) =>
    `<line x1="${sx(v).toFixed(1)}" y1="${T - 22}" x2="${sx(v).toFixed(1)}" y2="${cy + 10}"
       stroke="${GRID}" opacity="0.6"/>
     <text x="${sx(v).toFixed(1)}" y="${T - 28}" fill="${MUTED}" font-size="10.5" text-anchor="middle"
       font-family="var(--font-data)">${v.toFixed(2)}</text>`).join("");
  const leg = series.map((s, i) =>
    `<circle cx="${L + i * 118 + 6}" cy="${H - 20}" r="5" fill="${s.col}"/>
     <text x="${L + i * 118 + 18}" y="${H - 16}" fill="${MUTED}" font-size="11.5">${esc(s.k)}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="AUC falls only modestly when the between-day or between-cell variation is removed">
    <text x="${W - R}" y="${T - 44}" fill="${MUTED}" font-size="11" text-anchor="end"
      font-family="var(--font-data)" letter-spacing="0.06em">AUC · 1-DAY LEAD</text>
    ${ticks}${body}
    <text x="${L - 16}" y="${cy - 2}" fill="${ALERT}" font-size="12.5" text-anchor="end">Cell fire-rate only</text>
    <text x="${L - 16}" y="${cy + 14}" fill="${MUTED}" font-size="10.5" text-anchor="end">a constant map, using no weather at all</text>
    <line x1="${L}" y1="${cy}" x2="${W - R}" y2="${cy}" stroke="${GRID}"/>
    <circle cx="${sx(cr.auc).toFixed(1)}" cy="${cy}" r="6" fill="none" stroke="${ALERT}" stroke-width="2"/>
    <text x="${(sx(cr.auc) + 12).toFixed(1)}" y="${cy + 4}" fill="${ALERT}" font-size="11"
      font-family="var(--font-data)">${sig(cr.auc)}</text>
    ${leg}
  </svg>`;
}

/* ── Figure 4 · the decisive test: refit so no test cell was ever seen ─────────────── */
function fig4() {
  const W = 700, H = 348, L = 178, R = 96, T = 96;
  const x0 = 0.76, x1 = 0.91;
  const sx = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
  const groups = [{ lab: "1-day lead", pub: P1.auc, pubAp: L1.scores.model.ap, s: S1 },
                  { lab: "7-day lead", pub: P7.auc, pubAp: L7.scores.model.ap, s: S7 }];
  const gH = 118;
  const body = groups.map((g, i) => {
    const y = T + i * gH;
    const blocks = Object.entries(g.s.per_block).map(([k, b]: any) =>
      `<circle cx="${sx(b.auc).toFixed(1)}" cy="${y + 42}" r="4" fill="none"
         stroke="${BLOCKED}" stroke-width="1.5" data-t="spatial fold ${esc(k)} · AUC ${sig(b.auc)} · ${nf(b.n)} cell-days"/>`).join("");
    return `<text x="${L - 16}" y="${y - 4}" fill="${INK}" font-size="13" text-anchor="end">${esc(g.lab)}</text>
      <text x="${L - 16}" y="${y + 14}" fill="${MODEL}" font-size="10.5" text-anchor="end"
        font-family="var(--font-data)">published ${sig(g.pub, 4)}</text>
      <text x="${L - 16}" y="${y + 29}" fill="${BLOCKED}" font-size="10.5" text-anchor="end"
        font-family="var(--font-data)">blocked ${sig(g.s.auc, 4)}</text>
      <text x="${L - 16}" y="${y + 46}" fill="${MUTED}" font-size="10.5" text-anchor="end">the four spatial folds</text>
      <line x1="${sx(g.s.auc).toFixed(1)}" y1="${y}" x2="${sx(g.pub).toFixed(1)}" y2="${y}"
        stroke="${MUTED}" stroke-width="2.4" opacity="0.5"/>
      <circle cx="${sx(g.pub).toFixed(1)}" cy="${y}" r="7" fill="${MODEL}"
        data-t="published, seasons blocked · AUC ${sig(g.pub, 4)} · AP ${sig(g.pubAp)}"/>
      <circle cx="${sx(g.s.auc).toFixed(1)}" cy="${y}" r="7" fill="${BLOCKED}"
        data-t="refit, seasons and space blocked · AUC ${sig(g.s.auc, 4)} · AP ${sig(g.s.ap)}"/>
      ${blocks}
      <text x="${W - R + 12}" y="${y + 4}" fill="${INK}" font-size="12"
        font-family="var(--font-data)">Δ ${g.s.delta_auc.toFixed(4)}</text>
      <text x="${W - R + 12}" y="${y + 21}" fill="${MUTED}" font-size="10.5"
        font-family="var(--font-data)">AP ${sig(g.s.ap)}</text>
      <text x="${W - R + 12}" y="${y + 35}" fill="${MUTED}" font-size="10.5"
        font-family="var(--font-data)">vs ${sig(g.pubAp)}</text>`;
  }).join("");
  const ticks = [0.78, 0.82, 0.86, 0.90].map((v) =>
    `<line x1="${sx(v).toFixed(1)}" y1="${T - 34}" x2="${sx(v).toFixed(1)}" y2="${H - 46}"
       stroke="${GRID}" opacity="0.55"/>
     <text x="${sx(v).toFixed(1)}" y="${H - 30}" fill="${MUTED}" font-size="10.5"
       text-anchor="middle" font-family="var(--font-data)">${v.toFixed(2)}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Blocking the split in space as well as season costs the model less than one AUC point">
    ${ticks}${body}
    <g><circle cx="20" cy="24" r="6" fill="${MODEL}"/>
      <text x="32" y="28" fill="${MUTED}" font-size="11.5">published · seasons blocked</text>
      <circle cx="20" cy="48" r="6" fill="${BLOCKED}"/>
      <text x="32" y="52" fill="${MUTED}" font-size="11.5">refit · seasons and space blocked, so no test cell was ever seen</text>
      <circle cx="20" cy="72" r="4" fill="none" stroke="${BLOCKED}" stroke-width="1.5"/>
      <text x="32" y="76" fill="${MUTED}" font-size="11.5">each spatial fold, scored separately</text></g>
    <text x="${(L + W - R) / 2}" y="${H - 10}" fill="${MUTED}" font-size="11.5" text-anchor="middle">AUC on the identical ${nf(S1.n)} held-out cell-days</text>
  </svg>`;
}

/* ── Figure 5 · the FWI record has a hole exactly where the test is ────────────────── */
function fig5() {
  const years: number[] = [];
  for (let y = 2012; y <= 2026; y++) years.push(y);
  const W = 700, H = 250, L = 168, T = 58, cw = (W - L - 22) / years.length, ch = 26;
  const have = new Set(A.fwi.years_on_disk);
  const recovered = new Set(A.fwi.reviewed_build.years_recovered);
  const folds = new Set(A.fwi.oof_folds);
  const anchors = new Set(A.published.anchors);
  const rows = [
    { k: "CEMS FWI on disk", test: (y: number) => have.has(y), col: FWI, mark: true },
    { k: "held-out model season", test: (y: number) => folds.has(y), col: MODEL, mark: true },
    { k: "anchor season (never trained)", test: (y: number) => anchors.has(y), col: CLEAN, mark: true },
  ];
  const head = years.map((y, i) =>
    `<text x="${(L + i * cw + cw / 2).toFixed(1)}" y="${T - 10}" fill="${MUTED}" font-size="10"
       text-anchor="middle" font-family="var(--font-data)"
       transform="rotate(-52 ${(L + i * cw + cw / 2).toFixed(1)} ${T - 10})">${y}</text>`).join("");
  const body = rows.map((r, ri) => {
    const y = T + ri * (ch + 12);
    const cells = years.map((yr, i) => {
      const on = r.test(yr);
      const gap = on && recovered.has(yr);
      return `<rect x="${(L + i * cw + 2).toFixed(1)}" y="${y}" width="${(cw - 4).toFixed(1)}"
        height="${ch}" rx="2" fill="${on ? r.col : "#221E1B"}" opacity="${on ? 0.92 : 1}"
        ${gap ? `stroke="${ALERT}" stroke-width="2"` : ""}/>`;
    }).join("");
    return `<text x="${L - 14}" y="${y + 17}" fill="${INK}" font-size="12" text-anchor="end">${esc(r.k)}</text>${cells}`;
  }).join("");
  const i17 = years.indexOf(2017), i15 = years.indexOf(2015);
  const x17 = L + i17 * cw + cw / 2, x15 = L + i15 * cw + cw / 2;
  const yBase = T + 3 * (ch + 12);
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="CEMS FWI is missing for 2017, a held-out season, and for the 2015 anchor">
    <text x="${L - 14}" y="24" fill="${MUTED}" font-size="11.5" text-anchor="end">coverage</text>
    ${head}${body}
    <path d="M${x17.toFixed(1)} ${yBase} L${x17.toFixed(1)} ${yBase + 18} L${(x17 + 8).toFixed(1)} ${yBase + 18}"
      fill="none" stroke="${ALERT}" stroke-width="1.4"/>
    <path d="M${x15.toFixed(1)} ${yBase} L${x15.toFixed(1)} ${yBase + 36} L${(x15 + 8).toFixed(1)} ${yBase + 36}"
      fill="none" stroke="${ALERT}" stroke-width="1.4"/>
    <text x="${(x17 + 14).toFixed(1)}" y="${yBase + 22}" fill="${ALERT}" font-size="11"
      font-family="var(--font-data)">2017 · a held-out season, recovered</text>
    <text x="${(x15 + 14).toFixed(1)}" y="${yBase + 40}" fill="${ALERT}" font-size="11"
      font-family="var(--font-data)">2015 · the anchor, recovered</text>
  </svg>`;
}

/* ── Figure 6 · the composite index is not the best member of its own family ───────── */
function fig6() {
  const comp = FW1.components;
  const entries = Object.entries(comp).map(([k, v]: any) => ({ k, auc: v.auc }))
    .sort((a, b) => b.auc - a.auc);
  const rows = [
    { k: "our model", auc: FW1.like_for_like.model_auc, col: MODEL },
    ...entries.map((e) => ({ k: e.k.toUpperCase(), auc: e.auc, col: e.k === "fwi" ? FWI : PERSIST })),
  ];
  const W = 700, H = 110 + rows.length * 27 + 96, L = 118, R = 92, T = 96;
  const x0 = 0.6, bw = W - L - R;
  const sx = (v: number) => ((v - x0) / (0.92 - x0)) * bw;
  const body = rows.map((r, i) => {
    const y = T + i * 27;
    return `<text x="${L - 12}" y="${y + 14}" fill="${INK}" font-size="12" text-anchor="end">${esc(r.k)}</text>
      <rect x="${L}" y="${y + 2}" width="${sx(r.auc).toFixed(1)}" height="17" rx="2" fill="${r.col}"
        opacity="${r.k === "FWI" || r.k === "our model" ? 1 : 0.55}"/>
      <text x="${(L + sx(r.auc) + 9).toFixed(1)}" y="${y + 15}" fill="${r.col}" font-size="11"
        font-family="var(--font-data)">${sig(r.auc)}</text>`;
  }).join("");
  const yB = T + rows.length * 27 + 44;
  const deltas = [["1 day", FW1], ["3 days", FW3], ["7 days", FW7]].map(([lab, d]: any, i) => {
    const dv = d.components.bui.auc - d.components.fwi.auc;
    return `<text x="${L + i * 176}" y="${yB + 16}" fill="${MUTED}" font-size="11">${esc(lab)}</text>
      <text x="${L + i * 176}" y="${yB + 33}" fill="${ALERT}" font-size="12.5"
        font-family="var(--font-data)">BUI +${dv.toFixed(4)}</text>`;
  }).join("");
  // the published band for the same index over very nearly the same box
  const ml = L + sx(LIT.mortelmans.fwi_drained), mh = L + sx(LIT.mortelmans.fwi_undrained);
  const dl = L + sx(LIT.mortelmans.dc_drained), dh = L + sx(LIT.mortelmans.dc_undrained);
  const yBot = T + rows.length * 27 + 6;
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="The Build-Up Index outscores the composite Fire Weather Index at every lead, and our FWI value sits inside the published band for the same box">
    <text x="${L - 12}" y="26" fill="${MUTED}" font-size="11.5" text-anchor="end">1-day lead</text>
    <text x="${L}" y="26" fill="${MUTED}" font-size="11.5">AUC on the ${nf(FW1.like_for_like.n)} held-out cell-days that carry a CEMS value</text>
    <rect x="${ml.toFixed(1)}" y="${T - 12}" width="${(mh - ml).toFixed(1)}" height="${(rows.length * 27 + 16).toFixed(1)}"
      fill="${FWI}" opacity="0.12"/>
    <rect x="${dl.toFixed(1)}" y="${T - 12}" width="${(dh - dl).toFixed(1)}" height="${(rows.length * 27 + 16).toFixed(1)}"
      fill="${CLEAN}" opacity="0.1"/>
    <line x1="${((ml + mh) / 2).toFixed(1)}" y1="${T - 30}" x2="${((ml + mh) / 2).toFixed(1)}"
      y2="${T - 14}" stroke="${FWI}" stroke-width="1"/>
    <text x="${((ml + mh) / 2).toFixed(1)}" y="${T - 36}" fill="${FWI}" font-size="10" text-anchor="middle"
      font-family="var(--font-data)">FWI, published</text>
    <line x1="${((dl + dh) / 2).toFixed(1)}" y1="${T - 48}" x2="${((dl + dh) / 2).toFixed(1)}"
      y2="${T - 14}" stroke="${CLEAN}" stroke-width="1"/>
    <text x="${((dl + dh) / 2).toFixed(1)}" y="${T - 54}" fill="${CLEAN}" font-size="10" text-anchor="middle"
      font-family="var(--font-data)">Drought Code, published</text>
    ${body}
    <text x="${L}" y="${yBot + 16}" fill="${MUTED}" font-size="10.5">shaded: Mortelmans et al. (2025) over ${esc(LIT.mortelmans.box)} — drained to undrained peat</text>
    <line x1="${L}" y1="${yB - 6}" x2="${W - R}" y2="${yB - 6}" stroke="${GRID}"/>
    <text x="${L - 12}" y="${yB + 26}" fill="${INK}" font-size="12" text-anchor="end">BUI over FWI</text>
    ${deltas}
  </svg>`;
}

/* ── Figure 7 · the ensemble that carries a 72-hour attribution ────────────────────── */
function fig7() {
  const W = 700, H = 362, L = 58, R = 74, T = 30, B = 96;
  const e = TR.ensemble;
  const x0 = 0, x1 = 72, y1 = 500;
  const sx = (v: number) => L + (v / x1) * (W - L - R);
  const sy = (v: number) => H - B - (v / y1) * (H - T - B);
  const sr = (v: number) => H - B - v * (H - T - B);
  const path = (key: "med" | "p90", col: string, w: number, dash = "") =>
    `<path fill="none" stroke="${col}" stroke-width="${w}" ${dash} d="${e.map((r: any, i: number) =>
      `${i ? "L" : "M"}${sx(r.h).toFixed(1)} ${sy(r[key]).toFixed(1)}`).join(" ")}"/>`;
  const surv = `<path fill="none" stroke="${PERSIST}" stroke-width="2.2" stroke-dasharray="5 4"
    d="${e.map((r: any, i: number) => `${i ? "L" : "M"}${sx(r.h).toFixed(1)} ${sr(r.surv).toFixed(1)}`).join(" ")}"/>`;
  const dots = e.map((r: any) =>
    `<circle class="hv" cx="${sx(r.h).toFixed(1)}" cy="${sy(r.med).toFixed(1)}" r="4.5" fill="${MODEL}"
       data-t="${r.h} h upwind · ensemble half-width ${r.med.toFixed(0)} km (p90 ${r.p90.toFixed(0)} km) · ${(r.surv * 100).toFixed(0)}% of parcels still inside the domain"/>`).join("");
  const gl = [0, 125, 250, 375, 500].map((v) =>
    `<line x1="${L}" y1="${sy(v).toFixed(1)}" x2="${W - R}" y2="${sy(v).toFixed(1)}" stroke="${GRID}" opacity="0.55"/>
     <text x="${L - 9}" y="${(sy(v) + 4).toFixed(1)}" fill="${MUTED}" font-size="10.5" text-anchor="end"
       font-family="var(--font-data)">${v}</text>`).join("");
  const xt = [6, 24, 48, 72].map((v) =>
    `<text x="${sx(v).toFixed(1)}" y="${H - B + 19}" fill="${MUTED}" font-size="10.5"
       text-anchor="middle" font-family="var(--font-data)">${v} h</text>`).join("");
  const rk = sy(TR.receptor_km);
  const last = e[e.length - 1], first = e[0];
  const legY = H - 34;
  const leg = [
    { c: MODEL, w: 2.6, d: "", k: "median half-width" },
