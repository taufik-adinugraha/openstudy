    ${path("p90", BLOCKED, 1.8, 'stroke-dasharray="2 3"')}${path("med", MODEL, 2.6)}${surv}${dots}
    <text x="${(sx(first.h) + 8).toFixed(1)}" y="${(sr(first.surv) + 16).toFixed(1)}" fill="${PERSIST}"
