/* ── Figure 8 · where Singapore's air came from, over every episode in the archive ─── */
function fig8() {
  const rows = SG.provinces;
  const MY = new Set(["Johor", "Pahang", "Selangor", "Malacca", "Negeri Sembilan", "Perak",
    "Kelantan", "Terengganu", "Kedah", "Penang", "Perlis", "Sarawak", "Sabah"]);
  const W = 700, L = 194, R = 84, T = 44, rowH = 30;
  const H = T + rows.length * rowH + 54;
  const bw = W - L - R;
  const max = Math.max(...rows.map((r: any) => r.share));
  const body = rows.map((r: any, i: number) => {
    const y = T + i * rowH;
    const my = MY.has(r.p);
    const w = (r.share / max) * bw;
    return `<text x="${L - 12}" y="${y + 15}" fill="${INK}" font-size="12" text-anchor="end">${esc(r.p)}</text>
      <rect x="${L}" y="${y + 2}" width="${w.toFixed(1)}" height="18" rx="2"
        fill="${my ? PERSIST : MODEL}"/>
      <text x="${(L + w + 9).toFixed(1)}" y="${y + 16}" fill="${my ? PERSIST : MODEL}" font-size="11"
        font-family="var(--font-data)">${pct(r.share)} · ${r.days} d</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Over 1284 Singapore episode days the most frequent upwind province is Johor in Malaysia">
    <text x="${L - 12}" y="26" fill="${MUTED}" font-size="11.5" text-anchor="end">share of episode days</text>
    <rect x="${L}" y="18" width="11" height="11" rx="2" fill="${MODEL}"/>
    <text x="${L + 18}" y="28" fill="${MUTED}" font-size="11.5">Indonesia</text>
    <rect x="${L + 104}" y="18" width="11" height="11" rx="2" fill="${PERSIST}"/>
    <text x="${L + 122}" y="28" fill="${MUTED}" font-size="11.5">Malaysia</text>
    ${body}
    <text x="${L}" y="${H - 18}" fill="${MUTED}" font-size="11">${SG.distinct_top_provinces} different provinces take first place at some point across ${nf(SG.episode_days)} episode days</text>
  </svg>`;
}

/* ── Figure 9 · direction error, and the tail the median hides ─────────────────────── */
function fig9() {
  const per = TR.bearing.per_receptor;
  const rows = Object.entries(per).map(([k, v]: any) => ({ k, ...v }))
    .sort((a, b) => b.within_30 - a.within_30);
  const W = 700, L = 132, R = 118, T = 52, rowH = 33;
  const H = T + rows.length * rowH + 52;
  const x1 = 130;
  const sx = (v: number) => L + (v / x1) * (W - L - R);
  const body = rows.map((r, i) => {
    const y = T + i * rowH;
    return `<text x="${L - 12}" y="${y + 5}" fill="${INK}" font-size="12" text-anchor="end">${esc(title(r.k))}</text>
      <line x1="${sx(r.median).toFixed(1)}" y1="${y}" x2="${sx(r.p90).toFixed(1)}" y2="${y}"
        stroke="${ALERT}" stroke-width="2" opacity="0.45"/>
      <circle cx="${sx(r.median).toFixed(1)}" cy="${y}" r="5" fill="${MODEL}"
        data-t="${esc(title(r.k))} · median ${r.median.toFixed(1)}°"/>
      <circle cx="${sx(r.p90).toFixed(1)}" cy="${y}" r="5" fill="${ALERT}"
        data-t="${esc(title(r.k))} · p90 ${r.p90.toFixed(1)}° on ${nf(r.n)} days"/>
      <text x="${W - R + 14}" y="${y + 4}" fill="${r.within_30 >= 0.7 ? FWI : ALERT}" font-size="11.5"
        font-family="var(--font-data)">${pct(r.within_30)}</text>`;
  }).join("");
  const t30 = sx(30);
  const xt = [0, 30, 60, 90, 120].map((v) =>
    `<text x="${sx(v).toFixed(1)}" y="${H - 30}" fill="${MUTED}" font-size="10.5" text-anchor="middle"
       font-family="var(--font-data)">${v}°</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Median direction error is under 25 degrees everywhere but the 90th percentile exceeds 90 degrees at every receptor">
    <line x1="${t30.toFixed(1)}" y1="${T - 16}" x2="${t30.toFixed(1)}" y2="${H - 42}"
      stroke="${MUTED}" stroke-dasharray="3 4" opacity="0.7"/>
    <circle cx="${L + 6}" cy="26" r="5" fill="${MODEL}"/><text x="${L + 18}" y="30" fill="${MUTED}" font-size="11.5">median</text>
    <circle cx="${L + 116}" cy="26" r="5" fill="${ALERT}"/><text x="${L + 128}" y="30" fill="${MUTED}" font-size="11.5">90th percentile</text>
    <text x="${W - R + 14}" y="30" fill="${MUTED}" font-size="11">within ±30°</text>
    ${body}
    <line x1="${L}" y1="${H - 42}" x2="${W - R}" y2="${H - 42}" stroke="${GRID}"/>${xt}
    <text x="${(t30 + 7).toFixed(1)}" y="${H - 50}" fill="${MUTED}" font-size="10.5">what the check asks for</text>
    <text x="${(L + W - R) / 2}" y="${H - 10}" fill="${MUTED}" font-size="11.5" text-anchor="middle">difference between the backward and forward bearing, ${nf(TR.bearing.rows)} episode days</text>
  </svg>`;
}

/* ── Figure 10 · the check published as failed ranks all seven seasons correctly ───── */
function fig10() {
  const S = A.anchors.seasons;
  const W = 700, H = 340, T = 62, rowH = 34, L = 76, R = 76;
  const xa = L + 138, xb = W - R - 138;
  const maxO = Math.max(...S.map((s: any) => s.observed));
  const maxM = Math.max(...S.map((s: any) => s.modelled));
  const byObs = [...S].sort((a: any, b: any) => b.observed - a.observed);
  const byMod = [...S].sort((a: any, b: any) => b.modelled - a.modelled);
  const yO = (s: any) => T + byObs.indexOf(s) * rowH;
  const yM = (s: any) => T + byMod.indexOf(s) * rowH;
  const body = S.map((s: any) => {
    const anchor = A.published.anchors.includes(s.year);
    const col = anchor ? MODEL : PERSIST;
    const wo = (s.observed / maxO) * 120, wm = (s.modelled / maxM) * 120;
    const a = yO(s), b = yM(s);
    return `<rect x="${(xa - wo).toFixed(1)}" y="${a - 8}" width="${wo.toFixed(1)}" height="16" rx="2"
        fill="${col}" opacity="${anchor ? 0.95 : 0.5}"/>
      <rect x="${xb}" y="${b - 8}" width="${wm.toFixed(1)}" height="16" rx="2"
        fill="${col}" opacity="${anchor ? 0.95 : 0.5}"/>
      <path d="M${xa + 6} ${a} C${xa + 60} ${a} ${xb - 60} ${b} ${xb - 6} ${b}" fill="none"
        stroke="${col}" stroke-width="${anchor ? 2.4 : 1.4}" opacity="${anchor ? 0.9 : 0.4}"/>
      <text x="${(xa - wo - 8).toFixed(1)}" y="${a + 4}" fill="${col}" font-size="11"
        text-anchor="end" font-family="var(--font-data)">${s.year}</text>
      <text x="${(xb + wm + 8).toFixed(1)}" y="${b + 4}" fill="${col}" font-size="11"
        font-family="var(--font-data)">${s.year}</text>`;
  }).join("");
  return `<svg viewBox="0 0 ${W} ${H}" class="fig" role="img" aria-label="Modelled and observed seasonal severity rank the seven seasons in exactly the same order">
    <text x="${xa}" y="30" fill="${MUTED}" font-size="12" text-anchor="end"
      font-family="var(--font-data)" letter-spacing="0.06em">OBSERVED DETECTIONS</text>
    <text x="${xb}" y="30" fill="${MUTED}" font-size="12" font-family="var(--font-data)"
      letter-spacing="0.06em">MODELLED SEASONAL RISK</text>
    ${body}
    <text x="${W / 2}" y="${H - 34}" fill="${INK}" font-size="12.5" text-anchor="middle">Spearman ρ = ${A.anchors.spearman.toFixed(2)} across all ${S.length} seasons — the ordering is exact</text>
    <text x="${W / 2}" y="${H - 14}" fill="${ALERT}" font-size="11.5" text-anchor="middle">and the case publishes this check as FAILED, because a 90th-percentile rule over ${A.anchors.seasons_in_record} seasons admits ${A.anchors.seasons_admitted}</text>
  </svg>`;
}

