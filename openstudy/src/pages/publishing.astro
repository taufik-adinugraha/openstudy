    display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem;
    font-family: var(--sans); font-size: 0.82rem; font-weight: 500;
    margin: 1.3rem 0 0.6rem;
  }
  .flow b {
    border: 1px solid var(--rule); padding: 0.35rem 0.7rem;
    background: var(--panel); font-weight: 600;
  }
  .flow b.doi { border-color: var(--accent); color: var(--accent); }
  .flow i { font-style: normal; color: var(--faint); }
  .flow em { font-style: italic; color: var(--flag); font-size: 0.78rem; margin-left: 0.4rem; }
</style>
