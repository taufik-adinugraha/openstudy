---
// The front door.
//
// This page used to open "You did the research. It still lives in a PDF." — a pitch to
// an academic with a finished paper who wanted it revived. That is not what this is for.
// The direction is a portfolio: someone deciding whether the person who built this can
// do the work, with domain specialists validating findings as a second audience.
//
// So the journal furniture is gone from here — the reusable-analysis argument, the
// conference pitch, the four-stage service menu, the intake process, the authorship
// tally whose headline column was a zero. What is left is what an evaluator needs:
// what this is, three cases in depth, the findings the analysis caught, what it is
// built with, and one short line on collaboration. /work/ carries the depth,
// /stack/ the tools, /contribute/ the intake.
//
// First person, deliberately. The site used to speak as an institution ("this site will
// not publish"), which is a strange voice for work whose point is that one person built
// it.
import { existsSync } from "node:fs";
import Page from "../layouts/Page.astro";
import S from "../data/stack.json";
import W from "../data/work.json";
import { INSTRUMENTS } from "../data/instruments.js";

// Card art is each case's own tile — a purpose-drawn schematic animated with the
// phenomenon it measures. Which ones animate is read off the filesystem rather than
// hand-listed, because two of the ten are stills and a hand-kept list would drift.
const tileFor = (slug) => {
  for (const ext of ["svg", "jpg"]) {
    if (existsSync(new URL(`../../public/tiles/${slug}.${ext}`, import.meta.url)))
      return { src: `/tiles/${slug}.${ext}`, animated: ext === "svg" };
  }
  return null;
};

const n = (x) => x.toLocaleString("en-US");
const m = (x) => (x / 1e6).toFixed(1) + "M";
const DEEP = ["poverty", "rice", "haze"];
const deep = DEEP.map((d) => INSTRUMENTS.find((i) => i.slug === d));
const rest = INSTRUMENTS.filter((i) => !DEEP.includes(i.slug));

// what each of the three demonstrates — the only ordering an evaluator cares about
const SHOWS = {
  poverty: "Validation design",
  rice: "Data engineering",
  haze: "Operational modelling",
};
const HEADLINE = {
  poverty: `The same model scores ${W.poverty.validation[0].r2.toFixed(2)} or `
    + `${W.poverty.validation[2].r2.toFixed(2)} depending only on how the data is split`,
  rice: `Precision ${W.rice.precision.toFixed(2)} against recall `
    + `${W.rice.recall.toFixed(2)}, and a controlled experiment showing why`,
  haze: `AUC ${W.haze.leads[0].auc.toFixed(3)} a day ahead, against the operational `
    + `index's ${W.haze.vs_fwi.fwi.toFixed(3)}`,
};
---

<Page
  title="Advanced analytics on Indonesian public data"
  description="Ten instruments built end to end on satellite and official data: pipelines, models, evaluations designed to fail, and dashboards you can interrogate."
  current="/"
>
  <section class="hero">
    <p class="eyebrow">
      <a href="/standards/#sources">Public data</a> · Indonesia —
      <a href="#caught">advanced analytics</a> ·
      <a href="/stack/#models">ML</a> ·
      <a href="/stack/#pipelines">AI</a> ·
      <a href="/standards/#visualization">interactive dashboards</a>
    </p>
    <h1>Satellite data, public statistics.<br /><em>Models, and the checks that break them.</em></h1>
    <p class="lead">
      I build instruments end to end on Indonesian public data: the satellite ingest, the
      features, the model, an evaluation designed to fail, and a dashboard you can
      interrogate rather than just look at. <b>Ten are live.</b> In every one of them the
      figure that mattered came out of the evaluation, not the model — which is the part
      of this work I would want to be judged on.
    </p>
    <dl class="tally">
      <div><dt>Instruments live</dt><dd>{INSTRUMENTS.length}</dd></div>
      <div><dt>Public data sources</dt><dd>{S.sources.length}</dd></div>
      <div><dt>Rows modelled</dt><dd>{m(W.haze.fwi_rows)}</dd></div>
      <div><dt>Lines of Python</dt><dd>{n(S.code.python.lines)}</dd></div>
    </dl>
    <p class="ctas">
      <a class="cta" href="/work/">Three cases in depth</a>
      <a class="cta ghost" href="/stack/">What it is built with</a>
      <a class="cta ghost" href="#collaborate">Work with me</a>
    </p>
  </section>

  <section class="sec" id="three">
    <div class="rail">In depth<span>three of ten</span></div>
    <div class="col wide">
      <h2>Each one demonstrates something different</h2>
      <p>
        Ten summaries say less than three worked examples, so three get the space. Every
        figure on those pages is read from the record the pipeline wrote.
      </p>
      <ul class="three">
        {deep.map((i) => (
          <li>
            {tileFor(i.slug) && (
              <a class="card-shot" href={`/work/#${i.slug}`} aria-hidden="true" tabindex="-1">
                <img src={tileFor(i.slug).src} alt="" loading="lazy" decoding="async" />
              </a>
            )}
            <p class="shows">{SHOWS[i.slug]}</p>
            <h3><a href={`/work/#${i.slug}`}>{i.title}</a></h3>
            <p class="claim">{HEADLINE[i.slug]}</p>
            <p class="links">
              <a href={`/${i.slug}/`}>Dashboard<span aria-hidden="true"> →</span></a>
              <a href={`/work/#${i.slug}`}>What it shows<span aria-hidden="true"> →</span></a>
            </p>
          </li>
        ))}
      </ul>
      <p class="go">
        <a class="strong" href="/work/">All three, with the numbers<span aria-hidden="true"> →</span></a>
        <a href="/work/#more">And the other {rest.length}<span aria-hidden="true"> →</span></a>
      </p>
    </div>
  </section>

  <section class="sec" id="caught">
    <div class="rail">Analysis<span>what drawing cannot do</span></div>
    <div class="col wide">
      <h2>The findings a dashboard could never have produced</h2>
      <p>
        Visualization is the last of four stages and the most visible, which makes it easy
        to mistake for the whole job. It is not. Every result below came out of the
        pipeline, the estimator or the evaluation — and each one contradicted something the
        instrument was expected to show.
      </p>
      <div class="tw">
        <table>
          <thead><tr><th>What the analysis caught</th><th>Where</th><th>Why it took analysis</th></tr></thead>
          <tbody>
            <tr>
              <td><b>Recovered a compressor efficiency its own author no longer had.</b>
                A 2016 paper reported a COP but not the isentropic efficiency behind it.
                Inverting the cycle against three different refrigerant mixtures returned
                0.642, 0.649 and 0.662 — a spread of 0.01</td>
              <td><a href="/notes/cascade-refrigeration/">cascade replication</a> ·
                <a href="/notes/cascade-explorer/">dashboard</a></td>
              <td>Three independent fluids agreeing is the evidence. A wrong cycle would
                have scattered</td>
            </tr>
            <tr>
              <td><b>57% of the squared error was a single constant per province.</b>
                A satellite cannot see the poverty line the roofs are judged against —
                and a random k-fold would have reported R² 0.65 instead of 0.395</td>
              <td><a href="/poverty/">poverty map</a></td>
              <td>Only a spatially-blocked fold design exposes it. The inflation was the
                finding</td>
            </tr>
            <tr>
              <td><b>A nowcast 41% worse than doing nothing</b>, with 99.5% of it
                intercept — a number that would print almost unchanged if the satellite
                were switched off</td>
              <td><a href="/nightlights/">nightlights</a></td>
              <td>Requires scoring against a naive rival. Without one it looks like skill</td>
            </tr>
            <tr>
              <td><b>The archive shrank 4.4× in nine years.</b> Raw counts would have told
                a confident and completely false story about attention</td>
              <td><a href="/narrative/">global narrative</a></td>
              <td>Found by checking the denominator, which nothing in the data announces</td>
            </tr>
            <tr>
              <td><b>Precision bought by detecting less.</b> A detector quoted 83%
                agreement as evidence it found the rice; precision is the one statistic a
                detector can always buy by finding fewer fields</td>
              <td><a href="/rice/">rice security</a></td>
              <td>Caught in adversarial review of our own published claim, which was then
                corrected on the page</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="dim">
        Statistics, ML/AI, thermodynamics, spatial validation, and enough software
        engineering to make it re-runnable. The dashboard is what you see; it is not what
        makes the number trustworthy.
      </p>
    </div>
  </section>

  <section class="sec" id="how">
    <div class="rail">Built with<span>and where to check</span></div>
    <div class="col wide">
      <h2>The visible part is the smallest part</h2>
      <p>
        {S.sources.length} external sources, none of them a tidy CSV: Sentinel-1 radar as
        compressed scenes found by catalogue query, NASA Black Marble as authenticated
        HDF5, ERA5 through a request queue that takes hours. Then gradient boosting and
        regularised linear models on raster-derived features, scored against naive rivals
        under spatially blocked validation. Then {S.code.astro.files} Astro files and
        {" "}{S.javascript.length} front-end packages, with no high-level charting library —
        charts are composed from d3's scales and shape generators, and where a chart has
        tens of thousands of marks the dense layer goes on a canvas so the axis text stays
        text.
      </p>
      <p>
        <a href="/stack/">/stack/</a> lists all of it with versions and a link to the file
        that uses each one. It is generated from the repository rather than typed, so it
        cannot name a library the code does not install.
      </p>
      <p class="go">
        <a class="strong" href="/stack/">The stack, in full<span aria-hidden="true"> →</span></a>
        <a href="/standards/">How a result gets to count<span aria-hidden="true"> →</span></a>
        <a href={S.repo}>The repository<span aria-hidden="true"> →</span></a>
      </p>
    </div>
  </section>

  <section class="sec" id="collaborate">
    <div class="rail">Collaboration<span>two kinds</span></div>
    <div class="col wide">
      <h2>What I need, and what I can build</h2>
      <div class="sides">
        <div class="side">
          <h3>If you know the subject</h3>
          <p>
            Measurement is finished on all ten; what none of them carries is what the
            result <em>means</em> in its own field. That needs someone who knows the
            subject, and it is a small ask: read the finding, tell me whether it is
            plausible, and say so in your own words if you want the credit. If your
            reading is that it should not be published, that ends it.
          </p>
          <p><a href="/contribute/#interpret">What that involves, exactly</a></p>
        </div>
        <div class="side">
          <h3>If you have the research and not the tools</h3>
          <p>
            Most of the people this would help are strong in their own field and have
            never had to open a NASA endpoint, fit a gradient booster or build something
            interactive — the work sits in Excel or SPSS because that is what was
            available. That gap is the thing I am useful for, and it costs nothing. The
            findings stay yours.
          </p>
          <p><a href="/contribute/">How a case starts</a></p>
        </div>
      </div>
      <div class="callout">
        <p>
          <b>Also one replication.</b> A published optimisation rebuilt from the paper
          alone — three of five pre-registered checks reproduced, two did not, and a
          compressor efficiency its own author no longer had recovered from the paper's
          own reported performance. It is here as proof of method:
          {" "}<a href="/notes/cascade-refrigeration/">the note</a>, and
          {" "}<a href="/notes/cascade-explorer/">the dashboard</a> that recomputes 62,370
          operating points in your browser.
        </p>
      </div>
    </div>
  </section>
</Page>

<style>
  .hero { padding-bottom: 0.5rem; }
  .eyebrow {
    font-family: var(--sans); font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
    margin: 0 0 1.1rem;
  }
  .eyebrow a { color: inherit; text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); }
  .eyebrow a:hover { border-bottom-color: var(--accent); }
  .hero h1 { max-width: 28ch; }
  .sec .col.wide { max-width: none; }

  .tally {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 1px; margin: 2rem 0 0; padding: 0;
    background: var(--rule); border: 1px solid var(--rule);
  }
  .tally > div { background: var(--ground); padding: 0.85rem 1rem; }
  .tally dt { font-family: var(--sans); font-size: 0.66rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .tally dd { margin: 0.3rem 0 0; font-family: var(--sans); font-size: 1.6rem;
    font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; color: var(--ink); }

  .ctas { display: flex; flex-wrap: wrap; gap: 0.7rem; margin: 1.8rem 0 0; }
  .cta { font-family: var(--sans); font-size: 0.88rem; font-weight: 600;
    text-decoration: none; padding: 0.62rem 1.1rem; border: 1px solid var(--accent);
    background: var(--accent); color: var(--ground);
    box-shadow: 0 0 26px -10px var(--glow); }
  .cta.ghost { background: transparent; color: var(--accent); box-shadow: none; }
  .cta:hover { filter: brightness(1.08); }
  .cta.ghost:hover { background: color-mix(in srgb, var(--accent) 12%, transparent); }

  .three { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px;
    background: var(--rule); border: 1px solid var(--rule); }
  @media (max-width: 900px) { .three { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .three { grid-template-columns: 1fr; } }
  .three > li { background: var(--ground); padding: 0 0 1.15rem; display: flex;
    flex-direction: column; }
  .three > li > :not(.card-shot) { padding-left: 1.2rem; padding-right: 1.2rem; }
  .card-shot { display: block; margin: 0 0 1.05rem; overflow: hidden;
    border-bottom: 1px solid var(--rule); background: var(--panel); }
  .card-shot img { display: block; width: 100%; aspect-ratio: 16 / 9;
    object-fit: cover; transition: transform .4s ease; }
  .three > li:hover .card-shot img { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .card-shot img { transition: none; }
    .three > li:hover .card-shot img { transform: none; }
  }
  .links { margin-top: auto; }
  .shows { font-family: var(--sans); font-size: 0.64rem; font-weight: 600;
    letter-spacing: 0.09em; text-transform: uppercase; color: var(--accent);
    margin: 0 0 0.55rem; }
  .three h3 { font-family: var(--serif); font-size: 1.12rem; font-weight: 600;
    line-height: 1.25; margin: 0 0 0.5rem; }
  .three h3 a { color: var(--ink); text-decoration: none; }
  .three h3 a:hover { color: var(--accent); }
  .claim { font-family: var(--sans); font-size: 0.84rem; line-height: 1.58;
    color: var(--muted); margin: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; margin: 0.9rem 0 0;
    font-family: var(--sans); font-size: 0.8rem; }
  .links a { color: var(--muted); text-decoration: none;
    border-bottom: 1px solid var(--rule); }
  .links a:hover { color: var(--accent); border-bottom-color: var(--accent); }

  .go { display: flex; flex-wrap: wrap; gap: 0.6rem 1.7rem; margin: 1.5rem 0 0;
    font-family: var(--sans); font-size: 0.88rem; }
  .go a { color: var(--muted); text-decoration: none;
    border-bottom: 1px solid var(--rule); padding-bottom: 2px; }
  .go a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .go a.strong { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }

  /* the evidence table, kept from the previous version of this page */
  .tw { overflow-x: auto; margin: 1.4rem 0; }
  .tw table { min-width: 34rem; }
  td .chip, .chip { font-family: var(--sans); font-size: 0.66rem; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
</style>
