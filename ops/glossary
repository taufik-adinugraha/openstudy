#!/usr/bin/env python3
"""Put a glossary on every article, from one set of definitions.

Each case is its own Astro app with its own root, so it cannot import from shared/.
The definitions are therefore copied in, and this script is the only thing allowed to
write them — one source of truth, ten identical copies, and `verify` fails if they drift.

Which terms an article shows is NOT maintained by hand. The article reads its own source
at build time and renders only the terms that appear in it. Hand-kept lists were how the
tally, the door count and the gate count all went stale earlier; the filesystem is a
better authority than a person's memory.

    ops/glossary sync      copy definitions in and inject the section where missing
    ops/glossary verify    check every copy matches shared/ and every article has one
"""

from __future__ import annotations

import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SRC = ROOT / "shared/glossary.js"
ARTICLES = sorted(ROOT.glob("cases/*/web/src/pages/article.astro"))

IMPORT_LINE = 'import { glossaryFor } from "../data/glossary.js";'
# Vite's ?raw gives this file's own SOURCE as a string. readFileSync(import.meta.url)
# does not: at build time that resolves to the COMPILED module, which has the
# definitions bundled into it, so every term matched itself and all 44 rendered on
# every article. The source is the thing to scan.
FS_LINE = 'import __src from "./article.astro?raw";'
TERMS_LINE = (
    "// Only the terms this article actually uses, scanned from its own source at build\n"
    "// time so no per-article list has to be kept in step by hand. The frontmatter is\n"
    "// excluded: variable names are not prose, and scanning them defined 'F1' and\n"
    "// 'median' on pages where no reader ever meets those words.\n"
    "const __glossary = glossaryFor(__src.slice(__src.indexOf('\\n---', 3)));"
)

SECTION = """
      <details class="glossary" id="glossary">
        <summary>
          <span>Plain-language glossary</span>
          <span class="gcount">{__glossary.length} terms this article uses</span>
        </summary>
        <p class="glossary-lede">
          Written for someone who knows the subject and not this vocabulary. The instrument
          and measurement terms come first, because those are the ones a specialist in the
          subject has no reason to know; the statistics follow.
        </p>
        <dl>
          {__glossary.map((g) => (
            <div>
              <dt>{g.term}</dt>
              <dd>{g.plain}</dd>
            </div>
          ))}
        </dl>
      </details>
"""

STYLE = """
  .glossary { max-width: 46rem; margin: 2rem auto 2.5rem; padding: 0;
    border: 1px solid var(--hairline, #2a2a2a); background: rgba(255,255,255,0.015); }
  .glossary > summary { cursor: pointer; padding: 0.9rem 1.1rem; display: flex;
    flex-wrap: wrap; gap: 0.2rem 0.8rem; align-items: baseline;
    font-size: 0.95rem; font-weight: 600; color: var(--ink, #e8ede9); }
  .glossary > summary:hover { color: var(--accent, #6fc7d6); }
  /* display:flex on a <summary> removes the disclosure marker in every browser, so
     the panel read as a static bar rather than a control. Put one back explicitly. */
  .glossary > summary { list-style: none; }
  .glossary > summary::-webkit-details-marker { display: none; }
  .glossary > summary::before { content: "\25B8"; color: var(--accent, #6fc7d6);
    font-size: 0.85em; line-height: 1.4; }
  .glossary[open] > summary::before { content: "\25BE"; }
  .glossary > summary:focus-visible { outline: 2px solid var(--accent, #6fc7d6);
    outline-offset: 2px; }
  .glossary .gcount { font-size: 0.78rem; font-weight: 400;
    color: var(--ink-muted, #93a198); }
  .glossary-lede { margin: 0 1.1rem 1.1rem; font-size: 0.88rem; line-height: 1.6;
    color: var(--ink-muted, #93a198); }
  .glossary dl { margin: 0; padding: 0 1.1rem 1.2rem; display: grid; gap: 1rem; }
  .glossary dt { font-weight: 600; font-size: 0.93rem; color: var(--ink, #e8ede9); }
  .glossary dd { margin: 0.25rem 0 0; font-size: 0.91rem; line-height: 1.6;
    color: var(--ink-muted, #93a198); }
"""


def frontmatter_bounds(s: str) -> tuple[int, int]:
    assert s.startswith("---"), "article does not open with frontmatter"
    end = s.index("\n---", 3)
    return 3, end


def inject(path: pathlib.Path) -> str:
    s = path.read_text()
    changed = []

    # 1. definitions, copied into the app's own tree
    dest = path.parent.parent / "data/glossary.js"
    dest.parent.mkdir(parents=True, exist_ok=True)
    if not dest.exists() or dest.read_text() != SRC.read_text():
        dest.write_text(SRC.read_text())
        changed.append("definitions")

    # 2. frontmatter. Imports must sit at the TOP: Astro's compiler hoists them, and
    # appending them at the end of a long frontmatter fails to parse with an error that
    # points at an unrelated line in the markup. The derived const can go at the end.
    fs_start, fs_end = frontmatter_bounds(s)
    fm = s[fs_start:fs_end]
    if IMPORT_LINE not in fm or FS_LINE not in fm:
        anchor = 'import "../styles/tokens.css";'
        assert s.count(anchor) == 1, f"{path}: no single tokens.css import to anchor to"
        s = s.replace(anchor, anchor + "\n" + IMPORT_LINE + "\n" + FS_LINE)
        changed.append("imports")
    if "__glossary" not in fm:
        _, fs_end = frontmatter_bounds(s)
        s = s[:fs_end] + "\n" + TERMS_LINE + s[fs_end:]
        changed.append("term list")

    # 3. the section, immediately BEFORE the abstract. It used to sit before </body>: a
    # domain expert reported finding it below the References, after she had already given
    # up on the method section it was supposed to unlock. Above rather than below the
    # abstract because these abstracts run to several hundred words and are themselves
    # dense with the vocabulary being defined — and a collapsed <details> costs one line.
    if 'id="glossary"' not in s:
        m = re.search(r'\n(\s*)<section class="abstract"', s)
        assert m, f"{path}: no <section class=\"abstract\"> to sit above"
        s = s[:m.start()] + "\n" + SECTION + s[m.start() + 1:]
        changed.append("section above the abstract")

    # 4. styles, appended to the last style block
    if ".glossary {" not in s:
        i = s.find("</style>")          # the page's own block, not a nested one
        if i > 0:
            s = s[:i] + STYLE + s[i:]
            changed.append("styles")

    if changed:
        path.write_text(s)
    return ", ".join(changed) or "already current"


def verify() -> int:
    bad = 0
    for p in ARTICLES:
        case = p.parts[-5]
        dest = p.parent.parent / "data/glossary.js"
        issues = []
        if not dest.exists():
            issues.append("no definitions copy")
        elif dest.read_text() != SRC.read_text():
            issues.append("definitions DRIFTED from shared/")
        if 'id="glossary"' not in p.read_text():
            issues.append("no glossary section")
        print(f"  {case:20} {'; '.join(issues) if issues else 'ok'}")
        bad += bool(issues)
    print(f"\n  {len(ARTICLES) - bad} of {len(ARTICLES)} articles current")
    return 1 if bad else 0


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "sync"
    if cmd == "verify":
        return verify()
    if cmd != "sync":
        print(__doc__)
        return 2
    for p in ARTICLES:
        print(f"  {p.parts[-5]:20} {inject(p)}")
    print(f"\n  {len(ARTICLES)} article(s) · definitions from shared/glossary.js")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
